    "share_detail": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere diesen Inhalt im Eingang. Öffne CastReader, um ihn vorlesen oder erklären zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this content to your inbox. Open CastReader to read or explain it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este contenido en tu bandeja. Abre CastReader para leerlo o explicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ce contenu dans votre boîte de réception. Ouvrez CastReader pour le lire ou l’expliquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सामग्री को इनबॉक्स में सहेजें। इसे पढ़ने या समझाने के लिए CastReader खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva questo contenuto nella posta in arrivo. Apri CastReader per leggerlo o spiegarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツを受信箱に保存します。CastReader を開いて、読み上げまたは解説を選べます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve este conteúdo na caixa de entrada. Abra o CastReader para ouvir ou explicar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将内容保存到接收箱。打开 CastReader 后再选择朗读或解读。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar deze inhoud in uw inbox. Open CastReader om deze te laten voorlezen of uitleggen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠를 콘텐츠 보관함에 저장하세요. CastReader를 열어 소리 내어 읽거나 해설을 들으세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ هذا المحتوى في صندوق الوارد الخاص بك. افتح CastReader لقراءته أو شرحه."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните этот контент во входящих CastReader. Откройте CastReader, чтобы послушать текст или его объяснение."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz tę treść w skrzynce odbiorczej. Otwórz CastReader, aby jej posłuchać lub uzyskać wyjaśnienie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara detta innehåll till din inkorg. Öppna CastReader för att läsa eller förklara det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem dette indhold i din indbakke. Åbn CastReader for at læse eller forklare det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre dette innholdet i innboksen din. Åpne CastReader for å lese eller forklare det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna sisältö CastReaderin saapuneisiin sisältöihin. Avaa CastReader, niin voit kuunnella tekstin tai sen selityksen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte tento obsah do složky příchozího obsahu. Otevřete CastReader pro předčítání nebo vysvětlení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε αυτό το περιεχόμενο στα εισερχόμενά σας. Ανοίξτε το CastReader για ανάγνωση ή εξήγηση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd ezt a tartalmat a beérkező tartalmak közé. Nyisd meg a CastReadert a felolvasáshoz vagy a magyarázathoz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save ang nilalaman na ito sa iyong inbox. Buksan ang CastReader para mabasa o maipaliwanag."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan konten ini ke kotak masuk Anda. Buka CastReader untuk membaca atau menjelaskannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kandungan ini ke peti masuk anda. Buka CastReader untuk membaca atau menerangkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu içeriği gelen kutunuza kaydedin. Okumak veya açıklamak için CastReader'ı açın."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează acest conținut în inbox. Deschide CastReader pentru a-l citi sau explica."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירת התוכן הזה בתיבת התוכן. יש לפתוח את CastReader כדי לקרוא או להסביר אותו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu nội dung này vào hộp thư nội dung. Mở CastReader để đọc hoặc giải thích."
          }
        }
      }
    },
