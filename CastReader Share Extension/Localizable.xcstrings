    "share_youtube_open_manually": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link ist sicher gespeichert. Tippe unten, um CastReader zu öffnen, oder öffne die App später manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is safely saved. Tap below to open CastReader, or open the app manually later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace está guardado. Toca abajo para abrir CastReader o abre la app manualmente más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien est bien enregistré. Touchez ci-dessous pour ouvrir CastReader, ou ouvrez l’app manuellement plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक सुरक्षित है। CastReader खोलने के लिए नीचे टैप करें, या बाद में ऐप को स्वयं खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link è stato salvato. Tocca qui sotto per aprire CastReader oppure apri l’app manualmente più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは保存済みです。下のボタンで CastReader を開くか、後で手動でアプリを開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link está salvo. Toque abaixo para abrir o CastReader ou abra o app manualmente depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接已安全保存。轻点下方按钮打开 CastReader；也可稍后手动打开 App 自动继续。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link is veilig opgeslagen. Tik hieronder om CastReader te openen, of open de app later handmatig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 안전하게 저장되었습니다. 아래를 탭하여 CastReader를 열거나 나중에 앱을 직접 여세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ الرابط بأمان. اضغط أدناه لفتح CastReader، أو افتح التطبيق يدويًا لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка безопасно сохранена. Нажмите ниже, чтобы открыть CastReader, или запустите приложение вручную позже."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link został bezpiecznie zapisany. Stuknij poniżej, aby otworzyć CastReader, lub uruchom aplikację ręcznie później."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länken är säkert sparad. Tryck nedan för att öppna CastReader, eller öppna appen manuellt senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linket er sikkert gemt. Tryk nedenfor for at åbne CastReader, eller åbn appen manuelt senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenken er trygt lagret. Trykk nedenfor for å åpne CastReader, eller åpne appen manuelt senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkki on turvallisesti tallennettu. Napauta alla avataksesi CastReaderin tai avaa sovellus myöhemmin manuaalisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz je bezpečně uložen. Klepněte níže pro otevření CastReader nebo aplikaci otevřete ručně později."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο σύνδεσμος έχει αποθηκευτεί με ασφάλεια. Πατήστε παρακάτω για να ανοίξετε το CastReader ή ανοίξτε την εφαρμογή χειροκίνητα αργότερα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A link biztonságosan el lett mentve. Koppints alább a CastReader megnyitásához, vagy nyisd meg az alkalmazást később."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligtas na na-save ang link. I-tap sa ibaba upang buksan ang CastReader, o buksan ang app nang manu-mano mamaya."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan telah disimpan dengan aman. Ketuk di bawah untuk membuka CastReader, atau buka aplikasi secara manual nanti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan telah disimpan dengan selamat. Ketuk di bawah untuk membuka CastReader, atau buka aplikasi secara manual kemudian."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı güvenle kaydedildi. CastReader'ı açmak için aşağıya dokunun veya uygulamayı daha sonra elle açın."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkul a fost salvat în siguranță. Atinge mai jos pentru a deschide CastReader sau deschide aplicația manual mai târziu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישור נשמר בבטחה. אפשר להקיש למטה כדי לפתוח את CastReader, או לפתוח את האפליקציה ידנית בהמשך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết đã được lưu an toàn. Nhấn bên dưới để mở CastReader hoặc tự mở ứng dụng sau."
          }
        }
      }
    },
