    "share_youtube_saved": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Videolink wurde gespeichert. CastReader wird jetzt geöffnet, wenn iOS es zulässt, oder automatisch beim nächsten App-Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video link is saved. CastReader will open it now when iOS allows, or automatically the next time you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace del video se guardó. CastReader se abrirá ahora si iOS lo permite, o automáticamente la próxima vez que abras la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien de la vidéo est enregistré. CastReader va s’ouvrir si iOS l’autorise, ou automatiquement à la prochaine ouverture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो लिंक सहेज लिया गया है। iOS की अनुमति मिलने पर CastReader अभी खुलेगा, या अगली बार ऐप खोलने पर अपने आप जारी रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link del video è stato salvato. CastReader si aprirà ora se iOS lo consente, oppure automaticamente al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画リンクを保存しました。iOS で許可されれば CastReader を今すぐ開き、許可されない場合は次回起動時に自動で続行します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link do vídeo foi salvo. O CastReader será aberto agora se o iOS permitir, ou automaticamente na próxima vez que você abrir o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频链接已保存。系统允许时会立即打开 CastReader；否则下次打开 App 时会自动继续。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw videolink is opgeslagen. CastReader opent deze nu zodra iOS dit toelaat, of automatisch de volgende keer dat u de app opent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 링크가 저장되었습니다. iOS에서 허용하면 CastReader가 지금 링크를 열고, 그렇지 않으면 다음에 앱을 열 때 자동으로 엽니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ رابط الفيديو الخاص بك. سيفتح CastReader الرابط الآن عندما يسمح iOS، أو تلقائيًا عند فتح التطبيق في المرة القادمة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка на видео сохранена. CastReader откроет её сейчас, когда iOS разрешит, или автоматически при следующем запуске приложения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link do filmu zapisano. CastReader otworzy go teraz, gdy iOS na to pozwoli, lub automatycznie przy następnym otwarciu aplikacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din videolänk har sparats. CastReader öppnar den nu om iOS tillåter det, annars automatiskt nästa gång du öppnar appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit videolink er gemt. CastReader åbner det nu, hvis iOS tillader det, eller automatisk næste gang du åbner appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolenken er lagret. CastReader vil åpne den når iOS tillater det, eller automatisk neste gang du åpner appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolinkkisi on tallennettu. CastReader avaa sen nyt, kun iOS sallii, tai automaattisesti seuraavan kerran, kun avaat sovelluksen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz na video je uložen. CastReader jej otevře nyní, jakmile to iOS dovolí, nebo automaticky při příštím spuštění aplikace."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο σύνδεσμος του βίντεο αποθηκεύτηκε. Το CastReader θα τον ανοίξει τώρα, αν το επιτρέπει το iOS, ή αυτόματα την επόμενη φορά που θα ανοίξετε την εφαρμογή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A videólinked el lett mentve. A CastReader most megnyitja, ha az iOS engedi, vagy automatikusan a következő alkalommal, amikor megnyitod az alkalmazást."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang link ng video. Bubuksan ito ng CastReader ngayon kung papayagan ng iOS, o awtomatiko sa susunod mong pagbukas ng app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan video Anda telah disimpan. CastReader akan membukanya sekarang saat iOS mengizinkan, atau secara otomatis saat Anda membuka aplikasi berikutnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan video anda telah disimpan. CastReader akan membukanya sekarang jika dibenarkan oleh iOS, atau secara automatik apabila anda membuka aplikasi pada kali seterusnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video bağlantınız kaydedildi. iOS izin verirse CastReader bağlantıyı şimdi, aksi takdirde uygulamayı bir sonraki açışınızda otomatik olarak açar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkul videoclipului a fost salvat. CastReader îl va deschide acum, dacă iOS permite, sau automat la următoarea deschidere a aplicației."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישור הסרטון שלך נשמר. CastReader יפתח אותו עכשיו אם iOS מאפשר זאת, או אוטומטית בפעם הבאה שהאפליקציה תיפתח."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết video đã được lưu. CastReader sẽ mở ngay khi iOS cho phép, hoặc tự động mở vào lần tiếp theo bạn mở ứng dụng."
          }
        }
      }
    },
