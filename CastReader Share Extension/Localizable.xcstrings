    "share_youtube_saved" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Videolink wurde gespeichert. CastReader wird jetzt geöffnet, wenn iOS es zulässt, oder automatisch beim nächsten App-Start." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your video link is saved. CastReader will open it now when iOS allows, or automatically the next time you open the app." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El enlace del video se guardó. CastReader se abrirá ahora si iOS lo permite, o automáticamente la próxima vez que abras la app." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le lien de la vidéo est enregistré. CastReader va s’ouvrir si iOS l’autorise, ou automatiquement à la prochaine ouverture." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "वीडियो लिंक सहेज लिया गया है। iOS की अनुमति मिलने पर CastReader अभी खुलेगा, या अगली बार ऐप खोलने पर अपने आप जारी रहेगा।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il link del video è stato salvato. CastReader si aprirà ora se iOS lo consente, oppure automaticamente al prossimo avvio." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "動画リンクを保存しました。iOS で許可されれば CastReader を今すぐ開き、許可されない場合は次回起動時に自動で続行します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O link do vídeo foi salvo. O CastReader será aberto agora se o iOS permitir, ou automaticamente na próxima vez que você abrir o app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "视频链接已保存。系统允许时会立即打开 CastReader；否则下次打开 App 时会自动继续。" } }
      }
    },
