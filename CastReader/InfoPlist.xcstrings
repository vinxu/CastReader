    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere Text aus Büchern, Dokumenten oder von Bildschirmen. Für einige Sprachen werden Bilder über CastReader zur Texterkennung an Google gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture text from books, documents, or screens. For some languages, images are sent to Google through CastReader for text recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura texto de libros, documentos o pantallas. Para algunos idiomas, las imágenes se envían a Google a través de CastReader para reconocer el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez du texte dans des livres, des documents ou sur des écrans. Pour certaines langues, les images sont envoyées à Google via CastReader pour reconnaître le texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किताबों, दस्तावेज़ों या स्क्रीन से टेक्स्ट कैप्चर करें। कुछ भाषाओं के लिए, टेक्स्ट पहचानने हेतु चित्र CastReader के माध्यम से Google को भेजे जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisisci testo da libri, documenti o schermi. Per alcune lingue, le immagini vengono inviate a Google tramite CastReader per il riconoscimento del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本や書類、画面の文字を撮影します。 一部の言語では、文字認識のために画像がCastReaderを通じてGoogleに送信されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture textos de livros, documentos ou telas. Para alguns idiomas, as imagens são enviadas ao Google pelo CastReader para reconhecimento de texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄文字，用于朗读、逐词高亮和 AI 讲解。 部分语言需通过 CastReader 将图片发送至 Google 进行文字识别。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer tekst uit boeken, documenten of op schermen. Voor sommige talen worden afbeeldingen via CastReader naar Google gestuurd voor tekstherkenning."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّر النص من الكتب أو المستندات أو الشاشات. لبعض اللغات، تُرسل الصور إلى Google عبر CastReader للتعرّف على النص."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте текст в книге, документе или на экране. Для некоторых языков изображения отправляются в Google через CastReader для распознавания текста."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób zdjęcie tekstu w książce, dokumencie lub na ekranie. W przypadku niektórych języków obrazy są wysyłane do Google za pośrednictwem CastReader w celu rozpoznania tekstu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografera text i böcker, dokument eller på skärmar. För vissa språk skickas bilder till Google via CastReader för textigenkänning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografér tekst i bøger, dokumenter eller på skærme. For nogle sprog sendes billeder til Google via CastReader til tekstgenkendelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografer tekst i bøker, dokumenter eller på skjermer. For enkelte språk sendes bilder til Google via CastReader for tekstgjenkjenning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaa tekstiä kirjoista, asiakirjoista tai näytöiltä. Joillakin kielillä kuvat lähetetään Googlelle CastReaderin kautta tekstintunnistusta varten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfoťte text z knih, dokumentů nebo obrazovek. U některých jazyků se obrázky odesílají přes CastReader společnosti Google k rozpoznání textu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογραφίστε κείμενο από βιβλία, έγγραφα ή οθόνες. Για ορισμένες γλώσσες, οι εικόνες αποστέλλονται στην Google μέσω του CastReader για αναγνώριση κειμένου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotózz le szöveget könyvből, dokumentumból vagy képernyőről. Egyes nyelveknél a képek a CastReaderen keresztül a Google-hoz kerülnek szövegfelismerésre."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunan ng larawan ang teksto sa mga aklat, dokumento, o screen. Para sa ilang wika, ipinapadala ang mga larawan sa Google sa pamamagitan ng CastReader upang makilala ang teksto."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil gambar teks daripada buku, dokumen atau skrin. Bagi sesetengah bahasa, imej dihantar ke Google melalui CastReader untuk pengecaman teks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitap, belge veya ekranlardaki metinlerin fotoğrafını çekin. Bazı dillerde görüntüler, metin tanıma için CastReader aracılığıyla Google’a gönderilir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책, 문서 또는 화면의 글을 촬영하세요. 일부 언어의 경우 텍스트 인식을 위해 이미지가 CastReader를 통해 Google로 전송됩니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto teks dari buku, dokumen, atau layar. Untuk beberapa bahasa, gambar dikirim ke Google melalui CastReader untuk pengenalan teks."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiază text din cărți, documente sau de pe ecrane. Pentru unele limbi, imaginile sunt trimise către Google prin CastReader pentru recunoașterea textului."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צלמו טקסט מתוך ספרים, מסמכים או מסכים. בשפות מסוימות, התמונות נשלחות ל-Google דרך CastReader לצורך זיהוי טקסט."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp văn bản từ sách, tài liệu hoặc màn hình. Với một số ngôn ngữ, hình ảnh được gửi đến Google qua CastReader để nhận dạng văn bản."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm eine kurze Sprachprobe auf, um deine persönliche Stimme zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a short sample to create your personal voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una muestra breve para crear tu voz personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un court extrait pour créer votre voix personnelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी व्यक्तिगत आवाज़ बनाने के लिए एक छोटा नमूना रिकॉर्ड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un breve campione per creare la tua voce personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い音声サンプルを録音して、自分の声を作成します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma breve amostra para criar sua voz pessoal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制一段简短样本，用于创建你的个人声音。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een kort stemfragment op om uw persoonlijke stem te maken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل عينة صوتية قصيرة لإنشاء صوتك الشخصي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите короткий образец речи, чтобы создать свой голос."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj krótką próbkę, aby utworzyć własny głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in ett kort röstprov för att skapa din egen röst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag en kort stemmeprøve for at oprette din egen stemme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp en kort stemmeprøve for å lage din egen stemme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna lyhyt ääninäyte luodaksesi oman äänesi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrajte krátkou hlasovou ukázku a vytvořte si vlastní hlas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ηχογραφήστε ένα σύντομο δείγμα για να δημιουργήσετε την προσωπική σας φωνή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíts egy rövid hangmintát a saját hangod létrehozásához."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magrekord ng maikling sample upang lumikha ng sarili mong boses."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakam sampel pendek untuk mencipta suara peribadi anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel sesinizi oluşturmak için kısa bir ses örneği kaydedin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 음성 샘플을 녹음해 나만의 음성을 만드세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam sampel singkat untuk membuat suara pribadi Anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează o mostră scurtă pentru a-ți crea vocea personală."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקליטו דוגמה קצרה ליצירת הקול האישי שלכם."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu một mẫu ngắn để tạo giọng cá nhân của bạn."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Fotos mit Text aus. Für einige Sprachen werden Bilder über CastReader zur Texterkennung an Google gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos that contain text. For some languages, images are sent to Google through CastReader for text recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona fotos que contengan texto. Para algunos idiomas, las imágenes se envían a Google a través de CastReader para reconocer el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez des photos contenant du texte. Pour certaines langues, les images sont envoyées à Google via CastReader pour reconnaître le texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट वाली फ़ोटो चुनें। कुछ भाषाओं के लिए, टेक्स्ट पहचानने हेतु चित्र CastReader के माध्यम से Google को भेजे जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli foto che contengono testo. Per alcune lingue, le immagini vengono inviate a Google tramite CastReader per il riconoscimento del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を含む写真を選択します。 一部の言語では、文字認識のために画像がCastReaderを通じてGoogleに送信されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione fotos que contenham texto. Para alguns idiomas, as imagens são enviadas ao Google pelo CastReader para reconhecimento de texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择包含文字的照片，用于朗读、逐词高亮和 AI 讲解。 部分语言需通过 CastReader 将图片发送至 Google 进行文字识别。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies foto’s met tekst. Voor sommige talen worden afbeeldingen via CastReader naar Google gestuurd voor tekstherkenning."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورًا تحتوي على نص. لبعض اللغات، تُرسل الصور إلى Google عبر CastReader للتعرّف على النص."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фотографии с текстом. Для некоторых языков изображения отправляются в Google через CastReader для распознавания текста."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zdjęcia zawierające tekst. W przypadku niektórych języków obrazy są wysyłane do Google za pośrednictwem CastReader w celu rozpoznania tekstu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj foton som innehåller text. För vissa språk skickas bilder till Google via CastReader för textigenkänning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg fotos med tekst. For nogle sprog sendes billeder til Google via CastReader til tekstgenkendelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg bilder som inneholder tekst. For enkelte språk sendes bilder til Google via CastReader for tekstgjenkjenning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kuvia, joissa on tekstiä. Joillakin kielillä kuvat lähetetään Googlelle CastReaderin kautta tekstintunnistusta varten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte fotografie obsahující text. U některých jazyků se obrázky odesílají přes CastReader společnosti Google k rozpoznání textu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε φωτογραφίες που περιέχουν κείμενο. Για ορισμένες γλώσσες, οι εικόνες αποστέλλονται στην Google μέσω του CastReader για αναγνώριση κειμένου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz szöveget tartalmazó fotókat. Egyes nyelveknél a képek a CastReaderen keresztül a Google-hoz kerülnek szövegfelismerésre."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng mga larawang may teksto. Para sa ilang wika, ipinapadala ang mga larawan sa Google sa pamamagitan ng CastReader upang makilala ang teksto."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto yang mengandungi teks. Bagi sesetengah bahasa, imej dihantar ke Google melalui CastReader untuk pengecaman teks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin içeren fotoğrafları seçin. Bazı dillerde görüntüler, metin tanıma için CastReader aracılığıyla Google’a gönderilir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글이 있는 사진을 선택하세요. 일부 언어의 경우 텍스트 인식을 위해 이미지가 CastReader를 통해 Google로 전송됩니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto yang berisi teks. Untuk beberapa bahasa, gambar dikirim ke Google melalui CastReader untuk pengenalan teks."
          }
        },
        "ro": {
          "stringUnit": {
