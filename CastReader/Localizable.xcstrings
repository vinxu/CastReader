          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakında"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În curând"
          }
        },
        "vi": {
          "stringUnit": {
