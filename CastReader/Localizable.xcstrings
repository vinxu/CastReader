    "点击后自动朗读 · 听满 30 秒完成首次激活": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Tippen startet das Vorlesen automatisch · Nach 30 Sekunden ist die erste Aktivierung abgeschlossen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to start reading aloud automatically · Listen for 30 seconds to complete setup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para iniciar la lectura automáticamente · Escucha 30 segundos para completar la activación inicial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour lancer automatiquement la lecture · Écoutez 30 secondes pour terminer la première activation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैप करते ही अपने-आप पढ़ना शुरू होगा · पहली सक्रियता पूरी करने के लिए 30 सेकंड सुनें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per avviare automaticamente la lettura · Ascolta 30 secondi per completare la prima attivazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップすると自動で読み上げ · 30秒聴くと初回設定が完了"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para iniciar a leitura automaticamente · Ouça por 30 segundos para concluir a primeira ativação"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击后自动朗读 · 听满 30 秒完成首次激活"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om automatisch te beginnen met voorlezen · Luister 30 seconden om het instellen af te ronden"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للبدء بالقراءة الصوتية تلقائيًا · استمع لمدة 30 ثانية لإكمال الإعداد"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы начать автоматическое озвучивание · Послушайте 30 секунд для завершения настройки"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby rozpocząć automatyczny odczyt głosowy · Posłuchaj 30 sekund, aby dokończyć konfigurację"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att starta automatisk uppläsning · Lyssna i 30 sekunder för att slutföra inställningen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at starte automatisk oplæsning · Lyt i 30 sekunder for at fuldføre opsætningen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å starte automatisk opplesning · Lytt i 30 sekunder for å fullføre oppsettet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita automaattinen ääneenluku napauttamalla · Viimeistele käyttöönotto kuuntelemalla 30 sekuntia"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte pro automatické zahájení čtení nahlas · Poslouchejte 30 sekund pro dokončení nastavení"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για να ξεκινήσει αυτόματα η ανάγνωση με φωνή · Ακούστε για 30 δευτερόλεπτα για να ολοκληρώσετε τη ρύθμιση"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a felolvasás automatikus indításához · Hallgasson meg 30 másodpercet a befejezéshez"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap para simulan ang automatic na pagbasa nang may boses · Makinig ng 30 segundo para tapusin ang setup"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르면 자동으로 읽기 시작합니다 · 30초간 들으면 설정이 완료됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk mula membaca kuat secara automatik · Dengar selama 30 saat untuk menyelesaikan persediaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mulai membacakan secara otomatis · Dengarkan selama 30 detik untuk menyelesaikan penyiapan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik sesli okumayı başlatmak için dokunun · Kurulumu tamamlamak için 30 saniye dinleyin"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a începe automat citirea cu voce tare · Ascultă 30 de secunde pentru a finaliza configurarea"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש כדי להתחיל הקראה אוטומטית · האזנה של 30 שניות תסיים את ההגדרה"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để tự động bắt đầu đọc to · Nghe 30 giây để hoàn tất thiết lập"
          }
        }
      }
    },
