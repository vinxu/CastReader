    "找到第一本可朗读的书后会自动继续。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geht automatisch weiter, sobald das erste vorlesbare Buch gefunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll continue automatically once the first readable book is found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuaremos automáticamente cuando encontremos el primer libro que se pueda leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous continuerons automatiquement dès que le premier livre lisible sera trouvé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली पढ़ी जा सकने वाली किताब मिलते ही अपने आप आगे बढ़ेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proseguiremo automaticamente non appena troviamo il primo libro leggibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げられる最初の本が見つかると自動的に進みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos continuar automaticamente assim que o primeiro livro legível for encontrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到第一本可朗读的书后会自动继续。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We gaan automatisch verder zodra het eerste leesbare boek is gevonden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
