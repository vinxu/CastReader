    "声音、逐词高亮和自动滚动会一起跟上。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimme, Hervorhebung Wort für Wort und automatisches Scrollen bleiben synchron."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice, word-by-word highlighting, and automatic scrolling stay in sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz, el resaltado palabra por palabra y el desplazamiento automático avanzan sincronizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix, le surlignage mot à mot et le défilement automatique restent synchronisés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़, शब्द-दर-शब्द हाइलाइट और अपने-आप स्क्रॉल एक साथ चलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voce, evidenziazione parola per parola e scorrimento automatico restano sincronizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声、単語ごとのハイライト、自動スクロールが連動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz, o destaque palavra por palavra e a rolagem automática ficam sincronizados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音、逐词高亮和自动滚动会一起跟上。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stem, de markering van elk woord en het automatisch scrollen blijven synchroon."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل الصوت وتظليل الكلمات بالتتابع والتمرير التلقائي متزامنةً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос, пословная подсветка и автоматическая прокрутка работают синхронно."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos, podświetlanie słów po kolei i automatyczne przewijanie są zsynchronizowane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röst, ord-för-ord-markering och automatisk rullning hålls synkade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplæsning, ordvis fremhævelse og automatisk rulning er synkroniseret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høytlesing, fremheving av hvert ord og automatisk rulling er synkronisert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni, sanakohtainen korostus ja automaattinen vieritys pysyvät synkronoituneina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlas, zvýrazňování slov po slově a automatické posouvání zůstávají synchronizované."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωνή, η επισήμανση λέξης-προς-λέξη και η αυτόματη κύλιση παραμένουν συγχρονισμένες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang, a szószintű kiemelések és az automatikus görgetés szinkronban marad."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang boses, pag-highlight ng salita-salita, at automatic na pag-scroll ay naka-sync."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성, 단어별 강조 표시, 자동 스크롤이 함께 맞춰집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara, sorotan perkataan demi perkataan dan tatal automatik kekal segerak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara, sorotan kata demi kata, dan gulir otomatis tetap sinkron."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, sözcük sözcük vurgulama ve otomatik kaydırma eşzamanlı çalışır."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea, evidențierea cuvânt cu cuvânt și derularea automată rămân sincronizate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקול, ההדגשה מילה אחר מילה והגלילה האוטומטית נשארים מסונכרנים."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng đọc, tô sáng từng từ và cuộn tự động luôn đồng bộ."
          }
        }
      }
    },
