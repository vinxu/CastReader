    "按成功生成的音频时长计量；试听和重复播放已生成的音频不扣额度。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按成功生成的音频时长计量；试听和重复播放已生成的音频不扣额度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts successfully generated audio duration. Previews and replaying existing audio use no allowance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成に成功した音声の長さで計算。試聴と生成済み音声の再生は枠を消費しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuenta la duración del audio generado correctamente. Las muestras y volver a reproducir audio existente no consumen cupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée des fichiers audio générés avec succès est comptabilisée. Les extraits et la réécoute ne consomment aucun quota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt wird die Dauer erfolgreich erzeugter Audios. Hörproben und erneutes Abspielen vorhandener Audios verbrauchen kein Kontingent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta a duração do áudio gerado com sucesso. Prévias e reprodução de áudio já gerado não usam a cota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta la durata dell’audio generato correttamente. Anteprime e riascolto di audio esistente non consumano quota."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफलतापूर्वक बने ऑडियो की अवधि गिनी जाती है। नमूने और पहले से बने ऑडियो को दोबारा सुनना सीमा नहीं घटाता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de duur van succesvol gegenereerde audio telt mee. Luistervoorbeelden en het opnieuw afspelen van bestaande audio kosten geen tegoed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성에 성공한 오디오 길이만 계산합니다. 미리 듣기와 기존 오디오 재생은 한도를 사용하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывается длительность успешно созданного аудио. Пробное прослушивание и повторное воспроизведение готового аудио не расходуют лимит."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit obejmuje czas pomyślnie wygenerowanego dźwięku. Odsłuch próbek i ponowne odtwarzanie istniejącego dźwięku nie zużywają limitu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknar längden på ljud som har genererats utan fel. Provlyssning och återuppspelning av befintligt ljud förbrukar ingen kvot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller varigheden af lyd, der er genereret uden fejl. Stemmeprøver og genafspilning af eksisterende lyd bruger ingen kvote."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teller varigheten av lyd som er generert uten feil. Stemmeprøver og avspilling av eksisterende lyd bruker ingen kvote."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiintiöstä vähennetään vain onnistuneesti luodun äänen kesto. Ääninäytteet ja olemassa olevan äänen toistaminen eivät kuluta kiintiötä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Započítává se délka úspěšně vygenerovaného zvuku. Poslech ukázek ani opakované přehrávání již vytvořeného zvuku limit nečerpají."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρά τη διάρκεια του ήχου που δημιουργήθηκε επιτυχώς. Η ακρόαση δειγμάτων και η επανάληψη υπάρχοντος ήχου δεν καταναλώνουν το όριο."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sikeresen generált hang időtartamát számolja. A hangminták meghallgatása és a meglévő hang újrajátszása nem fogyasztja a keretet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagal lamang ng matagumpay na nabuong audio ang binibilang. Hindi gumagamit ng quota ang pagsubok na pakikinig at muling pag-play ng dati nang audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכסה מחושבת לפי משך השמע שנוצר בהצלחה. האזנה לדוגמה והשמעה חוזרת של שמע שכבר נוצר אינן מנצלות מכסה."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ia în calcul durata audio generată cu succes. Ascultarea mostrelor și redarea înregistrărilor deja generate nu consumă alocarea."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب مدة الصوت الذي تم توليده بنجاح. لا تستهلك المعاينات وإعادة تشغيل الصوت الموجود أي رصيد."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tempoh audio yang berjaya dijana dikira. Pratonton dan memainkan semula audio sedia ada tidak menggunakan kuota."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghitung durasi audio yang berhasil dibuat. Pratinjau dan pemutaran ulang audio yang sudah ada tidak menggunakan kuota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarıyla oluşturulan sesin süresi hesaplanır. Ön dinlemeler ve mevcut sesi yeniden oynatma kota kullanmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính thời lượng âm thanh được tạo thành công. Nghe thử và phát lại âm thanh có sẵn không dùng hạn mức."
          }
        }
      }
    },
