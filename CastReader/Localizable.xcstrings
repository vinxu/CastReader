        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naabot mo na ang dulo ng mga naka-save na pahina. Kumonekta sa internet upang ipagpatuloy ang pag-download."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגעת לסוף הדפים השמורים. התחבר לאינטרנט כדי להמשיך בהורדה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai akhir halaman yang disimpan. Hubungkan ke internet untuk melanjutkan pengunduhan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah sampai ke penghujung halaman yang disimpan. Sambungkan peranti ke internet untuk meneruskan muat turun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai ajuns la sfârșitul paginilor salvate. Conectează-te la internet pentru a continua descărcarea."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen sayfaların sonuna geldiniz. İndirmeye devam etmek için internete bağlanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đến cuối các trang đã lưu. Kết nối internet để tiếp tục tải xuống."
          }
        }
      }
    },
    "这一页文件缺失或损坏，请重新保存此书。其他已保存页面仍可阅读。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一页文件缺失或损坏，请重新保存此书。其他已保存页面仍可阅读。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page is missing or damaged. Save the book again. Other saved pages can still be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページのファイルが見つからないか破損しています。本を保存し直してください。他の保存済みページは読めます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página falta o está dañada. Guarda el libro de nuevo. Las demás páginas guardadas siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page est manquante ou endommagée. Enregistrez à nouveau le livre. Les autres pages enregistrées restent lisibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite fehlt oder ist beschädigt. Speichere das Buch erneut. Andere gespeicherte Seiten sind weiterhin lesbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página está ausente ou danificada. Salve o livro novamente. As outras páginas salvas continuam disponíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa pagina manca o è danneggiata. Salva di nuovo il libro. Le altre pagine salvate restano leggibili."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पन्ना गायब है या खराब हो गया है। किताब फिर सहेजें। बाकी सहेजे गए पन्ने पढ़े जा सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze pagina ontbreekt of is beschadigd. Sla het boek opnieuw op. Andere opgeslagen pagina's kunnen nog steeds worden gelezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지가 없거나 손상되었습니다. 책을 다시 저장하세요. 다른 저장된 페이지는 여전히 읽을 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصفحة مفقودة أو تالفة. احفظ الكتاب مرة أخرى. لا تزال الصفحات المحفوظة الأخرى قابلة للقراءة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница отсутствует или повреждена. Сохраните книгу заново. Остальные сохранённые страницы можно читать."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak tej strony lub jest uszkodzona. Zapisz książkę ponownie. Pozostałe zapisane strony można nadal czytać."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna sida saknas eller är skadad. Spara boken igen. Andra sparade sidor kan fortfarande läsas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne side mangler eller er beskadiget. Gem bogen igen. Andre gemte sider kan stadig læses."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne siden mangler eller er skadet. Lagre boken på nytt. Andre lagrede sider kan fortsatt leses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä sivu puuttuu tai on vioittunut. Tallenna kirja uudelleen. Muita tallennettuja sivuja voi edelleen lukea."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato stránka chybí nebo je poškozena. Uložte knihu znovu. Ostatní uložené stránky lze stále číst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η σελίδα λείπει ή έχει καταστραφεί. Αποθηκεύστε ξανά το βιβλίο. Οι άλλες αποθηκευμένες σελίδες μπορούν ακόμα να διαβαστούν."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az oldal hiányzik vagy sérült. Mentse újra a könyvet. A többi mentett oldal továbbra is olvasható."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawawala o nasira ang pahinang ito. I-save muli ang aklat. Maaari pa ring basahin ang ibang naka-save na pahina."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדף חסר או פגום. שמור את הספר שוב. עדיין ניתן לקרוא את שאר הדפים השמורים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ini hilang atau rusak. Simpan ulang buku ini. Halaman lain yang tersimpan masih dapat dibaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ini hilang atau rosak. Simpan semula buku. Halaman tersimpan lain masih boleh dibaca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această pagină lipsește sau este deteriorată. Salvează din nou cartea. Celelalte pagini salvate pot fi citite în continuare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfa eksik veya hasarlı. Kitabı yeniden kaydedin. Kaydedilen diğer sayfalar hâlâ okunabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang này bị thiếu hoặc bị hỏng. Hãy lưu lại sách. Các trang khác đã lưu vẫn đọc được."
          }
        }
      }
    },
    "朗读位置未能保存，请检查本机空间。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读位置未能保存，请检查本机空间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reading position could not be saved. Check the available storage on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書位置を保存できませんでした。端末の空き容量をご確認ください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la posición de lectura. Comprueba el espacio disponible."
