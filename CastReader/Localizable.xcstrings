    "画面太小，靠近一点或用更高分辨率重拍": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild zu klein – gehen Sie näher heran oder fotografieren Sie mit höherer Auflösung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image is too small — move closer or retake at a higher resolution"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen es demasiado pequeña: acércate o vuelve a tomarla con mayor resolución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image trop petite : rapprochez-vous ou reprenez la photo en haute résolution"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि बहुत छोटी है — पास जाएँ या अधिक रिज़ॉल्यूशन में दोबारा लें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagine troppo piccola: avvicinati o riscattala a risoluzione più alta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が小さすぎます。近づくか、より高い解像度で撮り直してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagem muito pequena — aproxime-se ou refaça com resolução maior"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面太小，靠近一点或用更高分辨率重拍"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeelding is te klein — kom dichterbij of maak opnieuw met hogere resolutie"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 너무 작습니다 — 더 가까이서 촬영하거나 더 높은 해상도로 다시 찍으세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة صغيرة جدًا — اقترب أو أعد التصوير بدقة أعلى"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение слишком маленькое — подойдите ближе или сделайте снимок с более высоким разрешением"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie jest zbyt małe — zbliż się lub zrób je ponownie w wyższej rozdzielczości"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden är för liten – kom närmare eller ta om bilden med högre upplösning"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet er for lille – gå tættere på, eller tag et nyt billede med højere opløsning"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet er for lite – kom nærmere eller ta et nytt bilde med høyere oppløsning"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on liian pieni. Siirry lähemmäs tai ota uusi kuva suuremmalla tarkkuudella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek je příliš malý – přibližte se nebo pořiďte snímek s vyšším rozlišením"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εικόνα είναι πολύ μικρή — πλησιάστε ή τραβήξτε ξανά σε υψηλότερη ανάλυση"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kép túl kicsi — közelebb lépve vagy nagyobb felbontással készítse újra"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maliit ang larawan — lumapit o kunin muli sa mas mataas na resolusyon"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה קטנה מדי — התקרב או צלם מחדש ברזולוציה גבוהה יותר"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlalu kecil — mendekat atau ambil ulang dengan resolusi lebih tinggi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej terlalu kecil — dekatkan diri atau ambil gambar semula pada resolusi yang lebih tinggi"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea este prea mică — apropie-te sau fotografiază din nou la o rezoluție mai mare"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh quá nhỏ — hãy tiến lại gần hơn hoặc chụp lại ở độ phân giải cao hơn"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü çok küçük — yaklaşın veya daha yüksek çözünürlükte yeniden çekin"
          }
        }
      }
    },
    "画面有点模糊，端稳手机重拍会识别得更准": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild ist unscharf – halten Sie das Gerät ruhig und fotografieren Sie erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shot looks blurry — hold steady and retake for better recognition"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto está borrosa: mantén el teléfono firme y repítela para reconocerla mejor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo un peu floue : tenez le téléphone stable et reprenez-la pour une meilleure reconnaissance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीर थोड़ी धुंधली है — फ़ोन स्थिर रखकर दोबारा लें, पहचान बेहतर होगी"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto è un po' sfocata: tieni fermo il telefono e riscattala per un riconoscimento migliore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が少しぼやけています。手ぶれを抑えて撮り直すと精度が上がります"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto ficou borrada — segure firme e refaça para reconhecer melhor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面有点模糊，端稳手机重拍会识别得更准"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto lijkt onscherp — houd stil en maak opnieuw voor betere herkenning"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초점이 흐릿합니다 — 안정적으로 잡고 더 나은 인식을 위해 다시 찍으세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة تبدو ضبابية — ثبّت يدك وأعد التصوير لتحسين التعرف"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок размыт — удерживайте устройство неподвижно и сделайте новый снимок для лучшего распознавания"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie jest nieostre — trzymaj telefon nieruchomo i zrób je ponownie, aby poprawić rozpoznawanie tekstu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden ser suddig ut – håll kameran stilla och ta om bilden för bättre igenkänning"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet ser sløret ud – hold kameraet stille, og tag et nyt billede for bedre genkendelse"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet ser uskarpt ut – hold kameraet stabilt og ta et nytt bilde for bedre gjenkjenning"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva näyttää sumealta — pidä kamera paikallaan ja ota kuva uudelleen paremman tunnistuksen saamiseksi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímek vypadá rozmazaně – držte telefon stabilně a pořiďte nový snímek pro lepší rozpoznání"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη φαίνεται θολή — κρατήστε σταθερά και τραβήξτε ξανά για καλύτερη αναγνώριση"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kép elmosódott — tartsa stabilan, és készítsen újat a jobb felismerés érdekében"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Malabo ang kuha — humawak nang matibay at kunin ulit para sa mas mahusay na pagkilala"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה מטושטשת — החזק יציב וצלם מחדש לזיהוי טוב יותר"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlihat buram — tahan stabil dan ambil ulang untuk pengenalan yang lebih baik"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar kelihatan kabur — pegang telefon dengan stabil dan ambil gambar semula untuk pengecaman yang lebih tepat"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia pare neclară — ține telefonul nemișcat și fotografiază din nou pentru o recunoaștere mai precisă"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bức ảnh bị mờ — hãy giữ vững và chụp lại để nhận diện tốt hơn"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf bulanık görünüyor — daha iyi tanıma için sabit tutup yeniden çekin"
          }
        }
      }
    },
