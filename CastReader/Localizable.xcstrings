            "value": "Kobo सामग्री अभी उपलब्ध नहीं है। फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto Kobo non è temporaneamente disponibile. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo のコンテンツを一時的に開けません。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo da Kobo está temporariamente indisponível. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo 内容暂时无法打开，请重试。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo-inhoud is tijdelijk niet beschikbaar. Probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo 콘텐츠가 일시적으로 사용할 수 없습니다. 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوى Kobo غير متاح مؤقتًا. يرجى المحاولة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контент Kobo временно недоступен. Попробуйте позже."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość Kobo jest tymczasowo niedostępna. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo-innehållet är tillfälligt inte tillgängligt. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo-indhold er midlertidigt utilgængeligt. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo-innhold er midlertidig utilgjengelig. Vennligst prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo-sisältö ei ole väliaikaisesti saatavilla. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah Kobo je dočasně nedostupný. Zkuste to prosím znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα περιεχόμενα Kobo είναι προσωρινά μη διαθέσιμα. Παρακαλώ δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kobo-tartalom ideiglenesen nem érhető el. Próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panandaliang hindi available ang nilalaman ng Kobo. Subukan ulit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo içeriği geçici olarak kullanılamıyor. Lütfen tekrar deneyin."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandungan Kobo tidak tersedia buat sementara waktu. Sila cuba lagi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten Kobo sementara tidak tersedia. Silakan coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conținutul Kobo este momentan indisponibil. Încearcă din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכן של Kobo אינו זמין באופן זמני. יש לנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung Kobo tạm thời không khả dụng. Vui lòng thử lại."
          }
        }
      }
    },
    "Kobo 登录已过期，请重新绑定 Kobo。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kobo-Sitzung ist abgelaufen. Verbinde Kobo erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Kobo session expired. Please connect Kobo again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de Kobo ha caducado. Vuelve a conectar Kobo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Kobo a expiré. Reconnectez Kobo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Kobo सत्र समाप्त हो गया। कृपया Kobo को फिर से कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione Kobo è scaduta. Ricollega Kobo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo のログインが期限切れです。Kobo を再連携してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão da Kobo expirou. Conecte a Kobo novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo 登录已过期，请重新绑定 Kobo。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw Kobo-sessie is verlopen. Verbind Kobo opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo 세션이 만료되었습니다. Kobo 를 다시 연결하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة Kobo الخاصة بك. يرجى إعادة الاتصال بـ Kobo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия Kobo истекла. Подключите Kobo снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja sesja Kobo wygasła. Połącz się ponownie z Kobo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kobo-session har upphört. Anslut Kobo igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kobo-session er udløbet. Forbind Kobo igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kobo-sesjon har utløpt. Koble til Kobo på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo-istuntosi on vanhentunut. Yhdistä Kobo uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše relace Kobo vypršela. Prosím, znovu připojte Kobo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία Kobo σας έληξε. Συνδεθείτε ξανά με το Kobo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kobo munkamenete lejárt. Csatlakoztassa újra a Kobót."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire ang iyong Kobo session. I-connect muli ang Kobo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo oturumunuzun süresi doldu. Lütfen Kobo'yu tekrar bağlayın."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Kobo anda telah tamat tempoh. Sila sambungkan Kobo semula."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Kobo Anda telah kedaluwarsa. Silakan hubungkan Kobo kembali."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea ta Kobo a expirat. Conectează din nou Kobo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף ההתחברות שלך ל־Kobo פג. יש לחבר את Kobo מחדש."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên Kobo của bạn đã hết hạn. Vui lòng kết nối lại Kobo."
          }
        }
      }
    },
    "Kobo 阅读会话暂时失效。请重试打开；仍失败时再重新登录 Kobo。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kobo-Lesesitzung ist vorübergehend ungültig. Öffne das Buch erneut; melde dich erst wieder bei Kobo an, wenn der Fehler bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Kobo reading session is temporarily unavailable. Try opening the book again; sign in to Kobo again only if it still fails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de lectura de Kobo no está disponible temporalmente. Intenta abrir el libro de nuevo; vuelve a iniciar sesión en Kobo solo si sigue fallando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de lecture Kobo est temporairement indisponible. Essayez de rouvrir le livre ; reconnectez-vous à Kobo seulement si le problème persiste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Kobo रीडिंग सत्र अभी उपलब्ध नहीं है। किताब दोबारा खोलें; समस्या बनी रहे तभी Kobo में फिर साइन इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione di lettura Kobo non è temporaneamente disponibile. Prova a riaprire il libro; accedi di nuovo a Kobo solo se il problema persiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo の読書セッションを一時的に利用できません。もう一度本を開き、解決しない場合のみ Kobo に再ログインしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão de leitura da Kobo está temporariamente indisponível. Tente abrir o livro novamente; entre na Kobo de novo apenas se o problema continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo 阅读会话暂时失效。请重试打开；仍失败时再重新登录 Kobo。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw leessessie bij Kobo is tijdelijk niet beschikbaar. Probeer het boek opnieuw te openen; log alleen opnieuw in bij Kobo als dit nog steeds niet lukt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo 읽기 세션이 일시적으로 사용할 수 없습니다. 책을 다시 열어보세요; 그래도 안 되면 Kobo 에 다시 로그인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة قراءة Kobo غير متاحة مؤقتًا. حاول فتح الكتاب مرة أخرى؛ سجّل الدخول إلى Kobo مرة أخرى فقط إذا فشل الأمر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия чтения в Kobo временно недоступна. Откройте книгу снова; войдите в Kobo повторно только если это не поможет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja sesja czytania w Kobo jest tymczasowo niedostępna. Spróbuj otworzyć książkę ponownie; zaloguj się do Kobo ponownie tylko jeśli nadal to nie działa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kobo-läsningssession är tillfälligt inte tillgänglig. Försök öppna boken igen; logga in i Kobo igen endast om det fortfarande misslyckas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kobo-læsesession er midlertidigt utilgængelig. Åbn bogen igen; log kun ind på Kobo igen, hvis det stadig mislykkes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kobo-lesesesjon er midlertidig utilgjengelig. Prøv å åpne boken på nytt; logg inn i Kobo på nytt bare hvis det fortsatt feiler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo-lukuistuntosi on tilapäisesti poissa käytöstä. Kokeile avata kirja uudelleen. Kirjaudu Koboon uudelleen vain, jos avaaminen ei vieläkään onnistu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtecí relace Kobo je dočasně nedostupná. Zkuste knihu znovu otevřít; přihlaste se k Kobo znovu pouze pokud to stále nefunguje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία ανάγνωσης Kobo είναι προσωρινά μη διαθέσιμη. Δοκιμάστε να ανοίξετε ξανά το βιβλίο· συνδεθείτε ξανά στο Kobo μόνο αν αποτύχει."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kobo olvasási munkamenete ideiglenesen nem érhető el. Nyissa meg újra a könyvet; csak akkor jelentkezzen be újra a Kobóra, ha ez sem működik."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panandaliang hindi available ang iyong session sa pagbasa ng Kobo. Subukang buksan ang aklat muli; mag-sign in sa Kobo ulit lamang kung patuloy pa ring nagkakamali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobo okuma oturumunuz geçici olarak kullanılamıyor. Kitabı tekrar açmayı deneyin; yalnızca başarısız olursa Kobo'ya tekrar giriş yapın."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi bacaan Kobo anda tidak tersedia buat sementara waktu. Cuba buka buku semula; log masuk ke Kobo semula hanya jika masih gagal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi membaca Kobo Anda sementara tidak tersedia. Coba buka bukunya lagi; masuk kembali ke Kobo hanya jika masih gagal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea de lectură Kobo este momentan indisponibilă. Încearcă să deschizi din nou cartea; reconectează-te la Kobo doar dacă problema persistă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן הקריאה ב־Kobo אינו זמין באופן זמני. יש לנסות לפתוח את הספר שוב; יש להיכנס מחדש ל־Kobo רק אם הבעיה נמשכת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đọc Kobo tạm thời không khả dụng. Thử mở lại sách; chỉ đăng nhập lại Kobo nếu vẫn không mở được."
          }
        }
      }
    },
