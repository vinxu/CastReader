    "内容太短，无法解读，试试朗读": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content too short to explain. Try Read Aloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が短すぎて説明できません。声に出して読んでみてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido demasiado corto para explicarlo. Intente leer en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu trop court pour être expliqué. Essayez de lire à haute voix."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo muito curto para explicar. Experimente ler em voz alta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuto troppo breve per essere spiegato. Prova a leggere ad alta voce."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समझाने के लिए सामग्री बहुत छोटी है. जोर से पढ़ने का प्रयास करें."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太短，无法解读，试试朗读"
          }
        }
      }
    },
    "内容太短或暂不支持解读，请稍后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content is too short or is not supported for explanation. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が短すぎるか、現在は解説に対応していません。しばらくしてからもう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido es demasiado breve o no se puede explicar por ahora. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu est trop court ou n’est pas encore pris en charge pour l’explication. Réessayez plus tard."
