        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Texterkennung wurde nicht abgeschlossen. Das Seitenbild ist gespeichert. Tippe auf Wiedergabe, um es erneut zu versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de texto não terminou. A imagem está salva no celular. Toque em reproduzir para tentar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento del testo non è terminato. L’immagine è salvata sul telefono. Tocca Riproduci per riprovare."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट की पहचान पूरी नहीं हुई। पन्ने की तस्वीर फ़ोन पर सहेजी गई है। फिर कोशिश करने के लिए चलाएँ दबाएँ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekstherkenning is niet voltooid. De afbeelding van de pagina is opgeslagen op uw telefoon. Tik op Afspelen om het opnieuw te proberen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 인식이 완료되지 않았습니다. 페이지 이미지가 기기에 저장되어 있습니다. 재생을 눌러 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل التعرف على النص. تم حفظ صورة الصفحة على هاتفك. اضغط تشغيل للمحاولة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание текста не завершено. Изображение страницы сохранено на устройстве. Нажмите «Воспроизвести», чтобы попробовать снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie tekstu nie zostało zakończone. Obraz strony został zapisany na telefonie. Dotknij przycisku odtwarzania, aby spróbować ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Textigenkänningen har inte slutförts. Sidans bild är sparad på din telefon. Tryck på spela för att försöka igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstgenkendelsen blev ikke færdig. Billedet af siden er gemt på din telefon. Tryk på Afspil for at prøve igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstgjenkjenningen ble ikke fullført. Sidebildet er lagret på telefonen. Trykk på Spill av for å prøve igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstintunnistus ei valmistunut. Sivun kuva on tallennettu puhelimeesi. Yritä uudelleen napauttamalla Toista."
