    "登录发生在 Amazon 官方页面，CastReader 不会看到你的密码。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung erfolgt auf der offiziellen Amazon-Seite. CastReader kann dein Passwort nicht sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in takes place on Amazon’s official page. CastReader cannot see your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión ocurre en la página oficial de Amazon. CastReader no puede ver tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion se fait sur la page officielle d’Amazon. CastReader ne peut pas voir votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन Amazon के आधिकारिक पेज पर होता है। CastReader आपका पासवर्ड नहीं देख सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso avviene sulla pagina ufficiale di Amazon. CastReader non può vedere la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインはAmazonの公式ページで行われます。CastReaderにパスワードは見えません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login acontece na página oficial da Amazon. O CastReader não pode ver sua senha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录发生在 Amazon 官方页面，CastReader 不会看到你的密码。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanmelden vindt plaats op de officiële pagina van Amazon. CastReader kan uw wachtwoord niet zien."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدث تسجيل الدخول في الصفحة الرسمية لـ Amazon. لا يمكن لـ CastReader رؤية كلمة مرورك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход осуществляется на официальной странице Amazon. CastReader не видит ваш пароль."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie odbywa się na oficjalnej stronie Amazon. CastReader nie widzi Twojego hasła."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggning sker på Amazons officiella sida. CastReader kan inte se ditt lösenord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login foregår på Amazons officielle side. CastReader kan ikke se din adgangskode."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlogging skjer på Amazons offisielle side. CastReader kan ikke se passordet ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisäänkirjautuminen tapahtuu Amazonin virallisella sivulla. CastReader ei voi nähdä salasanaasi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení probíhá na oficiální stránce Amazon. CastReader nemůže vidět vaše heslo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση πραγματοποιείται στην επίσημη σελίδα της Amazon. Το CastReader δεν μπορεί να δει τον κωδικό πρόσβασής σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezés az Amazon hivatalos oldalán történik. A CastReader nem látja a jelszavát."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang sign-in ay mangyayari sa opisyal na pahina ng Amazon. Hindi makikita ng CastReader ang iyong password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 Amazon 공식 페이지에서 진행됩니다. CastReader는 비밀번호를 볼 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk dilakukan pada halaman rasmi Amazon. CastReader tidak dapat melihat kata laluan anda."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses masuk dilakukan di halaman resmi Amazon. CastReader tidak dapat melihat kata sandi Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş, Amazon'un resmi sayfasında gerçekleşir. CastReader parolanızı göremez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea are loc pe pagina oficială Amazon. CastReader nu îți poate vedea parola."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכניסה מתבצעת בדף הרשמי של Amazon. CastReader אינו יכול לראות את הסיסמה שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đăng nhập trên trang chính thức của Amazon. CastReader không thể xem mật khẩu của bạn."
          }
        }
      }
    },
    "登录成功后会自动继续，无需再点按钮。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach erfolgreicher Anmeldung geht es automatisch weiter. Du musst nichts mehr antippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll continue automatically after you sign in. No extra tap needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuaremos automáticamente cuando inicies sesión. No tendrás que tocar nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la connexion, nous continuerons automatiquement. Aucun autre bouton à toucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन के बाद हम अपने-आप आगे बढ़ेंगे। दोबारा टैप करने की ज़रूरत नहीं।"
          }
        },
        "it": {
