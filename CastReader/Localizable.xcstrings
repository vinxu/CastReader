    "稍后重试即可。你的 Kindle 绑定和书架都没有变化。": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es gleich noch einmal. Kindle-Konto und Bibliothek bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in a moment. Your Kindle account and library are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo en un momento. Tu cuenta de Kindle y tu biblioteca no han cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez dans un instant. Votre compte Kindle et votre bibliothèque sont inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थोड़ी देर बाद फिर कोशिश करें। आपका Kindle खाता और लाइब्रेरी अपरिवर्तित हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova tra poco. Il tuo account Kindle e la libreria non sono cambiati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてからもう一度お試しください。Kindle の連携とライブラリはそのままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente em instantes. Sua conta Kindle e sua biblioteca não mudaram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后重试即可。你的 Kindle 绑定和书架都没有变化。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het zo dadelijk opnieuw. Uw Kindle-account en bibliotheek zijn ongewijzigd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 다시 시도하세요. Kindle 계정과 라이브러리는 변경되지 않았습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة أخرى خلال لحظة. حساب Kindle ومكتبتك دون تغيير."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте снова через мгновение. Ваша учётная запись Kindle и библиотека не изменились."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie za chwilę. Twoje konto Kindle i biblioteka pozostają bez zmian."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök igen om en stund. Ditt Kindle-konto och bibliotek är oförändrade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igen om et øjeblik. Din Kindle-konto og dit bibliotek er uændrede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igjen om et øyeblikk. Kindle-kontoen og biblioteket ditt er uendret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritä uudelleen hetken kuluttua. Kindle-tilisi ja kirjastosi ovat ennallaan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste to znovu za chvíli. Účet Kindle a knihovna zůstávají nezměněny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε ξανά σύντομα. Ο λογαριασμός και η βιβλιοθήκη Kindle σας παραμένουν αμετάβλητα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbálja újra egy pillanat múlva. A Kindle fiókja és könyvtára változatlan maradt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Subukan muli sa sandali. Hindi nagbago ang iyong Kindle account at aklatan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסה שוב בעוד רגע. חשבון ה-Kindle והספרייה שלך לא השתנו."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba lagi sebentar. Akaun dan perpustakaan Kindle anda tidak berubah."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba lagi sebentar lagi. Akun dan pustaka Kindle Anda tidak berubah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz sonra yeniden deneyin. Kindle hesabınız ve kitaplığınız değişmedi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă din nou peste puțin timp. Contul și biblioteca ta Kindle nu au fost modificate."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử lại sau giây lát. Tài khoản và thư viện Kindle của bạn không thay đổi."
          }
        }
      }
    },
