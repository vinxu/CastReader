        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 घंटे में अधिकतम %1$lld आमंत्रण भेजे जा सकते हैं। %2$@ के बाद फिर कोशिश करें; अधूरे आमंत्रण बनने के 48 घंटे बाद अपने आप समाप्त हो जाते हैं।"
