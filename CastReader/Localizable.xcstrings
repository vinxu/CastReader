    "仅保存在本机，不上传云端": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät gespeichert, niemals hochgeladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on this device only, never uploaded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenado solo en este dispositivo, nunca subido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké sur cet appareil uniquement, jamais téléchargé"
          }
        },
        "hi": {
