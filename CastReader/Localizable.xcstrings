    "保存在本机，没网也能读和听": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在本机，没网也能读和听"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this device. Read and listen offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末に保存済み。オフラインで読書・読み上げできます"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este dispositivo. Lee y escucha sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet appareil. Lisez et écoutez hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät. Offline lesen und hören."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste dispositivo. Leia e ouça offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo dispositivo. Leggi e ascolta offline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर सहेजी गई। ऑफ़लाइन पढ़ें और सुनें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat. Lees en luister offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 있음. 오프라인으로 읽고 들으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве. Чтение и прослушивание офлайн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym urządzeniu. Czytaj i słuchaj offline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På denna enhet. Läs och lyssna offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne enhed. Læs og lyt offline."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne enheten. Les og lytt offline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä laitteella. Lue ja kuuntele offline-tilassa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto zařízení. Čtěte a poslouchejte offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αυτή τη συσκευή. Διαβάστε και ακούστε εκτός σύνδεσης."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön. Olvasson és hallgasson offline módban."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito. Magbasa at makinig nang offline."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על המכשיר הזה. קרא והקשב באופן לא מקוון."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe acest dispozitiv. Citește și ascultă offline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الجهاز. اقرأ واستمع دون اتصال."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada peranti ini. Baca dan dengar di luar talian."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di perangkat ini. Baca dan dengarkan secara offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda. Çevrimdışı okuyun ve dinleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên thiết bị này. Đọc và nghe ngoại tuyến."
          }
        }
      }
    },
    "当前无网络，打开本机书籍": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无网络，打开本机书籍"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Open your saved books."
