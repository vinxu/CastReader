        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai esaurito i 120 minuti mensili di voce clonata. Passa a una voce predefinita per continuare a leggere o spiegare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のクローン音声120分を使い切りました。プリセット音声に切り替えると読み上げや解説を続けられます。"
