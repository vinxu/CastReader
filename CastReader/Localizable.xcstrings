    "我已阅读并同意《服务条款》和《隐私政策》": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die Nutzungsbedingungen und die Datenschutzerklärung gelesen und stimme zu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read and agree to the Terms of Service and Privacy Policy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído y acepto los Términos del servicio y la Política de privacidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai lu et j'accepte les Conditions d'utilisation et la Politique de confidentialité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने सेवा की शर्तें और गोपनीयता नीति पढ़ लीं और सहमत हूँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho letto e accetto i Termini di servizio e l'Informativa sulla privacy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「利用規約」と「プライバシーポリシー」に同意します"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Li e concordo com os Termos de Serviço e a Política de Privacidade"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读并同意《服务条款》和《隐私政策》"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de Algemene Voorwaarden en Privacyverklaring gelezen en ga ermee akkoord"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이용 약관 및 개인정보 처리방침을 읽고 동의합니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قرأتُ وأوافق على شروط الخدمة وسياسة الخصوصية"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прочитал(а) и принимаю Условия использования и Политику конфиденциальности"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytałem/am i zgadzam się z Regulaminem oraz Polityką Prywatności"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag har läst och godkänner Villkor och Integritetspolicy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har læst og accepteret Vilkår for brug og Privatlivspolitik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har lest og godtar Vilkår for bruk og personvernregler"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olen lukenut ja hyväksyn käyttöehdot ja tietosuojakäytännön"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάβασα και αποδέχομαι τους Όρους Παροχής Υπηρεσιών και την Πολιτική Απορρήτου"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabasa ko at sinasang-ayunan ko ang Mga Tuntunin ng Serbisyo at Patakaran sa Privacy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizmet Şartları ve Gizlilik Politikasını okudum ve kabul ediyorum"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã đọc và đồng ý với Điều khoản Dịch vụ và Chính sách Bảo mật"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečetl(a) jsem si podmínky služby a zásady ochrany soukromí a souhlasím s nimi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elolvastam és elfogadom a Felhasználási feltételeket és az Adatvédelmi szabályzatot"
          }
        },
        "ms": {
