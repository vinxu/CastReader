          "stringUnit": {
            "state": "translated",
            "value": "%d livros disponíveis para sincronizar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架中有 %d 本书可以同步"
          }
        }
      }
    },
    "书架中没有找到这本书，请重新同步微信读书书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Buch wurde in deiner Bibliothek nicht gefunden. Synchronisiere deine WeRead-Bibliothek erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book was not found in your library. Sync your WeRead library again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este libro no se encontró en tu biblioteca. Vuelve a sincronizar tu biblioteca de WeRead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce livre est introuvable dans votre bibliothèque. Synchronisez à nouveau votre bibliothèque WeRead."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह किताब आपकी लाइब्रेरी में नहीं मिली। अपनी WeRead लाइब्रेरी फिर से सिंक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo libro non è stato trovato nella libreria. Sincronizza di nuovo la libreria WeRead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本棚にこの本が見つかりません。WeRead 本棚をもう一度同期してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este livro não foi encontrado na sua biblioteca. Sincronize novamente a biblioteca do WeRead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架中没有找到这本书，请重新同步微信读书书架。"
          }
        }
      }
    },
    "书架已同步，但 Kindle 未能打开这本书。请重试或返回书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek wurde synchronisiert, aber Kindle konnte dieses Buch nicht öffnen. Versuche es erneut oder kehre zur Bibliothek zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library was synced, but Kindle could not open this book. Try again or return to the library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su biblioteca se sincronizó, pero Kindle no pudo abrir este libro. Inténtalo de nuevo o regresa a la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque a été synchronisée, mais Kindle n'a pas pu ouvrir ce livre. Réessayez ou retournez à la bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी सिंक हो गई थी, लेकिन किंडल इस किताब को नहीं खोल सका। पुनः प्रयास करें या लाइब्रेरी में वापस लौटें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è stata sincronizzata, ma Kindle non è riuscito ad aprire questo libro. Riprova o torna in biblioteca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリは同期されましたが、Kindle はこの本を開くことができませんでした。もう一度試すか、ライブラリに戻ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca foi sincronizada, mas o Kindle não conseguiu abrir este livro. Tente novamente ou volte para a biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架已同步，但 Kindle 未能打开这本书。请重试或返回书架。"
          }
        }
      }
    },
