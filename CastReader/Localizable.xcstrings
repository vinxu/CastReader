          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴图书馆提供的 O’Reilly 或 EZproxy 登录链接。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak de door uw bibliotheek verstrekte O'Reilly- of EZproxy-aanmeldlink."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도서관에서 제공한 O'Reilly 또는 EZproxy 로그인 링크를 붙여넣으세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رابط تسجيل الدخول الخاص بـ O'Reilly أو EZproxy الذي قدمته مكتبتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ссылку на вход O'Reilly или EZproxy, предоставленную вашей библиотекой."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej link do logowania O’Reilly lub EZproxy dostarczony przez Twoją bibliotekę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
