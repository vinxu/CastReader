          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε εξαντλήσει τα 120 λεπτά κλωνοποιημένης φωνής αυτού του μήνα. Επιλέξτε μια προκαθορισμένη φωνή για να συνεχίσετε την ανάγνωση ή την εξήγηση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felhasználta a klónozott hangok havi 120 perces keretét. Váltson beépített hangra a felolvasás vagy a magyarázat folytatásához."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naubos mo na ang 120 minuto ng kinlonang boses ngayong buwan. Lumipat sa nakahandang boses upang magpatuloy sa pagbasa o pagpapaliwanag."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai folosit cele 120 de minute de voce clonată din această lună. Alege o voce predefinită pentru a continua citirea sau explicația."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 복제 음성 120분을 모두 사용했습니다. 읽기나 해설을 계속하려면 기본 음성으로 전환하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menggunakan 120 minit suara klon bulan ini. Tukar kepada suara pratetap untuk terus membaca atau menghuraikan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menggunakan 120 menit suara klon bulan ini. Beralih ke suara bawaan untuk melanjutkan membaca atau menjelaskan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki 120 dakikalık klonlanmış ses kotanızı kullandınız. Okumaya veya açıklamaya devam etmek için hazır bir sese geçin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניצלת את 120 הדקות של קול משוכפל לחודש זה. אפשר לעבור לקול מובנה כדי להמשיך לקרוא או לקבל הסבר."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng hết 120 phút giọng nhân bản của tháng này. Chuyển sang giọng có sẵn để tiếp tục đọc hoặc giải thích."
          }
        }
      }
    },
