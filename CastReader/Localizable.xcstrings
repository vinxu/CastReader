    "只需按当前语言录制一次，生成的声音可用于全部支持的朗读语言。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einmal in deiner aktuellen App-Sprache auf. Die erstellte Stimme kann in allen unterstützten Vorlesesprachen verwendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record once in your current app language. The resulting voice works with every supported reading language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una vez en el idioma actual de la app. La voz creada funciona con todos los idiomas de lectura compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une fois dans la langue actuelle de l’app. La voix créée fonctionne avec toutes les langues de lecture prises en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी मौजूदा ऐप भाषा में एक बार रिकॉर्ड करें। बनी हुई आवाज़ सभी समर्थित पठन भाषाओं में काम करेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una volta nella lingua attuale dell’app. La voce creata funziona con tutte le lingue di lettura supportate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のアプリ言語で一度録音するだけで、作成した声を対応するすべての読み上げ言語で使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma vez no idioma atual do app. A voz criada funciona com todos os idiomas de leitura compatíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需按当前语言录制一次，生成的声音可用于全部支持的朗读语言。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem één keer op in de huidige taal van de app. De gegenereerde stem werkt met alle ondersteunde leestalen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل مرة واحدة باللغة الحالية لتطبيقك. يعمل الصوت الناتج مع كل لغة قراءة مدعومة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите один раз на языке вашего приложения. Полученный голос будет работать со всеми поддерживаемыми языками чтения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj raz w języku aplikacji. Otrzymany głos działa we wszystkich obsługiwanych językach czytania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in en gång i appens aktuella språk. Den skapade rösten fungerar med alla stödda lässpråk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag én gang i appens nuværende sprog. Den resulterende stemme virker med alle understøttede læsesprog."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp én gang i språket som appen bruker nå. Den resulterende stemmen fungerer med alle støttede lesespråk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänitä kerran sovelluksen nykyisellä kielellä. Luotu ääni toimii kaikilla tuetuilla lukukielillä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrajte jednou v jazyce aplikace. Vzniklý hlas funguje ve všech podporovaných jazycích čtení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ηχογραφήστε μία φορά στη γλώσσα της εφαρμογής σας. Η προκύπτουσα φωνή λειτουργεί με κάθε υποστηριζόμενη γλώσσα ανάγνωσης."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegye fel egyszer a jelenlegi alkalmazásnyelven. Az így létrejött hang minden támogatott olvasási nyelven működik."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magrekord nang isang beses sa kasalukuyang wika ng app. Ang nabuong boses ay gagana sa lahat ng suporta na wikang pagbasa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează o singură dată în limba curentă a aplicației. Vocea rezultată poate fi folosită în toate limbile de lectură acceptate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 앱 언어로 한 번 녹음하세요. 생성된 음성은 지원되는 모든 읽기 언어에서 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakam sekali dalam bahasa aplikasi semasa anda. Suara yang terhasil berfungsi dengan setiap bahasa bacaan yang disokong."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam sekali dalam bahasa aplikasi Anda saat ini. Suara yang dihasilkan berfungsi dalam setiap bahasa bacaan yang didukung."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli uygulama dilinizde bir kez kayıt yapın. Oluşturulan ses, desteklenen tüm okuma dillerinde çalışır."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקליט פעם אחת בשפה הנוכחית של האפליקציה. הקול שיתקבל יעבוד בכל שפות הקריאה הנתמכות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu âm một lần bằng ngôn ngữ ứng dụng hiện tại. Giọng tạo ra dùng được với mọi ngôn ngữ đọc được hỗ trợ."
          }
        }
      }
    },
