    "用微信登录，同步你的微信读书书架，选一本就能开始朗读。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit WeChat an, um dein WeRead-Regal zu synchronisieren, und wähle ein Buch zum Vorlesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with WeChat to sync your WeRead shelf, then pick a book to start listening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con WeChat para sincronizar tu estantería de WeRead y elige un libro para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec WeChat pour synchroniser votre bibliothèque WeRead, puis choisissez un livre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WeChat से साइन इन करके अपनी WeRead शेल्फ़ सिंक करें और एक किताब चुनकर सुनना शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con WeChat per sincronizzare la tua libreria WeRead e scegli un libro per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WeChat でログインして WeRead の本棚を同期し、一冊選ぶだけで読み上げが始まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com o WeChat para sincronizar sua estante do WeRead e escolha um livro para começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用微信登录，同步你的微信读书书架，选一本就能开始朗读。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met WeChat om je WeRead-boekenplank te synchroniseren, kies vervolgens een boek om te beginnen met luisteren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WeChat 으로 로그인하여 WeRead 서가를 동기화한 후 듣기를 시작할 책을 선택하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول عبر WeChat لمزامنة رفّ كتبك في WeRead، ثم اختر كتابًا لبدء الاستماع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите через WeChat, чтобы синхронизировать полку WeRead, затем выберите книгу для прослушивания."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się za pomocą WeChat, aby zsynchronizować półkę WeRead, a następnie wybierz książkę, aby rozpocząć słuchanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med WeChat för att synkronisera din WeRead-hylla. Välj sedan en bok att lyssna på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med WeChat for at synkronisere dit WeRead-bibliotek, vælg derefter en bog for at starte afspilning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn med WeChat for å synkronisere WeRead-hyllen, velg deretter en bok for å starte avspilling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sisään WeChatillä synkronoidaksesi WeRead-hyllysi, valitse sitten kirja aloittaaksesi kuuntelun."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε με WeChat για συγχρονισμό της βιβλιοθήκης WeRead σας, στη συνέχεια επιλέξτε ένα βιβλίο για να ξεκινήσετε την ακρόαση."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in gamit ang WeChat upang i-sync ang iyong estante sa WeRead, pagkatapos ay pumili ng isang aklat upang magsimulang makinig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRead rafınızı senkronize etmek için WeChat ile giriş yapın, ardından dinlemeye başlamak için bir kitap seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng WeChat để đồng bộ hóa kệ WeRead, sau đó chọn một cuốn sách để bắt đầu nghe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se přes WeChat, synchronizujte svou knihovnu WeRead a vyberte knihu k poslechu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be a WeChat segítségével, szinkronizáld a WeRead-könyvtáradat, majd válassz egy könyvet a hallgatáshoz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk dengan WeChat untuk menyegerakkan rak WeRead anda, kemudian pilih buku untuk mula mendengar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan WeChat untuk menyinkronkan rak WeRead Anda, lalu pilih buku untuk mulai mendengarkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te prin WeChat pentru a sincroniza biblioteca WeRead, apoi alege o carte și începe să asculți."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להיכנס עם WeChat כדי לסנכרן את מדף WeRead, ואז לבחור ספר ולהתחיל להאזין."
          }
        }
      }
    },
