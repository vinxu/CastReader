            "state": "translated",
            "value": "Elimina la copia dañada y guárdala de nuevo desde Kindle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez la copie endommagée et enregistrez-la à nouveau depuis Kindle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche die beschädigte Kopie und speichere sie erneut aus Kindle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua a cópia danificada e salve novamente pelo Kindle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la copia danneggiata e salvala di nuovo da Kindle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खराब प्रति हटाएँ और Kindle से इसे फिर सहेजें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder de beschadigde kopie en sla deze opnieuw op vanuit Kindle."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손상된 복사본을 삭제하고 Kindle 에서 다시 저장하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف النسخة التالفة واحفظها مرة أخرى من Kindle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите повреждённую копию и снова сохраните её из Kindle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń uszkodzoną kopię i zapisz ją ponownie z Kindle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort den skadade kopian och spara den igen från Kindle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet den beskadigede kopi og gem den igen fra Kindle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett den skadede kopien og lagre den på nytt fra Kindle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista viallinen kopio ja tallenna se uudelleen Kindlestä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraňte poškozenou kopii a znovu ji uložte z Kindle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε το κατεστραμμένο αντίγραφο και αποθηκεύστε ξανά από το Kindle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölje a sérült másolatot, majd mentse újra a Kindle-ből."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggalin ang sira na kopya at i-save muli mula sa Kindle."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam salinan yang rosak dan simpan semula daripada Kindle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש למחוק את העותק הפגום ולשמור אותו שוב מ-Kindle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus salinan yang rusak lalu simpan lagi dari Kindle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge copia deteriorată și salveaz-o din nou din Kindle."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasarlı kopyayı silin ve Kindle'dan yeniden kaydedin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa bản bị hỏng rồi lưu lại từ Kindle."
          }
        }
      }
    },
