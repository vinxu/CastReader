    "订阅自动续期，可随时在 App Store 取消。": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abonnement verlängert sich automatisch. Jederzeit im App Store kündbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription auto-renews. Cancel anytime in the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente. Cancela en cualquier momento en la App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement se renouvelle automatiquement. Annulez à tout moment dans l’App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता स्वतः नवीनीकरण. ऐप स्टोर में किसी भी समय रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento si rinnova automaticamente. Annulla in qualsiasi momento nell'App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは自動更新されます。 App Storeでいつでもキャンセルできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura é renovada automaticamente. Cancele a qualquer momento na App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅自动续期，可随时在 App Store 取消。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnement wordt automatisch verlengd. U kunt dit op elk moment annuleren in de App Store."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 자동 갱신됩니다. 언제든지 App Store 에서 취소할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
