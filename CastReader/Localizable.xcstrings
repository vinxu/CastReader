        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمع أكثر. افهم أكثر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше слушайте. Лучше понимайте."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słuchaj więcej. Zrozumiej więcej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyssna mer. Förstå mer."
