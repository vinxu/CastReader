        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brukt månedens 120 minutter med klonet stemme. Bytt til en forhåndsdefinert stemme for å fortsette å lese eller forklare."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet käyttänyt tämän kuukauden 120 minuuttia kloonattua ääntä. Siirry valmiiseen ääneen jatkaaksesi lukemista tai selittämistä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
