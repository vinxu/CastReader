          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制文案已跟随你的 App 语言，生成的声音可以跨语言使用"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het opnamescript volgt de taal van de app. Uw gegenereerde stem kan in meerdere talen worden gebruikt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع نص التسجيل لغة تطبيقك الحالية. يمكن استخدام صوتك المُولَّد عبر لغات متعددة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст для записи соответствует языку вашего приложения. Сгенерированный голос можно использовать на разных языках."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst do nagrania jest w języku aplikacji. Utworzonego głosu można używać w różnych językach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningstexten följer appens språk. Din genererade röst kan användas på flera språk."
