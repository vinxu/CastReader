    "免费版只能创建一个声音；删除后也不会恢复创建名额": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos kann nur eine Stimme erstellt werden. Löschen stellt den Platz nicht wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free plan can create one voice. Deleting it does not restore the creation slot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito puede crear una voz. Eliminarla no restaura el cupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’offre gratuite permet de créer une voix. La supprimer ne rétablit pas l’emplacement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त प्लान में एक आवाज़ बनाई जा सकती है। उसे हटाने पर मौका वापस नहीं मिलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano gratuito può creare una voce. Eliminarla non ripristina lo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版で作成できる声は1つです。削除しても作成枠は戻りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano grátis pode criar uma voz. Excluí-la não restaura a vaga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版只能创建一个声音；删除后也不会恢复创建名额"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met het gratis abonnement kunt u één stem maken. Verwijderen geeft u geen nieuwe gratis mogelijkheid om een stem te maken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح الخطة المجانية بإنشاء صوت واحد. حذفه لا يعيد فرصة الإنشاء المجانية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный план позволяет создать один голос. Удаление не восстанавливает слот для создания."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan bezpłatny pozwala utworzyć jeden głos. Usunięcie go nie przywraca możliwości ponownego utworzenia głosu za darmo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisplanen låter dig skapa en röst. Om du tar bort den kan du inte skapa en ny gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisplanen lader dig oprette én stemme. Hvis du sletter den, får du ikke en ny gratis oprettelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisplanen lar deg opprette én stemme. Hvis du sletter den, får du ikke opprette en ny gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisversiossa voit luoda yhden äänen. Sen poistaminen ei anna uutta ilmaista luontikertaa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatný plán umožňuje vytvořit jeden hlas. Jeho smazání neobnoví možnost dalšího bezplatného vytvoření."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δωρεάν πλάνο μπορεί να δημιουργήσει μία φωνή. Η διαγραφή της δεν αποκαθιστά τη θέση δημιουργίας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ingyenes csomag egyetlen hang létrehozására képes. Törlése nem állítja vissza a létrehozási helyet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang libreng plano ay kayang lumikha ng isang boses. Ang pag-delete nito ay hindi magre-restore ng slot sa paglikha."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket gratis memungkinkan pembuatan satu suara. Menghapusnya tidak mengembalikan jatah pembuatan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan percuma boleh mencipta satu suara. Memadamnya tidak mengembalikan slot penciptaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 플랜에서는 음성을 하나 만들 수 있습니다. 삭제해도 생성 기회가 복원되지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz plan bir ses oluşturabilir. Sesi silmek oluşturma hakkını geri getirmez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul gratuit permite crearea unei voci. Ștergerea ei nu restabilește posibilitatea de creare gratuită."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסלול החינמי מאפשר ליצור קול אחד. מחיקתו אינה מחזירה את אפשרות היצירה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói miễn phí cho phép tạo một giọng. Xóa giọng không khôi phục lượt tạo."
          }
        }
      }
