          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε τον σύνδεσμο σύνδεσης O'Reilly ή EZproxy που παρέχει η βιβλιοθήκη σας."
          }
        },
        "hu": {
          "stringUnit": {
