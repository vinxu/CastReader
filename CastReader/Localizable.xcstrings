    "精选音色与我的声音共享，所有语言通用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精选音色与我的声音共享，所有语言通用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by curated and personal voices, across languages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳選音声と自分の声で共有。全言語共通です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartido entre voces seleccionadas y personales, en todos los idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagé entre les voix sélectionnées et personnelles, toutes langues confondues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ausgewählte und eigene Stimmen gemeinsam, in allen Sprachen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhada entre vozes selecionadas e pessoais, em todos os idiomas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivisa tra voci selezionate e personali, in tutte le lingue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनिंदा और निजी आवाज़ों में साझा, सभी भाषाओं के लिए।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedeeld door geselecteerde en persoonlijke stemmen, in alle talen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선정된 음성과 개인 음성이 모든 언어에 걸쳐 한도를 공유합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий для подобранных и личных голосов на всех языках."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspólny dla wyselekcjonowanych i osobistych głosów we wszystkich językach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delas av utvalda och personliga röster på alla språk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt mellem udvalgte og personlige stemmer på tværs af sprog."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt mellom utvalgte og personlige stemmer, på tvers av språk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikoitujen ja henkilökohtaisten äänien yhteinen kiintiö kaikille kielille."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdíleno mezi vybranými a osobními hlasy napříč jazyky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοινή για επιμελημένες και προσωπικές φωνές, σε όλες τις γλώσσες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válogatott és személyes hangok közös kerete, minden nyelven."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinagsasaluhan ng mga pinili at personal na boses, sa lahat ng wika."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משותף לקולות נבחרים וקולות אישיים, בכל השפות."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alocare comună pentru vocile selectate și personale, în toate limbile."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد مشترك بين الأصوات المختارة والشخصية بجميع اللغات."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikongsi oleh suara pilihan dan peribadi merentas bahasa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan bersama oleh suara pilihan dan pribadi, lintas bahasa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş ve kişisel sesler tarafından tüm dillerde ortak kullanılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng chung cho giọng tuyển chọn và giọng cá nhân ở mọi ngôn ngữ."
          }
        }
      }
    },
