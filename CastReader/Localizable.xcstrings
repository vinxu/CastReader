    "免费版可创建并试听多个自己的声音": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle und teste kostenlos mehrere eigene Stimmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create and preview multiple voices of your own for free"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea y prueba gratis varias voces propias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez et testez gratuitement plusieurs voix personnelles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त में अपनी कई आवाज़ें बनाएं और सुनकर देखें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea e prova gratuitamente più voci personali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声を複数、無料で作成して試聴できます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie e teste gratuitamente várias vozes próprias"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版可创建并试听多个自己的声音"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak gratis meerdere eigen stemmen en beluister voorbeelden"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ عدة أصوات خاصة بك واستمع إلى عينات منها مجانًا"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно создавайте и прослушивайте несколько собственных голосов"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz bezpłatnie wiele własnych głosów i odsłuchuj ich próbki"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa och provlyssna på flera egna röster gratis"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret flere egne stemmer, og lyt til prøver gratis"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett flere egne stemmer og hør prøver gratis"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo useita omia ääniä ja kuuntele näytteitä ilmaiseksi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte a vyzkoušejte zdarma více vlastních hlasů"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε πολλές δικές σας φωνές και ακούστε δείγματά τους δωρεάν"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzon létre több saját hangot, és hallgassa meg őket ingyen"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumawa at subukang pakinggan ang maraming sarili mong boses nang libre"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta dan dengar sampel beberapa suara anda sendiri secara percuma"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinize ait birden fazla sesi ücretsiz oluşturun ve dinleyin"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 개의 내 음성을 무료로 만들고 미리 듣기"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat dan dengarkan pratinjau beberapa suara Anda sendiri secara gratis"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează și ascultă gratuit mai multe voci proprii"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת כמה קולות משלך והאזנה לדוגמאות בחינם"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo và nghe thử nhiều giọng của riêng bạn miễn phí"
          }
        }
      }
    },
    "创建成功后可随时修改，不影响声音使用": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Erstellung jederzeit änderbar, ohne die Stimme zu beeinflussen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change it anytime after creation without affecting the voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámbialo cuando quieras después de crearla sin afectar a la voz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez-le à tout moment après la création sans affecter la voix"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बनाने के बाद इसे कभी भी बदलें—आवाज़ पर कोई असर नहीं पड़ेगा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificalo in qualsiasi momento dopo la creazione senza influire sulla voce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成後いつでも変更でき、声の利用には影響しません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere quando quiser após a criação sem afetar a voz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建成功后可随时修改，不影响声音使用"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig dit op elk gewenst moment na creatie zonder de stem te beïnvloeden"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّره في أي وقت بعد الإنشاء دون التأثير على الصوت"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить имя можно в любое время после создания, без влияния на сам голос"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień ją w dowolnym momencie po utworzeniu bez wpływu na sam głos"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra det när som helst efter skapandet utan att påverka rösten"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændr det når som helst efter oprettelsen uden at påvirke stemmen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre når som helst etter oppretting uten å påvirke stemmen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit muuttaa nimeä milloin tahansa luomisen jälkeen. Se ei vaikuta ääneen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změňte kdykoli po vytvoření bez ovlivnění hlasu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξτε το οποιαδήποτε στιγμή μετά τη δημιουργία χωρίς να επηρεάσετε τη φωνή"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor módosíthatja létrehozás után anélkül, hogy a hang minőségét befolyásolná"
