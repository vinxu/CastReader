    "请先登录 Google 账号，登录后会自动进入书架。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich zuerst bei Google an – dein Regal öffnet sich danach automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to Google first — your shelf opens automatically afterwards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero inicia sesión en Google; tu estantería se abrirá automáticamente."
