          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in om uw lidmaatschap en gratis tegoed tussen apparaten te synchroniseren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 간에 멤버십과 무료 한도를 동기화하려면 로그인하세요."
