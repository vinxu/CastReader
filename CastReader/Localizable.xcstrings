    "每 24 小时只能创建一个声音": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nur alle 24 Stunden eine Stimme erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create only one voice every 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes crear solo una voz cada 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez créer qu'une seule voix toutes les 24 heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप हर 24 घंटे में केवल एक आवाज बना सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi creare una sola voce ogni 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24 時間ごとに作成できるボイスは 1 つだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode criar apenas uma voz a cada 24 horas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 24 小时只能创建一个声音"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt slechts één stem per 24 uur maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24 시간마다 하나의 목소리만 생성할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إنشاء صوت واحد فقط كل 24 ساعة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете создавать только один голос каждые 24 часа."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz utworzyć tylko jeden głos co 24 godziny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan skapa endast en röst var 24:e timme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kun oprette én stemme hver 24. time."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bare opprette én stemme hver 24. time."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit luoda vain yhden puheäänen 24 tunnin välein."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete vytvořit pouze jeden hlas za 24 hodin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να δημιουργήσετε μόνο μία φωνή κάθε 24 ώρες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "24 óránként csak egy hangot hozhat létre."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaari kang gumawa lamang ng isang boses tuwing 24 oras."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן ליצור קול אחד בלבד בכל 24 שעות."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda hanya dapat membuat satu suara setiap 24 jam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda hanya boleh membuat satu suara setiap 24 jam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți crea o singură voce la fiecare 24 de ore."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ có thể tạo một giọng mỗi 24 giờ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 saatte yalnızca bir ses oluşturabilirsiniz."
          }
        }
      }
    },
    "每种语言分别记忆所选音色；可用语言由云端目录自动更新。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimmenauswahl wird je Sprache gespeichert; verfügbare Sprachen werden automatisch aus dem Cloud-Katalog aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice choices are saved per language, and available languages update automatically from the cloud catalog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de voz se guardan por idioma y los idiomas disponibles se actualizan automáticamente desde el catálogo en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix vocaux sont enregistrés par langue et les langues disponibles sont mises à jour automatiquement à partir du catalogue cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्वनि विकल्प प्रति भाषा सहेजे जाते हैं, और उपलब्ध भाषाएँ क्लाउड कैटलॉग से स्वचालित रूप से अपडेट हो जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scelte vocali vengono salvate per lingua e le lingue disponibili si aggiornano automaticamente dal catalogo cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の選択は言語ごとに保存され、利用可能な言語はクラウド カタログから自動的に更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções de voz são salvas por idioma e os idiomas disponíveis são atualizados automaticamente no catálogo da nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种语言分别记忆所选音色；可用语言由云端目录自动更新。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemkeuzes worden per taal bewaard; beschikbare talen worden automatisch bijgewerkt via de cloudcatalogus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 선택은 언어별로 저장되며, 사용 가능한 언어는 클라우드 카탈로그에서 자동으로 업데이트됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ خيارات الصوت لكل لغة، وتُحدّث اللغات المتاحة تلقائيًا من كتالوج السحابة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор голоса сохраняется для каждого языка; доступные языки автоматически обновляются из облачного каталога."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybory głosów są zapisywane dla każdego języka, a dostępne języki aktualizują się automatycznie z katalogu w chmurze."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstval sparas per språk, och tillgängliga språk uppdateras automatiskt från molnkatalogen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmevalg gemmes per sprog, og tilgængelige sprog opdateres automatisk fra cloud-kataloget."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmevalg lagres per språk, og tilgjengelige språk oppdateres automatisk fra skykatalogen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puheääniasetukset tallennetaan kunkin kielen osalta, ja saatavilla olevat kielet päivittyvät automaattisesti pilvipohjaisesta luettelosta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volby hlasů se ukládají podle jazyka a dostupné jazyky se automaticky aktualizují z cloudového katalogu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές φωνής αποθηκεύονται ανά γλώσσα και οι διαθέσιμες γλώσσες ενημερώνονται αυτόματα από τον κατάλογο cloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangválasztás nyelvenként kerül mentésre, az elérhető nyelvek pedig automatikusan frissülnek a felhőben lévő katalógusból."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga pagpipilian ng boses ay nakaimbak bawat wika, at ang mga available na wika ay nag-uupdate nang awtomatikong mula sa cloud catalog."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקול שנבחר נשמר לכל שפה בנפרד, והשפות הזמינות מתעדכנות אוטומטית מהקטלוג בענן."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan suara disimpan per bahasa, dan bahasa yang tersedia diperbarui secara otomatis dari katalog cloud."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan suara disimpan mengikut bahasa, dan bahasa yang tersedia dikemas kini secara automatik dari katalog awan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunile de voce sunt salvate pe limbă, iar limbile disponibile se actualizează automat din catalogul cloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn giọng được lưu theo ngôn ngữ, và các ngôn ngữ khả dụng sẽ tự động cập nhật từ kho dữ liệu đám mây."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses tercihleri her dil için ayrı kaydedilir ve kullanılabilir diller bulut kataloğundan otomatik olarak güncellenir."
          }
        }
      }
    },
