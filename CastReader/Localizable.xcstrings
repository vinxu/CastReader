    "声音服务正在更新，请稍后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sprachdienst wird aktualisiert. Bitte versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice service is being updated. Please try again later."
          }
        },
        "es": {
