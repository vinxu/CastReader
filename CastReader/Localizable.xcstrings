    "Pro 会员可以购买更多克隆音色额度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro members can purchase more voice credits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 会员可以购买更多克隆音色额度"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro メンバーはクローン音声の利用時間を追加購入できます"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros Pro pueden comprar más minutos de voz clonada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres Pro peuvent acheter des minutes supplémentaires de voix clonée"
          }
        },
        "de": {
          "stringUnit": {
