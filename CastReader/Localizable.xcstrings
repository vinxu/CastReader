    "刷新会重新同步书架并更新这本书的入口，不会清除朗读设置。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei wird deine Bibliothek synchronisiert und der Bucheintrag aktualisiert, ohne die Wiedergabeeinstellungen zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This refresh syncs your library and updates this book's entry without clearing playback settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta actualización sincroniza su biblioteca y actualiza la entrada de este libro sin borrar la configuración de reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette actualisation synchronise votre bibliothèque et met à jour l'entrée de ce livre sans effacer les paramètres de lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिफ्रेश आपकी लाइब्रेरी को सिंक करता है और प्लेबैक सेटिंग्स को साफ़ किए बिना इस पुस्तक की प्रविष्टि को अपडेट करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo aggiornamento sincronizza la tua libreria e aggiorna la voce di questo libro senza cancellare le impostazioni di riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この更新によりライブラリが同期され、再生設定をクリアせずにこの本のエントリが更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta atualização sincroniza sua biblioteca e atualiza a entrada deste livro sem limpar as configurações de reprodução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新会重新同步书架并更新这本书的入口，不会清除朗读设置。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vernieuwing synchroniseert uw bibliotheek en update de vermelding van dit boek zonder afspeelinstellingen te wissen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 새로고침은 라이브러리를 동기화하고 이 책 항목을 업데이트하지만 재생 설정은 초기화하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزامن هذا التحديث مكتبتك ويحدّث إدخال هذا الكتاب دون مسح إعدادات التشغيل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это обновление синхронизирует вашу библиотеку и обновляет запись этой книги без сброса настроек воспроизведения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To odświeżenie synchronizuje Twoją bibliotekę i aktualizuje wpis tej książki bez usuwania ustawień odtwarzania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna uppdatering synkroniserar ditt bibliotek och uppdaterar bokens post utan att rensa inställningar för uppspelning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne genopfriskning synkroniserer dit bibliotek og opdaterer bogens post uden at rydde afspilningsindstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne oppdateringen synkroniserer biblioteket ditt og oppdaterer oppføringen for denne boken uten å fjerne avspillingsinnstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä päivitys synkronoi kirjastosi ja päivittää tämän kirjan merkinnän poistamatta toistoasetuksia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto obnovení synchronizuje vaši knihovnu a aktualizuje záznam této knihy bez vymazání nastavení přehrávání."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ανανέωση συγχρονίζει τη βιβλιοθήκη σας και ενημερώνει την καταχώρηση αυτού του βιβλίου χωρίς να καθαρίζει τις ρυθμίσεις αναπαραγωγής."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a frissítés szinkronizálja a könyvtárat, és frissíti a könyv bejegyzését lejátszási beállítások törlése nélkül."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang refresh na ito ay nag-s-sync ng iyong aklatan at nag-uupdate ng entry ng aklat na ito nang hindi tinatanggal ang mga setting ng playback."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini menyegerakkan pustaka anda dan mengemas kini entri buku ini tanpa mengosongkan tetapan main balik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyegaran ini menyinkronkan pustaka Anda dan memperbarui entri buku ini tanpa menghapus pengaturan pemutaran."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yenileme, oynatma ayarlarını temizlemeden kitaplığınızı eşitler ve bu kitabın kaydını günceller."
