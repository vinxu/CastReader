    "仅处理字幕文本；视频和音频流不会被播放或保留。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur Untertiteltext verarbeitet. Video- und Audiostreams werden weder abgespielt noch gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only caption text is processed. Video and audio streams are never played or retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se procesa el texto de los subtítulos. Las transmisiones de video y audio nunca se reproducen ni conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le texte des sous-titres est traité. Les flux vidéo et audio ne sont jamais lus ni conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल कैप्शन टेक्स्ट प्रोसेस किया जाता है। वीडियो और ऑडियो स्ट्रीम कभी चलाए या सहेजे नहीं जाते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene elaborato solo il testo dei sottotitoli. I flussi video e audio non vengono mai riprodotti né conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理するのは字幕テキストのみです。動画や音声ストリームは再生・保存されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o texto das legendas é processado. As transmissões de vídeo e áudio nunca são reproduzidas nem retidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅处理字幕文本；视频和音频流不会被播放或保留。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen ondertiteltekst wordt verwerkt. Video- en audiostreams worden nooit afgespeeld of bewaard."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعالج نص التسميات التوضيحية فقط. ولا تُشغّل تدفقات الفيديو والصوت أو يُحتفظ بها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывается только текст субтитров. Видео- и аудиопотоки никогда не воспроизводятся и не сохраняются."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetwarzany jest tylko tekst napisów. Strumienie wideo i audio nigdy nie są odtwarzane ani przechowywane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast undertexterna bearbetas. Video- och ljudströmmar spelas aldrig upp och sparas aldrig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun underteksterne behandles. Video- og lydstreams afspilles eller gemmes aldrig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare undertekstene behandles. Video- og lydstrømmer spilles aldri av eller lagres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsitellään vain tekstitystekstiä. Videovirtaa ja äänivirtaa ei koskaan toisteta eikä säilytetä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpracovává se pouze text titulků. Video a zvukové proudy nejsou nikdy přehrávány ani ukládány."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υποβάλλεται σε επεξεργασία μόνο το κείμενο των υποτίτλων. Οι ροές βίντεο και ήχου δεν αναπαράγονται ούτε αποθηκεύονται ποτέ."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksto lamang ng caption ang pinoproseso. Hindi pine-play o iniimbak ang mga stream ng video at audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק טקסט הכתוביות מעובד. זרמי הווידאו והאודיו לעולם לא מושמעים או נשמרים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya teks subtitel yang diproses. Aliran video dan audio tidak pernah diputar atau disimpan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya teks kapsyen diproses. Aliran video dan audio tidak pernah dimainkan atau disimpan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a felirat szövegét dolgozzuk fel. A video- és hangfolyamokat nem játsszuk le és nem tároljuk."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자막 텍스트만 처리하며 동영상 및 오디오 스트림은 재생하거나 보관하지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca altyazı metni işlenir. Video ve ses akışları hiçbir zaman oynatılmaz veya saklanmaz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este procesat doar textul subtitrărilor. Fluxurile video și audio nu sunt niciodată redate sau păstrate."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xử lý văn bản phụ đề. Luồng video và âm thanh không bao giờ được phát hoặc lưu giữ."
          }
        }
      }
    },
