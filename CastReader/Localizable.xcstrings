            "state": "translated",
            "value": "Encore environ %lld min %lld s"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch etwa %lld Min. %lld Sek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam cerca de %lld min %lld s"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano circa %lld min %lld s"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग %lld मिनट %lld सेकंड बाकी"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer %lld min %lld sec resterend"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %lld분 %lld초 남음"
