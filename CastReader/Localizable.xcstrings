    "书架已保存，但同步确认未完成，请重试。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek wurde gespeichert, aber die Synchronisierung konnte nicht bestätigt werden. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library was saved, but sync could not be confirmed. Please try again."
          }
        },
        "es": {
