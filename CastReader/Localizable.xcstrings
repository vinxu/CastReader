    "朗读者已收回这个声音的使用授权，已为你取消选择": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorlesende Person hat den Zugriff auf diese Stimme widerrufen. Die Auswahl wurde aufgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reader revoked access to this voice, so it has been deselected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lector retiró el acceso a esta voz, por lo que se anuló la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur a retiré l’accès à cette voix. Elle a donc été désélectionnée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीडर ने इस आवाज़ का एक्सेस वापस ले लिया है, इसलिए इसे अचयनित कर दिया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il lettore ha revocato l’accesso a questa voce, quindi è stata deselezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朗読者がこの声の利用許可を取り消したため、選択を解除しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O leitor revogou o acesso a esta voz, então ela foi desmarcada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读者已收回这个声音的使用授权，已为你取消选择"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorlezer heeft toegang tot deze stem ingetrokken, dus deze is gedeselecteerd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغى القارئ الوصول إلى هذا الصوت، لذا تم إلغاء تحديده."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Владелец голоса отозвал разрешение. Этот голос больше не выбран для озвучивания."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektor cofnął dostęp do tego głosu, więc głos nie jest już wybrany."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppläsaren har återkallat åtkomsten till denna röst, så den har avmarkerats."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplæseren har tilbagekaldt adgangen til denne stemme, så den er blevet fravalgt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppleseren har trukket tilbake tilgangen til denne stemmen, så den er ikke lenger valgt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukija on peruuttanut pääsyn tähän ääneen, joten se on poistettu valinnasta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předčítající odvolal přístup k tomuto hlasu, proto hlas už není vybraný."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αφηγητής ανακάλεσε την πρόσβαση σε αυτή τη φωνή, οπότε η επιλογή της καταργήθηκε."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felolvasó visszavonta a hozzáférést ehhez a hanghoz, ezért a kijelölését megszüntettük."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binawi ng tagabasa ang pahintulot sa boses na ito, kaya inalis na ito sa napiling boses."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaca telah membatalkan akses kepada suara ini, jadi pilihan suara ini telah dibatalkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuyucu bu sesin erişimini iptal etti, bu nedenle seçim kaldırıldı."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낭독자가 이 음성의 사용 권한을 취소하여 선택이 해제되었습니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemilik suara mencabut akses ke suara ini, sehingga pilihan suara ini dibatalkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cititorul a retras accesul la această voce, așa că aceasta a fost deselectată."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקריא ביטל את הגישה לקול הזה, ולכן בחירתו בוטלה."
