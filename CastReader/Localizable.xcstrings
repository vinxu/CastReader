        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の言語を判別できません。読み上げ言語を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede identificar el idioma del texto. Elige un idioma de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue du texte n’a pas pu être identifiée. Choisissez une langue de lecture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Textsprache konnte nicht erkannt werden. Wähle eine Vorlesesprache."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível identificar o idioma do texto. Escolha um idioma de leitura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile identificare la lingua del testo. Scegli una lingua di lettura."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठ की भाषा पहचानी नहीं जा सकी। पढ़ने की भाषा चुनें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taal van de tekst kan niet worden herkend. Kies een voorleestaal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문의 언어를 확인할 수 없습니다. 읽기 언어를 선택해 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد لغة النص. اختر لغة القراءة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить язык текста. Выберите язык чтения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można rozpoznać języka tekstu. Wybierz język czytania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att identifiera textens språk. Välj ett uppläsningsspråk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstens sprog kan ikke genkendes. Vælg et oplæsningssprog."
