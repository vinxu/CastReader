            "state": "translated",
            "value": "Öppna valfri plats och välj Läs upp eller Förklara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn en hvilken som helst placering, og vælg Læs højt eller Forklar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne hvilken som helst plassering, og velg deretter Les høyt eller Forklar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa mikä tahansa sijainti, sitten valitse Lue ääneen tai Selitä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete libovolnou pozici a zvolte Číst nahlas nebo Vysvětlit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταβείτε σε οποιοδήποτε σημείο και επιλέξτε Εκφώνηση ή Εξήγηση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisson meg bármelyik helyet, majd válassza a Felolvasás vagy Magyarázat lehetőséget."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang anumang lokasyon, tapos pumili sa Basahin nang malakas o Ipaliwanag."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו כל מיקום, ואז בחרו בקריאה בקול או בהסבר."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka bagian mana pun, lalu pilih Baca nyaring atau Jelaskan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka mana-mana kedudukan, kemudian pilih Baca lantang atau Terangkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir konumu açın, ardından Sesli Okuma veya Açıklama'yı seçin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide la orice poziție, apoi alege Citire cu voce tare sau Explicare."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở ở vị trí bất kỳ rồi chọn Đọc thành tiếng hoặc Giải thích."
          }
        }
      }
    },
