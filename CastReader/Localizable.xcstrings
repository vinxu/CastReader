        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınız kaydedildi, ancak eşitleme doğrulanamadı. Lütfen yeniden deneyin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca a fost salvată, dar sincronizarea nu a putut fi confirmată. Încearcă din nou."
