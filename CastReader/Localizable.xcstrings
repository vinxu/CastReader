    "这个克隆音色暂不支持当前朗读语言": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese geklonte Stimme unterstützt die aktuelle Lesesprache noch nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cloned voice does not yet support the current reading language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz clonada aún no admite el idioma de lectura actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette voix clonée ne prend pas encore en charge la langue de lecture actuelle."
          }
