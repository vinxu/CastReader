          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインに失敗しました。後でもう一度お試しください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no login. Tente novamente mais tarde"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败，请稍后重试"
