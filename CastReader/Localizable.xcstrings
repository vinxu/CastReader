            "value": "Tekstin kieltä ei voitu tunnistaa. Valitse lukukieli."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk textu se nepodařilo rozpoznat. Vyberte jazyk čtení."
