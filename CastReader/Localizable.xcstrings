            "value": "تعذّر مزامنة رف WeRead الآن. يرجى المحاولة مجددًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось синхронизировать вашу полку WeRead. Пожалуйста, повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zsynchronizować półki WeRead. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte synkronisera din WeRead-hylla just nu. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke synkronisere din WeRead-hylde lige nu. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke synkronisere WeRead-hyllen din akkurat nå. Vennligst prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRead-kirjahyllyn synkronointi epäonnistui. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se synchronizovat vaši polici WeRead. Zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο συγχρονισμός της βιβλιοθήκης WeRead αυτή τη στιγμή. Δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült szinkronizálni a WeRead polcot most. Próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-sync ang iyong WeRead na estante ngayon. Subukan ulit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לסנכרן את מדף WeRead כרגע. נסה שוב."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyinkronkan rak WeRead Anda saat ini. Silakan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyegerakkan rak WeRead anda pada masa ini. Sila cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut sincroniza raftul tău WeRead chiar acum. Încearcă din nou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRead rafınız şu anda senkronize edilemedi. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vừa rồi không thể đồng bộ kệ sách WeRead. Vui lòng thử lại."
          }
        }
      }
    },
