        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のページへの連続再生に失敗しました。再生をタップして続けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível continuar a reprodução na próxima página. Toque em Reproduzir para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一页播放衔接失败，请点击播放继续。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afspelen kon niet verdergaan op de volgende pagina. Tik op Afspelen om door te gaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 페이지에서 재생을 계속할 수 없습니다. 재생을 탭하여 계속하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الاستمرار في التشغيل على الصفحة التالية. اضغط تشغيل للمتابعة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось продолжить воспроизведение на следующей странице. Нажмите «Воспроизвести», чтобы продолжить."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można kontynuować odtwarzania na następnej stronie. Dotknij Odtwórz, aby wznowić."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att fortsätta uppspelning på nästa sida. Tryck på Spela för att fortsätta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke fortsætte afspilning på næste side. Tryk Afspil for at fortsætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke fortsette avspillingen på neste side. Trykk Spill for å fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistoa ei voitu jatkaa seuraavalla sivulla. Napauta Toista jatkaaksesi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se pokračovat ve přehrávání na další stránce. Klepněte na Přehrát pro pokračování."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατόν να συνεχιστεί η αναπαραγωγή στην επόμενη σελίδα. Πατήστε Αναπαραγωγή για συνέχιση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem folytatható a lejátszás a következő oldalon. Koppintson a Lejátszás gombra a folytatáshoz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makapagpatuloy ang playback sa susunod na pahina. I-tap ang Play para magpatuloy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat melanjutkan pemutaran di halaman berikutnya. Ketuk Putar untuk melanjutkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat meneruskan main balik pada halaman seterusnya. Ketuk Main untuk meneruskan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tiếp tục phát ở trang tiếp theo. Nhấn Phát để tiếp tục."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki sayfada oynatmaya devam edilemedi. Devam etmek için Oynat'a dokunun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redarea nu a putut continua pe pagina următoare. Atinge Redare pentru a continua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להמשיך את ההפעלה בעמוד הבא. יש להקיש על הפעלה כדי להמשיך."
          }
        }
      }
    },
