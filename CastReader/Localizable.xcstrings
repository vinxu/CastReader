    "播放已转移到其他窗口，轻点播放继续。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback moved to another window. Tap Play to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已转移到其他窗口，轻点播放继续。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生は別のウインドウに移りました。再生をタップして続けてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción pasó a otra ventana. Toca Reproducir para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture est passée dans une autre fenêtre. Touchez Lecture pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe wurde in ein anderes Fenster verschoben. Tippe zum Fortfahren auf Wiedergabe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução passou para outra janela. Toque em Reproduzir para continuar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione è passata a un’altra finestra. Tocca Riproduci per continuare."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेबैक दूसरी विंडो में चला गया। जारी रखने के लिए चलाएँ पर टैप करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afspelen is verplaatst naar een ander venster. Tik op Afspelen om door te gaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 다른 창으로 이동했습니다. 재생을 탭하여 계속하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение перемещено в другое окно. Нажмите «Воспроизвести», чтобы продолжить."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie przeniesiono do innego okna. Dotknij Odtwórz, aby kontynuować."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppspelningen flyttades till ett annat fönster. Tryck på Spela för att fortsätta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilning flyttet til et andet vindue. Tryk Afspil for at fortsætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avspilling flyttet til et annet vindu. Trykk Spill av for å fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toisto siirretty toiseen ikkunaan. Jatka napauttamalla Toista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrávání bylo přesunuto do jiného okna. Klepněte na Přehrát pro pokračování."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναπαραγωγή μεταφέρθηκε σε άλλο παράθυρο. Πατήστε Αναπαραγωγή για συνέχιση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lejátszás átkerült egy másik ablakba. Koppintson a Lejátszás gombra a folytatáshoz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumipat ang pag-play sa ibang window. I-tap ang Play upang magpatuloy."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשמעה הועברה לחלון אחר. הקש על ניגון כדי להמשיך."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutaran dipindahkan ke jendela lain. Ketuk Putar untuk melanjutkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Main balik dialihkan ke tetingkap lain. Ketuk Main untuk meneruskan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل التشغيل إلى نافذة أخرى. اضغط على تشغيل للمتابعة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma başka bir pencereye taşındı. Devam etmek için Oynat'a dokunun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redarea a fost mutată în altă fereastră. Atinge Redă pentru a continua."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung đang phát đã chuyển sang cửa sổ khác. Nhấn Phát để tiếp tục."
          }
        }
      }
    },
