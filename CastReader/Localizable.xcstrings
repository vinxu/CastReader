    "同步后即可在 CastReader 中朗读和解读。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Synchronisierung kannst du diese Bücher in CastReader vorlesen und erklären lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After syncing, you can read aloud and explain these books in CastReader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras sincronizar, podrás escuchar y explicar estos libros en CastReader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après synchronisation, vous pourrez écouter et expliquer ces livres dans CastReader."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक करने के बाद आप CastReader में इन किताबों को सुन और समझ सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la sincronizzazione, potrai ascoltare e spiegare questi libri in CastReader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期後、CastReaderで本の朗読と解説を利用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após sincronizar, você poderá ouvir e explicar esses livros no CastReader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步后即可在 CastReader 中朗读和解读。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het synchroniseren kunt u deze boeken voorlezen en uitleggen in CastReader."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 후 CastReader에서 이 책들을 소리 내어 읽거나 해설할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد المزامنة، يمكنك قراءة هذه الكتب بصوت عالٍ وشرحها في CastReader."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После синхронизации вы сможете читать вслух и объяснять эти книги в CastReader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po synchronizacji możesz odczytywać te książki na głos i wyjaśniać je w CastReader."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter synkronisering kan du läsa upp och förklara dessa böcker i CastReader."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter synkronisering kan du læse højt og forklare disse bøger i CastReader."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter synkronisering kan du lese høyt og forklare disse bøkene i CastReader."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronoinnin jälkeen voit lukea nämä kirjat ääneen ja selittää ne CastReaderissa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po synchronizaci budete moci tyto knihy v CastReader předčítat a vysvětlovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά τον συγχρονισμό, μπορείτε να ακούσετε εκφωνήσεις και εξηγήσεις αυτών των βιβλίων στο CastReader."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagkatapos i-sync, maaari mong basahin nang malakas at ipaliwanag ang mga aklat na ito sa CastReader."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După sincronizare, poți asculta aceste cărți și explicațiile lor în CastReader."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đồng bộ, bạn có thể nghe đọc và nghe giải thích các cuốn sách này trong CastReader."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szinkronizálás után a CastReader felolvashatja és elmagyarázhatja ezeket a könyveket."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas penyegerakan, anda boleh membaca kuat dan menghuraikan buku ini dalam CastReader."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah disinkronkan, Anda dapat membacakan dan menjelaskan buku-buku ini di CastReader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitlemeden sonra bu kitapları CastReader'da sesli okuyabilir ve açıklayabilirsiniz."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר הסנכרון ניתן להקריא ולהסביר את הספרים האלה ב־CastReader."
          }
        }
      }
