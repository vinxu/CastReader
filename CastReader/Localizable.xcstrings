    "以后在 YouTube 里点分享，就能直接听字幕稿。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile künftig direkt aus YouTube, um das Transkript anzuhören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next time, share from YouTube to hear the transcript directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima vez, comparte desde YouTube para escuchar directamente la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine fois, partagez depuis YouTube pour écouter directement la transcription."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार ट्रांसक्रिप्ट सीधे सुनने के लिए YouTube से शेयर करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima volta condividi da YouTube per ascoltare direttamente la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回から YouTube で共有すると、字幕をすぐに聴けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da próxima vez, compartilhe pelo YouTube para ouvir a transcrição diretamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后在 YouTube 里点分享，就能直接听字幕稿。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende keer kun je vanuit YouTube delen om het transcript direct te horen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المرة القادمة، شارك من YouTube لسماع النص مباشرةً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В следующий раз делитесь из YouTube, чтобы сразу услышать расшифровку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnym razem udostępnij z YouTube, aby bezpośrednio wysłuchać transkryptu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa gång, dela från YouTube för att höra transkriptet direkt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Næste gang skal du dele fra YouTube for at høre transskriptet direkte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste gang, del fra YouTube for å høre underteksten direkte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavan kerran jaa YouTubesta kuullaksesi tekstityksen suoraan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příště sdílejte z aplikace YouTube, abyste mohli přepis poslouchat přímo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
