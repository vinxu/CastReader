    "系统声音暂不可用，请切换本机声音后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统声音暂不可用，请切换本机声音后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This voice is unavailable. Choose another device voice and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声は利用できません。別の端末音声を選んで再試行してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz no está disponible. Elige otra voz del dispositivo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette voix est indisponible. Choisissez une autre voix de l’appareil et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Stimme ist nicht verfügbar. Wähle eine andere Gerätestimme und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz não está disponível. Escolha outra voz do dispositivo e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa voce non è disponibile. Scegli un’altra voce del dispositivo e riprova."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आवाज़ उपलब्ध नहीं है। डिवाइस की दूसरी आवाज़ चुनें और फिर कोशिश करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze stem is niet beschikbaar. Kies een andere apparaatstem en probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الصوت غير متاح. اختر صوت جهاز آخر وحاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот голос недоступен. Выберите другой голос устройства и повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten głos jest niedostępny. Wybierz inny głos urządzenia i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna röst är inte tillgänglig. Välj en annan enhetsröst och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne stemme er ikke tilgængelig. Vælg en anden enhedsstemme og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne stemmen er ikke tilgjengelig. Velg en annen enhetstemme og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ääni ei ole käytettävissä. Valitse toinen laitteen ääni ja yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento hlas není k dispozici. Zvolte jiný hlas zařízení a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η φωνή δεν είναι διαθέσιμη. Επιλέξτε άλλη φωνή συσκευής και δοκιμάστε ξανά."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang boses na ito. Pumili ng ibang boses ng device at subukang muli."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara ini tidak tersedia. Pilih suara lain pada peranti ini dan cuba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ses kullanılamıyor. Başka bir cihaz sesi seçip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng đọc này không khả dụng. Hãy chọn một giọng đọc khác trên thiết bị và thử lại."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a hang nem érhető el. Válassz másik hangot az eszközön, és próbáld újra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 음성을 사용할 수 없습니다. 다른 기기 음성을 선택하고 다시 시도하세요."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקול הזה אינו זמין. יש לבחור קול אחר מהמכשיר ולנסות שוב."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara ini tidak tersedia. Pilih suara perangkat lain lalu coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această voce nu este disponibilă. Alege altă voce a dispozitivului și încearcă din nou."
          }
        }
      }
    },
    "这些声音由本机系统提供。选择常规声音可获得更自然的离线朗读。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些声音由本机系统提供。选择常规声音可获得更自然的离线朗读。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These voices are provided by your device. Standard voices offer more natural offline reading."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは端末のシステム音声です。標準音声を選ぶと、より自然なオフライン読み上げになります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas voces las proporciona tu dispositivo. Las voces estándar ofrecen una lectura sin conexión más natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces voix sont fournies par votre appareil. Les voix standard offrent une lecture hors ligne plus naturelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Stimmen werden vom Gerät bereitgestellt. Standardstimmen ermöglichen natürlicheres Offline-Vorlesen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas vozes são fornecidas pelo dispositivo. Vozes padrão oferecem uma leitura offline mais natural."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste voci sono fornite dal dispositivo. Le voci standard offrono una lettura offline più naturale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आवाज़ें आपके डिवाइस का सिस्टम देता है। सामान्य आवाज़ चुनने पर ऑफ़लाइन पढ़ना अधिक स्वाभाविक लगता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze stemmen worden door uw apparaat geleverd. Standaardstemmen bieden natuurlijker offline voorlezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 음성들은 장치에서 제공됩니다. 표준 음성은 더 자연스러운 오프라인 읽기를 제공합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُوفَّر هذه الأصوات بواسطة جهازك. توفر الأصوات القياسية قراءة أكثر طبيعية دون اتصال."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти голоса предоставляются вашим устройством. Стандартные голоса обеспечивают более естественное офлайн-чтение."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te głosy są dostarczane przez Twoje urządzenie. Standardowe głosy zapewniają bardziej naturalne czytanie offline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa röster tillhandahålls av din enhet. Standardröster ger mer naturlig läsning offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse stemmer leveres af din enhed. Standardstemmer giver mere naturlig offline læsning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse stemmene leveres av enheten din. Standardstemmer gir mer naturlig lesing offline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä äänet tarjoaa laitteesi. Vakioäänet tarjoavat luonnollisempaa offline-lukemista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto hlasy poskytuje vaše zařízení. Standardní hlasy nabízejí přirozenější čtení offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές οι φωνές παρέχονται από τη συσκευή σας. Οι τυπικές φωνές προσφέρουν πιο φυσική ανάγνωση εκτός σύνδεσης."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga boses na ito ay galing sa iyong device. Ang mga standard na boses ay nag-aalok ng mas natural na pagbasa offline."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara ini disediakan oleh peranti anda. Suara piawai menawarkan bacaan luar talian yang lebih semula jadi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sesler cihazınız tarafından sağlanır. Standart sesler, daha doğal çevrimdışı okuma sunar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giọng này do thiết bị cung cấp. Giọng tiêu chuẩn mang lại trải nghiệm đọc ngoại tuyến tự nhiên hơn."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket a hangokat az eszközöd biztosítja. A standard hangok természetesebb offline felolvasást nyújtanak."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקולות האלה מסופקים על ידי המכשיר. קולות רגילים מציעים הקראה טבעית יותר במצב לא מקוון."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara ini disediakan oleh perangkat Anda. Suara standar menawarkan pembacaan offline yang lebih alami."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste voci sunt furnizate de dispozitiv. Vocile standard oferă o lectură offline mai naturală."
          }
        }
      }
    },
    "本机尚无适合此书的声音，请联网准备系统声音后重新打开此书。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机尚无适合此书的声音，请联网准备系统声音后重新打开此书。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No suitable voice is available on this device. Connect to the internet to download a system voice, then reopen this book."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本に適した音声が端末にありません。ネットに接続してシステム音声をダウンロードし、本を開き直してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una voz adecuada en este dispositivo. Conéctate para descargar una voz del sistema y vuelve a abrir el libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune voix adaptée n’est disponible sur cet appareil. Connectez-vous pour télécharger une voix système, puis rouvrez ce livre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine passende Stimme verfügbar. Lade online eine Systemstimme herunter und öffne das Buch erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há uma voz adequada neste dispositivo. Conecte-se para baixar uma voz do sistema e reabra o livro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è disponibile una voce adatta. Connettiti per scaricare una voce di sistema, poi riapri il libro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस किताब के लिए उपयुक्त आवाज़ डिवाइस पर नहीं है। इंटरनेट से जुड़कर सिस्टम की आवाज़ डाउनलोड करें और किताब फिर खोलें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen geschikte stem beschikbaar op dit apparaat. Verbind met internet om een systeemstem te downloaden, en open dit boek opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에 적합한 음성이 없습니다. 인터넷에 연결하여 시스템 음성을 다운로드한 후 이 책을 다시 여세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد صوت مناسب متوفر على هذا الجهاز. اتصل بالإنترنت لتحميل صوت النظام، ثم أعد فتح هذا الكتاب."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве нет подходящего голоса. Подключитесь к интернету, чтобы загрузить системный голос, затем откройте книгу снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym urządzeniu nie ma odpowiedniego głosu. Połącz się z internetem, aby pobrać głos systemowy, a następnie otwórz tę książkę ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lämplig röst finns tillgänglig på denna enhet. Anslut till internet för att ladda ner en systemröst, öppna sedan boken igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen egnet stemme tilgængelig på denne enhed. Forbind til internettet for at downloade en systemstemme, og åbn derefter denne bog igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen egnet stemme er tilgjengelig på denne enheten. Koble til internett for å laste ned en systemstemme, og åpne deretter boken på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä laitteella ei ole sopivaa ääntä. Yhdistä internetiin, lataa järjestelmän ääni ja avaa kirja uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto zařízení není k dispozici žádný vhodný hlas. Připojte se k internetu, stáhněte systémový hlas a znovu otevřete tuto knihu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει κατάλληλη φωνή στη συσκευή. Συνδεθείτε στο διαδίκτυο για να κατεβάσετε μια φωνή συστήματος, στη συνέχεια ανοίξτε ξανά αυτό το βιβλίο."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang angkop na boses na available sa device na ito. Konektahin ang internet upang ma-download ang system voice, pagkatapos ay buksan muli ang aklat na ito."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada suara yang sesuai pada peranti ini. Sambungkan ke internet untuk memuat turun suara sistem, kemudian buka semula buku ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda uygun ses bulunmuyor. Sistem sesini indirmek için internete bağlanın, ardından bu kitabı yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giọng phù hợp trên thiết bị này. Hãy kết nối internet để tải giọng hệ thống, sau đó mở lại cuốn sách."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs megfelelő hang ezen az eszközön. Csatlakozz az internethez, tölts le egy rendszerhangot, majd nyisd meg újra a könyvet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין קול מתאים במכשיר זה. יש להתחבר לאינטרנט ולהוריד קול של המערכת, ואז לפתוח את הספר מחדש."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada suara yang sesuai di perangkat ini. Hubungkan ke internet untuk mengunduh suara sistem, lalu buka kembali buku ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe acest dispozitiv nu este disponibilă o voce potrivită. Conectează-te la internet pentru a descărca o voce de sistem, apoi redeschide cartea."
          }
        }
      }
    },
