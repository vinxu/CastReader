    "从其他应用分享网页、文字、文档或图片到 CastReader，内容会保存在这里。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile Webseiten, Text, Dokumente oder Bilder aus anderen Apps mit CastReader. Sie werden hier gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share webpages, text, documents, or images from other apps to CastReader. They will be saved here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte páginas web, texto, documentos o imágenes desde otras apps a CastReader. Se guardarán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez des pages web, du texte, des documents ou des images avec CastReader. Ils seront enregistrés ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य ऐप्स से वेबपेज, टेक्स्ट, दस्तावेज़ या इमेज CastReader में साझा करें। वे यहाँ सहेजे जाएंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi pagine web, testo, documenti o immagini da altre app a CastReader. Verranno salvati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリからウェブページ、テキスト、文書、画像を CastReader に共有すると、ここに保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe páginas, textos, documentos ou imagens de outros apps com o CastReader. Eles ficarão salvos aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他应用分享网页、文字、文档或图片到 CastReader，内容会保存在这里。"
          }
        }
      }
    },
