    "未能在 Kindle 书架找到这本书，请手动同步书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Buch wurde in deiner Kindle-Bibliothek nicht gefunden. Bitte synchronisiere die Bibliothek manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book could not be found in your Kindle library. Please sync the library manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este libro no se pudo encontrar en su biblioteca Kindle. Sincronice la biblioteca manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce livre est introuvable dans votre bibliothèque Kindle. Veuillez synchroniser la bibliothèque manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पुस्तक आपकी किंडल लाइब्रेरी में नहीं मिल सकी। कृपया लाइब्रेरी को मैन्युअल रूप से सिंक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare questo libro nella tua libreria Kindle. Si prega di sincronizzare la libreria manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本は Kindle ライブラリに見つかりませんでした。ライブラリを手動で同期してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este livro não foi encontrado na sua biblioteca do Kindle. Sincronize a biblioteca manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能在 Kindle 书架找到这本书，请手动同步书架。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit boek is niet gevonden in uw Kindle-bibliotheek. Synchroniseer de bibliotheek handmatig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على هذا الكتاب في مكتبة Kindle الخاصة بك. يرجى مزامنة المكتبة يدويًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта книга не найдена в вашей библиотеке Kindle. Пожалуйста, синхронизируйте библиотеку вручную."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono tej książki w Twojej bibliotece Kindle. Zsynchronizuj bibliotekę ręcznie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna bok kunde inte hittas i ditt Kindle-bibliotek. Synkronisera biblioteket manuellt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bog kunne ikke findes i dit Kindle-bibliotek. Synkroniser biblioteket manuelt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne boken kunne ikke finnes i Kindle-biblioteket ditt. Synkroniser biblioteket manuelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kirjaa ei löytynyt Kindle-kirjastostasi. Synkronoi kirjasto manuaalisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kniha nebyla nalezena ve vaší knihovně Kindle. Prosím, synchronizujte knihovnu ručně."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το βιβλίο δεν βρέθηκε στη βιβλιοθήκη Kindle σας. Συγχρονίστε τη βιβλιοθήκη χειροκίνητα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a könyv nem található a Kindle-könyvtárában. Kérem, állítsa szinkronba a könyvtárat manuálisan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makita ang aklat na ito sa iyong Kindle aklatan. I-sync ang aklatan nang manu-mano."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku ini tidak ditemui dalam pustaka Kindle anda. Sila segerakkan pustaka secara manual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această carte nu a fost găsită în biblioteca ta Kindle. Sincronizează biblioteca manual."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle 서재에서 이 책을 찾을 수 없습니다. 서재를 수동으로 동기화하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku ini tidak ditemukan di pustaka Kindle Anda. Silakan sinkronkan pustaka secara manual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitap Kindle kitaplığınızda bulunamadı. Lütfen kitaplığı elle eşitleyin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספר לא נמצא בספריית Kindle שלך. יש לסנכרן את הספרייה ידנית."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy sách này trong thư viện Kindle của bạn. Vui lòng đồng bộ thư viện thủ công."
          }
        }
      }
    },
