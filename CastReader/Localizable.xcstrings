{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "正在同步当前书页，请稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing the current page. Please try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在同步当前书页，请稍后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のページを同期中です。しばらくしてから再試行してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando la página actual. Inténtalo de nuevo en unos instantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation de la page en cours. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Seite wird synchronisiert. Versuche es gleich noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando a página atual. Tente novamente em instantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione della pagina in corso. Riprova tra poco."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा पेज सिंक हो रहा है। थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige pagina synchroniseren. Probeer het over even opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 페이지를 동기화 중입니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация текущей страницы. Повторите попытку через мгновение."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizowanie bieżącej strony. Spróbuj ponownie za chwilę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniserar aktuell sida. Försök igen om en stund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniserer nuværende side. Prøv igen om et øjeblik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniserer nåværende side. Vennligst prøv igjen om kort tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sivua synkronoidaan. Yritä uudelleen pian."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuji aktuální stránku. Zkuste to prosím brzy znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγχρονισμός της τρέχουσας σελίδας. Παρακαλώ δοκιμάστε ξανά σύντομα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktuális oldal szinkronizálása. Kérjük, próbálja meg újra rövidesen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sini-sync ang kasalukuyang pahina. Subukang muli pagkaraan ng ilang sandali."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסנכרן את הדף הנוכחי. נסה שוב בעוד רגע."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyinkronkan halaman saat ini. Silakan coba lagi sebentar lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyegerakkan halaman semasa. Sila cuba lagi sebentar lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجري مزامنة الصفحة الحالية. حاول مجددًا بعد قليل."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli sayfa eşitleniyor. Lütfen biraz sonra yeniden deneyin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincronizează pagina curentă. Încearcă din nou în scurt timp."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đồng bộ trang hiện tại. Vui lòng thử lại sau giây lát."
          }
        }
      }
    },
    "解读失败，请重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explanation failed. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解读失败，请重试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解説に失敗しました。もう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo generar la explicación. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de générer l’explication. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erklärung konnte nicht erstellt werden. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gerar a explicação. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile generare la spiegazione. Riprova."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्याख्या तैयार नहीं हो सकी। फिर कोशिश करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitleg is mislukt. Probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해설에 실패했습니다. 다시 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить объяснение. Повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjaśnienie nie powiodło się. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förklaringen misslyckades. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklaring mislykkedes. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklaringen mislyktes. Vennligst prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selitys epäonnistui. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysvětlení se nezdařilo. Zkuste to prosím znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εξήγηση απέτυχε. Παρακαλώ δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magyarázat sikertelen. Kérjük, próbálja meg újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigo ang paliwanag. Subukan muli."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההסבר נכשל. נסה שוב."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penjelasan gagal. Silakan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penjelasan gagal. Sila cuba lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إنشاء الشرح. حاول مجددًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklama oluşturulamadı. Lütfen yeniden deneyin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicația a eșuat. Încearcă din nou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải thích không thành công. Vui lòng thử lại."
          }
        }
      }
    },
    "额度暂时无法同步，请稍后重试。已付款的订单会自动补到账。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits could not be synced. Please try again. Paid purchases will be delivered automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额度暂时无法同步，请稍后重试。已付款的订单会自动补到账。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用時間を同期できません。しばらくしてから再試行してください。支払い済みの購入分は自動的に反映されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo sincronizar el saldo. Inténtalo de nuevo más tarde. Las compras pagadas se acreditarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de synchroniser le solde. Réessayez plus tard. Les achats payés seront crédités automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Guthaben konnte nicht synchronisiert werden. Versuche es später erneut. Bezahlte Käufe werden automatisch gutgeschrieben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível sincronizar o saldo. Tente novamente mais tarde. As compras pagas serão creditadas automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile sincronizzare il saldo. Riprova più tardi. Gli acquisti pagati saranno accreditati automaticamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिनटों का बैलेंस सिंक नहीं हो सका। बाद में फिर कोशिश करें। जिन खरीदारी का भुगतान हो चुका है, उनके मिनट अपने आप जुड़ जाएँगे।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits konden niet worden gesynchroniseerd. Probeer het opnieuw. Betaalde aankopen worden automatisch geleverd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레딧을 동기화할 수 없습니다. 다시 시도해 주세요. 결제된 구매 건의 크레딧은 자동으로 지급됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось синхронизировать кредиты. Повторите попытку. Оплаченные кредиты будут начислены автоматически."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zsynchronizować kredytów. Spróbuj ponownie. Opłacone kredyty zostaną dodane automatycznie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediterna kunde inte synkroniseras. Försök igen. Betalda krediter läggs till automatiskt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditterne kunne ikke synkroniseres. Prøv igen. Betalte kreditter tilføjes automatisk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditter kunne ikke synkroniseres. Vennligst prøv igjen. Betalte kjøp leveres automatisk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediittejä ei voitu synkronoida. Yritä uudelleen. Maksetut krediitit lisätään automaattisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredity se nepodařilo synchronizovat. Zkuste to znovu. Zaplacené kredity budou připsány automaticky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο συγχρονισμός των πιστωτικών μονάδων. Δοκιμάστε ξανά. Οι μονάδες που έχουν πληρωθεί θα προστεθούν αυτόματα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült szinkronizálni a krediteket. Próbálja újra. A kifizetett vásárlásokat automatikusan jóváírjuk."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-sync ang mga kredito. Subukang muli. Awtomatikong idaragdag sa account ang mga nabayarang kredito."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לסנכרן את יתרת הדקות. נסה שוב. דקות שנרכשו יתווספו אוטומטית."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit tidak dapat disinkronkan. Silakan coba lagi. Kredit dari pembelian yang sudah dibayar akan ditambahkan secara otomatis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit tidak dapat disegerakkan. Sila cuba lagi. Kredit daripada pembelian yang telah dibayar akan ditambahkan secara automatik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت مزامنة الرصيد. حاول مجددًا. ستُضاف المشتريات المدفوعة تلقائيًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediler eşitlenemedi. Lütfen yeniden deneyin. Ödemesi yapılan satın alımlar otomatik olarak hesabınıza yansıtılacaktır."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creditele nu au putut fi sincronizate. Încearcă din nou. Achizițiile plătite vor fi acordate automat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đồng bộ số phút. Vui lòng thử lại. Các giao dịch đã thanh toán sẽ được cộng tự động."
          }
        }
      }
    },
