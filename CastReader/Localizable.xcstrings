    "避免背景音乐、多人同时讲话、明显回声或破音。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide Hintergrundmusik, gleichzeitig sprechende Personen, deutlichen Hall oder Übersteuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid background music, people speaking at the same time, obvious echo, or clipping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la música de fondo, varias personas hablando a la vez, el eco marcado o la saturación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez la musique de fond, plusieurs personnes parlant en même temps, l’écho prononcé ou la saturation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड संगीत, एक साथ बोलते कई लोग, साफ़ गूंज या क्लिपिंग से बचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita musica di sottofondo, più persone che parlano insieme, eco evidente o clipping."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BGM、複数人の同時発話、強い反響、音割れは避けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite música de fundo, várias pessoas falando ao mesmo tempo, eco evidente ou áudio estourado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免背景音乐、多人同时讲话、明显回声或破音。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd achtergrondmuziek, meerdere sprekers tegelijk, duidelijke echo of overversterking."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 음악, 여러 사람이 동시에 말하는 소리, 심한 울림, 너무 큰 소리로 인한 음질 왜곡을 피하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجنب الموسيقى الخلفية، وتداخل عدة أصوات في وقت واحد، والصدى الواضح، أو التشويه."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте фоновой музыки, одновременной речи нескольких людей, явного эха или перегрузки сигнала."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj muzyki w tle, wielu osób mówiących jednocześnie, wyraźnego echa lub przesterowania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik bakgrundsmusik, flera personer som talar samtidigt, uppenbart ekoljud eller överstyrning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå baggrundsmusik, flere personer, der taler samtidig, tydeligt ekko eller overstyring."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå bakgrunnsmusikk, flere personer som snakker samtidig, tydelig ekko eller overstyring."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältä taustamusiikkia, useita puhujia samanaikaisesti, selvää kaikua tai vääristymää."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhněte se hudbě na pozadí, více lidem mluvícím současně, výrazné ozvěně a přebuzenému zvuku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποφύγετε μουσική υπόκρουση, ταυτόχρονη ομιλία πολλών ατόμων, προφανή ηχώ ή κορεσμό."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerülje a háttérzenét, egyszerre beszélő embereket, nyilvánvaló visszhangot vagy torzítást."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwasan ang background music, maraming taong nagsasalita nang sabay, malinaw na echo, o clipping."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הימנעו ממוזיקת רקע, דיבור בו-זמני של מספר אנשים, הד חזק או עיוות (clipping)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Elakkan muzik latar, orang bercakap serentak, gema yang ketara atau herotan akibat bunyi terlalu kuat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evită muzica de fundal, vorbirea simultană a mai multor persoane, ecoul evident sau distorsiunile (clipping)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan müziğinden, aynı anda konuşan birden fazla kişiden, belirgin yankıdan ve aşırı yüksek ses nedeniyle oluşan bozulmadan kaçının."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindari musik latar, orang berbicara bersamaan, gema yang jelas, atau suara pecah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh nhạc nền, nhiều người nói cùng lúc, tiếng vang rõ rệt hoặc âm thanh vỡ tiếng."
          }
        }
      }
    },
    "使用本人或已获授权的声音": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende deine eigene oder eine autorisierte Stimme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Your Own or an Authorized Voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu propia voz o una voz autorizada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre propre voix ou une voix autorisée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी या अधिकृत आवाज़ का उपयोग करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la tua voce o una voce autorizzata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人または許可を得た声を使用"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use sua própria voz ou uma voz autorizada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本人或已获授权的声音"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik uw eigen of een geautoriseerde stem"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 목소리나 권한이 있는 목소리를 사용하세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم صوتك الخاص أو صوتًا مخولًا لك"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте свой голос или голос с разрешением"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj własnego głosu lub głosu, na którego użycie masz zgodę"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd din egen röst eller en röst du har tillstånd att använda"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug din egen stemme eller en stemme, du har tilladelse til at bruge"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk din egen stemme eller en stemme du har tillatelse til å bruke"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä omaa ääntäsi tai ääntä, jonka käyttöön sinulla on lupa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte vlastní hlas nebo hlas, k jehož použití máte svolení"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση της δικής σας ή εξουσιοδοτημένης φωνής"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saját hangot vagy engedéllyel használható hangot válasszon"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang Sarili o Awtorisyadong Boses"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו בקול שלכם או בקול מורשה"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Suara Sendiri atau Suara yang Diizinkan Pemiliknya"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește vocea ta sau o voce autorizată"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi Sesinizi veya Kullanım İzni Aldığınız Bir Sesi Kullanın"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Suara Sendiri atau yang Telah Diizinkan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng giọng của bạn hoặc giọng được cho phép"
          }
        }
      }
    },
    "上传后需要试听选中的短片段，并明确确认你有权创建这个声音。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Upload musst du den ausgewählten kurzen Clip anhören und ausdrücklich bestätigen, dass du diese Stimme erstellen darfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After uploading, you must listen to the selected short clip and explicitly confirm that you have the right to create this voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de subirlo, debes escuchar el fragmento corto seleccionado y confirmar expresamente que tienes derecho a crear esta voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’importation, vous devez écouter le court extrait sélectionné et confirmer explicitement que vous avez le droit de créer cette voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड के बाद चुना गया छोटा क्लिप सुनें और स्पष्ट रूप से पुष्टि करें कि आपको यह आवाज़ बनाने का अधिकार है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo il caricamento, devi ascoltare il breve clip selezionato e confermare esplicitamente di avere il diritto di creare questa voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード後、選択された短いクリップを試聴し、この声を作成する権利があることを明示的に確認する必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após o envio, ouça o trecho curto selecionado e confirme expressamente que você tem o direito de criar essa voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传后需要试听选中的短片段，并明确确认你有权创建这个声音。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het uploaden moet u de geselecteerde korte clip beluisteren en expliciet bevestigen dat u het recht heeft om deze stem te maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 후 선택한 짧은 클립을 듣고 해당 목소리를 생성할 권리가 있음을 명시적으로 확인해야 합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الرفع، يجب الاستماع إلى المقطع القصير المحدد والتأكيد صراحةً على امتلاكك الحق في إنشاء هذا الصوت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После загрузки необходимо прослушать выбранный короткий фрагмент и явно подтвердить, что у вас есть право создать этот голос."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przesłaniu musisz odsłuchać wybrany krótki klip i wyraźnie potwierdzić, że masz prawo stworzyć ten głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter uppladdning måste du lyssna på det valda korta klippet och uttryckligen bekräfta att du har rätt att skapa denna röst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter upload skal du lytte til det valgte korte klip og eksplicit bekræfte, at du har ret til at oprette denne stemme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter opplasting må du høre på det valgte korte utklippet og bekrefte eksplisitt at du har rett til å lage denne stemmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Latauksen jälkeen sinun on kuunneltava valittu lyhyt pätkä ja vahvistettava nimenomaan, että sinulla on oikeus luoda tämä ääni."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po nahrání si musíte vybraný krátký úsek poslechnout a výslovně potvrdit, že máte právo tento hlas vytvořit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά τη μεταφόρτωση, πρέπει να ακούσετε το επιλεγμένο σύντομο απόσπασμα και να επιβεβαιώσετε ρητά ότι έχετε το δικαίωμα να δημιουργήσετε αυτή τη φωνή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltöltés után meg kell hallgatnia a kiválasztott rövid részletet, és kifejezetten meg kell erősítenie, hogy jogosult a hang létrehozására."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagkatapos mag-upload, kailangan mong makinig sa napiling maikling klip at eksplisitong kumpirmahin na may karapatan ka gumawa ng boses na ito."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר ההעלאה, עליכם להאזין לקטע הקצר הנבחר ולאשר במפורש כי יש לכם את הזכות ליצור קול זה."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas memuat naik, anda mesti mendengar klip pendek yang dipilih dan mengesahkan dengan jelas bahawa anda berhak mencipta suara ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După încărcare, trebuie să asculți scurtul fragment selectat și să confirmi explicit că ai dreptul să creezi această voce."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükledikten sonra seçilen kısa klibi dinlemeli ve bu sesi oluşturma hakkına sahip olduğunuzu açıkça onaylamalısınız."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah mengunggah, Anda harus mendengarkan cuplikan pendek yang dipilih dan mengonfirmasi secara tegas bahwa Anda berhak membuat suara ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi tải lên, bạn phải nghe đoạn ngắn đã chọn và xác nhận rõ rằng bạn có quyền tạo giọng này."
          }
        }
      }
    },
