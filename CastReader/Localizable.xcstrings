          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν επιτρέπονται προστατευμένοι ήχοι. Επιλέξτε ένα τυπικό τοπικό αρχείο που έχετε το δικαίωμα να χρησιμοποιήσετε."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Védett hang nem használható. Válasszon szabványos helyi fájlt, amelyet jogában áll használni."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pwedeng gamitin ang protektadong audio. Pumili ng standard na lokal na file na may karapatan kang gamitin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמע מוגן לא ניתן לשימוש. בחרו קובץ מקומי סטנדרטי שיש לכם זכות להשתמש בו."
          }
