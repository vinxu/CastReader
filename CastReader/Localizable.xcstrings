            "state": "translated",
            "value": "Conecte a conta para ver os livros dela salvos neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega l’account per vedere i suoi libri salvati sul dispositivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता जोड़ने पर इस डिवाइस पर उसकी सहेजी गई किताबें दिखेंगी।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind om de boeken van dit account te bekijken die op dit apparaat zijn opgeslagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하면 이 계정으로 기기에 저장한 책을 볼 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل لعرض كتب هذا الحساب المحفوظة على هذا الجهاز."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь, чтобы просмотреть книги этого аккаунта, сохранённые на устройстве."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz, aby wyświetlić książki tego konta zapisane na tym urządzeniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut för att visa kontots böcker som sparats på denna enhet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind for at se denne kontos bøger, der er gemt på denne enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til for å vise bøkene i denne kontoen som er lagret på denne enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä nähdäksesi tämän tilin tälle laitteelle tallennetut kirjat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte se pro zobrazení knih účtu uložených na tomto zařízení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε για να δείτε τα βιβλία του λογαριασμού που έχουν αποθηκευτεί σε αυτή τη συσκευή."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Konektahin upang makita ang mga aklat ng account na ito na naka-save sa device na ito."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan untuk melihat buku akaun ini yang disimpan pada peranti ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaza kaydedilmiş bu hesabın kitaplarını görüntülemek için bağlanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối để xem các sách đã lưu của tài khoản này trên thiết bị."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozz a fiókhoz, hogy megtekinthesd az eszközre mentett könyveit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתחבר כדי להציג את ספרי החשבון השמורים במכשיר זה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan untuk melihat buku akun ini yang tersimpan di perangkat ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te pentru a vedea cărțile acestui cont salvate pe dispozitiv."
          }
        }
      }
    },
