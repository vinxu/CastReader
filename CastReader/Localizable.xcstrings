            "value": "Optagelsen må ikke være større end 4 MB."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket må ikke være større enn 4 MB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänityksen koko saa olla enintään 4 MB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka nesmí být větší než 4 MB."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ηχογράφηση δεν πρέπει να υπερβαίνει τα 4 MB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel mérete nem lehet nagyobb 4 MB-nál."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang recording ay hindi dapat mas malaki kaysa 4 MB."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak boleh lebih besar dari 4 MB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt en fazla 4 MB olabilir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman mestilah tidak melebihi 4 MB."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea nu trebuie să depășească 4 MB."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גודל ההקלטה לא יכול לעלות על 4 MB."
