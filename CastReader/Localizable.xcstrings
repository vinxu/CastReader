    "你的书，现在能听了": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bücher, jetzt zum Hören"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your books, now you can listen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus libros, ahora puedes escucharlos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos livres, désormais à écouter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी किताबें, अब सुनी जा सकती हैं"
          }
