    "解读服务暂未识别 Pro 会员，请稍后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erklärungsdienst hat deinen Pro-Status noch nicht erkannt. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The explanation service has not recognized your Pro status yet. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de explicación aún no ha reconocido tu estado Pro. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’explication n’a pas encore reconnu votre statut Pro. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्याख्या सेवा ने अभी आपका Pro स्टेटस नहीं पहचाना है। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio di spiegazione non ha ancora riconosciuto il tuo stato Pro. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解説サービスでProステータスをまだ確認できません。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de explicação ainda não reconheceu seu status Pro. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解读服务暂未识别 Pro 会员，请稍后重试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitlegservice herkent uw Pro-status nog niet. Probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해설 서비스가 Pro 상태를 아직 인식하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتعرف خدمة الشرح على حالة اشتراكك في Pro بعد. يرجى المحاولة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис объяснений ещё не распознал ваш статус Pro. Пожалуйста, попробуйте снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa wyjaśnień jeszcze nie rozpoznała Twojego statusu Pro. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förklaringstjänsten har ännu inte registrerat din Pro-status. Vänligen försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklaringstjenesten har endnu ikke registreret din Pro-status. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklaringstjenesten har ennå ikke registrert Pro-statusen din. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selityspalvelu ei ole vielä tunnistanut Pro-tilaasi. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba vysvětlování zatím neuznala váš status Pro. Zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηρεσία εξηγήσεων δεν έχει αναγνωρίσει ακόμα το καθεστώς Pro σας. Παρακαλώ δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magyarázó szolgáltatás még nem ismeri fel a Pro státuszát. Kérjük, próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nakikilala ng serbisyo ng pagpapaliwanag ang iyong Pro status. Pakisubukan muli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan penjelasan belum mengenali status Pro Anda. Silakan coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul de explicații nu a recunoscut încă statutul tău Pro. Încearcă din nou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklama hizmeti Pro durumunuzu henüz tanımadı. Lütfen tekrar deneyin."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
