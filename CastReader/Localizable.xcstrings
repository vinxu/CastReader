    "下载记录已保留，返回在线阅读时请确认原阅读位置。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载记录已保留，返回在线阅读时请确认原阅读位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download progress is saved. Check your original position when returning to online reading."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードの記録は保存済みです。オンライン読書に戻る際、元の読書位置をご確認ください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso se ha guardado. Comprueba tu posición original al volver a la lectura en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression est enregistrée. Vérifiez votre position initiale en revenant à la lecture en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download-Fortschritt ist gespeichert. Prüfe beim Online-Lesen deine ursprüngliche Leseposition."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso foi salvo. Confira sua posição original ao voltar à leitura online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’avanzamento è salvato. Controlla la posizione originale quando torni alla lettura online."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड की प्रगति सहेजी गई है। ऑनलाइन पढ़ने पर लौटते समय अपनी पिछली जगह जाँचें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadvoortgang is opgeslagen. Controleer uw oorspronkelijke positie wanneer u terugkeert naar online lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 진행 상황이 저장되었습니다. 온라인 독서로 돌아갈 때 원래 위치를 확인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ تقدم التنزيل. تحقق من موضع قراءتك الأصلي عند العودة إلى القراءة عبر الإنترنت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс загрузки сохранён. При возвращении к онлайн-чтению проверьте вашу исходную позицию."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp pobierania został zapisany. Przy powrocie do czytania online sprawdź swoją oryginalną pozycję."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedladdningsframsteg är sparade. Kontrollera din ursprungliga plats när du återgår till online-läsning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadfremskridt er gemt. Tjek din oprindelige position, når du vender tilbage til online-læsning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedlastingsfremskritt er lagret. Sjekk din opprinnelige posisjon når du går tilbake til nettlesing."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Latauksen edistyminen on tallennettu. Tarkista alkuperäinen sijaintisi palatessasi verkkolukuun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postup stahování byl uložen. Při návratu k online čtení zkontrolujte svou původní pozici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόοδος λήψης έχει αποθηκευτεί. Ελέγξτε την αρχική σας θέση όταν επιστρέψετε στην ανάγνωση με σύνδεση στο διαδίκτυο."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltési előrehaladás el lett mentve. Térjen vissza az online olvasáshoz, és ellenőrizze az eredeti pozícióját."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save ang download progress. Suriin ang iyong orihinal na posisyon kapag bumalik sa online reading."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקדמות ההורדה נשמרה. בדוק את מיקומך המקורי בעת החזרה לקריאה באינטרנט."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Progres pengunduhan disimpan. Periksa posisi asli Anda saat kembali ke mode baca online."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemajuan muat turun disimpan. Semak kedudukan asal anda apabila kembali ke bacaan dalam talian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresul descărcării este salvat. Verifică poziția inițială când revii la lectura online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme ilerlemesi kaydedildi. Çevrimiçi okumaya dönerken asıl konumunuzu kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu tiến độ tải xuống. Kiểm tra vị trí ban đầu khi quay lại đọc trực tuyến."
          }
        }
      }
    },
