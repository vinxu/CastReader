    "打开书籍后会自动返回并更新阅读历史。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Öffnen eines Buchs kehrst du automatisch zurück und der Leseverlauf wird aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you open a book, we’ll return automatically and update your reading history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de abrir un libro, volverás automáticamente y se actualizará tu historial de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir ouvert un livre, vous reviendrez automatiquement et votre historique de lecture sera mis à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किताब खोलने के बाद आप अपने-आप वापस आ जाएंगे और पढ़ने का इतिहास अपडेट हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver aperto un libro, tornerai automaticamente qui e la cronologia di lettura verrà aggiornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書籍を開くと自動的に戻り、読書履歴が更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de abrir um livro, você voltará automaticamente e o histórico de leitura será atualizado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开书籍后会自动返回并更新阅读历史。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat u een boek hebt geopend, keren we automatisch terug en updaten we uw leesgeschiedenis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 열면 자동으로 돌아와 읽기 기록을 업데이트합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد فتح كتاب، سنعود تلقائيًا ونحدّث سجل قراءتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После открытия книги мы автоматически вернёмся и обновим вашу историю чтения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po otwarciu książki wrócimy automatycznie i zaktualizujemy Twoją historię czytania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du öppnar en bok kommer vi automatiskt tillbaka och uppdaterar din läsningshistorik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har åbnet en bog, vender vi automatisk tilbage og opdaterer din læsehistorik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter at du åpner en bok, returnerer vi automatisk og oppdaterer lesehistorikken din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun avaat kirjan, palaamme automaattisesti ja päivitämme lukuhistoriasi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po otevření knihy se automaticky vrátíme a aktualizujeme vaši historii čtení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις ανοίξετε ένα βιβλίο, θα επιστρέψουμε αυτόματα και θα ενημερώσουμε το ιστορικό ανάγνωσης."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután megnyit egy könyvet, automatikusan visszatérünk, és frissítjük az olvasási előzményeket."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagbukas mo ng libro, babalik kami nang awtomatiko at mag-uupdate ng iyong reading history."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah Anda membuka buku, kami akan kembali secara otomatis dan memperbarui riwayat baca Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kitap açtıktan sonra otomatik olarak geri döneceğiz ve okuma geçmişinizi güncelleyeceğiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas anda membuka buku, kami akan kembali secara automatik dan mengemas kini sejarah bacaan anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce deschizi o carte, vom reveni automat și vom actualiza istoricul de lectură."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר פתיחת ספר נחזור אוטומטית ונעדכן את היסטוריית הקריאה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi bạn mở sách, chúng tôi sẽ tự quay lại và cập nhật lịch sử đọc."
          }
        }
      }
    },
    "打开一本书，听满 30 秒即可完成设置。": {
