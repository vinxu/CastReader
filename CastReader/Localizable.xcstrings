    "每种语言分别记忆所选音色；可用语言由云端目录自动更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice choices are saved per language, and available languages update automatically from the cloud catalog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の選択は言語ごとに保存され、利用可能な言語はクラウド カタログから自動的に更新されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de voz se guardan por idioma y los idiomas disponibles se actualizan automáticamente desde el catálogo en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix vocaux sont enregistrés par langue et les langues disponibles sont mises à jour automatiquement à partir du catalogue cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções de voz são salvas por idioma e os idiomas disponíveis são atualizados automaticamente no catálogo da nuvem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scelte vocali vengono salvate per lingua e le lingue disponibili si aggiornano automaticamente dal catalogo cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्वनि विकल्प प्रति भाषा सहेजे जाते हैं, और उपलब्ध भाषाएँ क्लाउड कैटलॉग से स्वचालित रूप से अपडेट हो जाती हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种语言分别记忆所选音色；可用语言由云端目录自动更新。"
          }
        }
      }
    },
