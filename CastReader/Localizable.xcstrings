          "stringUnit": {
            "state": "translated",
            "value": "Amazon ストアを切り替えました。ログインして本棚を同期してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Loja da Amazon alterada. Entre e sincronize sua biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon 站点已切换，请登录并同步书架。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon-site gewijzigd. Meld u aan en synchroniseer uw bibliotheek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon 사이트가 변경되었습니다. 로그인하여 라이브러리를 동기화하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر موقع Amazon. سجّل الدخول وزامن مكتبتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Региональный сайт Amazon изменён. Войдите и синхронизируйте библиотеку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona Amazonu została zmieniona. Zaloguj się i zsynchronizuj bibliotekę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon-regionen har ändrats. Logga in och synkronisera ditt bibliotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon-side ændret. Log ind og synkroniser dit bibliotek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon-nettsiden har endret seg. Logg inn og synkroniser biblioteket ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon-sivusto on muuttunut. Kirjaudu sisään ja synkronoi kirjastosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stránka Amazonu se změnila. Přihlaste se a synchronizujte svou knihovnu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ιστοσελίδα της Amazon άλλαξε. Συνδεθείτε και συγχρονίστε τη βιβλιοθήκη σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Amazon webhely megváltozott. Jelentkezzen be, és szinkronizálja a könyvtárát."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang site ng Amazon. Mag-sign in at i-sync ang iyong aklatan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתר Amazon השתנה. היכנס וסנכרן את הספרייה שלך."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Situs Amazon berubah. Masuk dan sinkronkan perpustakaan Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laman Amazon telah ditukar. Log masuk dan segerakkan pustaka anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Site-ul Amazon s-a schimbat. Conectează-te și sincronizează-ți biblioteca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon sitesi değişti. Kitaplığınızı senkronize etmek için oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đổi trang Amazon. Đăng nhập và đồng bộ thư viện của bạn."
          }
        }
      }
    },
