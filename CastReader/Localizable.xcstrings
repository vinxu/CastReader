        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את כל הספרייה. נסה שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh pustaka tidak dapat dimuatkan. Sila cuba lagi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh pustaka tidak dapat dimuat. Silakan coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığın tamamı yüklenemedi. Lütfen yeniden deneyin."
