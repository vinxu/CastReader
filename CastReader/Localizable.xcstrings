    "升级后可创建，并为中文或英语选择自己的声音。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade, um eine Stimme zu erstellen und sie für Chinesisch oder Englisch auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to create a voice and choose it for Chinese or English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice para crear una voz y elíjala para chino o inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à niveau pour créer une voix et choisissez-la pour le chinois ou l'anglais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज बनाने के लिए अपग्रेड करें और इसे चीनी या अंग्रेजी के लिए चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui l'upgrade per creare una voce e sceglierla per cinese o inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップグレードして音声を作成し、中国語または英語を選択します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize para criar uma voz e escolha-a para chinês ou inglês."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级后可创建，并为中文或英语选择自己的声音。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade om een stem te maken en deze te kiezen voor Chinees of Engels."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리를 생성하고 중국어나 영어용으로 선택하려면 Pro로 업그레이드하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترقية لإنشاء صوت واختياره للصينية أو الإنجليزية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите на Pro, чтобы создать голос и выбрать его для китайского или английского языка."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnij, aby utworzyć głos i wybrać go dla języka chińskiego lub angielskiego."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgradera för att skapa en röst och välja den för kinesiska eller engelska."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgrader for at oprette en stemme og vælge den til kinesisk eller engelsk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgrader for å opprette en stemme og velge den for kinesisk eller engelsk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä luodaksesi äänen, jota voit käyttää kiinaksi tai englanniksi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejděte na Pro, vytvořte hlas a vyberte ho pro čínštinu nebo angličtinu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναβάθμιση για δημιουργία φωνής και επιλογή της για Κινεζικά ή Αγγλικά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Váltson magasabb csomagra, hogy hangot hozhasson létre, és kínai vagy angol felolvasáshoz használhassa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-upgrade upang gumawa ng boses at piliin ito para sa Tsino o Ingles."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Naik taraf untuk mencipta suara dan memilihnya bagi bahasa Cina atau Inggeris."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkatkan untuk membuat suara dan memilihnya untuk bahasa Mandarin atau Inggris."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ses oluşturmak ve Çince veya İngilizce için seçmek üzere yükseltin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă upgrade pentru a crea o voce și a o selecta pentru chineză sau engleză."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לשדרג כדי ליצור קול ולבחור בו לסינית או לאנגלית."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng cấp để tạo giọng và chọn giọng đó cho tiếng Trung hoặc tiếng Anh."
          }
        }
      }
    },
    "历史记录仅保存在本机，不会上传或同步到云端": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf bleibt nur auf diesem Gerät – er wird nie hochgeladen oder mit der Cloud synchronisiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is kept on this device only — never uploaded or synced to the cloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se guarda solo en este dispositivo; nunca se carga ni se sincroniza con la nube"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique est conservé sur cet appareil uniquement : jamais téléchargé ni synchronisé sur le cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास केवल इस डिवाइस पर रखा जाता है - कभी भी क्लाउड पर अपलोड या सिंक नहीं किया जाता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia viene conservata solo su questo dispositivo e non viene mai caricata o sincronizzata nel cloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はこのデバイスにのみ保存され、クラウドにアップロードまたは同期されることはありません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico é mantido apenas neste dispositivo – nunca carregado ou sincronizado com a nuvem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录仅保存在本机，不会上传或同步到云端"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ السجل على هذا الجهاز فقط — لا يتم تحميله أبدًا أو مزامنته مع السحابة"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История хранится только на этом устройстве — никогда не загружается и не синхронизируется с облаком"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia jest przechowywana tylko na tym urządzeniu — nigdy nie jest przesyłana ani synchronizowana w chmurze"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Historik sparas endast på denna enhet – laddas aldrig upp eller synkroniseras till molnet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Historik opbevares kun på denne enhed – aldrig uploadet eller synkroniseret til skyen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Historikk beholdes kun på denne enheten – lastes aldri opp eller synkroniseres til skyen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia säilytetään vain tässä laitteessa — sitä ei koskaan ladata tai synkronoida pilveen"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie se ukládá pouze na tomto zařízení. Nikdy se neodesílá ani nesynchronizuje do cloudu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ιστορικό διατηρείται μόνο σε αυτή τη συσκευή — δεν ανεβαίνει ποτέ ούτε συγχρονίζεται με το cloud"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előzmények csak ezen a készüléken maradnak elmentve – soha nem kerülnek feltöltésre vagy szinkronizálásra a felhőbe"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang kasaysayan ay pinapanatili lamang sa device na ito — kailanman ay hindi i-a-upload o i-sync sa cloud"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geschiedenis wordt alleen op dit apparaat bewaard en nooit naar de cloud geüpload of gesynchroniseerd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 기기에만 보관되며 클라우드에 업로드되거나 동기화되지 않습니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah hanya disimpan pada peranti ini — tidak pernah dimuat naik atau disegerakkan ke awan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat hanya disimpan di perangkat ini — tidak pernah diunggah atau disinkronkan ke cloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş yalnızca bu cihazda tutulur — hiçbir zaman buluta yüklenmez veya eşitlenmez"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul este păstrat doar pe acest dispozitiv — nu este încărcat sau sincronizat în cloud"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההיסטוריה נשמרת רק במכשיר הזה — לעולם אינה מועלה או מסונכרנת לענן"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử chỉ được lưu trên thiết bị này — không tải lên hoặc đồng bộ lên đám mây"
          }
        }
      }
    },
