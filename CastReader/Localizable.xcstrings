        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldeseite nutzt den gesamten Bildschirm. Anschließend wird der Leseverlauf automatisch geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in page uses the full screen. You’ll be taken to your reading history when you finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página de inicio de sesión usa toda la pantalla. Al terminar, accederás automáticamente al historial de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page de connexion utilise tout l’écran. Une fois terminé, l’historique de lecture s’ouvrira automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन-इन पेज पूरी स्क्रीन का उपयोग करेगा। पूरा होने पर पढ़ने का इतिहास अपने आप खुल जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina di accesso utilizza tutto lo schermo. Al termine, la cronologia di lettura si aprirà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインページは画面全体に表示されます。完了すると読書履歴が自動的に開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A página de login usa a tela inteira. Ao concluir, o histórico de leitura será aberto automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录页面会使用完整空间，完成后自动进入阅读历史。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmeldpagina is volledig scherm. U wordt naar uw leesgeschiedenis geleid zodra u klaar bent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 페이지는 전체 화면으로 표시됩니다. 작업이 끝나면 읽기 기록으로 이동합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم صفحة تسجيل الدخول الشاشة الكاملة. سيتم نقلك إلى سجل قراءتك عند الانتهاء."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница входа занимает весь экран. После завершения вы перейдёте к истории чтения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona logowania jest wyświetlana na pełnym ekranie. Po zakończeniu zostaniesz przeniesiony do historii czytania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningssidan använder hela skärmen. Du kommer att tas till din läshistorik när du är klar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log-in-siden bruger fuld skærm. Du bliver ført til din læsehistorik, når du er færdig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innloggingssiden bruker hele skjermen. Du kommer tilbake til lesehistorikken når du er ferdig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisäänkirjautumissivu on koko näytön kokoinen. Kun olet valmis, siirryt lukuhistoriaasi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stránka pro přihlášení je na celou obrazovku. Po dokončení budete přesměrováni na historii čtení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σελίδα σύνδεσης χρησιμοποιεί πλήρη οθόνη. Θα μεταφερθείτε στο ιστορικό ανάγνωσης όταν ολοκληρωθεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkező oldal teljes képernyős. A befejezés után az olvasási előzményeire kerül át."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ang pahina ng pag-sign in ng buong screen. Dadalhin ka sa iyong history ng pagbabasa kapag tapos ka na."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דף הכניסה מוצג במסך מלא. תועבר להיסטוריית הקריאה שלך בסיום."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laman daftar masuk menggunakan skrin penuh. Anda akan dibawa ke sejarah membaca apabila selesai."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman masuk menggunakan layar penuh. Anda akan diarahkan ke riwayat membaca setelah selesai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş sayfası tam ekran açılır. İşlemi tamamladığınızda okuma geçmişinize yönlendirilirsiniz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina de autentificare ocupă întregul ecran. Vei fi redirecționat către istoricul de lectură când termini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang đăng nhập hiển thị toàn màn hình. Bạn sẽ được chuyển đến lịch sử đọc khi hoàn tất."
          }
        }
      }
    },
