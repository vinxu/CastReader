        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The YouTube player couldn't initialize, or YouTube temporarily limited caption access. Try again or open the video in YouTube."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor de YouTube no pudo inicializarse o YouTube limitó temporalmente el acceso a los subtítulos. Inténtalo de nuevo o abre el video en YouTube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur YouTube n’a pas pu s’initialiser ou YouTube a temporairement limité l’accès aux sous-titres. Réessayez ou ouvrez la vidéo dans YouTube."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube प्लेयर शुरू नहीं हो सका, या YouTube ने कैप्शन की पहुँच अस्थायी रूप से सीमित कर दी है। फिर कोशिश करें या वीडियो YouTube में खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il player di YouTube non è riuscito ad avviarsi oppure YouTube ha limitato temporaneamente l’accesso ai sottotitoli. Riprova o apri il video in YouTube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube プレーヤーを初期化できなかったか、YouTube により字幕へのアクセスが一時的に制限されています。再試行するか、YouTube で動画を開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player do YouTube não conseguiu iniciar ou o YouTube limitou temporariamente o acesso às legendas. Tente novamente ou abra o vídeo no YouTube."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 播放器未能初始化或暂时限制了字幕访问，请重试或在 YouTube 中打开视频"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De YouTube-speler kon niet worden geïnitieerd, of YouTube heeft tijdelijk de toegang tot ondertitelingen beperkt. Probeer het opnieuw of open de video in YouTube."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تهيئة مشغل YouTube، أو تم تقييد الوصول إلى التسميات التوضيحية مؤقتًا. حاول مرة أخرى أو افتح الفيديو في YouTube."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить плеер YouTube, либо YouTube временно ограничил доступ к субтитрам. Повторите попытку или откройте видео в YouTube."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzacz YouTube nie mógł się zainicjować lub YouTube tymczasowo ograniczył dostęp do napisów. Spróbuj ponownie lub otwórz wideo w aplikacji YouTube."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube-spelaren kunde inte initieras, eller YouTube begränsade tillfälligt tillgången till undertexter. Försök igen eller öppna videon i YouTube."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube-afspilleren kunne ikke starte, eller YouTube har midlertidigt begrænset adgangen til undertekster. Prøv igen, eller åbn videoen i YouTube."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube-spilleren kunne ikke initialiseres, eller YouTube begrenset midlertidig tilgang til undertekster. Prøv igjen eller åpne videoen i YouTube."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube-soitin ei pystynyt käynnistymään tai YouTube rajoitti väliaikaisesti tekstitysten käyttöoikeutta. Yritä uudelleen tai avaa video YouTubessa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrávač YouTube se nepodařilo inicializovat nebo YouTube dočasně omezil přístup k titulkům. Zkuste to znovu nebo otevřete video v YouTube."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η εκκίνηση του προγράμματος αναπαραγωγής YouTube ή το YouTube περιόρισε προσωρινά την πρόσβαση στους υπότιτλους. Δοκιμάστε ξανά ή ανοίξτε το βίντεο στο YouTube."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A YouTube lejátszó nem tudott inicializálódni, vagy a YouTube ideiglenesen korlátozta a feliratok hozzáférését. Próbálja újra, vagy nyissa meg a videót a YouTube-on."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-initialize ang YouTube player, o limitado pansamantala ang access sa caption ng YouTube. Subukan ulit o buksan ang video sa YouTube."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain YouTube tidak dapat dimulakan, atau YouTube telah mengehadkan akses kapsyen buat sementara waktu. Cuba lagi atau buka video dalam YouTube."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Playerul YouTube nu s-a putut inițializa sau YouTube a limitat temporar accesul la subtitrări. Încearcă din nou sau deschide videoclipul în YouTube."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube oynatıcısı başlatılamadı veya YouTube geçici olarak altyazı erişimini kısıtladı. Tekrar deneyin veya videoyu YouTube'da açın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 플레이어를 초기화하지 못했거나 YouTube가 자막 접근을 일시적으로 제한했습니다. 다시 시도하거나 YouTube에서 동영상을 여세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutar YouTube tidak dapat diinisialisasi, atau YouTube sementara membatasi akses subtitle. Coba lagi atau buka video di YouTube."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגן YouTube לא הצליח לפעול, או ש־YouTube הגביל זמנית את הגישה לכתוביות. יש לנסות שוב או לפתוח את הסרטון ב־YouTube."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khởi tạo trình phát YouTube hoặc YouTube tạm thời giới hạn quyền truy cập phụ đề. Hãy thử lại hoặc mở video trong YouTube."
          }
        }
      }
    },
    "YouTube 暂时限制了字幕访问，视频本身可能仍可正常观看；请稍后重试或在 YouTube 中打开": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube schränkt den Zugriff auf Untertitel vorübergehend ein. Das Video selbst lässt sich möglicherweise weiterhin normal ansehen. Versuche es später erneut oder öffne es in YouTube."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube has temporarily limited caption access. The video itself may still play normally. Try again later or open it in YouTube."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ha limitado temporalmente el acceso a los subtítulos. Es posible que el video siga reproduciéndose con normalidad. Inténtalo más tarde o ábrelo en YouTube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube a temporairement limité l’accès aux sous-titres. La vidéo elle-même peut encore être lue normalement. Réessayez plus tard ou ouvrez-la dans YouTube."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ने कैप्शन की पहुँच अस्थायी रूप से सीमित कर दी है। वीडियो अभी भी सामान्य रूप से चल सकता है। बाद में फिर कोशिश करें या इसे YouTube में खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ha limitato temporaneamente l’accesso ai sottotitoli. Il video potrebbe comunque essere riprodotto normalmente. Riprova più tardi o aprilo in YouTube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube により字幕へのアクセスが一時的に制限されています。動画自体は通常どおり視聴できる可能性があります。後でもう一度試すか、YouTube で開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O YouTube limitou temporariamente o acesso às legendas. O vídeo ainda pode ser reproduzido normalmente. Tente novamente mais tarde ou abra-o no YouTube."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 暂时限制了字幕访问，视频本身可能仍可正常观看；请稍后重试或在 YouTube 中打开"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube heeft tijdelijk de toegang tot ondertitelingen beperkt. De video zelf kan mogelijk wel normaal afspelen. Probeer het later opnieuw of open deze in YouTube."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيّد YouTube الوصول إلى التسميات التوضيحية مؤقتًا. قد يظل الفيديو نفسه يعمل بشكل طبيعي. حاول لاحقًا أو افتحه في YouTube."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube временно ограничил доступ к субтитрам. Само видео может воспроизводиться нормально. Попробуйте позже или откройте его в YouTube."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube tymczasowo ograniczył dostęp do napisów. Wideo może nadal działać normalnie. Spróbuj ponownie później lub otwórz je w aplikacji YouTube."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube har tillfälligt begränsat tillgången till undertexter. Videon kan fortfarande spelas normalt. Försök igen senare eller öppna den i YouTube."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube har midlertidigt begrænset adgang til undertekster. Videoen kan stadig afspilles normalt. Prøv igen senere, eller åbn den i YouTube."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube har midlertidig begrenset tilgang til undertekster. Videoen kan likevel spilles normalt. Prøv igjen senere eller åpne den i YouTube."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube on rajoittanut väliaikaisesti tekstitysten käyttöoikeutta. Video voi silti toistua normaalisti. Yritä myöhemmin uudelleen tai avaa se YouTubessa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube dočasně omezil přístup k titulkům. Video samotné může stále běžet normálně. Zkuste to znovu později nebo jej otevřete v YouTube."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στους υπότιτλους έχει περιοριστεί προσωρινά από το YouTube. Το βίντεο μπορεί να παίζει κανονικά. Δοκιμάστε αργότερα ή ανοίξτε το στο YouTube."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A YouTube ideiglenesen korlátozta a feliratok hozzáférését. A videó maga továbbra is normálisan lejátszható. Próbálja később újra, vagy nyissa meg a YouTube-on."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado pansamantala ng YouTube ang access sa caption. Maaaring normal pa ring tumugtog ang video mismo. Subukan ulit mamaya o buksan ito sa YouTube."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube telah mengehadkan akses kapsyen buat sementara waktu. Video itu sendiri mungkin masih boleh dimainkan seperti biasa. Cuba lagi kemudian atau buka dalam YouTube."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube a limitat temporar accesul la subtitrări. Videoclipul poate fi redat în continuare normal. Încearcă mai târziu sau deschide-l în YouTube."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube geçici olarak altyazı erişimini kısıtladı. Video normal şekilde çalışmaya devam edebilir. Daha sonra tekrar deneyin veya YouTube'da açın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube가 자막 접근을 일시적으로 제한했습니다. 동영상 자체는 정상 재생될 수 있습니다. 나중에 다시 시도하거나 YouTube에서 여세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube sementara membatasi akses subtitle. Videonya mungkin masih bisa diputar secara normal. Coba lagi nanti atau buka di YouTube."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube הגביל זמנית את הגישה לכתוביות. ייתכן שהסרטון עצמו עדיין פועל כרגיל. יש לנסות שוב מאוחר יותר או לפתוח אותו ב־YouTube."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube tạm thời giới hạn quyền truy cập phụ đề. Video vẫn có thể phát bình thường. Hãy thử lại sau hoặc mở video trong YouTube."
          }
        }
      }
    },
