    "声音太小，请换一段更清晰、响亮的讲话": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimme ist zu leise. Wähle eine klarere, lautere Sprachaufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice is too quiet. Choose clearer, louder speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz está demasiado baja. Elige un fragmento de voz más claro y alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix est trop faible. Choisissez un extrait de parole plus clair et plus fort."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ बहुत धीमी है। ज़्यादा साफ़ और तेज़ आवाज़ वाला क्लिप चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce è troppo bassa. Scegli un parlato più chiaro e forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声が小さすぎます。より明瞭で大きな声の音声を選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz está muito baixa. Escolha uma fala mais nítida e alta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音太小，请换一段更清晰、响亮的讲话"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stem is te zacht. Kies duidelijkere, hardere spraak."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리가 너무 작습니다. 더 명확하고 큰 소리의 말소리를 선택하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت منخفض جدًا. اختر كلامًا أوضح وأعلى صوتًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос слишком тихий. Выберите более чёткую и громкую речь."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos jest zbyt cichy. Wybierz wyraźniejszą, głośniejszą mowę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rösten är för tyst. Välj tydligare, högre tal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen er for lav. Vælg tydeligere, højere tale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen er for svak. Velg tydeligere, høyere tale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni on liian hiljainen. Valitse selkeämpää ja kovempaa puhetta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlas je příliš tichý. Vyberte srozumitelnější a hlasitější řeč."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωνή είναι πολύ χαμηλόφωνη. Επιλέξτε πιο καθαρή και δυνατή ομιλία."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang túl halk. Válasszon tisztább, hangosabb beszédet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong mahina ang boses. Pumili ng mas malinaw at mas malakas na salita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara terlalu pelan. Pilih ucapan yang lebih jelas dan keras."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara terlalu perlahan. Pilih ucapan yang lebih jelas dan kuat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea este prea încet înregistrată. Alege vorbire mai clară și cu volum mai mare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses çok kısık. Daha net ve yüksek sesli konuşma seçin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקול חלש מדי. יש לבחור דיבור ברור וחזק יותר."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng quá nhỏ. Chọn lời nói rõ hơn và lớn hơn."
          }
        }
      }
    },
    "声音过大并出现失真，请换一段没有破音的讲话": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimme ist zu laut und verzerrt. Wähle eine Aufnahme ohne Übersteuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice is too loud and distorted. Choose speech without clipping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz está demasiado alta y distorsionada. Elige un fragmento sin saturación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix est trop forte et déformée. Choisissez un extrait sans saturation."
