        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبقى حوالي %lld دقيقة و%lld ثانية"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось примерно %lld мин %lld сек"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostało około %lld min. %lld sek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefär %lld min %lld sek kvar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca. %lld min. %lld sek. tilbage"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca. %lld min %lld sek gjenstår"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noin %lld min %lld s jäljellä"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá přibližně %lld min %lld sek"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απομένουν περίπου %lld λεπτά και %lld δευτερόλεπτα"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kb. %lld perc %lld másodperc van hátra"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humigit-kumulang %lld min at %lld sec ang natitira"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
