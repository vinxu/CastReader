    "已上传，处理完成后在「文库」查看": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochgeladen. Nach der Verarbeitung findest du den Inhalt in deiner Bibliothek"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded. You'll find it in your Library once processing is done"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subido. Lo encontrarás en tu biblioteca una vez que finalice el procesamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargé. Vous le trouverez dans votre bibliothèque une fois le traitement terminé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड किया गया. प्रसंस्करण पूरा हो जाने पर आप इसे अपनी लाइब्रेरी में पाएंगे"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricato. Lo troverai nella tua Libreria una volta terminata l'elaborazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードされました。処理が完了すると、ライブラリに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregado. Você o encontrará em sua Biblioteca assim que o processamento for concluído"
          }
        },
