            "value": "Aceasta este pagina oficială WeRead. CastReader nu poate vedea sau stoca contul ori parola ta WeChat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו הדף הרשמי של WeRead. CastReader אינו יכול לראות או לשמור את חשבון WeChat או את הסיסמה שלך."
          }
        }
      }
    },
    "长按下方二维码 → 选择「识别图中二维码」→ 在微信里确认后回到 CastReader": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den QR-Code unten gedrückt → wähle „QR-Code erkennen“ → bestätige in WeChat und kehre zu CastReader zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold the QR code below → choose “Extract QR Code” → confirm in WeChat, then come back to CastReader"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el código QR de abajo → elige «Extraer código QR» → confirma en WeChat y vuelve a CastReader"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur le QR code ci-dessous → choisissez « Extraire le QR code » → confirmez dans WeChat, puis revenez à CastReader"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे दिए QR कोड को दबाकर रखें → “QR कोड पहचानें” चुनें → WeChat में पुष्टि करके CastReader पर लौटें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il codice QR qui sotto → scegli «Estrai codice QR» → conferma in WeChat e torna a CastReader"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の QR コードを長押し →「画像内の QR コードを認識」を選択 → WeChat で確認してから CastReader に戻ってください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure o código QR abaixo → escolha “Extrair código QR” → confirme no WeChat e volte ao CastReader"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按下方二维码 → 选择「识别图中二维码」→ 在微信里确认后回到 CastReader"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de QR-code hieronder ingedrukt → kies 'QR-code extraheren' → bevestig in WeChat, ga daarna terug naar CastReader"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 QR 코드를 길게 누른 후 'QR 코드 추출'을 선택하고 WeChat 에서 확인한 다음 CastReader 로 돌아오세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على رمز QR أدناه، ثم اختر «استخراج رمز QR» وأكّد في WeChat، ثم عُد إلى CastReader"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте QR-код ниже → выберите «Извлечь QR-код» → подтвердите в WeChat, затем вернитесь в CastReader"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj poniższy kod QR → wybierz „Wyodrębnij kod QR” → potwierdź w WeChat, a następnie wróć do CastReader"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll ned QR-koden nedan → välj \"Extrahera QR-kod\" → bekräfta i WeChat, kom sedan tillbaka till CastReader"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold QR-koden nedenfor → vælg \"Udtræk QR-kode\" → bekræft i WeChat, og kom tilbage til CastReader"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nede QR-koden nedenfor → velg «Uttrekk QR-kode» → bekreft i WeChat, og kom tilbake til CastReader"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina ja pidä QR-koodia alla → valitse \"Poimi QR-koodi\" → vahvista WeChatissä → palaa CastReaderiin"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε παρατεταμένα τον παρακάτω κωδικό QR → επιλέξτε «Εξαγωγή κωδικού QR» → επιβεβαιώστε στο WeChat και επιστρέψτε στο CastReader"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindutin at hawakan ang QR code sa ibaba → piliin ang \"Extract QR Code\" → kumpirmahin sa WeChat, pagkatapos ay bumalik sa CastReader"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki QR koduna basılı tutun → \"QR Kodu Çıkart\" seçeneğini seçin → WeChat'te onaylayın, ardından CastReader'a dönün"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ mã QR bên dưới → chọn “Trích xuất Mã QR” → xác nhận trong WeChat, sau đó quay lại CastReader"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte QR kód níže → vyberte „Rozpoznat QR kód“ → potvrďte ve WeChat a vraťte se do CastReader"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva az alábbi QR-kódot → válaszd a QR-kód felismerését → erősítsd meg a WeChatben, majd térj vissza a CastReaderbe"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan tahan kod QR di bawah → pilih “Extract QR Code” → sahkan dalam WeChat, kemudian kembali ke CastReader"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama kode QR di bawah → pilih “Extract QR Code” → konfirmasi di WeChat, lalu kembali ke CastReader"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține apăsat pe codul QR de mai jos → alege „Extrage codul QR” → confirmă în WeChat, apoi revino la CastReader"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ לחיצה ארוכה על קוד ה־QR למטה ← לבחור „חילוץ קוד QR” ← לאשר ב־WeChat, ואז לחזור ל־CastReader"
          }
        }
      }
    },
