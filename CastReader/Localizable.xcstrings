          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour synchroniser votre abonnement et votre quota gratuit entre vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करके अपनी सदस्यता और मुफ़्त कोटा सभी डिवाइस पर सिंक करें।"
