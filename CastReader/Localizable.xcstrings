    "试听暂不可用，请稍后重试": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试听暂不可用，请稍后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview is unavailable. Please try again shortly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在試聴できません。しばらくしてから再試行してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La muestra no está disponible. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’extrait est indisponible. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hörprobe ist nicht verfügbar. Bitte versuche es gleich noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia está indisponível. Tente novamente em instantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anteprima non è disponibile. Riprova tra poco."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी नमूना उपलब्ध नहीं है। थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het luistervoorbeeld is niet beschikbaar. Probeer het over even opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 듣기를 사용할 수 없습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробное прослушивание недоступно. Повторите попытку чуть позже."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz odsłuchać próbki. Spróbuj ponownie za chwilę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Provlyssning är inte tillgänglig. Försök igen om en stund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke høre en prøve lige nu. Prøv igen om et øjeblik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke høre en stemmeprøve nå. Prøv igjen om litt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääninäytettä ei voi kuunnella juuri nyt. Yritä hetken kuluttua uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázku teď nelze přehrát. Zkuste to za chvíli znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η ακρόαση δείγματος αυτή τη στιγμή. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangminta most nem játszható le. Próbálja újra később."
          }
        },
        "fil": {
          "stringUnit": {
