    "这是 Amazon 官方页面。CastReader 看不到，也不会保存你的密码。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die offizielle Amazon-Seite. CastReader kann dein Passwort weder sehen noch speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is Amazon’s official page. CastReader cannot see or save your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la página oficial de Amazon. CastReader no puede ver ni guardar tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est la page officielle d’Amazon. CastReader ne peut ni voir ni enregistrer votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Amazon का आधिकारिक पेज है। CastReader आपका पासवर्ड न देख सकता है, न सहेज सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è la pagina ufficiale di Amazon. CastReader non può vedere né salvare la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはAmazonの公式ページです。CastReaderがパスワードを見たり保存したりすることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a página oficial da Amazon. O CastReader não pode ver nem salvar sua senha."
