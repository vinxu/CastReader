          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपकरण अनलॉक है; क्रॉस-प्लेटफ़ॉर्म सिंक Apple सत्यापन की प्रतीक्षा कर रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è sbloccato; la sincronizzazione multipiattaforma è in attesa della verifica di Apple."
          }
