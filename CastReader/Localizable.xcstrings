            "value": "Página del libro Kindle abierta. Regrese a la Biblioteca Kindle y luego Sincronice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page du livre Kindle ouverte. Revenez à la bibliothèque Kindle, puis synchronisez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किंडल किताब का पेज खुला। किंडल लाइब्रेरी पर लौटें, फिर सिंक करें।"
          }
        },
        "it": {
          "stringUnit": {
