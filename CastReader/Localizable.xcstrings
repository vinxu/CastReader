    "书架已同步，但 Kindle 未能打开这本书。请重试或返回书架。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library was synced, but Kindle could not open this book. Try again or return to the library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリは同期されましたが、Kindle はこの本を開くことができませんでした。もう一度試すか、ライブラリに戻ってください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su biblioteca se sincronizó, pero Kindle no pudo abrir este libro. Inténtalo de nuevo o regresa a la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque a été synchronisée, mais Kindle n'a pas pu ouvrir ce livre. Réessayez ou retournez à la bibliothèque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca foi sincronizada, mas o Kindle não conseguiu abrir este livro. Tente novamente ou volte para a biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è stata sincronizzata, ma Kindle non è riuscito ad aprire questo libro. Riprova o torna in biblioteca."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी सिंक हो गई थी, लेकिन किंडल इस किताब को नहीं खोल सका। पुनः प्रयास करें या लाइब्रेरी में वापस लौटें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架已同步，但 Kindle 未能打开这本书。请重试或返回书架。"
          }
        }
      }
    },
