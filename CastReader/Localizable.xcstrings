    "微信读书书籍链接已失效，请重新登录并同步书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser WeRead-Buchlink ist abgelaufen. Melde dich erneut an und synchronisiere deine Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This WeRead book link has expired. Sign in again and sync your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de este libro de WeRead ha caducado. Vuelve a iniciar sesión y sincroniza tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien de ce livre WeRead a expiré. Reconnectez-vous et synchronisez votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस WeRead किताब का लिंक समाप्त हो गया है। फिर से साइन इन करके लाइब्रेरी सिंक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link di questo libro WeRead è scaduto. Accedi di nuovo e sincronizza la libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この WeRead の本のリンクは無効です。再度ログインして本棚を同期してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link deste livro do WeRead expirou. Entre novamente e sincronize sua biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微信读书书籍链接已失效，请重新登录并同步书架。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link naar een WeRead-boek is verlopen. Meld u opnieuw aan en synchroniseer uw bibliotheek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 WeRead 책 링크가 만료되었습니다. 다시 로그인하여 라이브러리를 동기화하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رابط كتاب WeRead هذا. سجّل الدخول مرة أخرى وقم بمزامنة مكتبتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка на книгу WeRead устарела. Войдите снова и синхронизируйте библиотеку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link do książki WeRead wygasł. Zaloguj się ponownie i zsynchronizuj swoją bibliotekę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länken till denna WeRead-bok har löpt ut. Logga in igen och synkronisera ditt bibliotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette WeRead-boglink er udløbet. Log ind igen og synkroniser dit bibliotek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenken til denne WeRead-boken har utløpt. Logg inn på nytt og synkroniser biblioteket ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä WeRead-kirjan linkki on vanhentunut. Kirjaudu sisään uudelleen ja synkronoi kirjastosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz na tuto knihu WeRead vypršel. Znovu se přihlaste a synchronizujte svou knihovnu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο σύνδεσμος αυτού του βιβλίου WeRead έχει λήξει. Συνδεθείτε ξανά και συγχρονίστε τη βιβλιοθήκη σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a WeRead könyvlink lejárt. Jelentkezzen be újra, és szinkronizálja a könyvtárát."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire na ang link ng aklat na ito sa WeRead. Mag-sign in at i-sync muli ang iyong aklatan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan buku WeRead ini telah kedaluwarsa. Masuk kembali dan sinkronkan perpustakaan Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu WeRead kitap bağlantısının süresi doldu. Tekrar giriş yapın ve kitaplığınızı senkronize edin."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan buku WeRead ini telah tamat tempoh. Log masuk semula dan segerakkan pustaka anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest link către cartea WeRead a expirat. Conectează-te din nou și sincronizează biblioteca."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף הקישור לספר WeRead הזה פג. יש להיכנס שוב ולסנכרן את הספרייה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết sách WeRead này đã hết hạn. Đăng nhập lại và đồng bộ thư viện."
          }
        }
      }
    },
