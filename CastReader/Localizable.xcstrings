          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at synkronisere Pro og forbrug på tværs af enheder"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn for å synkronisere Pro og bruk på tvers av enheter"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sisään synkronoidaksesi Pro-tilauksen ja käyttötiedot laitteiden välillä"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
