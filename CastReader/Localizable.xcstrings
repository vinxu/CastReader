    "在 O’Reilly 打开过的书会在重新同步后显示在这里。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In O’Reilly geöffnete Bücher werden nach der nächsten Synchronisierung hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books you open in O’Reilly will appear here after you sync again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros que abras en O’Reilly aparecerán aquí después de volver a sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les livres ouverts dans O’Reilly apparaîtront ici après la prochaine synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reilly में खोली गई किताबें दोबारा सिंक करने के बाद यहाँ दिखाई देंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I libri aperti in O’Reilly verranno visualizzati qui dopo la nuova sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reilly で開いた本は、再同期するとここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os livros que você abrir na O’Reilly aparecerão aqui após uma nova sincronização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 O’Reilly 打开过的书会在重新同步后显示在这里。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boeken die u opent in O'Reilly verschijnen hier nadat u opnieuw hebt gesynchroniseerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reilly에서 연 책은 다시 동기화하면 여기에 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الكتب التي تفتحها في O’Reilly هنا بعد مزامنتها مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Книги, которые вы открываете в O’Reilly, появятся здесь после повторной синхронизации."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Książki otwierane w O’Reilly pojawią się tutaj po ponownej synchronizacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böcker du öppnar i O'Reilly visas här efter att du synkroniserar igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøger, du åbner i O'Reilly, vises her efter næste synkronisering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøker du åpner i O’Reilly vises her etter at du synkroniserer igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reillyssä avaamasi kirjat näkyvät täällä synkronoinnin jälkeen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihy, které otevřete v O'Reilly, se zde objeví po další synchronizaci."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα βιβλία που ανοίγετε στο O'Reilly θα εμφανιστούν εδώ μετά τον ξανασυγχρονισμό."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga aklat na buksan mo sa O'Reilly ay makikita dito pagkatapos mag-sync muli."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cărțile pe care le deschizi în O’Reilly vor apărea aici după ce vei sincroniza din nou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các sách bạn mở trong O’Reilly sẽ xuất hiện ở đây sau khi bạn đồng bộ lại."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az O’Reillyben megnyitott könyvek újabb szinkronizálás után jelennek meg itt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku yang anda buka dalam O’Reilly akan muncul di sini selepas anda menyegerakkan semula."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku yang Anda buka di O’Reilly akan muncul di sini setelah Anda menyinkronkan kembali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reilly'de açtığınız kitaplar, yeniden eşitledikten sonra burada görünür."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרים שנפתחים ב־O’Reilly יופיעו כאן לאחר הסנכרון הבא."
          }
        }
      }
    },
    "在图片上拖动框选一篇文章，或直接读整页": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Rahmen um einen Artikel – oder lesen Sie die ganze Seite"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a box around one article, or just read the whole page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un recuadro sobre un artículo o lee la página completa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encadrez un article par glissement, ou lisez toute la page"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी एक लेख के चारों ओर बॉक्स खींचें, या पूरा पेज पढ़ें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un riquadro attorno a un articolo, oppure leggi tutta la pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事を囲むようにドラッグするか、ページ全体を読み上げます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma caixa em volta de um artigo ou leia a página inteira"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图片上拖动框选一篇文章，或直接读整页"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een kader rond één artikel, of lees gewoon de hele pagina"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 기사 주위에 박스를 드래그하거나 전체 페이지를 읽으세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب مربعًا حول مقال واحد، أو اقرأ الصفحة كاملة"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обведите рамкой одну статью или прочитайте всю страницу целиком"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz obszar wokół jednego artykułu lub przeczytaj całą stronę"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra en ruta runt en artikel, eller läs hela sidan"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk en boks omkring én artikel, eller læs hele siden"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn en boks rundt én artikkel, eller les hele siden"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raahaa laatikko yhden artikkelin ympärille tai lue koko sivu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obkreslete obdélníkem jeden článek, nebo si přečtěte celou stránku"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε ένα πλαίσιο γύρω από ένα άρθρο ή απλώς διαβάστε ολόκληρη τη σελίδα"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-drag ang kahon sa isang artikulo, o basahin lang ang buong pahina"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasează un chenar în jurul unui articol sau citește întreaga pagină"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo một khung quanh một bài viết, hoặc chỉ cần đọc toàn bộ trang"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölj ki egy cikket egy kerettel, vagy olvasd el az egész oldalt"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret kotak mengelilingi satu artikel, atau baca seluruh halaman"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret kotak mengelilingi satu artikel, atau baca seluruh halaman"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir yazının etrafına kutu çizin veya sayfanın tamamını okuyun"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לגרור מסגרת סביב מאמר אחד, או פשוט לקרוא את העמוד כולו"
          }
        }
      }
    },
    "在首页拍摄、上传、输入网址或文本，处理过的内容会出现在这里": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende auf der Startseite Kamera, Datei hochladen, URL eingeben oder Text eingeben – verarbeitete Inhalte erscheinen hier"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Camera, Upload File, Enter URL, or Enter Text on Home — processed content shows up here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use la cámara, cargue un archivo, ingrese una URL o ingrese texto en Inicio: el contenido procesado se muestra aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser l'appareil photo, télécharger un fichier, saisir une URL ou saisir du texte sur l'accueil : le contenu traité s'affiche ici"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा का उपयोग करें, फ़ाइल अपलोड करें, यूआरएल दर्ज करें, या होम पर टेक्स्ट दर्ज करें - संसाधित सामग्री यहां दिखाई देती है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fotocamera, carica file, inserisci URL o inserisci testo nella home page: i contenuti elaborati vengono visualizzati qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームでカメラを使用、ファイルをアップロード、URL を入力、またはテキストを入力 - 処理されたコンテンツがここに表示されます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use câmera, fazer upload de arquivo, inserir URL ou inserir texto na página inicial – o conteúdo processado aparece aqui"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在首页拍摄、上传、输入网址或文本，处理过的内容会出现在这里"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Camera, Bestand uploaden, URL invoeren of Tekst invoeren op Start — verwerkte inhoud wordt hier weergegeven"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈에서 카메라 사용, 파일 업로드, URL 입력 또는 텍스트 입력을 하세요. 처리된 콘텐츠가 여기에 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الكاميرا أو رفع ملف أو إدخال رابط أو إدخال نص من الشاشة الرئيسية — سيظهر المحتوى المعالج هنا"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте камеру, загрузите файл, введите URL или текст на главной странице — обработанный контент появится здесь"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj aparatu, prześlij plik, wprowadź adres URL lub wpisz tekst na stronie głównej — przetworzona treść pojawi się tutaj"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Kamera, Ladda upp fil, Ange URL eller Ange text på Hem – bearbetat innehåll visas här"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Kamera, Upload fil, Indtast URL eller Indtast tekst på Hjem – behandlet indhold vises her"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk Kamera, Last opp fil, Angi URL eller Skriv inn tekst på Hjem – behandlet innhold vises her"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kotinäytöllä Kameraa, Tiedoston latausta, URL-osoitteen syöttöä tai Tekstin syöttöä — käsitelty sisältö näkyy tässä"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte Fotoaparát, Nahrajte soubor, Zadejte URL nebo Zadejte text na domovské obrazovce – zpracovaný obsah se zobrazí zde"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε Κάμερα, Ανέβασμα Αρχείου, Εισαγωγή URL ή Εισαγωγή Κειμένου στην Αρχική Οθόνη — το επεξεργασμένο περιεχόμενο θα εμφανιστεί εδώ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang Kamera, I-upload ang File, Ilagay ang URL, o Ilagay ang Teksto sa Home. Lalabas dito ang naprosesong nilalaman."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește Camera, Încarcă fișier, Introdu URL sau Introdu text pe pagina principală — conținutul procesat va apărea aici"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng Camera, Tải lên tệp, Nhập URL hoặc Nhập văn bản trên Trang chủ — nội dung đã xử lý sẽ hiển thị ở đây"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezdőlapon használd a kamerát, a fájlfeltöltést, az URL- vagy szövegbevitelt. A feldolgozott tartalom itt jelenik meg"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Kamera, Muat Naik Fail, Masukkan URL atau Masukkan Teks di Utama — kandungan yang diproses akan muncul di sini"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Kamera, Unggah File, Masukkan URL, atau Masukkan Teks di Beranda — konten yang diproses akan muncul di sini"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Sayfa'da Kamera, Dosya Yükle, URL Gir veya Metin Gir seçeneklerini kullanın — işlenen içerik burada görünür"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשתמש במצלמה, בהעלאת קובץ, בהזנת כתובת או בהזנת טקסט בדף הבית — התוכן המעובד יופיע כאן"
          }
        }
      }
    },
