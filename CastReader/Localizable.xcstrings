            "value": "A hangszolgáltatás frissítése folyamatban van. Kérjük, próbálkozzon később."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabago ang serbisyo ng boses. Subukan ulit mamaya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul vocal este în curs de actualizare. Încearcă din nou mai târziu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 서비스를 업데이트하는 중입니다. 나중에 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan suara sedang dikemas kini. Sila cuba lagi kemudian."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan suara sedang diperbarui. Silakan coba lagi nanti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses hizmeti güncelleniyor. Lütfen daha sonra yeniden deneyin."
