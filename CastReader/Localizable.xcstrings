    "已暂停，已保存页面会保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停，已保存页面会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused. Saved pages have been kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止しました。保存済みページは残っています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa. Las páginas guardadas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause. Les pages enregistrées sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert. Gespeicherte Seiten bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado. As páginas salvas foram mantidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa. Le pagine salvate vengono conservate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रुका हुआ है। सहेजे गए पन्ने बने हुए हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd. Bewaarde pagina's zijn behouden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시중지됨. 저장된 페이지가 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановлено. Сохранённые страницы оставлены."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane. Zapisane strony zostały zachowane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausad. Sparade sidor har bevarats."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat på pause. Gemte sider er bevaret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauset. Lagrede sider er beholdt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauolla. Tallennetut sivut on säilytetty."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno. Uložené stránky byly zachovány."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παύση. Οι αποθηκευμένες σελίδες έχουν διατηρηθεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve. A mentett oldalak megmaradtak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause. Naka-save ang mga pahina."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושהה. הדפים שכבר נשמרו יישארו זמינים."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În pauză. Paginile salvate au fost păstrate."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإيقاف مؤقتًا. تم الاحتفاظ بالصفحات المحفوظة."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda. Halaman yang disimpan dikekalkan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda. Halaman yang tersimpan telah dipertahankan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı. Kaydedilen sayfalar korundu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng. Các trang đã lưu được giữ lại."
          }
        }
      }
    },
    "上次下载未完成，已保存页面会保留。可以继续下载。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次下载未完成，已保存页面会保留。可以继续下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous download did not finish. Saved pages are kept, and you can continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のダウンロードは未完了です。保存済みページは残っており、続きから保存できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga anterior no terminó. Las páginas guardadas se conservan y puedes continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement précédent est incomplet. Les pages enregistrées sont conservées et vous pouvez reprendre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Download wurde nicht abgeschlossen. Gespeicherte Seiten bleiben erhalten; du kannst fortsetzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download anterior não terminou. As páginas salvas foram mantidas e você pode continuar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download precedente non è terminato. Le pagine salvate sono conservate e puoi riprendere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछला डाउनलोड पूरा नहीं हुआ। सहेजे गए पन्ने बने हुए हैं और आप डाउनलोड जारी रख सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige download is niet voltooid. Bewaarde pagina's zijn behouden en u kunt doorgaan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая загрузка не завершена. Сохранённые страницы остаются, можно продолжить."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzednie pobieranie nie zostało ukończone. Zapisane strony są dostępne i możesz kontynuować."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den förra nedladdningen slutfördes inte. Sparade sidor finns kvar, och du kan fortsätta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det foregående download blev ikke fuldført. Gemte sider beholdes, og du kan fortsætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forrige nedlastingen ble ikke fullført. Lagrede sider beholdes, og du kan fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellinen lataus ei valmistunut. Tallennetut sivut on säilytetty, ja voit jatkaa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí stažení nebylo dokončeno. Uložené stránky jsou zachovány a můžete pokračovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προηγούμενη λήψη δεν ολοκληρώθηκε. Οι αποθηκευμένες σελίδες διατηρούνται και μπορείτε να συνεχίσετε."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előző letöltés nem fejeződött be. A mentett oldalak megmaradnak, és folytathatja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tapos ang nakaraang download. Naka-save ang mga pahina, at maaari kang magpatuloy."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההורדה הקודמת לא הושלמה. הדפים שכבר נשמרו יישארו זמינים, וניתן להמשיך בהורדה."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcarea anterioară nu s-a finalizat. Paginile salvate sunt păstrate și poți continua."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل التنزيل السابق. تم الاحتفاظ بالصفحات المحفوظة، ويمكنك المتابعة."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 다운로드가 완료되지 않았습니다. 저장된 페이지는 유지되며 이어서 다운로드할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun sebelumnya tidak selesai. Halaman yang disimpan dikekalkan dan anda boleh meneruskannya."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengunduhan sebelumnya belum selesai. Halaman tersimpan dipertahankan dan Anda dapat melanjutkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki indirme tamamlanmadı. Kaydedilen sayfalar korundu; devam edebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần tải trước chưa hoàn tất. Các trang đã lưu được giữ lại và bạn có thể tiếp tục."
          }
        }
      }
    },
