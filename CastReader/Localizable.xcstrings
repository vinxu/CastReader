    "如果已经看到 Kindle 书架，请点同步。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine Kindle-Bibliothek angezeigt wird, tippe auf Synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you see your Kindle library, tap Sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ve su biblioteca Kindle, toque Sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous voyez votre bibliothèque Kindle, appuyez sur Synchroniser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप अपनी किंडल लाइब्रेरी देखते हैं, तो सिंक पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vedi la tua libreria Kindle, tocca Sincronizza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle ライブラリが表示されたら、「同期」をタップします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você vir sua biblioteca Kindle, toque em Sincronizar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已经看到 Kindle 书架，请点同步。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u uw Kindle-bibliotheek ziet, tikt u op Synchroniseren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle 라이브러리가 보이면 '동기화'를 탭하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا رأيت مكتبة Kindle الخاصة بك، فانقر على مزامنة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы видите свою библиотеку Kindle, нажмите «Синхронизировать»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli widzisz swoją bibliotekę Kindle, dotknij Synchronizuj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du ser ditt Kindle-bibliotek, tryck på Synkronisera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ser dit Kindle-bibliotek, skal du trykke på Synkroniser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ser biblioteket ditt på Kindle, trykk på Synkroniser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos näet Kindle-kirjastosi, napauta Synkronoi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud vidíte svou knihovnu Kindle, klepněte na Synchronizovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν βλέπετε τη βιβλιοθήκη Kindle, πατήστε Συγχρονισμός."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung nakikita mo ang iyong Kindle aklatan, i-tap ang Sync."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă vezi biblioteca ta Kindle, apasă Sincronizează."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn thấy thư viện Kindle, hãy chạm vào Đồng bộ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha látod a Kindle-könyvtáradat, koppints a Szinkronizálásra."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda melihat pustaka Kindle anda, ketik Segerakkan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pustaka Kindle Anda terlihat, ketuk Sinkronkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle kitaplığınızı görüyorsanız Eşitle'ye dokunun."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם ספריית Kindle שלך מוצגת, יש להקיש על סנכרון."
          }
        }
      }
    },
