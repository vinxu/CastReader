    "请先登录 Google 账号，登录后会自动进入书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zuerst bei Google an – dein Regal öffnet sich danach automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Google first — your shelf opens automatically afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero inicia sesión en Google; tu estantería se abrirá automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d'abord à Google : votre bibliothèque s'ouvrira automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले Google में साइन इन करें — उसके बाद आपकी शेल्फ़ अपने आप खुल जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi prima a Google: la tua libreria si aprirà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に Google にログインしてください。ログイン後、自動的に本棚が開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login no Google primeiro; sua estante abre automaticamente depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录 Google 账号，登录后会自动进入书架。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log eerst in bij Google – uw plank wordt daarna automatisch geopend."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى Google أولًا؛ سيفتح رف كتبك تلقائيًا بعد ذلك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала войдите в Google — затем ваша полка откроется автоматически."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się najpierw do Google — Twoja półka otworzy się automatycznie później."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på Google först – din bokhylla öppnas automatiskt därefter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på Google først – din hylde åbnes automatisk derefter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn på Google først – hyllen åpnes automatisk deretter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu ensin Googleen — hyllysi avautuu sen jälkeen automaattisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve se přihlaste k Google – poté se vaše police automaticky otevře."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε πρώτα στο Google — η βιβλιοθήκη σας θα ανοίξει αυτόματα στη συνέχεια."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be először Google-fiókba – ezután automatikusan megnyílik a polca."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in muna sa Google. Pagkatapos, awtomatikong bubukas ang iyong estante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke Google terlebih dahulu — rak buku Anda akan terbuka secara otomatis setelahnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk ke Google dahulu — rak anda akan dibuka secara automatik selepas itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập Google trước — kệ sách sẽ mở tự động sau đó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Google에 로그인하세요. 로그인 후 서재가 자동으로 열립니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Google'a giriş yapın — ardından kitaplığınız otomatik olarak açılır."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te mai întâi la Google — biblioteca se va deschide automat după aceea."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להיכנס תחילה ל־Google — מדף הספרים ייפתח אוטומטית לאחר מכן."
          }
        }
      }
    },
