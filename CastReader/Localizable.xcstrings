        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bibliotheek is gewijzigd. Synchroniseer opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리가 변경되었습니다. 다시 동기화하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير المكتبة. يرجى المزامنة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека изменилась. Синхронизируйте её снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka uległa zmianie. Zsynchronizuj ją ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket har ändrats. Synkronisera igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket er ændret. Synkroniser igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket har endret seg. Vennligst synkroniser igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjasto on muuttunut. Synkronoi uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna se změnila. Synchronizujte ji znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βιβλιοθήκη έχει αλλάξει. Συγχρονίστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyvtár megváltozott. Kérjük, szinkronizáljon újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang aklatan. Mag-sync muli."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה השתנתה. נא לסנכרן שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka telah berubah. Sila segerakkan semula."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka telah berubah. Silakan sinkronkan kembali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplık değişti. Lütfen yeniden eşitleyin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca s-a schimbat. Sincronizează din nou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện đã thay đổi. Vui lòng đồng bộ lại."
          }
        }
      }
    },
