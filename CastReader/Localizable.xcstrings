    "Debug only：测试锁屏后 WebView 是否还能滚动": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug only: test whether WebView can keep scrolling after the phone is locked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグのみ: 電話がロックされた後も WebView がスクロールを継続できるかどうかをテストします。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo depurar: pruebe si WebView puede seguir desplazándose después de que el teléfono esté bloqueado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débogage uniquement : testez si WebView peut continuer à défiler une fois le téléphone verrouillé"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente depuração: teste se o WebView pode continuar rolando depois que o telefone for bloqueado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo debug: verifica se WebView può continuare a scorrere dopo che il telefono è bloccato"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल डीबग करें: परीक्षण करें कि फ़ोन लॉक होने के बाद WebView स्क्रॉल करना जारी रख सकता है या नहीं"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug only：测试锁屏后 WebView 是否还能滚动"
          }
        }
      }
    },
