          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taltjänsten har nått sin dagliga gräns. Försök igen senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taletjenesten har nået sin daglige grænse. Prøv igen senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taletjenesten har nådd sin daglige grense. Prøv igjen senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhepalvelun päiväraja on saavutettu. Yritä myöhemmin uudelleen."
