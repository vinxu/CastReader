    "未能在 Kindle 书架找到这本书，请手动同步书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Buch wurde in deiner Kindle-Bibliothek nicht gefunden. Bitte synchronisiere die Bibliothek manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book could not be found in your Kindle library. Please sync the library manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este libro no se pudo encontrar en su biblioteca Kindle. Sincronice la biblioteca manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce livre est introuvable dans votre bibliothèque Kindle. Veuillez synchroniser la bibliothèque manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पुस्तक आपकी किंडल लाइब्रेरी में नहीं मिल सकी। कृपया लाइब्रेरी को मैन्युअल रूप से सिंक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare questo libro nella tua libreria Kindle. Si prega di sincronizzare la libreria manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本は Kindle ライブラリに見つかりませんでした。ライブラリを手動で同期してください。"
