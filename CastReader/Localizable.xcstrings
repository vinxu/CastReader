    "播放时会在本机识别文字并匹配朗读声音。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放时会在本机识别文字并匹配朗读声音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you play, text is recognized on this device and a matching voice is selected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生時にこの端末で文字を認識し、対応する音声を選択します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reproducir, el texto se reconoce en este dispositivo y se selecciona una voz adecuada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la lecture, le texte est reconnu sur cet appareil et une voix adaptée est sélectionnée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abspielen wird der Text auf diesem Gerät erkannt und eine passende Stimme gewählt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao reproduzir, o texto é reconhecido neste dispositivo e uma voz adequada é selecionada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla riproduzione, il testo viene riconosciuto su questo dispositivo e viene selezionata una voce adatta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चलाने पर टेक्स्ट इसी डिवाइस पर पहचाना जाता है और उसके लिए उपयुक्त आवाज़ चुनी जाती है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer u afspeelt, wordt tekst op dit apparaat herkend en wordt een bijpassende stem geselecteerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생하면 이 기기에서 텍스트가 인식되고 일치하는 음성이 선택됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При воспроизведении текст распознаётся на устройстве, и выбирается подходящий голос."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas odtwarzania tekst jest rozpoznawany na tym urządzeniu i wybierany pasujący głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du startar uppspelningen identifieras texten på enheten och en lämplig röst väljs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du afspiller, genkendes tekst på enheden, og en matchende stemme vælges."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du spiller av, gjenkjennes tekst på denne enheten og en passende stemme velges."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiston aikana teksti tunnistetaan laitteella ja vastaava ääni valitaan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při přehrávání se text rozpozná na tomto zařízení a vybere se odpovídající hlas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ξεκινάτε την αναπαραγωγή, το κείμενο αναγνωρίζεται σε αυτή τη συσκευή και επιλέγεται η κατάλληλη φωνή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejátszáskor a szöveg felismerésre kerül az eszközön, és illeszkedő hangot választunk ki."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag nag-play ka, kikilalanin ang teksto sa device na ito at pipili ng angkop na boses."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בעת ההשמעה, הטקסט מזוהה במכשיר זה ונבחר קול מתאים."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când redai, textul este recunoscut pe acest dispozitiv și se selectează o voce potrivită."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التشغيل، يُتعرّف على النص على هذا الجهاز ويُختار صوت مناسب."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda memainkan audio, teks dikenal pasti pada peranti ini dan suara yang sepadan dipilih."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda memutar, teks dikenali di perangkat ini dan suara yang sesuai dipilih."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynattığınızda metin bu cihazda tanınır ve uygun bir ses seçilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn phát, văn bản được nhận dạng trên thiết bị này và giọng phù hợp được chọn."
          }
        }
      }
    },
