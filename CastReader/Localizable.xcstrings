            "state": "translated",
            "value": "Dopo l’accesso continueremo automaticamente. Non serve toccare altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン後は自動で次へ進みます。追加のタップは不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuaremos automaticamente depois do login. Não é preciso tocar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录成功后会自动继续，无需再点按钮。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We gaan automatisch verder na uw aanmelding. Geen extra tik nodig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنستمر تلقائيًا بعد تسجيل الدخول. لا حاجة للنقر الإضافي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
