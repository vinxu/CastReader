    "声音太小，请靠近手机并重新录制": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme ist zu leise. Gehe näher ans Telefon und nimm erneut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice is too quiet. Move closer to the phone and record again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz está demasiado baja. Acércate al teléfono y vuelve a grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix est trop faible. Rapprochez-vous du téléphone et réenregistrez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आवाज़ बहुत धीमी है। फ़ोन के पास आकर फिर से रिकॉर्ड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce è troppo bassa. Avvicinati al telefono e registra di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声が小さすぎます。端末に近づいて録音し直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua voz está muito baixa. Aproxime-se do telefone e grave novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音太小，请靠近手机并重新录制"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw stem is te zacht. Kom dichter bij de telefoon en neem opnieuw op."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوتك منخفض جدًا. اقترب من الهاتف وسجّل مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос слишком тихий. Подойдите ближе к телефону и запишите снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój głos jest zbyt cichy. Zbliż się do telefonu i nagraj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din röst är för svag. Kom närmare telefonen och spela in igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stemme er for lav. Kom tættere på telefonen og optag igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen din er for svak. Kom nærmere telefonen og ta opptaket på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänesi on liian hiljainen. Siirry lähemmäs puhelinta ja tallenna uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlas je příliš tichý. Přibližte se k telefonu a nahrávku opakujte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωνή σας είναι πολύ χαμηλή. Πλησιάστε το τηλέφωνο και ηχογραφήστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangja túl halk. Közelebb lépve a telefonhoz rögzítse újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong mahina ang iyong boses. Lumapit sa telepono at magrekord muli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara Anda terlalu pelan. Mendekatlah ke ponsel dan rekam lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara anda terlalu perlahan. Dekatkan diri ke telefon dan rakam semula."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리가 너무 작습니다. 휴대폰에 더 가까이 대고 다시 녹음하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiniz çok kısık. Telefona yaklaşın ve yeniden kaydedin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea ta este prea slabă. Apropie-te de telefon și înregistrează din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקול שלך חלש מדי. יש להתקרב לטלפון ולהקליט שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng của bạn quá nhỏ. Hãy đến gần điện thoại hơn rồi thu âm lại."
          }
        }
      }
    },
    "声音过大并出现失真，请稍微远离手机重新录制": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist zu laut und verzerrt. Gehe etwas weiter vom Telefon weg und nimm erneut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is too loud and distorted. Move slightly farther from the phone and record again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación está demasiado alta y distorsionada. Aléjate un poco del teléfono y vuelve a grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement est trop fort et saturé. Éloignez-vous légèrement du téléphone et réenregistrez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग बहुत तेज़ और विकृत है। फ़ोन से थोड़ा दूर होकर फिर से रिकॉर्ड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è troppo forte e distorta. Allontanati leggermente dal telefono e registra di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音が大きすぎて歪んでいます。端末から少し離れて録音し直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação está muito alta e distorcida. Afaste-se um pouco do telefone e grave novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音过大并出现失真，请稍微远离手机重新录制"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is te luid en vervormd. Beweeg iets verder weg van de telefoon en neem opnieuw op."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت مرتفع ومشوّه. ابتعد قليلًا عن الهاتف وسجّل مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись слишком громкая и искажённая. Отойдите немного дальше от телефона и запишите снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie jest zbyt głośne i zniekształcone. Odsuń się nieco od telefonu i nagraj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen är för hög och förvrängd. Flytta dig lite längre bort från telefonen och spela in igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen er for høj og forvrænget. Flyt dig lidt længere væk fra telefonen og optag igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket er for høyt og forvrengt. Flytt deg litt lenger bort fra telefonen og ta opptaket på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenne on liian kova ja vääristynyt. Siirry hieman kauemmas puhelimesta ja tallenna uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka je příliš hlasitá a zkreslená. Odstupte od telefonu o trochu dál a nahrávku opakujte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ηχογράφηση είναι πολύ δυνατή και παραμορφωμένη. Απομακρυνθείτε λίγο από το τηλέφωνο και ηχογραφήστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel túl hangos és torzult. Húzódjon kicsit hátrébb a telefontól, majd rögzítse újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong malakas at distorted ang rekording. Lumayo ka nang kaunti mula sa telepono at magrekord muli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman terlalu keras dan terdistorsi. Mundur sedikit dari ponsel dan rekam lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman terlalu kuat sehingga bunyinya herot. Jauhkan diri sedikit daripada telefon dan rakam semula."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 소리가 너무 커서 왜곡되었습니다. 휴대폰에서 조금 떨어져 다시 녹음하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt çok yüksek sesli ve bozulmuş. Telefondan biraz uzaklaşıp yeniden kaydedin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea este prea puternică și distorsionată. Îndepărtează-te puțin de telefon și înregistrează din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה חזקה ומעוותת מדי. יש להתרחק מעט מהטלפון ולהקליט שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản thu quá lớn và bị méo tiếng. Hãy ra xa điện thoại một chút rồi thu âm lại."
          }
        }
      }
    },
    "录音中可能有多人说话，请确保只有本人朗读": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise sprechen mehrere Personen. Nimm erneut auf, während nur du liest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one person may be speaking. Record again with only you reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede haber más de una persona hablando. Vuelve a grabar leyendo solo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs personnes semblent parler. Réenregistrez avec votre voix uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग में एक से अधिक लोग बोल रहे हो सकते हैं। केवल अपनी आवाज़ में फिर से रिकॉर्ड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbero parlare più persone. Registra di nuovo facendo leggere solo te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数人の声が含まれている可能性があります。本人だけで録音し直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode haver mais de uma pessoa falando. Grave novamente apenas com a sua voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中可能有多人说话，请确保只有本人朗读"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er spreken mogelijk meerdere personen. Neem opnieuw op en zorg dat alleen u voorleest."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون هناك أكثر من شخص يتحدث. سجّل مرة أخرى وأنت تقرأ وحدك فقط."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, в записи говорят несколько человек. Запишите снова так, чтобы читали только вы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W nagraniu może mówić więcej niż jedna osoba. Nagraj ponownie tak, aby było słychać tylko Twój głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan vara fler än en person som talar. Spela in igen med endast dig som läser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måske taler flere personer. Optag igen med kun dig, der læser op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan være flere som snakker. Ta opptaket på nytt mens bare du leser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenteessa saattaa puhua useampi henkilö. Äänitä uudelleen niin, että vain sinä luet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V nahrávce může mluvit více lidí. Nahrajte ji znovu tak, aby byl slyšet pouze váš hlas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενδέχεται να μιλούν περισσότερα από ένα άτομα. Ηχογραφήστε ξανά, με μόνο εσάς να διαβάζετε."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Több személy is beszélhet. Rögzítse újra úgy, hogy csak Ön olvasson."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring higit sa isang tao ang nagsasalita. Magrekord muli na ikaw lamang ang nagbabasa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin ada lebih dari satu orang yang berbicara. Rekam lagi dengan hanya Anda yang membaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin lebih daripada seorang sedang bercakap. Rakam semula dengan hanya anda yang membaca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 사람의 목소리가 들리는 것 같습니다. 혼자 읽는 목소리만 다시 녹음하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla kişi konuşuyor olabilir. Yalnızca sizin okuduğunuz bir kayıt yapın."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil să vorbească mai multe persoane. Înregistrează din nou, doar cu vocea ta citind."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שיותר מאדם אחד מדבר. יש להקליט שוב כשנשמע רק הקול שלך בקריאה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể có nhiều người đang nói. Hãy thu âm lại với chỉ giọng đọc của bạn."
          }
        }
      }
    },
    "录音中的静音太多，请按住后尽快开始朗读": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme enthält zu viel Stille. Beginne direkt nach dem Gedrückthalten zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is too much silence. Start reading soon after you press and hold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiado silencio. Empieza a leer poco después de mantener pulsado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement contient trop de silence. Commencez à lire juste après l’appui prolongé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग में बहुत अधिक चुप्पी है। दबाकर रखने के तुरंत बाद पढ़ना शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è troppo silenzio. Inizia a leggere subito dopo aver tenuto premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無音が長すぎます。長押ししたらすぐに読み始めてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há silêncio demais. Comece a ler logo após pressionar e segurar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中的静音太多，请按住后尽快开始朗读"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is te veel stilte. Begin met voorlezen zodra u de knop ingedrukt houdt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك فترات صمت طويلة. ابدأ القراءة فور الضغط المطوّل على الزر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много пауз. Начните читать вскоре после нажатия и удержания кнопки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt dużo ciszy. Zacznij czytać niedługo po przytrzymaniu przycisku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns för mycket tystnad. Börja läsa snart efter att du tryckt och hållit nere."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er for meget stilhed. Begynd at læse op kort efter, at du trykker og holder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er for mye stillhet. Begynn å lese snart etter at du holder inne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiljaisuutta on liikaa. Aloita lukeminen pian painikkeen pitkästä painamisesta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je příliš mnoho ticha. Začněte číst brzy po stisknutí a podržení tlačítka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει υπερβολική σιωπή. Ξεκινήστε την ανάγνωση λίγο αφού πατήσετε παρατεταμένα το κουμπί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok a csend. A gomb nyomva tartása után hamar kezdjen el felolvasni."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming katahimikan. Magsimula agad bumasa pagkatapos mong pindutin at hawakan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak keheningan. Mulai membaca segera setelah Anda menekan dan menahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak bahagian senyap. Mula membaca sebaik sahaja anda menekan dan menahan butang."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무음 구간이 너무 깁니다. 버튼을 길게 누른 뒤 바로 읽기 시작하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla sessizlik var. Basılı tuttuktan hemen sonra okumaya başlayın."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există prea multă liniște. Începe să citești la scurt timp după ce apeși și ții apăsat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש יותר מדי שקט. יש להתחיל לקרוא זמן קצר לאחר הלחיצה הממושכת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quá nhiều khoảng lặng. Hãy bắt đầu đọc ngay sau khi nhấn giữ."
          }
        }
      }
    },
    "录音文件无效，请重新录制": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei ist ungültig. Bitte nimm erneut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is invalid. Please record again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación no es válida. Vuelve a grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement n’est pas valide. Veuillez réenregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग मान्य नहीं है। कृपया फिर से रिकॉर्ड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non è valida. Registra di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音ファイルが無効です。録音し直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação é inválida. Grave novamente."
          }
        },
        "zh-Hans": {
