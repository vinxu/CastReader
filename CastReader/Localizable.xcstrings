        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stem werkt nog. Naamsynchronisatie is tijdelijk niet beschikbaar; probeer het later opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت لا يزال يعمل. مزامنة الاسم غير متاحة مؤقتاً؛ حاول مرة أخرى لاحقاً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос всё ещё работает. Синхронизация имён временно недоступна; попробуйте позже."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos nadal działa. Synchronizacja nazw jest tymczasowo niedostępna; spróbuj ponownie później."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rösten fungerar fortfarande. Namnsynkronisering är tillfälligt otillgänglig; försök igen senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen fungerer stadig. Navnesynkronisering er midlertidigt utilgængelig; prøv igen senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen fungerer fortsatt. Synkronisering av navn er midlertidig utilgjengelig; prøv igjen senere."
          }
        },
        "fi": {
          "stringUnit": {
