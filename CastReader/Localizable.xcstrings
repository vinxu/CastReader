        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah halaman resmi WeRead. CastReader tidak dapat melihat atau menyimpan akun maupun kata sandi WeChat Anda."
          }
        },
        "ro": {
          "stringUnit": {
