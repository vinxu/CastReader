        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn khoảng %lld phút %lld giây"
          }
        }
      }
    },
    "账号已切换，请从当前账号的离线书籍重新打开。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号已切换，请从当前账号的离线书籍重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has changed. Reopen this book from the current account’s Offline Books."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントが切り替わりました。現在のアカウントの「オフラインの本」から開き直してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta cambió. Reabre el libro desde Libros sin conexión de la cuenta actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte a changé. Rouvrez le livre depuis les Livres hors ligne du compte actuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto wurde gewechselt. Öffne das Buch unter „Offline-Bücher“ im aktuellen Konto erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta mudou. Reabra o livro em Livros offline da conta atual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account è cambiato. Riapri il libro da Libri offline dell’account attuale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता बदल गया है। मौजूदा खाते की “ऑफ़लाइन किताबें” से इसे फिर खोलें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw account is gewijzigd. Open dit boek opnieuw vanuit de offline boeken van het huidige account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 변경되었습니다. 현재 계정의 오프라인 책에서 이 책을 다시 여세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير الحساب. أعد فتح هذا الكتاب من «كتب للقراءة دون اتصال» الخاصة بالحساب الحالي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт изменён. Откройте эту книгу в разделе «Книги офлайн» текущего аккаунта."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto zostało zmienione. Otwórz tę książkę ponownie w sekcji Książki offline bieżącego konta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt konto har ändrats. Öppna boken igen från Offline-böcker i det aktuella kontot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto er ændret. Åbn bogen igen fra Offline-bøger i den aktuelle konto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto har endret seg. Åpne boken på nytt fra «Offline-bøker» i den nåværende kontoen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi on muuttunut. Avaa kirja uudelleen nykyisen tilin Offline-kirjat-osiossa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš účet se změnil. Otevřete tuto knihu znovu v sekci Knihy offline aktuálního účtu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σας έχει αλλάξει. Ανοίξτε ξανά αυτό το βιβλίο από τα Βιβλία εκτός σύνδεσης του τρέχοντος λογαριασμού."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókja megváltozott. Nyissa meg újra a könyvet az aktuális fiók Offline könyvek menüpontjában."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong account ay nagbago. Buksan muli ang aklat mula sa Mga Aklat Offline ng kasalukuyang account."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון הוחלף. פתח מחדש את הספר מתוך ספרים במצב לא מקוון של החשבון הנוכחי."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Anda telah berubah. Buka kembali buku ini dari Buku Offline akun saat ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun anda telah berubah. Buka semula buku ini dari Buku Luar Talian akaun semasa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul s-a schimbat. Redeschide această carte din Cărți offline ale contului curent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız değişti. Bu kitabı mevcut hesabın Çevrimdışı Kitaplar bölümünden yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản đã thay đổi. Mở lại sách này từ Sách ngoại tuyến của tài khoản hiện tại."
          }
        }
      }
    },
    "本机副本已删除，请返回离线书籍。": {
      "localizations": {
        "zh-Hans": {
