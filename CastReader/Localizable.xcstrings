            "value": "Przewiń bibliotekę Kindle, a następnie ponownie dotknij Synchronizuj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bläddra i Kindle-biblioteket, tryck sedan igen på Synkronisera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rul gennem Kindle-biblioteket, og tryk derefter igen på Synkroniser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull gjennom Kindle-biblioteket, og trykk deretter på Synkroniser igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä Kindle-kirjastoa, sitten napauta Synkronoi uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte seznam knih v knihovně Kindle a znovu klepněte na Synchronizovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κύλιση στη βιβλιοθήκη Kindle και πατήστε ξανά Συγχρονισμός."
