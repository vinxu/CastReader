    "免费试用 %1$d 天，之后按 %2$@/年自动续订，可随时取消": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d Tage gratis, danach %2$@/Jahr mit automatischer Verlängerung. Jederzeit kündbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d days free, then %2$@/year automatically. Cancel anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d días gratis y luego %2$@/año con renovación automática. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d jours gratuits, puis %2$@/an en renouvellement automatique. Annulable à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d दिन मुफ़्त, फिर %2$@/साल अपने आप रिन्यू। कभी भी रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d giorni gratis, poi %2$@/anno con rinnovo automatico. Puoi annullare quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 日間無料、その後 %2$@/年で自動更新。いつでもキャンセルできます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dias grátis e depois %2$@/ano com renovação automática. Cancele quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用 %1$d 天，之后按 %2$@/年自动续订，可随时取消"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dagen gratis, daarna automatische verlenging voor %2$@ per jaar. Je kunt op elk moment opzeggen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d일 무료 체험 후 연간 %2$@에 자동 갱신됩니다. 언제든지 취소할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجربة مجانية لمدة %1$d يوم، ثم تجديد تلقائي بسعر %2$@ سنويًا. يمكنك الإلغاء في أي وقت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный пробный период: %1$d дн., затем автоматическое продление за %2$@ в год. Можно отменить в любой момент."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dni za darmo, potem automatyczne odnawianie za %2$@ rocznie. Możesz anulować w dowolnym momencie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dagar gratis, därefter automatisk förnyelse för %2$@ per år. Du kan säga upp när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dage gratis, derefter automatisk fornyelse til %2$@ om året. Du kan opsige når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dager gratis, deretter automatisk fornyelse til %2$@ per år. Du kan si opp når som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d päivän ilmainen kokeilu, jonka jälkeen tilaus uusiutuu automaattisesti hintaan %2$@ vuodessa. Voit perua milloin tahansa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dní zdarma, poté automatické obnovení za %2$@ ročně. Zrušit můžete kdykoli."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δωρεάν δοκιμή %1$d ημερών και έπειτα αυτόματη ανανέωση με %2$@ ετησίως. Μπορείτε να ακυρώσετε οποιαδήποτε στιγμή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d nap ingyenes próbaidőszak, majd automatikus megújítás évi %2$@ díjért. Bármikor lemondható."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreng pagsubok sa loob ng %1$d araw, pagkatapos ay awtomatikong mare-renew sa halagang %2$@ bawat taon. Maaaring kanselahin anumang oras."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji coba gratis %1$d hari, lalu diperpanjang otomatis dengan biaya %2$@ per tahun. Dapat dibatalkan kapan saja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan percuma selama %1$d hari, kemudian diperbaharui secara automatik pada harga %2$@ setahun. Boleh dibatalkan pada bila-bila masa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng thử miễn phí %1$d ngày, sau đó tự động gia hạn với giá %2$@/năm. Bạn có thể hủy bất cứ lúc nào."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d günlük ücretsiz denemenin ardından yıllık %2$@ karşılığında otomatik yenilenir. İstediğiniz zaman iptal edebilirsiniz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d zile de probă gratuită, apoi reînnoire automată la %2$@ pe an. Poți anula oricând."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d ימי ניסיון בחינם, ולאחר מכן חידוש אוטומטי בעלות של %2$@ לשנה. אפשר לבטל בכל עת."
          }
        }
      }
    },
