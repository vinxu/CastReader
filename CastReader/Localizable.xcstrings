    "有效讲话时间太短，请连续清晰说话至少 3 秒": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die klare Sprechzeit ist zu kurz. Sprich mindestens 3 Sekunden lang durchgehend und deutlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough clear speech. Speak clearly and continuously for at least 3 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente voz clara. Habla de forma clara y continua durante al menos 3 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée de parole claire est trop courte. Parlez clairement et sans interruption pendant au moins 3 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ़ बोलने का समय बहुत कम है। कम से कम 3 सेकंड तक लगातार और साफ़ बोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il parlato chiaro è troppo breve. Parla chiaramente e senza interruzioni per almeno 3 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明瞭な音声が短すぎます。3秒以上続けてはっきり話してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há fala clara suficiente. Fale de forma clara e contínua por pelo menos 3 segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效讲话时间太短，请连续清晰说话至少 3 秒"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niet genoeg duidelijke spraak. Spreek duidelijk en doorlopend gedurende minimaal 3 seconden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد كلام واضح كافٍ. تحدث بوضوح واستمرارية لمدة 3 ثوانٍ على الأقل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно чёткой речи. Говорите чётко и непрерывно не менее 3 секунд."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wystarczająco wyraźnej mowy. Mów wyraźnie i ciągle przez co najmniej 3 sekundy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inte tillräckligt med tydligt tal. Tala tydligt och sammanhängande i minst 3 sekunder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke nok tydelig tale. Tal tydeligt og sammenhængende i mindst 3 sekunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke nok tydelig tale. Tal tydelig og kontinuerlig i minst 3 sekunder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selkeää puhetta ei ole tarpeeksi. Puhu selkeästi ja yhtäjaksoisesti vähintään 3 sekuntia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není dostatek srozumitelné řeči. Mluvte zřetelně a souvisle alespoň 3 sekundy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετή καθαρή ομιλία. Μιλήστε καθαρά και συνεχώς για τουλάχιστον 3 δευτερόλεπτα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs elég tiszta beszéd. Beszéljen tisztán és folyamatosan legalább 3 másodpercig."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sapat ang malinaw na pananalita. Magsalita nang malinaw at tuloy-tuloy nang hindi bababa sa 3 segundo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak cukup ucapan jelas. Bercakap dengan jelas dan berterusan selama sekurang-kurangnya 3 saat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli net konuşma algılanamadı. En az 3 saniye boyunca net ve kesintisiz konuşun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명확한 음성이 부족합니다. 3초 이상 또렷하게 이어서 말해 주세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapan yang jelas belum cukup. Bicaralah dengan jelas dan terus-menerus setidaknya selama 3 detik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există suficientă vorbire clară. Vorbește clar și continuu timp de cel puțin 3 secunde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מספיק דיבור ברור. יש לדבר באופן ברור ורציף לפחות 3 שניות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có đủ lời nói rõ ràng. Hãy nói rõ ràng, liên tục trong ít nhất 3 giây."
          }
        }
      }
    },
    "录音中的静音太多，请按住后尽快开始说话": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme enthält zu viel Stille. Beginne direkt nach dem Gedrückthalten zu sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is too much silence. Start speaking soon after you press and hold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiado silencio. Empieza a hablar poco después de mantener pulsado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement contient trop de silence. Commencez à parler juste après l’appui prolongé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग में बहुत अधिक चुप्पी है। दबाकर रखने के तुरंत बाद बोलना शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è troppo silenzio. Inizia a parlare subito dopo aver tenuto premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無音が長すぎます。長押ししたらすぐに話し始めてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há silêncio demais. Comece a falar logo após pressionar e segurar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中的静音太多，请按住后尽快开始说话"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is te veel stilte. Begin te spreken zodra u de knop ingedrukt houdt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك فترات صمت طويلة. ابدأ التحدث فور الضغط المطوّل على الزر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много пауз. Начните говорить вскоре после нажатия и удержания."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt dużo ciszy. Zacznij mówić krótko po naciśnięciu i przytrzymaniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns för mycket tystnad. Börja tala snart efter att du tryckt och hållit nere."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er for meget stilhed. Begynd at tale snart efter, du trykker og holder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er for mye stillhet. Begynn å snakke snart etter at du trykker og holder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian paljon hiljaisuutta. Aloita puhuminen pian painikkeen pitkästä painamisesta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je příliš mnoho ticha. Začněte mluvit brzy po stisknutí a podržení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει υπερβολική σιωπή. Ξεκινήστε να μιλάτε λίγο αφού πατήσετε παρατεταμένα το κουμπί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok a csend. A gomb nyomva tartása után hamar kezdjen el beszélni."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming katahimikan. Magsimulang magsalita agad pagkatapos mong pindutin at hawakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak kesunyian. Mulakan bercakap segera selepas anda tekan dan tahan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla sessizlik var. Basılı tuttuğunuzda hemen konuşmaya başlayın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무음 구간이 너무 깁니다. 버튼을 길게 누른 뒤 바로 말하기 시작하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak jeda hening. Mulailah berbicara segera setelah menekan dan menahan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există prea multă liniște. Începe să vorbești la scurt timp după ce apeși și ții apăsat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש יותר מדי שקט. יש להתחיל לדבר זמן קצר לאחר הלחיצה הממושכת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quá nhiều khoảng lặng. Hãy bắt đầu nói ngay sau khi nhấn giữ."
          }
        }
      }
    },
    "录音中可能有多人说话，请确保只有本人说话": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise sprechen mehrere Personen. Nimm erneut auf, während nur du sprichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one person may be speaking. Record again with only you speaking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede haber más de una persona hablando. Vuelve a grabar hablando solo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs personnes semblent parler. Réenregistrez avec votre voix uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग में एक से अधिक लोग बोल रहे हो सकते हैं। केवल अपनी आवाज़ में फिर से रिकॉर्ड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbero parlare più persone. Registra di nuovo facendo parlare solo te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数人の声が含まれている可能性があります。本人だけで録音し直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode haver mais de uma pessoa falando. Grave novamente apenas com a sua voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中可能有多人说话，请确保只有本人说话"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er spreken mogelijk meerdere personen. Neem opnieuw op en zorg dat alleen u spreekt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون أكثر من شخص يتحدث. سجّل مرة أخرى وأنت تتحدث وحدك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, в записи говорят несколько человек. Запишите снова так, чтобы говорили только вы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W nagraniu może mówić więcej niż jedna osoba. Nagraj ponownie tak, aby było słychać tylko Twój głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mer än en person kan ha talat. Spela in igen så att bara du talar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mere end én person kan tale. Optag igen, kun med dig selv, der taler."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere personer kan snakke samtidig. Ta opp på nytt med bare deg som snakker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useampi henkilö saattaa puhua. Tee tallenne uudelleen niin, että vain sinä puhut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Může mluvit více než jedna osoba. Nahrajte znovu pouze s vaším hlasem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πιθανόν μιλά περισσότερο από ένα άτομο. Ηχογραφήστε ξανά μόνο εσείς."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Több személy is beszélhetett egyszerre. Készítsen új felvételt úgy, hogy csak Ön beszél."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring may higit sa isang taong nagsasalita. Magrekord muli na ikaw lamang ang nagsasalita."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin lebih daripada seorang sedang bercakap. Rakam semula dengan hanya anda yang bercakap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla kişi konuşuyor olabilir. Sadece siz konuşarak tekrar kaydedin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 사람의 목소리가 들리는 것 같습니다. 혼자 말하는 목소리만 다시 녹음하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin ada lebih dari satu orang yang berbicara. Rekam ulang dengan hanya Anda yang berbicara."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil să vorbească mai multe persoane. Înregistrează din nou, doar cu vocea ta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שיותר מאדם אחד מדבר. יש להקליט שוב כשנשמע רק הקול שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể có nhiều người đang nói. Hãy thu âm lại với chỉ giọng nói của bạn."
          }
        }
      }
    },
    "没有检测到足够清晰的人声，请连续清晰说话至少 3 秒": {
      "localizations": {
