          "stringUnit": {
            "state": "translated",
            "value": "The sample text does not need to match word for word. Your recording was kept; retry it unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de ejemplo no tiene que coincidir palabra por palabra. La grabación se ha conservado; vuelve a intentarlo sin cambiarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte d’exemple ne doit pas être repris mot pour mot. Votre enregistrement a été conservé ; réessayez sans le modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरण टेक्स्ट का शब्दशः मिलना ज़रूरी नहीं है। आपकी रिकॉर्डिंग सुरक्षित है; इसी रिकॉर्डिंग से फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo di esempio non deve corrispondere parola per parola. La registrazione è stata conservata; riprova senza modificarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例文を一字一句合わせる必要はありません。録音は保持されています。そのまま再試行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto de exemplo não precisa corresponder palavra por palavra. Sua gravação foi mantida; tente novamente sem alterá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例文本无需逐字一致。录音已保留，请原样重试。"
