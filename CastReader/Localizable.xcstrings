    "只清除 CastReader 中对应平台的书架和阅读进度；共享网页登录状态会保留。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Bibliothek und der Lesefortschritt der jeweiligen Plattform werden aus CastReader entfernt. Die gemeinsame Webanmeldung bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only removes the corresponding platform’s shelf and reading progress from CastReader. The shared web sign-in remains available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se eliminan de CastReader la biblioteca y el progreso de lectura de la plataforma correspondiente. La sesión web compartida se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls la bibliothèque et la progression de lecture de la plateforme concernée sont supprimés de CastReader. La connexion Web partagée est conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे CastReader में केवल संबंधित प्लेटफ़ॉर्म की शेल्फ़ और पढ़ने की प्रगति हटेगी। साझा वेब साइन-इन बना रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono rimossi da CastReader solo la libreria e l’avanzamento di lettura della piattaforma corrispondente. L’accesso Web condiviso rimane disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CastReader 内の対象サービスの本棚と読書進捗だけを削除します。共有 Web ログイン状態は保持されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove do CastReader apenas a biblioteca e o progresso de leitura da plataforma correspondente. O login Web compartilhado será mantido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只清除 CastReader 中对应平台的书架和阅读进度；共享网页登录状态会保留。"
          }
        }
      }
    },
    "只清除 CastReader 中的 Google Play 图书书架和阅读进度；Google 网页登录状态会保留，便于下次快速确认。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Google-Play-Bücher-Regal und der Lesefortschritt in CastReader werden gelöscht. Die Google-Webanmeldung bleibt für eine schnellere Bestätigung erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only clears the Google Play Books shelf and reading progress in CastReader. Your Google web sign-in stays available for faster confirmation next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se borrarán de CastReader la estantería y el progreso de Google Play Libros. La sesión web de Google se conservará para confirmar más rápido la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls la bibliothèque et la progression Google Play Livres dans CastReader seront effacées. La connexion Web Google sera conservée pour une confirmation plus rapide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे CastReader में केवल Google Play किताबें की शेल्फ़ और पढ़ने की प्रगति हटेगी। अगली बार तेज़ पुष्टि के लिए Google वेब साइन-इन बना रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono rimossi solo la libreria e l'avanzamento di Google Play Libri in CastReader. L'accesso Web Google resta disponibile per conferme più rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CastReader 内の Google Play ブックスの本棚と閲覧進捗だけを削除します。Google の Web ログイン状態は次回の素早い確認のため保持されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga apenas a estante e o progresso do Google Play Livros no CastReader. O login Web do Google será mantido para uma confirmação mais rápida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只清除 CastReader 中的 Google Play 图书书架和阅读进度；Google 网页登录状态会保留，便于下次快速确认。"
          }
        }
      }
    },
