    "原文件不会上传；只上传你确认的短片段。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldatei wird nicht hochgeladen; nur der von dir bestätigte kurze Clip wird hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file is not uploaded; only the short clip you confirm is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original no se sube; solo se sube el fragmento corto que confirmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d’origine n’est pas envoyé ; seul le court extrait que vous confirmez est importé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ाइल अपलोड नहीं होती; केवल आपका पुष्टि किया गया छोटा क्लिप अपलोड होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file originale non viene caricato; viene caricato solo il breve clip che confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルはアップロードされません。確認した短いクリップだけがアップロードされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo original não é enviado; apenas o trecho curto que você confirmar será enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件不会上传；只上传你确认的短片段。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het originele bestand wordt niet geüpload; alleen de korte clip die u bevestigt, wordt geüpload."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일은 업로드되지 않으며, 확인한 짧은 클립만 업로드됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُرفع الملف الأصلي؛ بل يُرفع فقط المقطع القصير الذي تؤكده."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинальный файл не загружается; загружается только подтверждённый вами короткий фрагмент."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalny plik nie jest przesyłany; przesyłany jest tylko potwierdzony przez Ciebie krótki klip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalet laddas inte upp; endast det korta klipp du bekräftar laddas upp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den originale fil uploades ikke; kun det korte klip, du bekræfter, uploades."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalfilen lastes ikke opp; bare det korte utklippet du bekrefter, lastes opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäistä tiedostoa ei lähetetä palvelimelle. Vain vahvistamasi lyhyt leike lähetetään."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Původní soubor se nenahraje; nahraje se pouze krátký úsek, který potvrdíte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχικό αρχείο δεν ανεβαίνει· μόνο το σύντομο απόσπασμα που επιβεβαιώνετε ανεβαίνει."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredeti fájl nem kerül feltöltésre; csak a megerősített rövid részletet töltjük fel."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ia-upload ang orihinal na file. Ang maikling clip na kinumpirma mo lamang ang ia-upload."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ המקורי לא מועלה; רק הקטע הקצר שאישרתם מועלה."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail asal tidak dimuat naik; hanya klip pendek yang anda sahkan yang dimuat naik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul original nu este încărcat; doar scurtul fragment confirmat de tine este încărcat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal dosya yüklenmez; yalnızca onayladığınız kısa klip yüklenir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File asli tidak diunggah; hanya cuplikan pendek yang Anda konfirmasi yang diunggah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp gốc không được tải lên; chỉ đoạn ngắn bạn xác nhận mới được tải lên."
          }
        }
      }
    },
