    "所选音频暂不可用，请先下载到设备后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Audio ist derzeit nicht verfügbar. Lade es zuerst auf das Gerät und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
