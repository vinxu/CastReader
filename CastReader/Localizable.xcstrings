    "粘贴图书馆提供的 O’Reilly 或 EZproxy 登录链接。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den von deiner Bibliothek bereitgestellten O’Reilly- oder EZproxy-Anmeldelink ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the O’Reilly or EZproxy sign-in link provided by your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el enlace de inicio de sesión de O’Reilly o EZproxy proporcionado por tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le lien de connexion O’Reilly ou EZproxy fourni par votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी द्वारा दिया गया O’Reilly या EZproxy साइन-इन लिंक पेस्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il link di accesso O’Reilly o EZproxy fornito dalla biblioteca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
