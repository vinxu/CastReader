    "在视频的分享面板里选择 CastReader；字幕可用时会直接进入朗读。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle CastReader im Teilen-Menü eines Videos. Wenn Untertitel verfügbar sind, beginnt das Vorlesen direkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose CastReader from a video's Share menu. If captions are available, reading starts directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige CastReader en el menú Compartir del video. Si hay subtítulos disponibles, la lectura comenzará directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez CastReader dans le menu Partager d’une vidéo. Si des sous-titres sont disponibles, la lecture démarre directement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो के शेयर मेनू में CastReader चुनें। कैप्शन उपलब्ध होने पर पढ़ना सीधे शुरू हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli CastReader dal menu Condividi di un video. Se sono disponibili sottotitoli, la lettura inizierà direttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の共有メニューで CastReader を選択します。字幕が利用できる場合は、そのまま読み上げが始まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o CastReader no menu Compartilhar de um vídeo. Se houver legendas, a leitura começará diretamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在视频的分享面板里选择 CastReader；字幕可用时会直接进入朗读。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies CastReader in het deelmenu van een video. Als er ondertiteling beschikbaar is, begint het voorlezen direct."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر CastReader من قائمة مشاركة الفيديو. إذا توفرت تسميات توضيحية، تبدأ القراءة مباشرةً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите CastReader в меню «Поделиться» видео. Если доступны субтитры, чтение начнётся сразу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz CastReader z menu Udostępnij filmu. Jeśli dostępne są napisy, czytanie rozpocznie się bezpośrednio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj CastReader i videons delningsmeny. Om undertexter finns börjar uppläsningen direkt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg CastReader i en videos Del-menu. Hvis undertekster er tilgængelige, starter læsningen direkte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg CastReader i delemenyen for en video. Hvis undertekster er tilgjengelige, starter lesingen umiddelbart."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse CastReader videon Jaa-valikosta. Jos saatavilla on tekstityksiä, lukeminen alkaa suoraan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte CastReader ze sdílecí nabídky videa. Pokud jsou k dispozici titulky, čtení začne okamžitě."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε CastReader από το μενού Κοινοποίησης ενός βίντεο. Αν υπάρχουν υπότιτλοι, η ανάγνωση ξεκινά αμέσως."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng CastReader mula sa menu ng Share ng isang video. Kung may mga caption, magsisimula agad ang pagbasa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר ב-CastReader מתפריט השיתוף של סרטון. אם כתוביות זמינות, הקריאה תתחיל מיד."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih CastReader dari menu Bagikan video. Jika subtitel tersedia, pembacaan langsung dimulai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih CastReader daripada menu Kongsi video. Jika kapsyen tersedia, bacaan bermula serta-merta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd a CastReadert a videó Megosztás menüjében. Ha van felirat, a felolvasás közvetlenül elindul."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상의 공유 메뉴에서 CastReader를 선택하세요. 자막이 있으면 바로 읽기 시작합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir videonun Paylaş menüsünden CastReader'ı seçin. Altyazı varsa okuma doğrudan başlar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege CastReader din meniul Distribuie al unui videoclip. Dacă sunt disponibile subtitrări, lectura începe direct."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn CastReader trong menu Chia sẻ của video. Nếu có phụ đề, ứng dụng sẽ bắt đầu đọc ngay."
          }
        }
      }
    },
