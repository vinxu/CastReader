    "让重要的声音，陪你读懂每一页。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass eine vertraute Stimme dich durch jede Seite begleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let a voice that matters help you understand every page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que una voz importante te acompañe para comprender cada página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez une voix qui compte vous aider à comprendre chaque page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ख़ास आवाज़ को हर पन्ना समझने में अपना साथी बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che una voce importante ti accompagni nella comprensione di ogni pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大切な声と一緒に、一ページずつ深く理解しよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe uma voz importante acompanhar você na compreensão de cada página."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让重要的声音，陪你读懂每一页。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een betekenisvolle stem u helpen elke pagina te begrijpen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소중한 목소리와 함께 모든 페이지를 이해해 보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع صوتًا يعني لك الكثير يساعدك على فهم كل صفحة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть дорогой вам голос поможет понять каждую страницу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niech bliski Ci głos pomoże zrozumieć każdą stronę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt en röst som betyder något hjälpa dig att förstå varje sida."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad en stemme, der betyder noget, hjælpe dig med at forstå hver side."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La en viktig stemme hjelpe deg med å forstå hver side."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna merkityksellisen äänen auttaa sinua ymmärtämään jokaista sivua."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte blízký hlas pomoci vám porozumět každé stránce."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε μια σημαντική φωνή να σας βοηθήσει να κατανοήσετε κάθε σελίδα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedje, hogy egy fontos hang segítse minden oldal megértését."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayaan ang isang boses na mahalaga na tulungan kang intindihin ang bawat pahina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan suara yang berarti membantu Anda memahami setiap halaman."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan suara yang bermakna membantu anda memahami setiap halaman."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă o voce dragă să te ajute să înțelegi fiecare pagină."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlamlı bir sesin her sayfayı anlamanıza yardımcı olmasına izin verin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לתת לקול שחשוב לך לעזור להבין כל עמוד."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để một giọng nói thân thuộc giúp bạn hiểu từng trang."
          }
        }
      }
    },
    "CastReader 把 Kindle 书籍、照片、PDF 和网页变成同步指读与 AI 解读。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader verwandelt Kindle-Bücher, Fotos, PDFs und Webseiten in synchrones Mitlesen und KI-Erklärungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader turns Kindle books, photos, PDFs, and web pages into synchronized read-along and AI explanations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader convierte libros Kindle, fotos, PDF y páginas web en lectura sincronizada y explicaciones con IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader transforme les livres Kindle, les photos, les PDF et les pages web en lecture synchronisée et explications par IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader Kindle किताबों, फ़ोटो, PDF और वेब पेजों को सिंक किए गए रीड-अलॉन्ग और AI व्याख्या में बदलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader trasforma libri Kindle, foto, PDF e pagine web in lettura sincronizzata e spiegazioni con IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReaderはKindle本、写真、PDF、ウェブページを、同期読み上げとAI解説に変えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CastReader transforma livros Kindle, fotos, PDFs e páginas da web em leitura sincronizada e explicações por IA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader 把 Kindle 书籍、照片、PDF 和网页变成同步指读与 AI 解读。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader zet Kindle-boeken, foto's, PDF's en webpagina's om in gesynchroniseerd voorlezen en AI-uitleg."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader는 Kindle 책, 사진, PDF 및 웹 페이지를 텍스트와 동기화된 낭독 및 AI 해설로 제공합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل CastReader كتب Kindle والصور وPDF وصفحات الويب إلى قراءة متزامنة مع شرح بالذكاء الاصطناعي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader превращает книги Kindle, фотографии, PDF и веб-страницы в синхронизированное чтение вслух и ИИ-объяснения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader zamienia książki Kindle, zdjęcia, PDF-y i strony internetowe w zsynchronizowane czytanie na głos i wyjaśnienia AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader omvandlar Kindle-böcker, foton, PDF-filer och webbsidor till synkroniserad högläsning och AI-förklaringar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader omdanner Kindle-bøger, fotos, PDF'er og websteder til synkroniseret oplæsning og AI-forklaringer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader gjør Kindle-bøker, bilder, PDF-er og nettsider om til høytlesing der du kan følge teksten i takt med stemmen, og forklaringer laget med KI."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader muuttaa Kindle-kirjat, valokuvat, PDF-tiedostot ja verkkosivut ääneenluvuksi, jota voit seurata tekstistä, sekä tekoälyn tuottamiksi selityksiksi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader mění knihy Kindle, fotografie, PDF a webové stránky na synchronizované čtení nahlas a AI vysvětlení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CastReader μετατρέπει βιβλία Kindle, φωτογραφίες, PDF και ιστοσελίδες σε συγχρονισμένη ανάγνωση με ακρόαση και εξηγήσεις τεχνητής νοημοσύνης."
