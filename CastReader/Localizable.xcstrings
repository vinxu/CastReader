            "value": "Ez a felolvasóhang már nem érhető el, ezért a kijelölését megszüntettük."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na ma-access ang boses ng tagabasang ito, kaya inalis na ito sa napiling boses."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara pembaca ini tidak lagi boleh diakses, jadi ia telah dinyahpilih."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu okuyucu sesi artık erişilebilir değil, bu nedenle seçim kaldırıldı."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 낭독자 음성에 더 이상 접근할 수 없어 선택이 해제되었습니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara pembaca ini tidak lagi dapat diakses, sehingga pilihan suara ini dibatalkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea acestui cititor nu mai este accesibilă, așa că a fost deselectată."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קול המקריא הזה אינו נגיש עוד, ולכן בחירתו בוטלה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng người đọc này không còn truy cập được, nên giọng đã được bỏ chọn."
          }
        }
      }
    },
    "这个朗读者声音暂时无法使用，请刷新声音列表后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Leser-Stimme ist vorübergehend nicht verfügbar. Aktualisiere die Stimmenliste und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reader voice is temporarily unavailable. Refresh your voice list and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz de lector no está disponible temporalmente. Actualiza la lista de voces e inténtalo de nuevo."
          }
        },
        "fr": {
