    "拍摄、上传、输入网址或文本，处理过的内容都在这里。仅保存在本机。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du aufnimmst, hochlädst oder einfügst, erscheint hier. Nur auf diesem Gerät gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you capture, upload, or paste lives here. Stored on this device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que capturas, subes o pegas vive aquí. Almacenado únicamente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous capturez, téléchargez ou collez se trouve ici. Stocké sur cet appareil uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो कुछ भी कैप्चर करते हैं, अपलोड करते हैं या पेस्ट करते हैं वह यहां रहता है। केवल इस डिवाइस पर संग्रहीत."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che catturi, carichi o incolli risiede qui. Memorizzato solo su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ、アップロード、またはペーストしたものはすべてここに保存されます。このデバイスにのみ保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você captura, carrega ou cola fica aqui. Armazenado apenas neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄、上传、输入网址或文本，处理过的内容都在这里。仅保存在本机。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat u vastlegt, uploadt of plakt, bevindt zich hier. Alleen op dit apparaat opgeslagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 캡처, 업로드, 붙여넣은 모든 것이 저장됩니다. 이 기기에만 저장됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تلتقطه أو ترفعه أو تلصقه هنا. يُخزن على هذا الجهاز فقط."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь хранится всё, что вы снимаете, загружаете или вставляете. Данные сохраняются только на этом устройстве."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie przechwycone, wgrane lub wklejone treści znajdują się tutaj. Przechowywane wyłącznie na tym urządzeniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du fångar, laddar upp eller klistrar in finns här. Endast lagrat på denna enhet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, hvad du optager, uploader eller indsætter, findes her. Gemmes kun på denne enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du tar bilde av, laster opp eller limer inn, finnes her. Lagres bare på denne enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki, mitä otat, lataat tai liität, säilytetään täällä. Tallennettu vain tälle laitteelle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechno, co zachytíte, nahrajete nebo vložíte, je zde. Uloženo pouze v tomto zařízení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα όσα καταγράφετε, ανεβάζετε ή επικολλάτε βρίσκονται εδώ. Αποθηκεύονται μόνο σε αυτή τη συσκευή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden lefényképezett, feltöltött vagy beillesztett tartalom ide kerül. Kizárólag ezen az eszközön tárolódik."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito naka-save ang lahat ng iyong kinunan, in-upload, o ipinaste. Nakaimbak lamang sa device na ito."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שתצלמו, תעלו או תדביקו נשמר כאן. מאוחסן רק במכשיר זה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang Anda tangkap, unggah, atau tempel ada di sini. Hanya disimpan di perangkat ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang anda tangkap, muat naik atau tampal ada di sini. Disimpan pada peranti ini sahaja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çektiğiniz, yüklediğiniz veya yapıştırdığınız her şey burada yer alır. Yalnızca bu cihazda saklanır."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce fotografiezi, încarci sau lipești se găsește aici. Stocat doar pe acest dispozitiv."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi nội dung bạn chụp, tải lên hoặc dán đều nằm ở đây. Chỉ lưu trên thiết bị này."
          }
        }
      }
    },
