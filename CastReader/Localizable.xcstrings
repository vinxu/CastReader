          }
        }
      }
    },
    "无论选择哪种方式，完成后都会回到已创建列表，在那里试听、编辑和选择音色。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jeder Methode kehrst du zur Liste Erstellt zurück, um Stimmen anzuhören, zu bearbeiten und auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whichever method you choose, you’ll return to Created to preview, edit, and select the voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elijas el método que elijas, volverás a Creadas para escuchar, editar y seleccionar la voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle que soit la méthode choisie, vous reviendrez à Créées pour écouter, modifier et sélectionner la voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी तरीके के बाद आप बनाई गई सूची पर लौटेंगे, जहाँ आवाज़ सुन, संपादित और चुन सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualunque metodo tu scelga, tornerai a Create per ascoltare, modificare e selezionare la voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの方法でも、完了後は作成済みに戻り、試聴・編集・選択できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja qual for o método, você voltará a Criadas para ouvir, editar e selecionar a voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论选择哪种方式，完成后都会回到已创建列表，在那里试听、编辑和选择音色。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke methode je ook kiest, je keert terug naar Gemaakt om de stem voor te beluisteren, te bewerken en te selecteren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 방법을 선택하든 생성 후 만든 음성 화면으로 돌아와 미리 듣거나 편집하고 선택할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيًا كانت الطريقة التي تختارها، ستعود إلى «المنشأة» للاستماع إلى الصوت وتعديله واختياره."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой бы метод вы ни выбрали, вы вернётесь в раздел «Созданные», чтобы прослушать, отредактировать и выбрать голос."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezależnie od wybranej metody wrócisz do sekcji Utworzone, aby odsłuchać próbkę, edytować i wybrać głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oavsett metod återgår du till Skapade för att provlyssna, redigera och välja rösten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uanset hvilken metode du vælger, vender du tilbage til Oprettede, hvor du kan lytte til en prøve, redigere og vælge stemmen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uansett hvilken metode du velger, kommer du tilbake til Opprettet for å høre en prøve, redigere og velge stemmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsemastasi menetelmästä riippumatta palaat Luodut-osioon, jossa voit kuunnella näytteen, muokata ja valita äänen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ohledu na zvolenou metodu se vrátíte do sekce Vytvořeno, kde si hlas můžete přehrát, upravit a vybrat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όποιον τρόπο κι αν επιλέξετε, θα επιστρέψετε στην ενότητα «Δημιουργημένες» για ακρόαση δείγματος, επεξεργασία και επιλογή της φωνής."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármelyik módszert választja, visszatér a Létrehozott hangok lapra, ahol meghallgathatja, szerkesztheti és kiválaszthatja a hangot."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Anumang paraan ang piliin mo, babalik ka sa Mga Nilikha upang pakinggan, i-edit, at piliin ang boses."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בכל שיטה שתבחר, בסיום תחזור לרשימת הקולות שנוצרו, ובה תוכל להאזין, לערוך ולבחור קול."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa-apa pun kaedah yang anda pilih, anda akan kembali ke Dicipta untuk mendengar pratonton, mengedit dan memilih suara."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa pun metode yang dipilih, Anda akan kembali ke Dibuat untuk mendengarkan pratinjau, mengedit, dan memilih suara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi yöntemi seçerseniz seçin, sesi ön dinlemek, düzenlemek ve seçmek için Oluşturulanlar'a dönersiniz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiferent de metoda aleasă, vei reveni la Create pentru a asculta, edita și selecta vocea."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù chọn cách nào, bạn cũng sẽ quay lại mục Đã tạo để nghe thử, chỉnh sửa và chọn giọng."
          }
        }
      }
    },
    "选择录制自己、邀请朋友或上传音频": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst aufnehmen, einen Freund einladen oder Audio hochladen"
          }
