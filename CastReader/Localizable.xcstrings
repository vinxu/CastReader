          "stringUnit": {
            "state": "translated",
            "value": "Toto je oficiální stránka Amazonu. CastReader nemůže vidět ani ukládat vaše heslo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι η επίσημη σελίδα της Amazon. Το CastReader δεν μπορεί να δει ή να αποθηκεύσει τον κωδικό πρόσβασής σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az Amazon hivatalos oldala. A CastReader nem látja és nem tárolja a jelszavát."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ito ay opisyal na pahina ng Amazon. Hindi makikita o ma-i-save ng CastReader ang iyong password."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah halaman rasmi Amazon. CastReader tidak dapat melihat atau menyimpan kata laluan anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Amazon'un resmi sayfasıdır. CastReader şifrenizi göremez veya kaydetmez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon 공식 페이지입니다. CastReader는 비밀번호를 보거나 저장할 수 없습니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah halaman resmi Amazon. CastReader tidak dapat melihat atau menyimpan kata sandi Anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este pagina oficială Amazon. CastReader nu îți poate vedea sau salva parola."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו הדף הרשמי של Amazon. CastReader אינו יכול לראות או לשמור את הסיסמה שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là trang chính thức của Amazon. CastReader không thể xem hoặc lưu mật khẩu của bạn."
          }
        }
      }
    },
