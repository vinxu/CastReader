    "每月 120 分钟基础额度，用完后可使用加购额度。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan includes 120 minutes each month. Purchased credits are used after these minutes run out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 120 分钟基础额度，用完后可使用加购额度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月 120 分の利用時間が含まれます。使い切った後は、追加購入した利用時間が使われます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan incluye 120 minutos al mes. Cuando se agotan, se usan los minutos comprados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre forfait comprend 120 minutes par mois. Les minutes achetées sont utilisées une fois ce quota épuisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tarif enthält monatlich 120 Minuten. Sobald diese aufgebraucht sind, werden gekaufte Minuten verwendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano inclui 120 minutos por mês. Quando eles acabam, são usados os minutos comprados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano include 120 minuti al mese. Una volta esauriti, vengono usati i minuti acquistati."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके प्लान में हर महीने 120 मिनट मिलते हैं। उनके खत्म होने के बाद खरीदे गए मिनट इस्तेमाल होते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw abonnement bevat 120 minuten per maand. Gekochte credits worden gebruikt nadat deze minuten zijn opgebruikt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 플랜에는 매월 120 분이 포함됩니다. 구매한 크레딧은 해당 분량이 소진된 후 사용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш план включает 120 минут каждый месяц. Приобретённые кредиты используются после исчерпания этих минут."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój plan obejmuje 120 minut miesięcznie. Kupione kredyty są zużywane po wyczerpaniu tych minut."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din prenumeration inkluderar 120 minuter varje månad. Köpta krediter används när dessa minuter är slut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan inkluderer 120 minutter hver måned. Købte kreditter bruges, når disse minutter er brugt op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet ditt inkluderer 120 minutter hver måned. Kjøpte kreditter brukes når disse minuttene er brukt opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukseesi sisältyy 120 minuuttia kuukaudessa. Ostettuja krediittejä käytetään, kun nämä minuutit loppuvat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš plán zahrnuje 120 minut měsíčně. Nakoupené kredity se použijí až po vyčerpání těchto minut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πλάνο σας περιλαμβάνει 120 λεπτά κάθε μήνα. Οι αγορασμένες πιστωτικές μονάδες χρησιμοποιούνται όταν εξαντληθούν τα μηνιαία λεπτά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csomagja havi 120 percet tartalmaz. A vásárolt krediteket akkor használják fel, ha ezek a percek elfogynak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong plano ay naglalaman ng 120 minuto bawat buwan. Ang mga biniling kredito ay gagamitin pagkatapos matapos ang mga minutong ito."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכנית שלך כוללת 120 דקות בכל חודש. הדקות שנרכשו ישמשו לאחר שהדקות החודשיות ייגמרו."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan Anda mencakup 120 menit setiap bulan. Kredit yang dibeli digunakan setelah menit bulanan habis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan anda merangkumi 120 minit setiap bulan. Kredit yang dibeli digunakan selepas minit bulanan tersebut habis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل خطتك 120 دقيقة كل شهر. يُستخدم الرصيد المشترى بعد نفاد هذه الدقائق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planınız her ay 120 dakika içerir. Bu dakikalar tükendikten sonra satın alınan krediler kullanılır."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul tău include 120 de minute în fiecare lună. Creditele cumpărate sunt folosite după epuizarea acestor minute."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói của bạn bao gồm 120 phút mỗi tháng. Số phút đã mua sẽ được dùng sau khi hết số phút này."
          }
        }
      }
    },
