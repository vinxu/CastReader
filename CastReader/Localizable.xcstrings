    "CastReader 不保存你的密码或整本正文。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader speichert weder dein Passwort noch den vollständigen Text deiner Bücher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader does not save your password or the full text of your books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader no guarda tu contraseña ni el texto completo de tus libros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader n’enregistre ni votre mot de passe ni le texte intégral de vos livres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader आपका पासवर्ड या आपकी किताबों का पूरा पाठ सेव नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader non salva la password né il testo completo dei tuoi libri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReaderはパスワードや本の全文を保存しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CastReader não salva sua senha nem o texto completo dos seus livros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader 不保存你的密码或整本正文。"
          }
        }
      }
    },
    "你主要在哪里读书？绑定后打开一本书，让 CastReader 朗读 30 秒。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo liest du normalerweise? Verbinde deine Bibliothek, öffne ein Buch und lass CastReader 30 Sekunden lang vorlesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you usually read? Connect your library, open a book, and let CastReader read for 30 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde sueles leer? Conecta tu biblioteca, abre un libro y deja que CastReader lo lea durante 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où lisez-vous habituellement ? Connectez votre bibliothèque, ouvrez un livre et laissez CastReader le lire pendant 30 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप आम तौर पर कहाँ पढ़ते हैं? अपनी लाइब्रेरी कनेक्ट करें, कोई किताब खोलें और CastReader को 30 सेकंड तक पढ़ने दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove leggi di solito? Collega la libreria, apri un libro e lascia che CastReader legga per 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段はどこで読書しますか？連携後に本を開き、CastReaderで30秒間読み上げてみましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde você costuma ler? Conecte sua biblioteca, abra um livro e deixe o CastReader ler por 30 segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你主要在哪里读书？绑定后打开一本书，让 CastReader 朗读 30 秒。"
          }
        }
      }
    },
