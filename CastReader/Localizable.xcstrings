        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisen på én lydbok dekker hele biblioteket ditt i en måned – fra %@/måned"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhden äänikirjan hinta kattaa koko kirjastosi yhdeksi kuukaudeksi — alkaen %@/kk"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena jedné audioknihy vám pokryje celou knihovnu na měsíc — od %@/měsíc"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τιμή ενός ακουστικού βιβλίου καλύπτει ολόκληρη τη βιβλιοθήκη σας για έναν μήνα — από %@/μήνα"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy hangoskönyv ára fedezi az egész könyvtárát egy hónapra – %@/hó-tól"
          }
        },
        "fil": {
