          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatível com assinaturas pessoais e com o acesso institucional oferecido por escolas, empresas e bibliotecas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
