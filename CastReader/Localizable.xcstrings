    "语音正在生成，请稍后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is being generated. Please try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音正在生成，请稍后重试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を生成中です。しばらくしてから再試行してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está generando el audio. Vuelve a intentarlo en unos momentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio est en cours de génération. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachausgabe wird erstellt. Bitte versuche es gleich erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio está sendo gerado. Tente novamente em instantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio è in fase di generazione. Riprova tra poco."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ तैयार की जा रही है। कृपया कुछ देर बाद फिर कोशिश करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spraak wordt gegenereerd. Probeer het zo opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성을 생성하고 있습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إنشاء الصوت. يُرجى إعادة المحاولة بعد قليل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио создаётся. Повторите попытку через некоторое время."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa generowanie mowy. Spróbuj ponownie za chwilę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Talet genereras. Försök igen om en liten stund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talen er ved at blive genereret. Prøv igen om lidt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talen genereres. Prøv igjen om litt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhetta luodaan. Yritä hetken kuluttua uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá generování řeči. Zkuste to za chvíli znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ομιλία δημιουργείται. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszéd létrehozása folyamatban van. Próbálja újra hamarosan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagawa pa ang audio. Pakisubukang muli makalipas ang ilang sandali."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האודיו נוצר כעת. יש לנסות שוב בעוד זמן קצר."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara sedang dibuat. Silakan coba lagi sebentar lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio sedang dijana. Sila cuba lagi sebentar nanti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generează sunetul. Încearcă din nou în câteva momente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses oluşturuluyor. Lütfen kısa bir süre sonra yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tạo giọng đọc. Vui lòng thử lại sau giây lát."
          }
        }
      }
    },
    "语音服务今日额度已用完，请稍后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech service has reached its daily limit. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音服务今日额度已用完，请稍后重试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声サービスの本日の上限に達しました。後でもう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de voz ha alcanzado su límite diario. Inténtalo más tarde."
          }
