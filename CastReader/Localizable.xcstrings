    "登录状态需要更新，点击按钮重新连接后创建。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anmeldung muss aktualisiert werden. Tippe auf die Schaltfläche, verbinde dich erneut und erstelle dann die Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in needs to be refreshed. Tap the button to reconnect before creating a voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes actualizar el inicio de sesión. Toca el botón para volver a conectarte antes de crear una voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion doit être actualisée. Touchez le bouton pour vous reconnecter avant de créer une voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका साइन-इन अपडेट होना चाहिए। आवाज़ बनाने से पहले दोबारा कनेक्ट करने के लिए बटन टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario aggiornare l’accesso. Tocca il pulsante per riconnetterti prima di creare una voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン状態の更新が必要です。ボタンをタップして再接続してから声を作成してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu login precisa ser atualizado. Toque no botão para reconectar antes de criar uma voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录状态需要更新，点击按钮重新连接后创建。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw aanmelding moet worden ververst. Tik op de knop om opnieuw verbinding te maken voordat u een stem maakt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تحديث تسجيل الدخول الخاص بك. اضغط على الزر لإعادة الاتصال قبل إنشاء صوت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход требует обновления. Нажмите кнопку, чтобы подключиться перед созданием голоса."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wymaga odświeżenia. Dotknij przycisku, aby połączyć się ponownie przed utworzeniem głosu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din inloggning måste uppdateras. Tryck på knappen för att återansluta innan du skapar en röst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din indlogning skal genindlæses. Tryk på knappen for at oprette forbindelse igen, før du opretter en stemme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innloggingen din må oppdateres. Trykk på knappen for å koble til på nytt før du oppretter en stemme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautumisesi on päivitettävä. Napauta painiketta yhdistääksesi ennen äänen luomista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je třeba obnovit vaše přihlášení. Klepněte na tlačítko pro opětovné připojení před vytvořením hlasu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεσή σας χρειάζεται ανανέωση. Πατήστε το κουμπί για επανασύνδεση πριν τη δημιουργία φωνής."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezését frissíteni kell. Koppintson a gombra a hang létrehozása előtt való újbóli kapcsolódáshoz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan i-refresh ang iyong pag-sign in. I-tap ang buton upang konektahin muli bago lumikha ng boses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea trebuie reîmprospătată. Apasă butonul pentru a te reconecta înainte de a crea o voce."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인을 갱신해야 합니다. 음성을 만들기 전에 버튼을 눌러 다시 연결하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk anda perlu diperbaharui. Ketik butang untuk menyambung semula sebelum mencipta suara."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi masuk Anda perlu diperbarui. Ketuk tombol untuk menghubungkan kembali sebelum membuat suara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumunuzun yenilenmesi gerekiyor. Ses oluşturmadan önce yeniden bağlanmak için düğmeye dokunun."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לרענן את הכניסה שלך. יש להקיש על הכפתור כדי להתחבר מחדש לפני יצירת קול."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập cần được làm mới. Nhấn nút để kết nối lại trước khi tạo giọng."
          }
        }
      }
    },
