    "Today is a pleasant day. I am recording this sample in a clear, natural voice so CastReader can reproduce my voice accurately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist ein angenehmer Tag. Ich nehme dieses Beispiel mit klarer, natürlicher Stimme auf, damit CastReader meine Stimme genau wiedergeben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is a pleasant day. I am recording this sample in a clear, natural voice so CastReader can reproduce my voice accurately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es un día agradable. Estoy grabando esta muestra con una voz clara y natural para que CastReader pueda reproducir mi voz con precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui est une journée agréable. J'enregistre cet échantillon avec une voix claire et naturelle afin que CastReader puisse reproduire ma voix avec précision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का दिन सुखद है. मैं इस नमूने को स्पष्ट, प्राकृतिक आवाज में रिकॉर्ड कर रहा हूं ताकि CastReader मेरी आवाज को सटीक रूप से पुन: पेश कर सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è una giornata piacevole. Sto registrando questo campione con una voce chiara e naturale in modo che CastReader possa riprodurre accuratamente la mia voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は楽しい一日です。このサンプルはクリアで自然な声で録音しているので、CastReader で私の声を正確に再現できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje é um dia agradável. Estou gravando esta amostra com uma voz clara e natural para que o CastReader possa reproduzir minha voz com precisão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is a pleasant day. I am recording this sample in a clear, natural voice so CastReader can reproduce my voice accurately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag is een aangename dag. Ik neem deze sample op met een duidelijke, natuurlijke stem zodat CastReader mijn stem nauwkeurig kan nabootsen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 기분 좋은 날입니다. CastReader 가 제 목소리를 정확하게 재현할 수 있도록 명확하고 자연스러운 목소리로 이 샘플을 녹음하고 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم يوم لطيف. أقوم بتسجيل هذه العينة بصوت واضح وطبيعي حتى يتمكن CastReader من إعادة إنتاج صوتي بدقة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня приятный день. Я записываю этот образец чистым, естественным голосом, чтобы CastReader мог точно воспроизвести мой голос."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś jest przyjemny dzień. Nagrywam tę próbkę wyraźnym, naturalnym głosem, aby CastReader mógł dokładnie odtworzyć mój głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är en trevlig dag. Jag spelar in detta exempel med en tydlig, naturlig röst så att CastReader kan återge min röst korrekt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en behagelig dag. Jeg optager denne prøve med en klar, naturlig stemme, så CastReader kan gengive min stemme korrekt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag er en hyggelig dag. Jeg tar opp dette eksempelet med en klar, naturlig stemme slik at CastReader kan gjengi min stemme nøyaktig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänään on kaunis päivä. Tallennan tämän näytteen selkeällä, luontevalla äänellä, jotta CastReader voi toistaa ääneni tarkasti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes je hezký den. Nahrávám tuto ukázku zřetelným, přirozeným hlasem, aby CastReader mohl můj hlas přesně napodobit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σήμερα είναι μια ευχάριστη μέρα. Ηχογραφώ αυτό το δείγμα με καθαρή, φυσική φωνή, ώστε το CastReader να αναπαράγει τη φωνή μου με ακρίβεια."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma kellemes nap van. Ezt a mintát egy tiszta, természetes hangon rögzítem, hogy a CastReader pontosan reprodukálni tudja a hangomat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magandang araw ngayon. Nirerekord ko ang halimbawang ito sa malinaw at natural na boses upang tumpak na magaya ng CastReader ang aking boses."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün güzel bir gün. CastReader'in sesimi doğru bir şekilde taklit edebilmesi için bu örneği net ve doğal bir sesle kaydediyorum."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini sungguh menyenangkan. Saya merakam sampel ini dengan suara yang jelas dan semula jadi supaya CastReader dapat menghasilkan semula suara saya dengan tepat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini menyenangkan. Saya merekam sampel ini dengan suara yang jelas dan alami agar CastReader dapat meniru suara saya secara akurat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Astăzi este o zi plăcută. Înregistrez această mostră cu o voce clară și naturală, pentru ca CastReader să îmi poată reproduce vocea cu precizie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היום הוא יום נעים. אני מקליט את הדוגמה הזאת בקול ברור וטבעי כדי ש־CastReader יוכל לשחזר את קולי במדויק."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay là một ngày dễ chịu. Tôi đang ghi âm mẫu này bằng giọng rõ ràng, tự nhiên để CastReader có thể tái tạo chính xác giọng nói của tôi."
          }
        }
      }
    },
