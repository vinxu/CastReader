    "不要增字、漏字或重复，参考文本会用于准确还原音色。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass keine Wörter aus, füge nichts hinzu und wiederhole nichts. Der Referenztext hilft, deine Stimme genau nachzubilden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not add, omit, or repeat words. The reference text helps reproduce your voice accurately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No añadas, omitas ni repitas palabras. El texto de referencia ayuda a reproducir tu voz con precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’ajoutez, n’omettez et ne répétez aucun mot. Le texte de référence aide à reproduire fidèlement votre voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शब्द न जोड़ें, न छोड़ें और न दोहराएँ। संदर्भ टेक्स्ट आपकी आवाज़ को सही ढंग से बनाने में मदद करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non aggiungere, omettere o ripetere parole. Il testo di riferimento aiuta a riprodurre accuratamente la tua voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語句を追加・省略・繰り返さずに読んでください。参照テキストは声を正確に再現するために使われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não adicione, omita nem repita palavras. O texto de referência ajuda a reproduzir sua voz com precisão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要增字、漏字或重复，参考文本会用于准确还原音色。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg geen woorden toe, laat geen woorden weg en herhaal geen woorden. De referentietekst helpt om uw stem nauwkeurig na te bootsen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُضف كلمات أو تحذفها أو تكررها. يساعد النص المرجعي في إعادة إنتاج صوتك بدقة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не добавляйте, не пропускайте и не повторяйте слова. Справочный текст поможет точно воспроизвести ваш голос."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dodawaj, nie pomijaj i nie powtarzaj słów. Tekst odniesienia pomaga wiernie odtworzyć Twój głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg inte till, utelämna eller upprepa ord. Referenstexten hjälper till att reproducera din röst korrekt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj ikke, udelad eller gentag ord. Referenceteksten hjælper med at gengive din stemme præcist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke legg til, utelat eller gjenta ord. Referanseteksten bidrar til å gjengi stemmen din nøyaktig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä lisää, jätä pois tai toista sanoja. Viiteteksti auttaa tuottamaan äänesi tarkasti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepřidávejte, nevynechávejte ani neopakujte slova. Referenční text pomáhá přesně napodobit váš hlas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην προσθέτετε, παραλείπετε ή επαναλαμβάνετε λέξεις. Το κείμενο αναφοράς βοηθά στην ακριβή αναπαραγωγή της φωνής σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne adjon hozzá, ne hagyjon ki és ne ismételjen szavakat. A hivatkozási szöveg segít a hangja pontos visszaállításában."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag magdagdag, tanggalin, o paulitin ang mga salita. Ang teksto na sanggunian ay tumutulong upang makuha nang tama ang iyong boses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu adăuga, omite sau repeta cuvinte. Textul de referință ajută la reproducerea exactă a vocii tale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 추가하거나 생략하거나 반복하지 마세요. 참고 문장은 목소리를 정확하게 재현하는 데 도움이 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan tambah, tinggalkan atau ulang perkataan. Teks rujukan membantu menghasilkan semula suara anda dengan tepat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan menambah, menghilangkan, atau mengulang kata. Teks referensi membantu meniru suara Anda secara akurat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözcük eklemeyin, atlamayın veya tekrarlamayın. Referans metin, sesinizin doğru şekilde yeniden üretilmesine yardımcı olur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין להוסיף, להשמיט או לחזור על מילים. טקסט הייחוס מסייע לשחזר את הקול שלך במדויק."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thêm, bỏ hoặc lặp từ. Văn bản tham chiếu giúp tái tạo giọng của bạn chính xác."
          }
        }
      }
    },
    "严格按照文本朗读": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies den Text genau vor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the text exactly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el texto exactamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez le texte exactement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट को ठीक उसी तरह पढ़ें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi esattamente il testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された文章どおりに読む"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia o texto exatamente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格按照文本朗读"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees de tekst exact zoals deze is"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ النص حرفيًا كما هو مكتوب"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читайте текст точно так, как он написан"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytaj tekst dokładnie tak, jak jest napisany"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs texten exakt som den står"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs teksten nøjagtigt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teksten nøyaktig slik den står"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lue teksti täsmälleen kuten se on kirjoitettu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtěte text doslovně"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε το κείμενο ακριβώς όπως είναι"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvassa fel a szöveget pontosan"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Basahin ang teksto nang eksaktong katulad nito"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește textul exact așa cum este"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문구를 그대로 읽어 주세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca teks tepat seperti yang tertera"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca teks persis seperti tertulis"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni aynen okuyun"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לקרוא את הטקסט בדיוק כפי שהוא"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc đúng nguyên văn"
          }
        }
      }
    },
    "使用自然语气和日常说话习惯，保持手机距离稳定。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich natürlich wie im Alltag und halte einen gleichmäßigen Abstand zum Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak naturally as you normally do and keep a steady distance from your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con naturalidad, como siempre, y mantén una distancia estable del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez naturellement, comme d’habitude, et gardez une distance constante avec le téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सामान्य आवाज़ में स्वाभाविक रूप से बोलें और फ़ोन से दूरी स्थिर रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla in modo naturale, come fai di solito, e mantieni una distanza costante dal telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段どおり自然に話し、端末との距離を一定に保ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale naturalmente, como no dia a dia, e mantenha uma distância constante do celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自然语气和日常说话习惯，保持手机距离稳定。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek natuurlijk zoals u normaal doet en houd een constante afstand tot uw telefoon."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدث بشكل طبيعي كعادتك، وحافظ على مسافة ثابتة من هاتفك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите естественно, как обычно, и держите телефон на постоянном расстоянии от рта."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów naturalnie, jak zwykle, i utrzymuj stałą odległość od telefonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata naturligt som vanligt och håll ett jämnt avstånd från telefonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal naturligt som du plejer og hold en jævn afstand fra telefonen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk naturlig som du vanligvis gjør og hold en jevn avstand til telefonen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu luonnollisesti tavalliseen tapaan ja pidä puhelin tasaisella etäisyydellä suustasi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte přirozeně jako obvykle a udržujte stejnou vzdálenost od telefonu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μιλήστε φυσικά όπως συνήθως και διατηρήστε σταθερή απόσταση από το τηλέφωνό σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszéljen természetesen, ahogy szokta, és tartsen állandó távolságot a telefonjától."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsalita nang natural gaya ng karaniwan at panatilihin ang pantay na distansya sa iyong telepono."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorbește natural, ca de obicei, și păstrează o distanță constantă față de telefon."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소처럼 자연스럽게 말하고 휴대폰과의 거리를 일정하게 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bercakap secara semula jadi seperti biasa dan kekalkan jarak daripada telefon anda."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicaralah secara alami seperti biasa dan jaga jarak yang tetap dari ponsel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki gibi doğal konuşun ve telefonla aranızdaki mesafeyi sabit tutun."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לדבר בטבעיות כרגיל ולשמור על מרחק קבוע מהטלפון."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
