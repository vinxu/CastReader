        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ giọng nói đã đạt giới hạn hằng ngày. Vui lòng thử lại sau."
          }
        }
      }
    },
    "无法确定正文语言，请选择朗读语言": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot identify the text language. Choose a reading language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定正文语言，请选择朗读语言"
          }
