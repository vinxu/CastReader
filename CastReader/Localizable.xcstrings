            "value": "Invite a Friend to Be My Reader"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitar a un amigo a ser mi lector"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviter un ami à devenir mon lecteur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दोस्त को अपना रीडर बनने के लिए आमंत्रित करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita un amico a diventare il mio lettore"
