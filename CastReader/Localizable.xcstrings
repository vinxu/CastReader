    "音频准备超时，请重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiovorbereitung hat zu lange gedauert. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio preparation timed out. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de preparación del audio. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La préparation audio a expiré. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो तैयार होने में बहुत समय लगा। फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparazione dell'audio è scaduta. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の準備がタイムアウトしました。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A preparação do áudio expirou. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频准备超时，请重试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het voorbereiden van de audio duurde te lang. Probeer het opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время подготовки аудио истекло. Пожалуйста, попробуйте снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono limit czasu przygotowania audio. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förberedelse av ljudet tog för lång tid. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forberedelsen af lyden tog for lang tid. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forberedelse av lyd tok for lang tid. Vennligst prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänen valmistelu kesti liian kauan. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příprava zvuku překročila časový limit. Zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έληξε το χρονικό όριο προετοιμασίας του ήχου. Δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang előkészítése túllépte az időkorlátot. Próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-time out ang paghahanda ng audio. Subukan ulit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Persediaan audio telah tamat tempoh. Sila cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregătirea audio a durat prea mult. Încearcă din nou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة إعداد الصوت. حاول مجددًا."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 준비 시간이 초과되었습니다. 다시 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu penyiapan audio habis. Silakan coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses hazırlama zaman aşımına uğradı. Lütfen yeniden deneyin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמן שהוקצב להכנת השמע חלף. יש לנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị âm thanh quá thời gian chờ. Vui lòng thử lại."
          }
        }
      }
    },
    "音频播放失败，请重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
