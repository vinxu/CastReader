            "state": "translated",
            "value": "Adres przesyłania audio referencyjnego jest nieprawidłowy. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen för uppladdning av referensljud är ogiltig. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse til upload af referencelyd er ugyldig. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplastingsadressen for referanseopptaket er ugyldig. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viiteäänen latausosoite on virheellinen. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa pro nahrávání referenčního zvuku je neplatná. Zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση μεταφόρτωσης του ήχου αναφοράς δεν είναι έγκυρη. Δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hivatkozási hang feltöltési címe érvénytelen. Próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang address ng upload ng audio na sanggunian ay hindi wasto. Subukan ulit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat unggah audio referensi tidak valid. Coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat muat naik audio rujukan tidak sah. Cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa de încărcare a fișierului audio de referință nu este validă. Încearcă din nou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans ses yükleme adresi geçersizdir. Tekrar deneyin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובת העלאת שמע הייחוס אינה תקינה. יש לנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ tải âm thanh tham chiếu lên không hợp lệ. Hãy thử lại."
          }
        }
      }
    },
    "录制一小段，或上传已有音频。我们只需要一段清晰、自然的讲话。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen kurzen Clip auf oder lade vorhandenes Audio hoch. Wir brauchen nur eine klare, natürliche Sprachpassage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a short clip or upload existing audio. We only need a clear, natural sample of speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba un fragmento corto o sube un audio existente. Solo necesitamos una muestra de voz clara y natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un court extrait ou importez un audio existant. Il nous suffit d’un échantillon de parole clair et naturel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटा क्लिप रिकॉर्ड करें या मौजूदा ऑडियो अपलोड करें। हमें केवल साफ़, स्वाभाविक आवाज़ का नमूना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un breve clip o carica un audio esistente. Ci basta un campione di parlato chiaro e naturale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短く録音するか、既存の音声をアップロードしてください。明瞭で自然な話し声が少しあれば十分です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave um trecho curto ou envie um áudio existente. Só precisamos de uma amostra de fala nítida e natural."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制一小段，或上传已有音频。我们只需要一段清晰、自然的讲话。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een korte clip op of upload bestaande audio. We hebben alleen een duidelijke, natuurlijke spraakopname nodig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 클립을 녹음하거나 기존 오디오를 업로드하세요. 명확하고 자연스러운 말소리 샘플만 필요합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل مقطعًا قصيرًا أو ارفع ملفًا صوتيًا موجودًا. نحتاج فقط إلى عينة واضحة وطبيعية من الكلام."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите короткий фрагмент или загрузите существующее аудио. Нам нужен лишь чистый, естественный образец речи."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj krótki klip lub prześlij istniejący plik dźwiękowy. Potrzebujemy tylko wyraźnego, naturalnego fragmentu mowy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in ett kort klipp eller ladda upp befintligt ljud. Vi behöver endast ett tydligt, naturligt talprov."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag et kort klip eller upload eksisterende lyd. Vi har kun brug for et klart, naturligt udsnit af tale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill inn et kort klipp eller last opp eksisterende lyd. Vi trenger bare et tydelig, naturlig taleutdrag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänitä lyhyt leike tai lähetä olemassa oleva äänitiedosto. Tarvitsemme vain selkeän ja luonnollisen puhenäytteen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrajte krátkou ukázku nebo odešlete existující zvukový soubor. Stačí nám srozumitelná a přirozená ukázka řeči."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ηχογραφήστε ένα σύντομο απόσπασμα ή ανεβάστε υπάρχον ήχο. Χρειαζόμαστε μόνο ένα καθαρό, φυσικό δείγμα ομιλίας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsen egy rövid részletet, vagy töltsön fel meglévő hangfájlt. Csak egy tiszta, természetes beszédmintára van szükségünk."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magrekord ng maikling clip o i-upload ang umiiral na audio. Kailangan lang namin ng malinaw at natural na sample ng salita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam klip singkat atau unggah audio yang sudah ada. Kami hanya membutuhkan sampel ucapan yang jelas dan alami."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod klip pendek atau muat naik audio sedia ada. Kami hanya memerlukan sampel ucapan yang jelas dan semula jadi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează un fragment scurt sau încarcă un fișier audio existent. Avem nevoie doar de o mostră clară și naturală de vorbire."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir klip kaydedin veya mevcut bir ses yükleyin. Sadece net ve doğal bir konuşma örneğine ihtiyacımız var."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להקליט קטע קצר או להעלות שמע קיים. נדרשת רק דוגמת דיבור ברורה וטבעית."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu một đoạn ngắn hoặc tải âm thanh có sẵn lên. Chỉ cần một mẫu lời nói rõ ràng, tự nhiên."
          }
        }
      }
    },
