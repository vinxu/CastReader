    "本机已解锁，跨平台同步待完成": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät entsperrt. Die plattformübergreifende Synchronisierung steht noch aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked on this device. Cross-platform sync is pending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado en este dispositivo. La sincronización multiplataforma está pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloqué sur cet appareil. La synchronisation multiplateforme est en attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर अनलॉक किया गया. क्रॉस-प्लेटफ़ॉर्म सिंक लंबित है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbloccato su questo dispositivo. La sincronizzazione multipiattaforma è in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではロックが解除されました。クロスプラットフォーム同期は保留中です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado neste dispositivo. A sincronização entre plataformas está pendente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已解锁，跨平台同步待完成"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is actief op dit apparaat. Synchronisatie tussen platforms is nog in behandeling."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Pro가 활성화되었습니다. 플랫폼 간 동기화는 대기 중입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفعيل Pro على هذا الجهاز. المزامنة عبر المنصات قيد الانتظار."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro доступен на этом устройстве. Синхронизация между платформами ожидается."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowano na tym urządzeniu. Synchronizacja międzyplatformowa oczekuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro är aktiverat på denna enhet. Synkronisering mellan plattformar väntar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro er aktiveret på denne enhed. Synkronisering mellem platforme afventer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro er aktivert på denne enheten. Synkronisering mellom plattformer venter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro on käytössä tällä laitteella. Alustojen välinen synkronointi on kesken."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemčeno na tomto zařízení. Synchronizace mezi platformami čeká."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δυνατότητες έχουν ξεκλειδωθεί σε αυτή τη συσκευή. Εκκρεμεί ο συγχρονισμός μεταξύ πλατφορμών."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A funkciók ezen az eszközön feloldva. A platformok közötti szinkronizálás függőben van."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Available na ang Pro sa device na ito. Nakabinbin pa ang pag-sync sa iba pang platform."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuka kunci pada peranti ini. Penyegerakan merentas platform masih belum selesai."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocat pe acest dispozitiv. Sincronizarea interplatformă este în așteptare."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses terbuka di perangkat ini. Sinkronisasi lintas platform masih tertunda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda erişim açıldı. Platformlar arası eşitleme bekliyor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה במכשיר הזה פתוחה. הסנכרון בין פלטפורמות עדיין ממתין."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mở khóa trên thiết bị này. Đồng bộ liên nền tảng đang chờ."
          }
        }
      }
    },
    "本机已解锁；登录邮箱后可完成跨平台同步。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist entsperrt. Melde dich mit deiner E-Mail-Adresse an, um Pro plattformübergreifend zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is unlocked; log in with your email to sync Pro across platforms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; inicie sesión con su correo electrónico para sincronizar Pro entre plataformas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est déverrouillé ; connectez-vous avec votre e-mail pour synchroniser Pro sur toutes les plateformes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपकरण अनलॉक है; प्रो को सभी प्लेटफ़ॉर्म पर सिंक करने के लिए अपने ईमेल से लॉग इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è sbloccato; accedi con la tua email per sincronizzare Pro su tutte le piattaforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはロックが解除されています。メールアドレスでログインして、プラットフォーム間で Pro を同期します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; faça login com seu e-mail para sincronizar o Pro entre plataformas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已解锁；登录邮箱后可完成跨平台同步。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is actief op dit apparaat; log in met uw e-mailadres om Pro tussen platforms te synchroniseren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Pro가 활성화되었습니다. 플랫폼 간에 Pro를 동기화하려면 이메일로 로그인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفعيل Pro على هذا الجهاز؛ سجّل الدخول ببريدك الإلكتروني لمزامنة Pro عبر المنصات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro доступен на этом устройстве. Войдите по электронной почте, чтобы синхронизировать подписку между платформами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie jest odblokowane; zaloguj się za pomocą e-maila, aby synchronizować wersję Pro między platformami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro är aktiverat på denna enhet; logga in med din e-post för att synkronisera Pro mellan plattformar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro er aktiveret på denne enhed; log ind med din e-mail for at synkronisere Pro mellem platforme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro er aktivert på denne enheten. Logg inn med e-post for å synkronisere Pro mellom plattformer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro on käytössä tällä laitteella. Kirjaudu sähköpostilla synkronoidaksesi Pron alustojen välillä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení je odemčeno; pro synchronizaci Pro napříč platformami se přihlaste pomocí e-mailu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δυνατότητες έχουν ξεκλειδωθεί σε αυτή τη συσκευή. Συνδεθείτε με το email σας για συγχρονισμό του Pro μεταξύ πλατφορμών."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz fel van oldva; jelentkezzen be e-mail címmel a Pro funkciók platformok közötti szinkronizálásához."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Available na ang Pro sa device na ito. Mag-sign in gamit ang email upang i-sync ang Pro sa iba pang platform."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro telah diaktifkan pada peranti ini; log masuk dengan e-mel anda untuk menyegerakkan Pro merentas platform."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv este deblocat; autentifică-te cu e-mailul pentru a sincroniza Pro pe toate platformele."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini sudah mendapat akses; masuk dengan email Anda untuk menyinkronkan Pro lintas platform."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda erişim açıldı; Pro'yu platformlar arasında eşitlemek için e-postanızla giriş yapın."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה במכשיר הזה פתוחה; יש להיכנס עם הדוא״ל שלך כדי לסנכרן את Pro בין פלטפורמות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này đã được mở khóa; đăng nhập bằng email để đồng bộ Pro giữa các nền tảng."
          }
        }
      }
    },
    "本机已解锁；跨平台同步等待 Apple 验证接口。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist entsperrt; die plattformübergreifende Synchronisierung wartet auf die Apple-Verifizierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is unlocked; cross-platform sync is waiting for Apple verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; La sincronización multiplataforma está esperando la verificación de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est déverrouillé ; la synchronisation multiplateforme est en attente de vérification Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपकरण अनलॉक है; क्रॉस-प्लेटफ़ॉर्म सिंक Apple सत्यापन की प्रतीक्षा कर रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è sbloccato; la sincronizzazione multipiattaforma è in attesa della verifica di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはロックが解除されています。クロスプラットフォーム同期は Apple の検証を待っています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; a sincronização entre plataformas está aguardando verificação da Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已解锁；跨平台同步等待 Apple 验证接口。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is actief op dit apparaat; synchronisatie tussen platforms wacht op verificatie door Apple."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Pro가 활성화되었습니다. 플랫폼 간 동기화는 Apple 검증을 기다리고 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفعيل Pro على هذا الجهاز؛ المزامنة عبر المنصات بانتظار التحقق من Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro доступен на этом устройстве; синхронизация между платформами ожидает проверки Apple."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie jest odblokowane; synchronizacja międzyplatformowa oczekuje na potwierdzenie Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro är aktiverat på denna enhet; synkronisering mellan plattformar väntar på Apples verifiering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro er aktiveret på denne enhed; synkronisering mellem platforme afventer Apples bekræftelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro er aktivert på denne enheten. Synkronisering mellom plattformer venter på Apples bekreftelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro on käytössä tällä laitteella. Alustojen välinen synkronointi odottaa Applen vahvistusta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení je odemčeno; synchronizace napříč platformami čeká na ověření Apple."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δυνατότητες έχουν ξεκλειδωθεί σε αυτή τη συσκευή. Ο συγχρονισμός μεταξύ πλατφορμών περιμένει την επαλήθευση της Apple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz fel van oldva; a platformok közötti szinkronizálás várja az Apple jóváhagyását."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Available na ang Pro sa device na ito. Naghihintay ng beripikasyon ng Apple ang pag-sync sa iba pang platform."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro telah diaktifkan pada peranti ini; penyegerakan merentas platform menunggu pengesahan Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv este deblocat; sincronizarea interplatformă așteaptă verificarea Apple."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini sudah mendapat akses; sinkronisasi lintas platform menunggu verifikasi Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda erişim açıldı; platformlar arası eşitleme Apple doğrulamasını bekliyor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה במכשיר הזה פתוחה; הסנכרון בין פלטפורמות ממתין לאימות Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này đã được mở khóa; đồng bộ liên nền tảng đang chờ Apple xác minh."
          }
        }
      }
    },
