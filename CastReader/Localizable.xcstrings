    "本机已解锁，跨平台同步待完成": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät entsperrt. Die plattformübergreifende Synchronisierung steht noch aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked on this device. Cross-platform sync is pending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado en este dispositivo. La sincronización multiplataforma está pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloqué sur cet appareil. La synchronisation multiplateforme est en attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर अनलॉक किया गया. क्रॉस-प्लेटफ़ॉर्म सिंक लंबित है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbloccato su questo dispositivo. La sincronizzazione multipiattaforma è in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではロックが解除されました。クロスプラットフォーム同期は保留中です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado neste dispositivo. A sincronização entre plataformas está pendente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已解锁，跨平台同步待完成"
          }
        }
      }
    },
    "本机已解锁；登录邮箱后可完成跨平台同步。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist entsperrt. Melde dich mit deiner E-Mail-Adresse an, um Pro plattformübergreifend zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is unlocked; log in with your email to sync Pro across platforms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; inicie sesión con su correo electrónico para sincronizar Pro entre plataformas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est déverrouillé ; connectez-vous avec votre e-mail pour synchroniser Pro sur toutes les plateformes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपकरण अनलॉक है; प्रो को सभी प्लेटफ़ॉर्म पर सिंक करने के लिए अपने ईमेल से लॉग इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è sbloccato; accedi con la tua email per sincronizzare Pro su tutte le piattaforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはロックが解除されています。メールアドレスでログインして、プラットフォーム間で Pro を同期します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; faça login com seu e-mail para sincronizar o Pro entre plataformas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已解锁；登录邮箱后可完成跨平台同步。"
          }
        }
      }
    },
    "本机已解锁；跨平台同步等待 Apple 验证接口。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
