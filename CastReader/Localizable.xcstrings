    "受保护的音频无法使用，请选择你有权使用的普通本地文件": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschütztes Audio kann nicht verwendet werden. Wähle eine normale lokale Datei aus, die du verwenden darfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected audio cannot be used. Choose a standard local file that you have the right to use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar audio protegido. Elige un archivo local normal que tengas derecho a usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers audio protégés ne peuvent pas être utilisés. Choisissez un fichier local standard que vous avez le droit d’utiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित ऑडियो का उपयोग नहीं किया जा सकता। कोई सामान्य लोकल फ़ाइल चुनें जिसका उपयोग करने का आपको अधिकार है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio protetto non può essere usato. Scegli un normale file locale che hai il diritto di utilizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護された音声は使用できません。使用する権利のある通常のローカルファイルを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Áudios protegidos não podem ser usados. Escolha um arquivo local comum que você tenha o direito de usar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护的音频无法使用，请选择你有权使用的普通本地文件"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschermde audio kan niet worden gebruikt. Kies een gewoon lokaal bestand dat u mag gebruiken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 오디오는 사용할 수 없습니다. 사용할 권리가 있는 표준 로컬 파일을 선택하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام الصوت المحمي. اختر ملفًا محليًا قياسيًا تملك حق استخدامه."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённое аудио использовать нельзя. Выберите стандартный локальный файл, на использование которого у вас есть права."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroniony plik audio nie może być użyty. Wybierz standardowy plik lokalny, którego masz prawo używać."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyddat ljud kan inte användas. Välj en vanlig lokal fil som du har rätt att använda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskyttet lyd kan ikke bruges. Vælg en standard lokal fil, som du har ret til at bruge."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskyttet lyd kan ikke brukes. Velg en standard lokal fil som du har rett til å bruke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattua ääntä ei voi käyttää. Valitse vakio paikallinen tiedosto, jota sinulla on oikeus käyttää."
          }
        },
        "cs": {
          "stringUnit": {
