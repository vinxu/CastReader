            "value": "Sahkan pemadaman"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasi penghapusan"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmă ștergerea"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישור מחיקה"
          }
        }
      }
    },
    "注销后将删除你的账号与个人信息，已购买的订阅不会自动退款。此操作无法撤销。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen deines Kontos werden dein Profil und deine persönlichen Daten entfernt. Laufende Abos werden nicht automatisch erstattet. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account removes your profile and personal data. Existing subscriptions aren't refunded automatically. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar tu cuenta se borran tu perfil y tus datos personales. Las suscripciones activas no se reembolsan automáticamente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de votre compte efface votre profil et vos données personnelles. Les abonnements en cours ne sont pas remboursés automatiquement. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता हटाने पर आपकी प्रोफ़ाइल और निजी जानकारी मिट जाएगी। चालू सदस्यता अपने आप रिफ़ंड नहीं होती। यह वापस नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminando l'account rimuoviamo il tuo profilo e i tuoi dati personali. Gli abbonamenti attivi non vengono rimborsati automaticamente. L'operazione è irreversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除すると、アカウントと個人情報が削除されます。購入済みのサブスクリプションは自動的に返金されません。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta remove seu perfil e seus dados pessoais. Assinaturas ativas não são reembolsadas automaticamente. Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销后将删除你的账号与个人信息，已购买的订阅不会自动退款。此操作无法撤销。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verwijderen van je account verwijdert je profiel en persoonlijke gegevens. Bestaande abonnementen worden niet automatisch terugbetaald. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 삭제하면 프로필과 개인 데이터가 제거됩니다. 기존 구독은 자동으로 환불되지 않으며, 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي حذف حسابك إلى إزالة ملفك الشخصي وبياناتك الشخصية. لن تُسترد رسوم الاشتراكات الحالية تلقائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При удалении аккаунта удаляются ваш профиль и личные данные. Оплата действующих подписок не возвращается автоматически. Это действие нельзя отменить."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie konta usuwa Twój profil i dane osobowe. Opłaty za istniejące subskrypcje nie są automatycznie zwracane. Tej czynności nie można cofnąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att radera ditt konto tar bort din profil och personliga data. Befintliga prenumerationer återbetalas inte automatiskt. Detta kan inte ångras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du sletter din konto, fjernes din profil og personlige data. Eksisterende abonnementer refunderes ikke automatisk. Dette kan ikke fortrydes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du sletter kontoen, fjernes profilen din og personopplysningene dine. Eksisterende abonnementer refunderes ikke automatisk. Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilin poistaminen poistaa profiilisi ja henkilötietosi. Olemassa olevia tilauksia ei hyvitetä automaattisesti. Poistoa ei voi perua."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή του λογαριασμού σας αφαιρεί το προφίλ και τα προσωπικά σας δεδομένα. Δεν γίνεται αυτόματη επιστροφή χρημάτων για τις υπάρχουσες συνδρομές. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabubura ang iyong profile at personal na data kapag tinanggal ang account. Hindi awtomatikong ire-refund ang bayad sa mga kasalukuyang subscription. Hindi na ito maibabalik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızı silmek profilinizi ve kişisel verilerinizi kaldırır. Mevcut aboneliklerin ücretleri otomatik olarak iade edilmez. Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xóa tài khoản sẽ loại bỏ hồ sơ và dữ liệu cá nhân của bạn. Các gói đăng ký hiện có sẽ không được hoàn tiền tự động. Hành động này không thể hoàn tác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazáním účtu odstraníte svůj profil a osobní údaje. Platby za stávající předplatné se automaticky nevracejí. Tuto akci nelze vrátit zpět."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiók törlésével a profilod és személyes adataid is törlődnek. A meglévő előfizetések díját nem térítjük vissza automatikusan. Ez a művelet nem vonható vissza."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam akaun anda akan membuang profil dan data peribadi anda. Langganan sedia ada tidak dibayar balik secara automatik. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus akun akan menghapus profil dan data pribadi Anda. Langganan yang ada tidak otomatis dikembalikan dananya. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea contului elimină profilul și datele tale personale. Abonamentele existente nu sunt rambursate automat. Acțiunea este ireversibilă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת החשבון מסירה את הפרופיל ואת המידע האישי שלך. מינויים קיימים אינם מזוכים אוטומטית. לא ניתן לבטל פעולה זו."
          }
        }
      }
    },
