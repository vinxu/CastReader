    "每 24 小时只能创建一个声音": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nur alle 24 Stunden eine Stimme erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create only one voice every 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes crear solo una voz cada 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez créer qu'une seule voix toutes les 24 heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप हर 24 घंटे में केवल एक आवाज बना सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
