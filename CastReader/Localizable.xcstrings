    "将删除文库中全部本地历史，此操作不可撤销。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der gesamte lokale Verlauf in deiner Bibliothek gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all local history in your Library. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará todo el historial local de su biblioteca. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera tout l'historique local de votre bibliothèque. Cette action ne peut pas être annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपकी लाइब्रेरी का सारा स्थानीय इतिहास हट जाएगा। इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione eliminerà tutta la cronologia locale nella tua Libreria. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、ライブラリ内のすべてのローカル履歴が削除されます。この操作は元に戻すことができません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso excluirá todo o histórico local da sua biblioteca. Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除文库中全部本地历史，此操作不可撤销。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt alle lokale geschiedenis in uw bibliotheek verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함의 모든 로컬 기록이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع السجلات المحلية في مكتبتك. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие удалит всю локальную историю в вашей библиотеке. Это действие нельзя отменить."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie całej lokalnej historii w Twojej bibliotece. Tej akcji nie można cofnąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort all lokal historik i ditt Bibliotek. Denna åtgärd kan inte ångras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter al lokal historik i dit Bibliotek. Denne handling kan ikke fortrydes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter all lokal historikk i biblioteket ditt. Denne handlingen kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki paikalliset historia-tiedot kirjastostasi. Tätä toimintoa ei voi peruuttaa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se smaže celá místní historie vaší knihovny. Tuto akci nelze vrátit zpět."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα διαγράψει όλο το τοπικό ιστορικό στη Βιβλιοθήκη σας. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buburahin nito ang lahat ng lokal na kasaysayan sa iyong Aklatan. Hindi na ito maibabalik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va șterge tot istoricul local din Biblioteca ta. Această acțiune nu poate fi anulată."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động này sẽ xóa toàn bộ lịch sử cục bộ trong Thư viện của bạn. Hành động này không thể hoàn tác."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli a könyvtárad összes helyi előzményét. A művelet nem vonható vissza."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan memadam semua sejarah setempat dalam Pustaka anda. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan menghapus semua riwayat lokal di Pustaka Anda. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem Kitaplığınızdaki tüm yerel geçmişi siler. Bu işlem geri alınamaz."
