    "上次还没听完，接着听？": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast letztes Mal nicht zu Ende gehört. Dort weitermachen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn't finish last time. Pick up where you left off?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No terminaste la última vez. ¿Continuamos donde lo dejaste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'aviez pas terminé. Reprendre là où vous en étiez ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली बार आपने पूरा नहीं सुना। जहाँ छोड़ा था वहीं से जारी रखें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima volta non hai finito. Riprendiamo da dove eri rimasto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回は最後まで聞いていません。続きから再生しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não terminou da última vez. Continuar de onde parou?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次还没听完，接着听？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U hebt het de vorige keer niet uitgelezen. Verdergaan waar u was gebleven?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막에 끝내지 못했습니다. 멈췄던 곳에서 계속하시겠습니까?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكمل القراءة آخر مرة. هل تريد الاستئناف من حيث توقفت؟"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не закончили в прошлый раз. Продолжить с того же места?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie czytanie nie zostało ukończone. Wznowić od miejsca przerwania?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du avslutade inte förra gången. Vill du fortsätta där du slutade?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du fuldførte ikke sidste gang. Vil du fortsætte, hvor du stoppede?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du fullførte ikke sist gang. Fortsett der du slapp?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et päättänyt lukemista viime kerralla. Haluatko jatkaa siitä, mihin jäit?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minule jste čtení nedokončili. Pokračovat tam, kde jste přestali?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ολοκληρώσατε την προηγούμενη φορά. Θέλετε να συνεχίσετε από εκεί που σταματήσατε;"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem fejezte be legutóbb. Folytatja ott, ahol abbahagyta?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mo natapos noong nakaraang beses. Magpatuloy sa punto kung saan ka huminto?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son seferde bitiremediniz. Bıraktığınız yerden devam etmek ister misiniz?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum selesai kali terakhir. Sambung dari tempat anda berhenti?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum selesai terakhir kali. Lanjutkan dari bagian terakhir?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ai terminat data trecută. Continui de unde ai rămas?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא סיימת בפעם הקודמת. להמשיך מהמקום שבו עצרת?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần trước bạn chưa đọc xong. Tiếp tục từ chỗ đã dừng?"
          }
        }
      }
    },
