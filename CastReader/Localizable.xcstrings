        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। अपनी सहेजी हुई किताबें खोलें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
