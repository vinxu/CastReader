        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서재는 저장되었지만 동기화 여부를 확인하지 못했습니다. 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka anda telah disimpan, tetapi penyegerakan tidak dapat disahkan. Sila cuba lagi."
          }
