    "录制文案已跟随你的 App 语言，生成的声音可以跨语言使用": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufnahmetext folgt deiner App-Sprache. Die erstellte Stimme kann sprachübergreifend verwendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording script follows your app language. Your generated voice can be used across languages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de grabación sigue el idioma de la app. La voz creada puede usarse en varios idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
