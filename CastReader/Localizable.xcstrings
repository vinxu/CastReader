        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou os 120 minutos mensais de voz clonada. Mude para uma voz predefinida para continuar a leitura ou explicação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月 120 分钟的克隆音色额度已用完。你可以切换到预设音色继续朗读或解读。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U heeft deze maand de 120 minuten voor gekloonde stemmen bereikt. Schakel over naar een vooraf ingestelde stem om door te lezen of uit te leggen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استهلكت 120 دقيقة من الاستنساخ الصوتي لهذا الشهر. انتقل إلى صوت محدد مسبقًا للمتابعة في القراءة أو الشرح."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы использовали все 120 минут озвучивания клонированным голосом за этот месяц. Переключитесь на готовый голос, чтобы продолжить чтение или объяснение."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystano miesięczny limit 120 minut użycia sklonowanego głosu. Przełącz się na gotowy głos, aby kontynuować czytanie lub wyjaśnianie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har använt denna månads 120 minuter för klonad röst. Byt till en förinställd röst för att fortsätta läsa eller förklara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brugt denne måneds 120 minutter med klonet stemme. Skift til en forudindstillet stemme for at fortsætte med at læse eller forklare."
          }
