    "购买前需要登录邮箱，用于跨设备同步 Pro。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich vor dem Kauf mit deiner E-Mail an, damit Pro geräteübergreifend synchronisiert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your email before purchasing so Pro syncs across your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu correo antes de comprar para sincronizar Pro entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre e-mail avant l'achat pour synchroniser Pro sur vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदने से पहले अपने ईमेल से साइन इन करें, ताकि Pro सभी डिवाइस पर सिंक हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con la tua email prima dell'acquisto per sincronizzare Pro su tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入前にメールでログインしてください。Pro を複数のデバイスで同期するために必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login com seu e-mail antes de comprar para sincronizar o Pro entre dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买前需要登录邮箱，用于跨设备同步 Pro。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met uw e-mailadres voordat u koopt, zodat Pro over uw apparaten kan synchroniseren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول باستخدام بريدك الإلكتروني قبل الشراء حتى تتم مزامنة Pro عبر أجهزتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите по электронной почте перед покупкой, чтобы Pro синхронизировался между вашими устройствами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się za pomocą e-maila przed zakupem, aby synchronizacja Pro działała na wszystkich urządzeniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med din e-post innan du köper så att Pro synkroniseras över dina enheter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med din e-mail før køb, så Pro synkroniseres på tværs af dine enheder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn med e-post før du kjøper, slik at Pro synkroniseres på alle enhetene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sähköpostilla ennen ostamista, jotta Pro synkronoituu laitteidesi välillä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před nákupem se přihlaste pomocí e-mailu, aby se Pro synchronizovalo napříč vašimi zařízeními."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε με το email σας πριν την αγορά, ώστε ο συγχρονισμός Pro να λειτουργεί σε όλες τις συσκευές σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be e-mail-címével vásárlás előtt, hogy a Pro szinkronizálva legyen az eszközein."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in gamit ang iyong email bago bumili upang ma-sync ang Pro sa iyong mga device."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan email Anda sebelum membeli agar Pro tersinkronisasi di semua perangkat Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk menggunakan e-mel anda sebelum membeli supaya Pro dapat disegerakkan pada semua peranti anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng email trước khi mua để Pro đồng bộ trên các thiết bị của bạn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 기기에서 Pro를 동기화하려면 구매 전에 이메일로 로그인하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro'nun cihazlarınız arasında eşitlenmesi için satın almadan önce e-postanızla giriş yapın."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te cu e-mailul înainte de cumpărare pentru a sincroniza Pro pe toate dispozitivele."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להיכנס עם הדוא״ל שלך לפני הרכישה כדי ש־Pro יסונכרן בין המכשירים שלך."
          }
        }
      }
    },
