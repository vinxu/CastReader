        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a helyi másolat törölve lett. Térjen vissza az Offline könyvekhez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naalis ang lokal na kopya. Bumalik sa Mga Aklat Offline."
