        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות הדיבור הגיע למגבלה היומית שלו. יש לנסות שוב מאוחר יותר."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan suara telah mencapai batas harian. Silakan coba lagi nanti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan suara telah mencapai had hariannya. Sila cuba lagi kemudian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul vocal a atins limita zilnică. Încearcă din nou mai târziu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses hizmeti günlük sınırına ulaştı. Lütfen daha sonra yeniden deneyin."
