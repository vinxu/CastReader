    "页面范围未能连续确认，下载已停止，已有内容保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面范围未能连续确认，下载已停止，已有内容保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page continuity could not be confirmed. Downloading has stopped and saved pages are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの連続性を確認できず、ダウンロードを停止しました。保存済みの内容は残っています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la continuidad de las páginas. La descarga se detuvo y el contenido guardado se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La continuité des pages n’a pas pu être confirmée. Le téléchargement est arrêté et le contenu enregistré est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seitenfolge konnte nicht bestätigt werden. Der Download wurde gestoppt; gespeicherte Inhalte bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a sequência das páginas. O download parou e o conteúdo salvo foi mantido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare la continuità delle pagine. Il download è stato interrotto e i contenuti salvati sono conservati."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पन्नों का लगातार क्रम सत्यापित नहीं हो सका। डाउनलोड रोक दिया गया है और सहेजी गई सामग्री बनी हुई है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paginacontinuïteit kon niet worden bevestigd. Downloaden is gestopt en opgeslagen pagina's zijn bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 연속성을 확인할 수 없습니다. 다운로드가 중지되었으며 저장된 페이지는 유지됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التأكد من تتابع الصفحات. توقف التنزيل مع الاحتفاظ بالصفحات المحفوظة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить непрерывность страниц. Загрузка остановлена, сохранённые страницы оставлены."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potwierdzono ciągłości stron. Pobieranie zostało zatrzymane, a zapisane strony zachowane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidkontinuitet kunde inte bekräftas. Nedladdningen har stoppats och sparade sidor har behållits."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidesammenhæng kunne ikke bekræftes. Download er stoppet, og gemte sider er beholdt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidekontinuitet kunne ikke bekreftes. Nedlasting er stoppet, og lagrede sider beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sivujen yhtenäisyyttä ei voitu varmistaa. Lataus on pysäytetty ja tallennetut sivut on säilytetty."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návaznost stránek se nepodařilo potvrdit. Stahování se zastavilo a uložené stránky zůstaly zachovány."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν επιβεβαιώθηκε η συνέχεια σελίδων. Η λήψη έχει σταματήσει και οι αποθηκευμένες σελίδες έχουν διατηρηθεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az oldalak folytonossága nem igazolható. A letöltés leállt, a mentett oldalak megmaradtak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makumpirma na magkakasunod ang mga pahina. Itinigil ang pag-download at pinanatili ang mga naka-save na pahina."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את רצף העמודים. ההורדה הופסקה והדפים שכבר נשמרו יישארו זמינים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontinuitas halaman tidak dapat dikonfirmasi. Pengunduhan berhenti dan halaman yang disimpan tetap dipertahankan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinambungan halaman tidak dapat disahkan. Muat turun dihentikan dan halaman tersimpan dikekalkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuitatea paginilor nu a putut fi confirmată. Descărcarea s-a oprit, iar paginile salvate sunt păstrate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfa devamlılığı doğrulanamadı. İndirme durduruldu; kaydedilen sayfalar korundu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận các trang liền mạch. Đã dừng tải xuống và giữ lại các trang đã lưu."
          }
        }
      }
    },
    "书籍版式已变化，请恢复下载时的版式后继续。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书籍版式已变化，请恢复下载时的版式后继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The book layout has changed. Restore the original layout before continuing the download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本のレイアウトが変わりました。ダウンロード時のレイアウトに戻してから再開してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diseño del libro cambió. Restaura el diseño original para continuar la descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en page a changé. Rétablissez celle utilisée au téléchargement pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buchlayout hat sich geändert. Stelle zum Fortsetzen das ursprüngliche Layout wieder her."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O layout do livro mudou. Restaure o layout original para continuar o download."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impaginazione è cambiata. Ripristina quella originale per continuare il download."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किताब का लेआउट बदल गया है। जारी रखने से पहले डाउनलोड के समय वाला लेआउट बहाल करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De boekopmaak is gewijzigd. Herstel de oorspronkelijke opmaak voordat u doorgaat met downloaden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책 레이아웃이 변경되었습니다. 다운로드를 계속하기 전에 원래 레이아웃을 복원하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير تخطيط الكتاب. استعد التخطيط الأصلي قبل مواصلة التنزيل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макет книги изменился. Восстановите исходный макет перед продолжением загрузки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ książki uległ zmianie. Przywróć oryginalny układ przed kontynuowaniem pobierania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokens layout har ändrats. Återställ den ursprungliga layouten innan du fortsätter nedladdningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogens layout er ændret. Genopret det oprindelige layout, før du fortsætter downloaden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokens layout har endret seg. Gjenopprett den opprinnelige layouten før du fortsetter nedlasting."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjan ulkoasu on muuttunut. Palauta alkuperäinen ulkoasu ennen latauksen jatkamista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozložení knihy se změnilo. Před pokračováním ve stahování obnovte původní rozložení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διάταξη του βιβλίου έχει αλλάξει. Επαναφέρετε την αρχική διάταξη πριν συνεχίσετε τη λήψη."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyv elrendezése megváltozott. Helyezze vissza az eredeti elrendezést a letöltés folytatása előtt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang layout ng aklat. Balikan ang orihinal na layout bago magpatuloy sa pag-download."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עיצוב הספר השתנה. שחזר את העיצוב המקורי לפני המשך ההורדה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak buku telah berubah. Kembalikan tata letak asli sebelum melanjutkan pengunduhan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun atur buku telah berubah. Pulihkan susun atur asal sebelum meneruskan muat turun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspectul cărții s-a schimbat. Restabilește aspectul inițial înainte de a continua descărcarea."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitabın düzeni değişti. İndirmeye devam etmeden önce asıl düzeni geri yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục sách đã thay đổi. Khôi phục bố cục ban đầu trước khi tiếp tục tải xuống."
          }
        }
      }
    },
    "账号已变化，请重新打开当前账号的书籍。": {
      "localizations": {
