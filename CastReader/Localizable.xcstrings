    "已检测到购买，本机已解锁；跨平台同步等待 Apple 验证接口。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf erkannt. Dieses Gerät ist entsperrt; die plattformübergreifende Synchronisierung wartet auf die Apple-Verifizierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase detected. This device is unlocked; cross-platform sync is waiting for Apple verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra detectada. Este dispositivo está desbloqueado; La sincronización multiplataforma está esperando la verificación de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat détecté. Cet appareil est déverrouillé ; la synchronisation multiplateforme est en attente de vérification Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी का पता चला. यह उपकरण अनलॉक है; क्रॉस-प्लेटफ़ॉर्म सिंक Apple सत्यापन की प्रतीक्षा कर रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto rilevato. Questo dispositivo è sbloccato; la sincronizzazione multipiattaforma è in attesa della verifica di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入が検出されました。このデバイスはロックが解除されています。クロスプラットフォーム同期は Apple の検証を待っています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra detectada. Este dispositivo está desbloqueado; a sincronização entre plataformas está aguardando verificação da Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到购买，本机已解锁；跨平台同步等待 Apple 验证接口。"
          }
        }
      }
    },
    "已检测到购买，请登录邮箱同步 Pro": {
