    "Today is a pleasant day. I am recording this sample in a clear, natural voice so CastReader can reproduce my voice accurately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist ein angenehmer Tag. Ich nehme dieses Beispiel mit klarer, natürlicher Stimme auf, damit CastReader meine Stimme genau wiedergeben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is a pleasant day. I am recording this sample in a clear, natural voice so CastReader can reproduce my voice accurately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es un día agradable. Estoy grabando esta muestra con una voz clara y natural para que CastReader pueda reproducir mi voz con precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui est une journée agréable. J'enregistre cet échantillon avec une voix claire et naturelle afin que CastReader puisse reproduire ma voix avec précision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का दिन सुखद है. मैं इस नमूने को स्पष्ट, प्राकृतिक आवाज में रिकॉर्ड कर रहा हूं ताकि CastReader मेरी आवाज को सटीक रूप से पुन: पेश कर सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è una giornata piacevole. Sto registrando questo campione con una voce chiara e naturale in modo che CastReader possa riprodurre accuratamente la mia voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は楽しい一日です。このサンプルはクリアで自然な声で録音しているので、CastReader で私の声を正確に再現できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje é um dia agradável. Estou gravando esta amostra com uma voz clara e natural para que o CastReader possa reproduzir minha voz com precisão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is a pleasant day. I am recording this sample in a clear, natural voice so CastReader can reproduce my voice accurately."
          }
        }
      }
    },
