        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text size in images and PDFs is set by the original document."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schriftgröße in Bildern und PDFs wird vom Originaldokument bestimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del texto en imágenes y PDF depende del documento original."
          }
        },
        "fr": {
