    "整本已保存到这台设备，可离线阅读和朗读。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整本已保存到这台设备，可离线阅读和朗读。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entire book is saved on this device. You can read or listen offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本全体をこの端末に保存しました。オフラインで読書・読み上げができます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El libro completo está guardado en este dispositivo. Puedes leerlo o escucharlo sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le livre entier est enregistré sur cet appareil. Vous pouvez le lire ou l’écouter hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Buch ist auf diesem Gerät gespeichert. Du kannst es offline lesen oder anhören."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O livro inteiro está salvo neste dispositivo. Você pode ler ou ouvir offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intero libro è salvato su questo dispositivo. Puoi leggerlo o ascoltarlo offline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी किताब इस डिवाइस पर सहेज दी गई है। आप इसे ऑफ़लाइन पढ़ या सुन सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het hele boek is opgeslagen op dit apparaat. U kunt offline lezen of luisteren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 책이 이 기기에 저장되었습니다. 오프라인으로 읽거나 들을 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ الكتاب بالكامل على هذا الجهاز. يمكنك القراءة أو الاستماع إليه دون اتصال."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся книга сохранена на этом устройстве. Вы можете читать или слушать её офлайн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała książka jest zapisana na tym urządzeniu. Możesz czytać lub słuchać offline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela boken är sparad på denna enhet. Du kan läsa eller lyssna offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele bogen er gemt på denne enhed. Du kan læse eller lytte offline."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele boken er lagret på denne enheten. Du kan lese eller lytte offline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko kirja on tallennettu tälle laitteelle. Voit lukea tai kuunnella sitä offline-tilassa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá kniha je uložena v tomto zařízení. Můžete číst nebo poslouchat offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολόκληρο το βιβλίο έχει αποθηκευτεί σε αυτή τη συσκευή. Μπορείτε να διαβάσετε ή να ακούσετε εκτός σύνδεσης."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes könyv mentve van ezen az eszközön. Internetkapcsolat nélkül is olvashatja vagy hallgathatja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang buong libro ay naka-save sa device na ito. Maaari kang magbasa o makinig nang offline."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh buku telah disimpan pada peranti ini. Anda boleh membaca atau mendengar di luar talian."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספר כולו נשמר במכשיר זה. ניתן לקרוא או להאזין במצב לא מקוון."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh buku tersimpan di perangkat ini. Anda dapat membaca atau mendengarkan secara offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreaga carte este salvată pe acest dispozitiv. Poți citi sau asculta offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitabın tamamı bu cihaza kaydedildi. Çevrimdışı okuyabilir veya dinleyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ sách đã được lưu trên thiết bị này. Bạn có thể đọc hoặc nghe ngoại tuyến."
          }
        }
      }
    },
    "保存整本书的页面图片，朗读时再在本机识别文字。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存整本书的页面图片，朗读时再在本机识别文字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the book’s page images now. Text is recognized on this device when you start listening."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本全体のページ画像を保存します。読み上げ開始時に、この端末で文字を認識します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las imágenes de todas las páginas. El texto se reconoce en el dispositivo al escuchar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les images de toutes les pages. Le texte sera reconnu sur cet appareil au lancement de la lecture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere alle Seitenbilder. Der Text wird beim Vorlesen auf diesem Gerät erkannt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve as imagens de todas as páginas. O texto será reconhecido no dispositivo ao ouvir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le immagini di tutte le pagine. Il testo viene riconosciuto sul dispositivo quando inizi ad ascoltare."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी किताब के पन्नों की तस्वीरें सहेजें। सुनना शुरू करने पर टेक्स्ट इसी डिवाइस पर पहचाना जाएगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla nu de paginabeelden van het boek op. Tekst wordt herkend op dit apparaat wanneer u begint met luisteren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 책의 페이지 이미지를 저장합니다. 듣기를 시작하면 기기에서 텍스트가 인식됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ صور صفحات الكتاب الآن. يتم التعرف على النص على هذا الجهاز عند بدء الاستماع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните изображения страниц книги сейчас. Текст распознаётся на устройстве при начале воспроизведения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz teraz obrazy stron książki. Tekst zostanie rozpoznany na tym urządzeniu podczas uruchamiania odsłuchiwania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara bokens bildsidor nu. Textigenkänning sker på enheten när du börjar lyssna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem bogens billedsider nu. Tekst genkendes på enheden, når du starter afspilning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre bilder av bokens sider nå. Teksten gjenkjennes på denne enheten når du begynner å lytte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna kirjan sivukuvat nyt. Teksti tunnistetaan laitteella, kun aloitat kuuntelun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní uložte obrázky stránek knihy. Text je rozpoznán na tomto zařízení při spuštění poslechu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε τώρα τις εικόνες των σελίδων του βιβλίου. Το κείμενο αναγνωρίζεται στη συσκευή όταν ξεκινάτε την ακρόαση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentse most a könyv oldalképeit. A szöveg felismerése ezen az eszközön történik, amikor elindítja a hallgatást."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save ang mga larawan ng pahina ng libro ngayon. Ang teksto ay kinikilala sa device na ito kapag nagsimula kang makinig."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan imej halaman buku sekarang. Teks akan dikenal pasti pada peranti ini apabila anda mula mendengar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשמור כעת את תמונות עמודי הספר. הטקסט יזוהה במכשיר זה עם תחילת ההאזנה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan gambar halaman buku sekarang. Teks akan dikenali di perangkat ini saat Anda mulai mendengarkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează acum imaginile paginilor cărții. Textul este recunoscut pe acest dispozitiv când începi să asculți."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitabın sayfa görüntülerini şimdi kaydedin. Dinlemeye başladığınızda metin bu cihazda tanınır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ảnh các trang sách ngay bây giờ. Văn bản sẽ được nhận dạng trên thiết bị này khi bạn bắt đầu nghe."
          }
        }
      }
    },
