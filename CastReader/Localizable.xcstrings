    "已在其他设备购买？登录恢复 Pro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits auf einem anderen Gerät gekauft? Anmelden, um Pro wiederherzustellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already purchased on another device? Sign in to restore Pro"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya compraste en otro dispositivo? Inicia sesión para restaurar Pro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà acheté sur un autre appareil ? Connectez-vous pour restaurer Pro"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले से ही किसी अन्य डिवाइस पर खरीदा गया है? प्रो को पुनर्स्थापित करने के लिए साइन इन करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già acquistato su un altro dispositivo? Accedi per ripristinare Pro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスですでに購入していますか?サインインして Pro を復元する"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já comprou em outro dispositivo? Faça login para restaurar o Pro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在其他设备购买？登录恢复 Pro"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al gekocht op een ander apparaat? Log in om Pro te herstellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이미 구매하셨나요? Pro 복원을 위해 로그인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل اشتريت بالفعل على جهاز آخر؟ سجّل الدخول لاستعادة Pro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже куплено на другом устройстве? Войдите, чтобы восстановить Pro"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupiono już na innym urządzeniu? Zaloguj się, aby przywrócić wersję Pro"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redan köpt på en annan enhet? Logga in för att återställa Pro"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede købt på en anden enhed? Log ind for at gendanne Pro"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede kjøpt på en annen enhet? Logg inn for å gjenopprette Pro"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo ostanut toisella laitteella? Kirjaudu sisään palauttaaksesi Pro:n."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Již zakoupeno na jiném zařízení? Přihlaste se pro obnovení Pro."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε ήδη αγοράσει σε άλλη συσκευή; Συνδεθείτε για να αποκαταστήσετε το Pro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már megvásárolta más eszközön? Jelentkezzen be a Pro visszaállításához."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumili ka na ba sa ibang device? Mag-sign in upang i-restore ang Pro"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah dibeli pada peranti lain? Log masuk untuk memulihkan Pro"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazda satın aldınız mı? Pro’yu geri yüklemek için giriş yapın"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah membeli di perangkat lain? Masuk untuk memulihkan Pro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cumpărat deja pe alt dispozitiv? Conectează-te pentru a restaura Pro"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר רכשת במכשיר אחר? יש להיכנס כדי לשחזר את Pro"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mua trên thiết bị khác? Đăng nhập để khôi phục Pro"
          }
        }
      }
    },
