        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשנות את השם בכל עת לאחר היצירה בלי להשפיע על הקול"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
