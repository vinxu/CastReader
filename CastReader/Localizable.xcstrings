        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw opname hoeft niet woord voor woord overeen te komen met de voorbeeldtekst. Uw opname is bewaard; probeer het opnieuw zonder deze te wijzigen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يشترط أن يطابق تسجيلك نص العينة كلمةً بكلمة. تم حفظ تسجيلك؛ أعد المحاولة به دون تغييره."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно повторять образец слово в слово. Ваша запись сохранена; можно повторить её обработку без изменений."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie nie musi dokładnie odpowiadać przykładowemu tekstowi. Twoje nagranie zostało zachowane; spróbuj ponownie bez wprowadzania zmian."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Provtexten behöver inte matcha ord för ord. Din inspelning sparades; försök igen oförändrad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempelteksten behøver ikke matche ord for ord. Din optagelse er gemt; prøv igen uden ændringer."
