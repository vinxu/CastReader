        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 문구와 단어까지 일치할 필요는 없습니다. 녹음이 보관되었으니 그대로 다시 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks sampel tidak harus diikuti kata demi kata. Rekaman Anda tersimpan; coba lagi tanpa mengubahnya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul de exemplu nu trebuie să coincidă cuvânt cu cuvânt. Înregistrarea a fost păstrată; reîncearc-o fără modificări."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין צורך להתאים לטקסט הדוגמה מילה במילה. ההקלטה שלך נשמרה; אפשר לנסות אותה שוב ללא שינוי."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần đọc đúng từng từ trong văn bản mẫu. Bản thu đã được giữ lại; hãy thử lại mà không cần thay đổi."
          }
        }
      }
    },
