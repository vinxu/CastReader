        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane. Aby kontynuować pobieranie, utrzymuj ten ekran aktywny. Zapisane strony zostały zachowane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausad. Håll denna skärm öppen för att ladda ner. Sparade sidor har behållits."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat på pause. Hold denne skærm åben for at downloade. Gemte sider er bevaret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauset. Hold denne skjermen åpen for å fortsette nedlasting. Lagrede sider beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauko. Pidä tämä näyttö auki latauksen jatkamiseksi. Tallennetut sivut on säilytetty."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno. Pro stahování ponechte tuto obrazovku otevřenou. Uložené stránky byly zachovány."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε παύση. Κρατήστε αυτή την οθόνη ανοιχτή για να συνεχιστεί η λήψη. Οι αποθηκευμένες σελίδες έχουν διατηρηθεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve. Tartsa nyitva ezt a képernyőt a letöltéshez. A mentett oldalak megmaradtak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause. Panatilihing bukas ang screen na ito upang mag-download. Mananatili ang mga naka-save na pahina."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושהה. השאר מסך זה פתוח כדי להוריד. הדפים שכבר נשמרו יישארו זמינים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda. Biarkan layar ini terbuka untuk mengunduh. Halaman yang disimpan tetap dipertahankan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda. Kekalkan skrin ini terbuka untuk memuat turun. Halaman tersimpan telah dikekalkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În pauză. Păstrează acest ecran deschis pentru a descărca. Paginile salvate au fost păstrate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı. İndirmek için bu ekranı açık tutun. Kaydedilen sayfalar korundu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng. Giữ màn hình này mở để tải xuống. Các trang đã lưu được giữ lại."
          }
        }
      }
    },
