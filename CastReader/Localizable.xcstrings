    "微信读书书籍链接已失效，请重新登录并同步书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser WeRead-Buchlink ist abgelaufen. Melde dich erneut an und synchronisiere deine Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This WeRead book link has expired. Sign in again and sync your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de este libro de WeRead ha caducado. Vuelve a iniciar sesión y sincroniza tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien de ce livre WeRead a expiré. Reconnectez-vous et synchronisez votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस WeRead किताब का लिंक समाप्त हो गया है। फिर से साइन इन करके लाइब्रेरी सिंक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link di questo libro WeRead è scaduto. Accedi di nuovo e sincronizza la libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この WeRead の本のリンクは無効です。再度ログインして本棚を同期してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link deste livro do WeRead expirou. Entre novamente e sincronize sua biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微信读书书籍链接已失效，请重新登录并同步书架。"
          }
        }
      }
    },
