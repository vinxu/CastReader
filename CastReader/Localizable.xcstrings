          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות ההסברים עדיין לא זיהה את מצב Pro שלך. יש לנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
