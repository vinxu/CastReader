    "书架中没有找到这本书，请重新同步微信读书书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Buch wurde in deiner Bibliothek nicht gefunden. Synchronisiere deine WeRead-Bibliothek erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book was not found in your library. Sync your WeRead library again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este libro no se encontró en tu biblioteca. Vuelve a sincronizar tu biblioteca de WeRead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce livre est introuvable dans votre bibliothèque. Synchronisez à nouveau votre bibliothèque WeRead."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह किताब आपकी लाइब्रेरी में नहीं मिली। अपनी WeRead लाइब्रेरी फिर से सिंक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo libro non è stato trovato nella libreria. Sincronizza di nuovo la libreria WeRead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本棚にこの本が見つかりません。WeRead 本棚をもう一度同期してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este livro não foi encontrado na sua biblioteca. Sincronize novamente a biblioteca do WeRead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架中没有找到这本书，请重新同步微信读书书架。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit boek is niet gevonden in uw bibliotheek. Synchroniseer uw WeRead-bibliotheek opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 책을 라이브러리에서 찾을 수 없습니다. WeRead 라이브러리를 다시 동기화하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على هذا الكتاب في مكتبتك. قم بمزامنة مكتبة WeRead مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта книга не найдена в вашей библиотеке. Повторите синхронизацию библиотеки WeRead."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono tej książki w bibliotece. Ponownie zsynchronizuj bibliotekę WeRead."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här boken hittades inte i ditt bibliotek. Synkronisera ditt WeRead-bibliotek igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bog blev ikke fundet i dit bibliotek. Synkroniser dit WeRead-bibliotek igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne boken ble ikke funnet i biblioteket ditt. Synkroniser WeRead-biblioteket ditt igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kirjaa ei löytynyt kirjastostasi. Synkronoi WeRead-kirjastosi uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kniha nebyla nalezena ve vaší knihovně. Znovu synchronizujte svou knihovnu WeRead."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το βιβλίο δεν βρέθηκε στη βιβλιοθήκη σας. Συγχρονίστε ξανά τη βιβλιοθήκη WeRead."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a könyv nem található a könyvtárában. Szinkronizálja újra a WeRead-könyvtárat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nakita ang aklat sa iyong aklatan. I-sync muli ang iyong WeRead aklatan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku ini tidak ditemukan di perpustakaan Anda. Sinkronkan kembali perpustakaan WeRead Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku ini tidak dijumpai dalam pustaka anda. Segerakkan semula pustaka WeRead anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy cuốn sách này trong thư viện của bạn. Hãy đồng bộ lại thư viện WeRead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitap kitaplığınızda bulunamadı. WeRead kitaplığınızı yeniden eşitleyin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această carte nu a fost găsită în bibliotecă. Sincronizează din nou biblioteca WeRead."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספר לא נמצא בספרייה שלך. יש לסנכרן מחדש את ספריית WeRead."
          }
        }
      }
    },
    "书架仍在加载，请稍后重试。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek wird noch geladen. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library is still loading. Try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca todavía se está cargando. Inténtalo de nuevo en unos instantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque est encore en cours de chargement. Réessayez dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी अभी लोड हो रही है। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria è ancora in caricamento. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本棚を読み込み中です。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca ainda está carregando. Tente novamente em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架仍在加载，请稍后重试。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bibliotheek wordt nog geladen. Probeer het over even opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리가 아직 로드 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكتبة لا تزال تُحمّل. حاول مرة أخرى قريبًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека всё ещё загружается. Попробуйте снова через короткое время."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka nadal się ładuje. Spróbuj ponownie za chwilę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket laddas fortfarande. Försök igen om en stund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket indlæses stadig. Prøv igen om et øjeblik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket lastes fortsatt. Prøv igjen om kort tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjasto lataa edelleen. Yritä myöhemmin uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna se stále načítá. Zkuste to znovu za chvíli."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βιβλιοθήκη φορτώνεται ακόμα. Δοκιμάστε ξανά σύντομα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyvtár még betöltődik. Próbálja meg később."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naglo-load pa rin ang aklatan. Subukan ulit sa sandali."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perpustakaan masih memuat. Silakan coba lagi sebentar lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka masih dimuatkan. Cuba sebentar lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện vẫn đang tải. Vui lòng thử lại sau."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplık hâlâ yükleniyor. Biraz sonra yeniden deneyin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca încă se încarcă. Încearcă din nou în scurt timp."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה עדיין נטענת. יש לנסות שוב בקרוב."
          }
        }
      }
    },
    "书架已同步，但 Kindle 未能打开这本书。请重试或返回书架。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek wurde synchronisiert, aber Kindle konnte dieses Buch nicht öffnen. Versuche es erneut oder kehre zur Bibliothek zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library was synced, but Kindle could not open this book. Try again or return to the library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su biblioteca se sincronizó, pero Kindle no pudo abrir este libro. Inténtalo de nuevo o regresa a la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque a été synchronisée, mais Kindle n'a pas pu ouvrir ce livre. Réessayez ou retournez à la bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी सिंक हो गई थी, लेकिन किंडल इस किताब को नहीं खोल सका। पुनः प्रयास करें या लाइब्रेरी में वापस लौटें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è stata sincronizzata, ma Kindle non è riuscito ad aprire questo libro. Riprova o torna in biblioteca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリは同期されましたが、Kindle はこの本を開くことができませんでした。もう一度試すか、ライブラリに戻ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca foi sincronizada, mas o Kindle não conseguiu abrir este livro. Tente novamente ou volte para a biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架已同步，但 Kindle 未能打开这本书。请重试或返回书架。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bibliotheek is gesynchroniseerd, maar Kindle kon dit boek niet openen. Probeer het opnieuw of ga terug naar de bibliotheek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리는 동기화되었으나 Kindle 이 이 책을 열지 못했습니다. 다시 시도하거나 라이브러리로 돌아가세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت مزامنة مكتبتك، لكن لم يتمكن Kindle من فتح هذا الكتاب. حاول مرة أخرى أو عد إلى المكتبة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша библиотека была синхронизирована, но Kindle не смог открыть эту книгу. Попробуйте снова или вернитесь в библиотеку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja biblioteka została zsynchronizowana, ale Kindle nie mógł otworzyć tej książki. Spróbuj ponownie lub wróć do biblioteki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt bibliotek har synkroniserats, men Kindle kunde inte öppna den här boken. Försök igen eller gå tillbaka till biblioteket."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bibliotek blev synkroniseret, men Kindle kunne ikke åbne denne bog. Prøv igen eller vend tilbage til biblioteket."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket ditt ble synkronisert, men Kindle kunne ikke åpne denne boken. Prøv igjen eller gå tilbake til biblioteket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjastosi on synkronoitu, mutta Kindle ei voinut avata tätä kirjaa. Yritä uudelleen tai palaa kirjastoon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše knihovna byla synchronizována, ale Kindle tuto knihu nemohl otevřít. Zkuste to znovu nebo se vraťte do knihovny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βιβλιοθήκη σας συγχρονίστηκε, αλλά το Kindle δεν μπόρεσε να ανοίξει αυτό το βιβλίο. Δοκιμάστε ξανά ή επιστρέψτε στη βιβλιοθήκη."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyvtára szinkronizálva lett, de a Kindle nem tudta megnyitni ezt a könyvet. Próbálja meg újra, vagy térjen vissza a könyvtárhoz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-sync ang iyong aklatan, pero hindi mabuksan ng Kindle ang aklat na ito. Subukan ulit o bumalik sa aklatan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perpustakaan Anda telah disinkronkan, namun Kindle tidak dapat membuka buku ini. Coba lagi atau kembali ke perpustakaan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka anda telah disegerakkan, tetapi Kindle tidak dapat membuka buku ini. Cuba lagi atau kembali ke pustaka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện của bạn đã được đồng bộ, nhưng Kindle không thể mở cuốn sách này. Hãy thử lại hoặc quay lại thư viện."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınız eşitlendi, ancak Kindle bu kitabı açamadı. Yeniden deneyin veya kitaplığa dönün."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca a fost sincronizată, dar Kindle nu a putut deschide această carte. Încearcă din nou sau revino la bibliotecă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה סונכרנה, אך Kindle לא הצליח לפתוח את הספר. יש לנסות שוב או לחזור לספרייה."
          }
        }
      }
    },
