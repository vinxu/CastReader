            "value": "Disimpan hanya pada peranti ini, tidak pernah dimuat naik"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưu trữ trên thiết bị này, không bao giờ được tải lên"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazda saklanır, hiçbir zaman yüklenmez"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocat doar pe acest dispozitiv, fără încărcare în cloud"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר רק במכשיר הזה ואינו מועלה"
