    "书架是空的？你的书可能在其他亚马逊站点。": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist deine Bibliothek leer? Deine Bücher befinden sich möglicherweise in einem anderen Amazon-Shop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is your library empty? Your books may be on another Amazon site."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tu biblioteca está vacía? Puede que tus libros estén en otra tienda de Amazon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque est vide ? Vos livres se trouvent peut-être sur un autre site Amazon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपकी लाइब्रेरी खाली है? आपकी किताबें किसी दूसरी Amazon साइट पर हो सकती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è vuota? I tuoi libri potrebbero trovarsi su un altro sito Amazon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本棚が空ですか？本が別の Amazon ストアにある可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca está vazia? Seus livros podem estar em outra loja da Amazon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书架是空的？你的书可能在其他亚马逊站点。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is uw bibliotheek leeg? Uw boeken kunnen zich op een andere Amazon-site bevinden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리가 비어 있나요? 책이 다른 Amazon 사이트에 있을 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل مكتبتك فارغة؟ قد تكون كتبك على موقع أمازون آخر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша библиотека пуста? Ваши книги могут находиться на другом сайте Amazon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy Twoja biblioteka jest pusta? Twoje książki mogą znajdować się na innym serwisie Amazon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är ditt bibliotek tomt? Dina böcker kan finnas på en annan Amazon-sida."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er dit bibliotek tomt? Dine bøger kan være på en anden Amazon-side."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er biblioteket tomt? Bøkene dine kan være på et annet Amazon-nettsted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko kirjastosi tyhjä? Kirjasi voivat olla toisella Amazon-sivustolla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vaše knihovna prázdná? Vaše knihy mohou být v jiném obchodě Amazon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βιβλιοθήκη σας είναι άδεια; Τα βιβλία σας μπορεί να βρίσκονται σε άλλον ιστότοπο της Amazon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üres a könyvtára? A könyvei egy másik Amazon-oldalon lehetnek."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang laman ang iyong aklatan? Maaaring nasa ibang site ng Amazon ang mga aklat mo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah perpustakaan Anda kosong? Buku-buku Anda mungkin berada di situs Amazon lain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah pustaka anda kosong? Buku anda mungkin berada di tapak Amazon lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện của bạn có trống không? Sách của bạn có thể nằm trên một trang Amazon khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınız boş mu? Kitaplarınız başka bir Amazon sitesinde olabilir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca ta este goală? Cărțile tale pot fi pe un alt site Amazon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה שלך ריקה? ייתכן שהספרים שלך נמצאים באתר Amazon אחר."
          }
        }
      }
