    "朋友完成授权后，他的声音会自动出现在这里。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald dein Freund die Freigabe abgeschlossen hat, erscheint seine Stimme automatisch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once your friend finishes granting access, their voice will appear here automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tu amigo termine de autorizarla, su voz aparecerá aquí automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque votre ami aura accordé l’autorisation, sa voix apparaîtra automatiquement ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्त के अनुमति देने के बाद उसकी आवाज़ यहाँ अपने आप दिखाई देगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il tuo amico avrà concesso l’autorizzazione, la sua voce apparirà qui automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちが許可を完了すると、その声が自動的にここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando seu amigo concluir a autorização, a voz dele aparecerá aqui automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友完成授权后，他的声音会自动出现在这里。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra uw vriend toestemming heeft verleend, verschijnt hun stem hier automatisch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 접근 권한을 부여하면 해당 목소리가 자동으로 여기에 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد أن يمنح صديقك الإذن، سيظهر صوته هنا تلقائيًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только ваш друг предоставит доступ, его голос автоматически появится здесь."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Twój przyjaciel zakończy nadawanie dostępu, jego głos pojawi się tutaj automatycznie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När din vän har beviljat åtkomst visas deras röst automatiskt här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når din ven har givet adgang, vises deres stemme automatisk her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når vennen din har gitt tilgang, vises stemmen automatisk her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ystäväsi myöntää käyttöoikeuden, hänen äänensä ilmestyy tähän automaattisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile vám váš přítel udělí přístup, jeho hlas se zde automaticky zobrazí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις ο φίλος σας ολοκληρώσει την παροχή πρόσβασης, η φωνή του θα εμφανιστεί εδώ αυτόματα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amint a barátja megadta a hozzáférést, a hang automatikusan itt jelenik meg."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag nagbigay na ng pahintulot ang kaibigan mo, awtomatikong lalabas dito ang kanyang boses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah teman Anda selesai memberikan akses, suaranya akan muncul di sini secara otomatis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah rakan anda selesai memberikan akses, suaranya akan muncul di sini secara automatik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce prietenul tău acordă accesul, vocea sa va apărea automat aici."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşınız erişim izni verdiğinde, onun sesi otomatik olarak burada görünür."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר שהחבר שלך יסיים להעניק גישה, הקול שלו יופיע כאן אוטומטית."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi bạn của bạn cấp quyền truy cập, giọng của họ sẽ tự động xuất hiện ở đây."
          }
        }
      }
    },
    "朋友录制并提交后，声音会自动出现在这里。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem dein Freund die Aufnahme gesendet hat, erscheint die Stimme automatisch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your friend records and sends it, the voice will appear here automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tu amigo grabe y envíe el audio, la voz aparecerá aquí automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’enregistrement et l’envoi par votre ami, la voix apparaîtra automatiquement ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्त के रिकॉर्ड करके भेजने के बाद आवाज़ यहाँ अपने आप दिखाई देगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo che il tuo amico avrà registrato e inviato l’audio, la voce apparirà automaticamente qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちが録音して送信すると、その音声が自動的にここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que seu amigo gravar e enviar, a voz aparecerá aqui automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友录制并提交后，声音会自动出现在这里。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat uw vriend een opname heeft gemaakt en verzonden, verschijnt de stem hier automatisch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 녹음하고 전송하면 해당 목소리가 자동으로 여기에 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد أن يسجّل صديقك العينة ويرسلها، سيظهر الصوت هنا تلقائيًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После того как ваш друг запишет и отправит образец, голос автоматически появится здесь."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po nagraniu i wysłaniu przez przyjaciela głos pojawi się tutaj automatycznie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När din vän har spelat in och skickat den, visas rösten automatiskt här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når din ven har optaget og sendt stemmen, vises den automatisk her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når vennen din har spilt inn og sendt inn stemmen, vises den automatisk her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ystäväsi on nauhoittanut ja lähettänyt äänensä, se ilmestyy tähän automaattisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile váš přítel nahraje a odešle vzorek, hlas se zde automaticky zobrazí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφού ο φίλος σας ηχογραφήσει και στείλει τη φωνή του, αυτή θα εμφανιστεί εδώ αυτόματα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amint a barátja rögzíti és elküldi, a hang automatikusan itt jelenik meg."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagkatapos na magrekord at magpadala ng iyong kaibigan, ang boses ay lalabas dito nang awtomatiko."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah teman Anda merekam dan mengirimkannya, suaranya akan muncul di sini secara otomatis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas rakan anda merakam dan menghantarnya, suara itu akan muncul di sini secara automatik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce prietenul tău înregistrează și trimite mostra, vocea va apărea automat aici."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşınız kayıt yapıp gönderdiğinde, onun sesi otomatik olarak burada görünür."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר שהחבר שלך יקליט וישלח, הקול יופיע כאן אוטומטית."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi bạn của bạn thu âm và gửi, giọng sẽ tự động xuất hiện ở đây."
          }
        }
      }
    },
