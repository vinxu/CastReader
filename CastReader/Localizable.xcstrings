    "请选择个人账户，或学校、公司、图书馆提供的机构访问。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein persönliches Konto oder einen institutionellen Zugang Ihrer Schule, Ihres Unternehmens oder Ihrer Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a personal account or institutional access provided by your school, company, or library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una cuenta personal o el acceso institucional de tu escuela, empresa o biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un compte personnel ou l’accès institutionnel fourni par votre école, votre entreprise ou votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत खाता या अपने स्कूल, कंपनी अथवा लाइब्रेरी द्वारा दिया गया संस्थागत एक्सेस चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un account personale o l’accesso istituzionale fornito dalla tua scuola, azienda o biblioteca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人アカウント、または学校・企業・図書館が提供する機関アクセスを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma conta pessoal ou o acesso institucional oferecido pela sua escola, empresa ou biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择个人账户，或学校、公司、图书馆提供的机构访问。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een persoonlijk account of institutionele toegang die door uw school, bedrijf of bibliotheek wordt verstrekt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حسابًا شخصيًا أو وصولًا مؤسسيًا توفره مدرستك أو شركتك أو مكتبتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите личный аккаунт или доступ через учебное заведение, компанию или библиотеку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz konto osobiste lub dostęp instytucjonalny zapewniony przez szkołę, firmę lub bibliotekę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett personligt konto eller institutionell åtkomst som tillhandahålls av din skola, arbetsplats eller bibliotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en personlig konto eller institutionel adgang fra din skole, virksomhed eller bibliotek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en personlig konto eller institusjonell tilgang som tilbys av skolen, bedriften eller biblioteket ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse henkilökohtainen tili tai koulusi, yrityksesi tai kirjastosi tarjoama käyttöoikeus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte osobní účet nebo institucionální přístup poskytnutý vaší školou, společností nebo knihovnou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε έναν προσωπικό λογαριασμό ή πρόσβαση μέσω ιδρύματος που παρέχεται από το σχολείο, την εταιρεία ή τη βιβλιοθήκη σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon személyes fiókot vagy intézményi hozzáférést, amelyet iskolája, cége vagy könyvtára biztosít."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng personal na account o institusyonal na akses na binigay ng iyong paaralan, kumpanya, o aklatan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih akun pribadi atau akses institusional yang disediakan oleh sekolah, perusahaan, atau perpustakaan Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih akaun peribadi atau akses institusi yang disediakan oleh sekolah, syarikat, atau perpustakaan anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tài khoản cá nhân hoặc quyền truy cập tổ chức do trường học, công ty hoặc thư viện cung cấp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 계정 또는 학교, 회사, 도서관에서 제공하는 기관 이용 방식을 선택하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel hesap veya okulunuz, şirketiniz ya da kütüphaneniz tarafından sağlanan kurumsal erişimi seçin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un cont personal sau accesul instituțional oferit de școala, compania ori biblioteca ta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור חשבון אישי או גישה מוסדית שמספקים בית הספר, החברה או הספרייה שלך."
          }
        }
      }
    },
