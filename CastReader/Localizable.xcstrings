    "下一页已缓存，但 Kindle 页面同步失败，已暂停。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Seite ist zwischengespeichert, aber die Kindle-Seitensynchronisierung ist fehlgeschlagen. Die Wiedergabe wurde pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next page is cached, but Kindle page sync failed. Playback is paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página siguiente está en caché, pero no se pudo sincronizar la página de Kindle. La reproducción está en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page suivante est en cache, mais la synchronisation de la page Kindle a échoué. La lecture est en pause."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगला पेज कैश हो गया है, लेकिन Kindle पेज सिंक नहीं हुआ। प्लेबैक रोक दिया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina successiva è nella cache, ma la sincronizzazione della pagina Kindle non è riuscita. La riproduzione è in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のページはキャッシュ済みですが、Kindleページの同期に失敗したため一時停止しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima página está em cache, mas a sincronização da página do Kindle falhou. A reprodução foi pausada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一页已缓存，但 Kindle 页面同步失败，已暂停。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende pagina is gecacheerd, maar de Kindle-synchronisatie is mislukt. Afspelen is gepauzeerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 페이지는 캐시되었으나 Kindle 페이지 동기화가 실패했습니다. 재생이 일시 중지되었습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخزين الصفحة التالية مؤقتًا، لكن مزامنة صفحة Kindle فشلت. تم إيقاف التشغيل مؤقتًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующая страница закэширована, но синхронизация страниц Kindle не удалась. Воспроизведение приостановлено."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następna strona jest w pamięci podręcznej, ale synchronizacja stron Kindle nie powiodła się. Odtwarzanie zostało wstrzymane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa sida är cachad, men synkroniseringen med Kindle misslyckades. Uppspelningen är pausad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Næste side er cachet, men synkronisering af Kindle-side mislykkedes. Afspilning er sat på pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste side er lagret i hurtigminnet, men synkronisering av Kindle-side mislyktes. Avspillingen er satt på pause."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava sivu on välimuistissa, mutta Kindle-sivujen synkronointi epäonnistui. Toisto on keskeytetty."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další stránka je v mezipaměti, ale synchronizace stránek Kindle selhala. Přehrávání je pozastaveno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επόμενη σελίδα έχει αποθηκευτεί προσωρινά, αλλά ο συγχρονισμός της σελίδας Kindle απέτυχε. Η αναπαραγωγή έχει τεθεί σε παύση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő oldal gyorsítótárazva van, de a Kindle-oldal szinkronizálása sikertelen. A lejátszás szüneteltetve."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang susunod na pahina ay naka-cache, pero nabigo ang sync ng Kindle. Paused ang playback."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman berikutnya sudah di-cache, namun sinkronisasi halaman Kindle gagal. Pemutaran dijeda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman seterusnya telah disimpan dalam cache, tetapi penyegerakan halaman Kindle gagal. Main balik dijeda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang tiếp theo đã được lưu vào bộ nhớ đệm, nhưng không thể đồng bộ trang Kindle. Đã tạm dừng phát."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki sayfa önbellekte, ancak Kindle sayfa eşitlemesi başarısız oldu. Oynatma duraklatıldı."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina următoare este în cache, dar sincronizarea paginii Kindle a eșuat. Redarea este în pauză."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העמוד הבא שמור במטמון, אך סנכרון עמוד Kindle נכשל. ההפעלה מושהית."
          }
        }
      }
    },
    "下一页播放衔接失败，请点击播放继续。": {
