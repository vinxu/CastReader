            "value": "Обнаружена покупка. Войдите в аккаунт, чтобы синхронизировать Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto zakup. Zaloguj się na swoje konto, aby zsynchronizować wersję Pro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp upptäckt. Logga in på ditt konto för att synkronisera Pro."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb registreret. Log ind på din konto for at synkronisere Pro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøp oppdaget. Logg inn på kontoen din for å synkronisere Pro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osto havaittu. Kirjaudu tilillesi synkronoidaksesi Pro:n."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Detekován nákup. Přihlaste se k účtu pro synchronizaci Pro."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανιχνεύτηκε αγορά. Συνδεθείτε στον λογαριασμό σας για συγχρονισμό του Pro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vásárlás észlelve. Jelentkezzen be a fiókjába a Pro szinkronizálásához."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadetect ang pagbili. Mag-sign in sa iyong account upang i-sync ang Pro."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian dikesan. Log masuk ke akaun anda untuk menyegerakkan Pro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma algılandı. Pro'yu senkronize etmek için hesabınıza giriş yapın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian terdeteksi. Masuk ke akun Anda untuk menyinkronkan Pro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziție detectată. Conectează-te la cont pentru a sincroniza Pro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוהתה רכישה. יש להיכנס לחשבון שלך כדי לסנכרן את Pro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát hiện giao dịch. Đăng nhập vào tài khoản để đồng bộ Pro."
          }
        }
      }
    },
    "已检测到购买，请登录邮箱完成跨平台同步。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf erkannt. Melde dich mit deiner E-Mail-Adresse an, um Pro plattformübergreifend zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase detected. Log in with your email to enable cross-platform Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra detectada. Inicie sesión con su correo electrónico para habilitar Pro multiplataforma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat détecté. Connectez-vous avec votre e-mail pour activer multiplateforme Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी का पता चला. क्रॉस-प्लेटफ़ॉर्म प्रो सक्षम करने के लिए अपने ईमेल से लॉग इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto rilevato. Accedi con la tua email per abilitare Pro multipiattaforma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入が検出されました。クロスプラットフォーム Pro を有効にするには、電子メールでログインします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra detectada. Faça login com seu e-mail para ativar o Pro multiplataforma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到购买，请登录邮箱完成跨平台同步。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankoop gedetecteerd. Log in met je e-mailadres om cross-platform Pro in te schakelen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 감지되었습니다. 크로스 플랫폼 Pro를 사용하려면 이메일로 로그인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف الشراء. سجّل الدخول باستخدام بريدك الإلكتروني لتمكين Pro عبر المنصات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружена покупка. Войдите по электронной почте, чтобы включить кроссплатформенный Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto zakup. Zaloguj się za pomocą adresu e-mail, aby włączyć wersję Pro międzyplatformową."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp upptäckt. Logga in med din e-postadress för att aktivera plattformsovergripande Pro."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb registreret. Log ind med din e-mail for at aktivere tværplatforms Pro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøp oppdaget. Logg inn med e-posten din for å aktivere tverrplattform Pro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osto havaittu. Kirjaudu sähköpostiosoitteellasi mahdollistaaksesi alustojen välisen Pro:n."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup nalezen. Přihlaste se e-mailem a aktivujte Pro na všech platformách."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντοπίστηκε αγορά. Συνδεθείτε με το email σας για να ενεργοποιήσετε το Pro σε όλες τις πλατφόρμες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vásárlás észlelve. Jelentkezzen be e-mail címmel a platformok közötti Pro engedélyezéséhez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadetect ang pagbili. Mag-log in gamit ang iyong email upang mapagana ang cross-platform Pro."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian dikesan. Log masuk dengan e-mel anda untuk mengaktifkan Pro merentas platform."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma algılandı. Çapraz platform Pro'sunu etkinleştirmek için e-posta ile giriş yapın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian terdeteksi. Masuk dengan email Anda untuk mengaktifkan Pro lintas platform."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziție detectată. Conectează-te cu e-mailul pentru a activa Pro pe toate platformele."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוהתה רכישה. יש להיכנס עם הדוא״ל שלך כדי להפעיל את Pro בכל הפלטפורמות."
          }
        },
        "vi": {
