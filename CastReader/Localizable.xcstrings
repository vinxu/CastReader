    "关注定义、知识点、例题和易错点": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitionen, Konzepte, Beispiele und häufige Fehler hervorheben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on definitions, concepts, examples, and common mistakes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrarse en definiciones, conceptos, ejemplos y errores comunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrez-vous sur les définitions, les concepts, les exemples et les erreurs courantes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिभाषाओं, अवधारणाओं, उदाहरणों और सामान्य गलतियों पर ध्यान दें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrarsi su definizioni, concetti, esempi ed errori comuni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定義、概念、例、よくある間違いに焦点を当てる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se em definições, conceitos, exemplos e erros comuns"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注定义、知识点、例题和易错点"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus op definities, concepten, voorbeelden en veelgemaakte fouten"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정의, 개념, 예시 및 흔한 실수에 집중"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ركز على التعريفات والمفاهيم والأمثلة والأخطاء الشائعة"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сосредоточьтесь на определениях, концепциях, примерах и распространённых ошибках"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skup się na definicjach, koncepcjach, przykładach i typowych błędach"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokusera på definitioner, begrepp, exempel och vanliga misstag"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokusér på definitioner, begreber, eksempler og almindelige fejl"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokuser på definisjoner, begreper, eksempler og vanlige feil"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskity määritelmiin, käsitteisiin, esimerkkeihin ja yleisiin virheisiin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaměřte se na definice, pojmy, příklady a časté chyby"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εστίαση σε ορισμούς, έννοιες, παραδείγματα και συνηθισμένα λάθη"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fókuszban a definíciók, fogalmak, példák és gyakori hibák"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutok sa mga kahulugan, konsepto, halimbawa, at karaniwang pagkakamali"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumpukan pada definisi, konsep, contoh dan kesilapan lazim"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus pada definisi, konsep, contoh, dan kesalahan umum"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanımlara, kavramlara, örneklere ve yaygın hatalara odaklanın"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se concentrează pe definiții, concepte, exemple și greșeli frecvente"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמקדות בהגדרות, מושגים, דוגמאות וטעויות נפוצות"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tập trung vào định nghĩa, khái niệm, ví dụ và lỗi thường gặp"
          }
        }
      }
    },
    "关注权利义务、金额期限和风险条款": {
      "localizations": {
        "de": {
