          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Derulează biblioteca Kindle, apoi atinge din nou Sincronizează."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לגלול בספריית Kindle ואז להקיש שוב על סנכרון."
          }
        }
      }
