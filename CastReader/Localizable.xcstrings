        }
      }
    },
    "书籍索引读取失败，请返回离线书籍重新打开。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书籍索引读取失败，请返回离线书籍重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The book index could not be read. Return to Offline Books and reopen it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本の索引を読み込めませんでした。「オフラインの本」に戻り、開き直してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el índice. Vuelve a Libros sin conexión y abre el libro de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’index du livre est illisible. Revenez à Livres hors ligne et rouvrez le livre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Buchindex konnte nicht gelesen werden. Kehre zu „Offline-Bücher“ zurück und öffne es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o índice. Volte a Livros offline e reabra o livro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’indice. Torna a Libri offline e riapri il libro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किताब की सूची पढ़ी नहीं जा सकी। “ऑफ़लाइन किताबें” पर लौटें और इसे फिर खोलें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het boekregister kon niet worden gelezen. Ga terug naar Offline Boeken en open het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책 색인을 읽을 수 없습니다. 오프라인 책으로 돌아가서 다시 열어보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة فهرس الكتاب. عُد إلى «كتب للقراءة دون اتصال» وأعد فتحه."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать оглавление книги. Вернитесь в раздел «Книги офлайн» и откройте её снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać indeksu książki. Wróć do sekcji Książki offline i otwórz książkę ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokens innehållsförteckning kunde inte läsas. Gå tillbaka till Offline-böcker och öppna den igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogens indeks kunne ikke læses. Gå tilbage til Bøger offline, og åbn bogen igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokens indeks kunne ikke leses. Gå tilbake til «Offline-bøker» og åpne boken på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjan indeksiä ei voitu lukea. Palaa Offline-kirjoihin ja avaa kirja uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze přečíst index knihy. Vraťte se do sekce Knihy offline a knihu znovu otevřete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του ευρετηρίου του βιβλίου. Επιστρέψτε στα Βιβλία εκτός σύνδεσης και ανοίξτε το ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyv tartalomjegyzéke nem olvasható. Térjen vissza az Offline könyvekhez, és nyissa meg újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nabasa ang index ng aklat. Bumalik sa Mga Aklat Offline at buksan ito ulit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את אינדקס הספר. חזור אל ספרים במצב לא מקוון ופתח אותו מחדש."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks buku tidak dapat dibaca. Kembali ke Buku Offline dan buka kembali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks buku tidak dapat dibaca. Kembali ke Buku Luar Talian dan buka semula."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexul cărții nu a putut fi citit. Revino la Cărți offline și redeschide cartea."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitabın dizini okunamadı. Çevrimdışı Kitaplar'a dönüp kitabı yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc chỉ mục sách. Quay lại Sách ngoại tuyến và mở lại sách."
          }
        }
      }
    },
    "这台设备尚无适合此书的声音。请联网下载系统声音后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备尚无适合此书的声音。请联网下载系统声音后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No suitable voice is installed. Download a system voice while online, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本に適した音声が端末にありません。ネットに接続してシステム音声をダウンロードし、再試行してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una voz adecuada instalada. Descarga una voz del sistema con conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune voix adaptée n’est installée. Téléchargez une voix système en ligne, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine passende Stimme installiert. Lade online eine Systemstimme herunter und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma voz adequada está instalada. Baixe uma voz do sistema online e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna voce adatta installata. Scarica una voce di sistema online e riprova."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयुक्त आवाज़ इंस्टॉल नहीं है। इंटरनेट से जुड़कर सिस्टम की आवाज़ डाउनलोड करें, फिर कोशिश करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen geschikte stem geïnstalleerd. Download een systeemstem terwijl u online bent, en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 음성이 설치되어 있지 않습니다. 온라인 상태에서 시스템 음성을 다운로드한 후 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد صوت مناسب مثبت على الجهاز. نزّل صوتًا من أصوات النظام أثناء الاتصال بالإنترنت، ثم حاول مجددًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящий голос не установлен. Подключитесь к интернету, загрузите системный голос и повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zainstalowano odpowiedniego głosu. Pobierz głos systemowy, gdy jesteś połączony z internetem, a następnie spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lämplig röst är installerad. Ladda ner en systemröst när du är online, och försök sedan igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen egnet stemme er installeret. Download en systemstemme, mens du er online, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen egnet stemme er installert. Last ned en systemstemme mens du er online, og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopivaa ääntä ei ole asennettu. Lataa järjestelmän ääni verkkoyhteyden ollessa käytettävissä ja yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není nainstalován žádný vhodný hlas. Stáhněte si systémový hlas při připojení k internetu a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει εγκατασταθεί κατάλληλη φωνή. Κατεβάστε μια φωνή συστήματος με σύνδεση στο διαδίκτυο και δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs telepítve megfelelő hang. Töltse le a rendszerhangot internetkapcsolattal, majd próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang naka-install na angkop na boses. Mag-download ng boses ng system habang online, saka subukang muli."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין קול מתאים מותקן. הורד קול מערכת בזמן חיבור לאינטרנט, ואז נסה שוב."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada suara yang cocok terinstal. Unduh suara sistem saat terhubung internet, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada suara yang sesuai dipasang. Muat turun suara sistem dalam talian, kemudian cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este instalată o voce potrivită. Descarcă o voce de sistem când ai conexiune la internet, apoi încearcă din nou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygun bir ses yüklü değil. İnternete bağlıyken bir sistem sesi indirin, ardından yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cài đặt giọng phù hợp. Tải giọng hệ thống khi có kết nối mạng rồi thử lại."
          }
        }
      }
    },
