    },
    "点击后直接分享链接，无需填写对方手机号或发送短信。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um den Link direkt zu teilen – ohne die Telefonnummer der anderen Person einzugeben oder eine SMS zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to share the link directly—no need to enter the other person’s phone number or send a text message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para compartir el enlace directamente, sin introducir el número de teléfono de la otra persona ni enviar un SMS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour partager directement le lien, sans saisir le numéro de téléphone de l’autre personne ni envoyer de SMS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक सीधे शेयर करने के लिए टैप करें—दूसरे व्यक्ति का फ़ोन नंबर दर्ज करने या SMS भेजने की ज़रूरत नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per condividere direttamente il link, senza inserire il numero di telefono dell’altra persona né inviare un SMS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてリンクを直接共有できます。相手の電話番号の入力やSMSの送信は不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para compartilhar diretamente o link, sem informar o número de telefone da outra pessoa nem enviar SMS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击后直接分享链接，无需填写对方手机号或发送短信。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om de link direct te delen—geen telefoonnummer van de ontvanger invoeren of sms sturen nodig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 직접 공유하려면 탭하세요. 상대방의 전화번호 입력이나 문자 메시지 발송이 필요 없습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لمشاركة الرابط مباشرةً دون الحاجة إلى إدخال رقم هاتف الشخص الآخر أو إرسال رسالة نصية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы поделиться ссылкой напрямую — не нужно вводить номер телефона другого человека или отправлять SMS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby udostępnić link bezpośrednio – nie trzeba podawać numeru telefonu drugiej osoby ani wysyłać wiadomości SMS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att dela länken direkt – inget behov av att ange mottagarens telefonnummer eller skicka ett sms."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at dele linket direkte – du behøver ikke taste modtagerens telefonnummer eller sende en besked."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å dele lenken direkte – du trenger ikke skrive inn telefonnummeret til den andre personen eller sende en SMS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta jakaaksesi linkin suoraan – toisen henkilön puhelinnumeroa ei tarvitse syöttää eikä tekstiviestiä lähettää."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για να μοιραστείτε το σύνδεσμο απευθείας—δεν χρειάζεται να εισάγετε τον αριθμό τηλεφώνου του άλλου ή να στείλετε μήνυμα κειμένου."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap upang ibahagi ang link nang direkta—hindi na kailangang ilagay ang numero ng telepono ng iba o magpadala ng mensahe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı doğrudan paylaşmak için dokunun—karşı tarafın telefon numarasını girmenize veya mesaj göndermenize gerek yoktur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để chia sẻ liên kết trực tiếp—không cần nhập số điện thoại người khác hoặc gửi tin nhắn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím sdílejte odkaz přímo. Nemusíte zadávat telefonní číslo příjemce ani posílat SMS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintással közvetlenül megoszthatod a linket. Nem kell megadnod a másik fél telefonszámát vagy SMS-t küldened."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk terus berkongsi pautan—anda tidak perlu memasukkan nombor telefon penerima atau menghantar SMS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk langsung membagikan tautan—tidak perlu memasukkan nomor telepon penerima atau mengirim SMS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a distribui direct linkul — nu trebuie să introduci numărul de telefon al celeilalte persoane sau să trimiți un SMS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש כדי לשתף את הקישור ישירות — אין צורך להזין את מספר הטלפון של האדם האחר או לשלוח הודעת טקסט."
          }
        }
      }
    },
