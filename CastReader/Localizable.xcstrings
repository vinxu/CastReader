    "点击备案号可前往工业和信息化部备案管理系统查询。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Registrierungsnummer, um sie im ICP-System des chinesischen Ministeriums für Industrie und Informationstechnologie nachzuschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the filing number to look it up in China’s Ministry of Industry and Information Technology ICP system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el número de registro para consultarlo en el sistema ICP del Ministerio de Industria y Tecnología de la Información de China."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le numéro d’enregistrement pour le consulter dans le système ICP du ministère chinois de l’Industrie et des Technologies de l’information."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चीन के उद्योग और सूचना प्रौद्योगिकी मंत्रालय की ICP प्रणाली में जाँचने के लिए फ़ाइलिंग नंबर पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il numero di registrazione per consultarlo nel sistema ICP del Ministero cinese dell’Industria e della Tecnologia dell’informazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録番号をタップすると、中国工業情報化部の ICP 登録管理システムで確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no número de registro para consultá-lo no sistema ICP do Ministério da Indústria e Tecnologia da Informação da China."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击备案号可前往工业和信息化部备案管理系统查询。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het registratienummer om dit op te zoeken in het ICP-systeem van het Chinese Ministerie van Industrie en Informatietechnologie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على رقم التسجيل للبحث عنه في نظام ICP التابع لوزارة الصناعة وتكنولوجيا المعلومات الصينية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на номер регистрации, чтобы найти его в системе ICP Министерства промышленности и информационных технологий Китая."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij numer zgłoszenia, aby wyszukać go w systemie ICP Ministerstwa Przemysłu i Technologii Informacyjnych Chin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på registreringsnumret för att slå upp det i Kinas ministerium för industri och informationstekniks ICP-system."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på registreringsnummeret for at slå det op i Kinas ministerium for industri og informationsteknologis ICP-system."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på registreringsnummeret for å slå det opp i ICP-registeret til Kinas departement for industri og informasjonsteknologi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta rekisterinumeroa hakeaksesi sen Kiinan teollisuus- ja tietotekniikkaministeriön ICP-järjestelmästä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na registrační číslo vyhledejte záznam v systému ICP čínského Ministerstva průmyslu a informačních technologií."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε τον αριθμό εγγραφής για αναζήτηση στο σύστημα ICP του Υπουργείου Βιομηχανίας και Πληροφορικής της Κίνας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a nyilvántartási számra a Kínai Ipari és Információs Minisztérium ICP-rendszerében való lekérdezéshez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang filing number upang hanapin ito sa ICP system ng Ministry of Industry and Information Technology ng Tsina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk nomor pendaftaran untuk mencarinya di sistem ICP Kementerian Perindustrian dan Teknologi Informasi Tiongkok."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk nombor pendaftaran untuk menyemaknya dalam sistem ICP Kementerian Perindustrian dan Teknologi Maklumat China."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록 번호를 누르면 중국 공업정보화부 ICP 시스템에서 조회할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çin Sanayi ve Bilgi Teknolojileri Bakanlığı'nın ICP sisteminde sorgulamak için kayıt numarasına dokunun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge numărul de înregistrare pentru a-l căuta în sistemul ICP al Ministerului Industriei și Tehnologiei Informației din China."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על מספר הרישום כדי לחפש אותו במערכת ICP של משרד התעשייה וטכנולוגיית המידע בסין."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào số đăng ký để tra cứu trong hệ thống ICP của Bộ Công nghiệp và Công nghệ Thông tin Trung Quốc."
          }
        }
      }
    },
