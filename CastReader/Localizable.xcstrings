        "es" : { "stringUnit" : { "state" : "translated", "value" : "El aviso de cookies se ha cerrado. Toca Reproducir para continuar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La bannière de cookies a été fermée. Appuyez sur Lecture pour continuer." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कुकी सूचना बंद हो गई है। जारी रखने के लिए चलाएँ पर टैप करें।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "L'avviso sui cookie è stato chiuso. Tocca Riproduci per continuare." } },
