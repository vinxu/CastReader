    "支持个人订阅，也支持学校、公司和图书馆提供的机构访问。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Abos und institutionelle Zugänge über Schulen, Unternehmen und Bibliotheken werden unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports personal subscriptions and institutional access provided by schools, companies, and libraries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible con suscripciones personales y con el acceso institucional de escuelas, empresas y bibliotecas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible avec les abonnements personnels et les accès institutionnels fournis par les écoles, les entreprises et les bibliothèques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत सदस्यता और स्कूलों, कंपनियों व लाइब्रेरी द्वारा दिए गए संस्थागत एक्सेस का समर्थन करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supporta gli abbonamenti personali e l’accesso istituzionale fornito da scuole, aziende e biblioteche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人サブスクリプションのほか、学校・企業・図書館が提供する機関アクセスにも対応しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatível com assinaturas pessoais e com o acesso institucional oferecido por escolas, empresas e bibliotecas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持个人订阅，也支持学校、公司和图书馆提供的机构访问。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondersteunt persoonlijke abonnementen en institutionele toegang die door scholen, bedrijven en bibliotheken wordt verstrekt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 구독과 학교, 기업, 도서관에서 제공하는 기관 접근을 지원합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم الاشتراكات الشخصية والوصول المؤسسي الذي توفره المدارس والشركات والمكتبات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаются личные подписки и доступ через учебные заведения, компании и библиотеки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługuje subskrypcje indywidualne oraz dostęp instytucjonalny zapewniany przez szkoły, firmy i biblioteki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöder personliga prenumerationer och institutionell åtkomst tillhandahållen av skolor, företag och bibliotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Understøtter personlige abonnementer og institutionsadgang via skoler, virksomheder og biblioteker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Støtter personlige abonnementer og institusjonell tilgang som tilbys av skoler, bedrifter og bibliotek."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukee henkilökohtaisia tilauksia sekä koulujen, yritysten ja kirjastojen tarjoamia käyttöoikeuksia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podporuje osobní předplatná i institucionální přístup poskytovaný školami, firmami a knihovnami."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υποστηρίζει προσωπικές συνδρομές και θεσμική πρόσβαση που παρέχουν σχολεία, εταιρείες και βιβλιοθήκες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Támogatja a személyes előfizetéseket és az iskolák, vállalatok és könyvtárak által biztosított intézményi hozzáférést."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusuportahan ang personal na langganan at institusyonal na akses na ibinigay ng mga paaralan, kumpanya, at aklatan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תומך במנויים אישיים ובגישה מוסדית המופעלת על ידי בתי ספר, חברות וספריות."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendukung langganan pribadi dan akses institusional yang disediakan oleh sekolah, perusahaan, dan perpustakaan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyokong langganan peribadi dan akses institusi yang disediakan oleh sekolah, syarikat dan perpustakaan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel abonelikleri ve okullar, şirketler ve kütüphaneler tarafından sağlanan kurumsal erişimi destekler."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptă abonamente personale și acces instituțional oferit de școli, companii și biblioteci."
