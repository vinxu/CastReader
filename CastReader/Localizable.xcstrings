        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang még működik. A név szinkronizálása ideiglenesen nem elérhető; próbálja újra később."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana pa rin ang boses. Ang sync ng pangalan ay pansamantalang hindi available; subukan ulit mamaya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara masih berfungsi. Penyegerakan nama tidak tersedia buat sementara waktu; cuba lagi kemudian."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses hala çalışıyor. İsim senkronizasyonu geçici olarak kullanılamıyor; lütfen daha sonra tekrar deneyin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성은 계속 사용할 수 있습니다. 이름 동기화를 일시적으로 사용할 수 없으니 나중에 다시 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara tetap berfungsi. Sinkronisasi nama sementara tidak tersedia; coba lagi nanti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea funcționează în continuare. Sincronizarea numelui este momentan indisponibilă; încearcă din nou mai târziu."
