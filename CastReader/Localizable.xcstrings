          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η ανάγνωση αυτού του ήχου. Το αρχείο μπορεί να είναι κατεστραμμένο ή σε μη υποστηριζόμενη μορφή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a hang nem olvasható. A fájl sérült lehet, vagy nem támogatott formátumban van."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang audio na ito. Maaaring sira o hindi suporta ang format ng file."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא קובץ שמע זה. ייתכן שהקובץ פגום או שהפורמט שלו אינו נתמך."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ini tidak dapat dibaca. Fail mungkin rosak atau dalam format yang tidak disokong."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ses dosyası okunamıyor. Dosya bozuk olabilir veya desteklenmeyen bir biçimde olabilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ini tidak dapat dibaca. File mungkin rusak atau formatnya tidak didukung."
          }
        },
        "ro": {
