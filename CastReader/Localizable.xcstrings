            "value": "Nie wykryto wystarczającej ilości wyraźnej, ciągłej mowy. Wybierz inny plik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillräckligt med tydligt, sammanhängande tal hittades. Välj en annan fil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
