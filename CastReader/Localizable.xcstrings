    "历史记录仅保存在本机，不会上传或同步到云端": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is kept on this device only — never uploaded or synced to the cloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はこのデバイスにのみ保存され、クラウドにアップロードまたは同期されることはありません"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se guarda solo en este dispositivo; nunca se carga ni se sincroniza con la nube"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique est conservé sur cet appareil uniquement : jamais téléchargé ni synchronisé sur le cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico é mantido apenas neste dispositivo – nunca carregado ou sincronizado com a nuvem"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia viene conservata solo su questo dispositivo e non viene mai caricata o sincronizzata nel cloud"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास केवल इस डिवाइस पर रखा जाता है - कभी भी क्लाउड पर अपलोड या सिंक नहीं किया जाता है"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录仅保存在本机，不会上传或同步到云端"
          }
        }
      }
    },
