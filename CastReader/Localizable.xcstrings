        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la posizione di lettura. Controlla lo spazio disponibile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ने की जगह सहेजी नहीं जा सकी। डिवाइस में उपलब्ध जगह जाँचें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw leespositie kon niet worden opgeslagen. Controleer de beschikbare opslagruimte op dit apparaat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 위치를 저장할 수 없습니다. 이 기기의 사용 가능 저장 공간을 확인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ موضع قراءتك. تحقق من مساحة التخزين المتاحة على هذا الجهاز."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить позицию чтения. Проверьте доступное место на устройстве."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać pozycji czytania. Sprawdź dostępną pamięć urządzenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din läsplats kunde inte sparas. Kontrollera tillgängligt lagringsutrymme på enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din læseposition kunne ikke gemmes. Tjek den tilgængelige lagerplads på enheden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leseposisjonen kunne ikke lagres. Sjekk tilgjengelig lagringsplass på enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukukohtaasi ei voitu tallentaa. Tarkista laitteen vapaana oleva tallennustila."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze uložit vaši pozici čtení. Zkontrolujte dostupné úložiště na tomto zařízení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση της θέσης ανάγνωσής σας. Ελέγξτε τον διαθέσιμο χώρο αποθήκευσης στη συσκευή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az olvasási pozíció nem menthető. Ellenőrizze a rendelkezésre álló tárhelyet ezen az eszközön."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-save ang iyong reading position. Suriin ang available storage sa device na ito."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור את מיקום הקריאה שלך. בדוק את מקום האחסון הפנוי במכשיר."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisi membaca Anda tidak dapat disimpan. Periksa penyimpanan yang tersedia pada perangkat ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedudukan membaca anda tidak dapat disimpan. Semak ruang storan tersedia pada peranti ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziția de lectură nu a putut fi salvată. Verifică spațiul de stocare disponibil pe acest dispozitiv."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuma konumunuz kaydedilemedi. Bu cihazdaki kullanılabilir depolama alanını kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu vị trí đọc. Kiểm tra dung lượng còn trống trên thiết bị này."
          }
        }
      }
    },
    "已取消本次下载，已保存页面会保留。": {
