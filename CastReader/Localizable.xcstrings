          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie kontynuujemy po zalogowaniu. Nie ma potrzeby dodatkowego stuknięcia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fortsätter automatiskt efter att du loggat in. Inget extra tryck behövs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fortsætter automatisk, når du har logget ind. Du behøver ikke trykke igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fortsetter automatisk etter at du logger inn. Ingen ekstra trykk nødvendig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkamme automaattisesti sisäänkirjautumisen jälkeen. Ei tarvita lisänäppäystä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po přihlášení budeme pokračovat automaticky. Nemusíte na nic dalšího klepat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα συνεχίσουμε αυτόματα μετά τη σύνδεσή σας. Δεν απαιτείται επιπλέον πάτημα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejelentkezés után automatikusan folytatjuk. Nincs szükség további koppintásra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatiko kaming magpapatuloy pagkatapos mong mag-sign in. Wala nang kailangang i-tap."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 후 자동으로 계속합니다. 별도로 누를 필요가 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan meneruskan secara automatik selepas anda log masuk. Tidak perlu mengetik lagi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan melanjutkan secara otomatis setelah Anda masuk. Tidak perlu mengetuk lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yaptıktan sonra otomatik olarak devam edeceğiz. Tekrar dokunmanız gerekmez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom continua automat după autentificare. Nu trebuie să mai atingi nimic."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמשיך אוטומטית לאחר הכניסה. אין צורך בהקשה נוספת."
