            "state": "translated",
            "value": "Gemt kun på denne enhed, aldrig uploadet"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret kun på denne enheten, aldri lastet opp"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetaan vain tälle laitteelle, ei koskaan lähetetä palvelimelle"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo pouze na tomto zařízení, nikdy se neodesílá"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύεται μόνο σε αυτή τη συσκευή, χωρίς ποτέ να μεταφορτώνεται"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ezen az eszközön tárolva, soha nem feltöltve"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakaimbak lamang sa device na ito, hindi kailanman ina-upload"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan hanya di perangkat ini, tidak pernah diunggah"
          }
        },
        "ms": {
          "stringUnit": {
