        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mời bạn bè làm người đọc cho tôi"
          }
        }
      }
    },
    "朋友录一小段，你就能用他的声音朗读 Kindle、文件和网页。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Freund nimmt einen kurzen Ausschnitt auf und du kannst mit seiner Stimme Kindle, Dateien und Webseiten vorlesen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your friend records a short sample, and you can use their voice to read Kindle books, files, and web pages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu amigo graba una muestra breve y podrás usar su voz para leer Kindle, archivos y páginas web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ami enregistre un court extrait, puis vous pouvez utiliser sa voix pour lire Kindle, des fichiers et des pages web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दोस्त एक छोटा नमूना रिकॉर्ड करता है, फिर आप उसकी आवाज़ से Kindle, फ़ाइलें और वेब पेज सुन सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo amico registra un breve campione e potrai usare la sua voce per leggere Kindle, file e pagine web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちが短い音声を録音すると、その声でKindle、ファイル、ウェブページを読み上げられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu amigo grava uma amostra curta, e você pode usar a voz dele para ler Kindle, arquivos e páginas da web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友录一小段，你就能用他的声音朗读 Kindle、文件和网页。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw vriend maakt een korte stemopname. U kunt die stem gebruiken om Kindle-boeken, bestanden en webpagina’s voor te lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 짧은 샘플을 녹음하면 Kindle 책, 파일 및 웹 페이지를 읽을 때 그 목소리를 사용할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل صديقك عينة قصيرة، ويمكنك استخدام صوته لقراءة كتب Kindle والملفات وصفحات الويب."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш друг записывает короткий образец, после чего вы сможете использовать его голос для чтения книг Kindle, файлов и веб-страниц."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój przyjaciel nagrywa krótki fragment, a Ty możesz użyć jego głosu do czytania książek Kindle, plików i stron internetowych."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din vän spelar in ett kort röstprov, och du kan använda rösten för att läsa upp Kindle-böcker, filer och webbsidor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din ven optager en kort stemmeprøve, og du kan bruge stemmen til at læse Kindle-bøger, filer og websider højt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennen din spiller inn en kort stemmeprøve. Deretter kan du bruke stemmen til å lese Kindle-bøker, filer og nettsider høyt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ystäväsi nauhoittaa lyhyen otteen, ja voit käyttää hänen ääntään Kindle-kirjojen, tiedostojen ja verkkosivujen lukemiseen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš přítel nahraje krátký vzorek a vy můžete použít jeho hlas k čtení knih Kindle, souborů a webových stránek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο φίλος σας ηχογραφεί ένα σύντομο δείγμα και μπορείτε να χρησιμοποιήσετε τη φωνή του για να ακούτε βιβλία Kindle, αρχεία και ιστοσελίδες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Barátja rövid hangmintát készít, Ön pedig a hangjával hallgathat Kindle-könyveket, fájlokat és weboldalakat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong kaibigan ay nagre-rekord ng maikling sample, at pwede mong gamitin ang kanilang boses para basahin ang mga Kindle libro, file, at web page."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman Anda merekam sampel singkat, dan Anda dapat menggunakan suaranya untuk membaca buku Kindle, file, dan halaman web."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakan anda merakam sampel pendek, dan anda boleh menggunakan suaranya untuk membaca buku Kindle, fail dan halaman web."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prietenul tău înregistrează o mostră scurtă, iar tu îi poți folosi vocea pentru a citi cărți Kindle, fișiere și pagini web."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşınız kısa bir örnek kaydeder; ardından Kindle kitaplarını, dosyaları ve web sayfalarını bu sesle okutabilirsiniz."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החבר שלך מקליט דוגמה קצרה, ואפשר להשתמש בקול שלו לקריאת ספרי Kindle, קבצים ודפי אינטרנט."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn của bạn thu một đoạn mẫu ngắn, rồi bạn có thể dùng giọng của họ để đọc sách Kindle, tệp và trang web."
          }
        }
      }
    },
