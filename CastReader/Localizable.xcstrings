    "Kindle 书籍入口已失效，请重新同步书架。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Link zu diesem Kindle-Buch ist nicht mehr gültig. Synchronisiere deine Bibliothek erneut." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This Kindle book link is no longer valid. Sync your library again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El enlace de este libro de Kindle ya no es válido. Vuelve a sincronizar tu biblioteca." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le lien de ce livre Kindle n’est plus valide. Synchronisez à nouveau votre bibliothèque." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Kindle किताब का लिंक अब मान्य नहीं है। अपनी लाइब्रेरी फिर से सिंक करें।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il link a questo libro Kindle non è più valido. Sincronizza di nuovo la libreria." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Kindle 本のリンクは無効です。ライブラリを再同期してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O link deste livro do Kindle não é mais válido. Sincronize sua biblioteca novamente." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 书籍入口已失效，请重新同步书架。" } }
