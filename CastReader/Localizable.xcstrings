        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ giọng đọc đang được cập nhật. Vui lòng thử lại sau."
          }
        }
      }
    },
    "声音服务仍在更新。录音已保留，请稍后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sprachdienst wird noch aktualisiert. Deine Aufnahme wurde beibehalten. Bitte versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice service is still being updated. Your recording was kept. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de voz aún se está actualizando. La grabación se ha conservado. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
