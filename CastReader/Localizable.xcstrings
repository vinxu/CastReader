    "检查网络后重试。你的 Kindle 绑定和书架都没有变化。": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung und versuche es erneut. Kindle-Konto und Bibliothek bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. Your Kindle account and library are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión y vuelve a intentarlo. Tu cuenta de Kindle y tu biblioteca no han cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez. Votre compte Kindle et votre bibliothèque sont inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कनेक्शन जाँचें और फिर से कोशिश करें। आपका Kindle खाता और लाइब्रेरी अपरिवर्तित हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la connessione e riprova. Il tuo account Kindle e la libreria non sono cambiati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認してからもう一度お試しください。Kindle の連携とライブラリはそのままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão e tente novamente. Sua conta Kindle e sua biblioteca não mudaram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查网络后重试。你的 Kindle 绑定和书架都没有变化。"
          }
        }
