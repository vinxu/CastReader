    "只需连接一次 Kindle，通勤、走路或眼睛想休息时，CastReader 就能为你朗读书籍。" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbinde Kindle nur einmal. CastReader liest dir deine Bücher beim Pendeln, Spazierengehen oder Entspannen der Augen vor." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect Kindle once, then let CastReader read your books while you commute, walk, or rest your eyes." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Conecta Kindle una vez y CastReader leerá tus libros cuando viajes, camines o quieras descansar la vista." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez Kindle une seule fois, puis laissez CastReader lire vos livres pendant vos trajets, vos marches ou lorsque vos yeux se reposent." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle को बस एक बार कनेक्ट करें। सफ़र, चलते समय या आँखों को आराम देते हुए CastReader आपकी किताबें पढ़कर सुनाएगा।" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Collega Kindle una sola volta e lascia che CastReader legga i tuoi libri mentre viaggi, cammini o riposi gli occhi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleを一度接続するだけ。通勤中や歩いているとき、目を休めたいときにCastReaderが本を読み上げます。" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conecte o Kindle uma vez e deixe o CastReader ler seus livros no trajeto, na caminhada ou enquanto você descansa os olhos." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只需连接一次 Kindle，通勤、走路或眼睛想休息时，CastReader 就能为你朗读书籍。" } } } },
    "登录 Amazon 账号，同步 Kindle 书架，选一本就能开始朗读。" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Melde dich bei deinem Amazon-Konto an, synchronisiere deine Kindle-Bibliothek und wähle ein Buch aus, um es dir vorlesen zu lassen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to your Amazon account, sync your Kindle library, and choose a book to start listening." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión en tu cuenta de Amazon, sincroniza tu biblioteca Kindle y elige un libro para empezar a escucharlo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez-vous à votre compte Amazon, synchronisez votre bibliothèque Kindle, puis choisissez un livre à écouter." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपने Amazon खाते में साइन इन करें, Kindle लाइब्रेरी सिंक करें और सुनना शुरू करने के लिए एक किताब चुनें।" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Accedi al tuo account Amazon, sincronizza la libreria Kindle e scegli un libro da ascoltare." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "AmazonアカウントにログインしてKindleライブラリを同期。読み上げたい本を1冊選ぶだけです。" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Entre na sua conta Amazon, sincronize a biblioteca Kindle e escolha um livro para começar a ouvir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录 Amazon 账号，同步 Kindle 书架，选一本就能开始朗读。" } } } },
    "连接我的 Kindle" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Meinen Kindle verbinden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect my Kindle" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Conectar mi Kindle" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connecter mon Kindle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "मेरा Kindle कनेक्ट करें" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Collega il mio Kindle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "自分のKindleを接続" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conectar meu Kindle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接我的 Kindle" } } } },
    "我没有 Kindle" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Ich habe keinen Kindle" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "I don’t have a Kindle" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No tengo Kindle" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Je n’ai pas de Kindle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "मेरे पास Kindle नहीं है" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Non ho un Kindle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleを持っていません" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não tenho Kindle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我没有 Kindle" } } } },
    "1 · 选站" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "1 · Shop wählen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "1 · Choose store" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "1 · Elegir tienda" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "1 · Choisir la boutique" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "1 · स्टोर चुनें" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "1 · Scegli lo store" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "1 · ストア選択" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "1 · Escolher loja" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "1 · 选站" } } } },
    "你在哪个亚马逊买书？" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Bei welchem Amazon-Shop kaufst du Bücher?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Which Amazon store do you buy books from?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿En qué tienda de Amazon compras libros?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sur quelle boutique Amazon achetez-vous vos livres ?" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप किस Amazon स्टोर से किताबें खरीदते हैं?" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Su quale store Amazon acquisti i libri?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "どのAmazonストアで本を購入していますか？" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Em qual loja da Amazon você compra livros?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你在哪个亚马逊买书？" } } } },
    "%@（已按地区预选）" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ (nach Region vorausgewählt)" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ (preselected for your region)" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ (preseleccionada según tu región)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ (présélectionnée selon votre région)" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ (आपके क्षेत्र के अनुसार पहले से चुना गया)" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "%@ (preselezionato in base alla tua area)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@（地域に合わせて選択済み）" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ (pré-selecionada para sua região)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@（已按地区预选）" } } } },
    "就是这个" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Genau dieser" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This is the one" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta es" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "C’est celle-ci" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यही है" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "È questo" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "これです" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "É esta" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "就是这个" } } } },
    "Capturing Kindle page..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Seite wird erfasst …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Capturing Kindle page..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Capturando la página de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Capture de la page Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle पेज कैप्चर किया जा रहा है…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Acquisizione della pagina Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleページを取得中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Capturando a página do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在获取 Kindle 页面…" } } } },
    "Explaining Kindle page..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Seite wird erklärt …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Explaining Kindle page..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Explicando la página de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Explication de la page Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle पेज की व्याख्या की जा रही है…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Spiegazione della pagina Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleページを解説中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Explicando a página do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在解读 Kindle 页面…" } } } },
    "Generating Kindle audio..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Audio wird erstellt …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Generating Kindle audio..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Generando audio de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Génération de l’audio Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle ऑडियो बनाया जा रहा है…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Generazione dell’audio Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleの音声を生成中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Gerando áudio do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在生成 Kindle 音频…" } } } },
    "Kindle explain" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Erklärung" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Kindle explain" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Explicación de Kindle" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Explication Kindle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle व्याख्या" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Spiegazione Kindle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindle解説" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Explicação do Kindle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 解读" } } } },
    "Kindle page is not ready" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Seite ist noch nicht bereit" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Kindle page is not ready" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La página de Kindle no está lista" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La page Kindle n’est pas prête" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle पेज तैयार नहीं है" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La pagina Kindle non è pronta" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleページの準備ができていません" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A página do Kindle não está pronta" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 页面尚未准备好" } } } },
    "Kindle page preparation failed" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Seite konnte nicht vorbereitet werden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Kindle page preparation failed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo preparar la página de Kindle" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Échec de la préparation de la page Kindle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle पेज तैयार नहीं हो सका" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile preparare la pagina Kindle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleページを準備できませんでした" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível preparar a página do Kindle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 页面准备失败" } } } },
    "Kindle page state is not ready." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Status der Kindle-Seite ist noch nicht bereit." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Kindle page state is not ready." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El estado de la página de Kindle no está listo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’état de la page Kindle n’est pas prêt." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle पेज की स्थिति तैयार नहीं है।" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Lo stato della pagina Kindle non è pronto." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleページの状態がまだ準備できていません。" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O estado da página do Kindle não está pronto." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 页面状态尚未准备好。" } } } },
    "Kindle read aloud" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle vorlesen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Kindle read aloud" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Lectura en voz alta de Kindle" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lecture Kindle à voix haute" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle ज़ोर से पढ़ें" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Lettura Kindle ad alta voce" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindle読み上げ" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Leitura do Kindle em voz alta" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 朗读" } } } },
    "Kindle read preparation failed" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Vorlesen konnte nicht vorbereitet werden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Kindle read preparation failed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo preparar la lectura de Kindle" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Échec de la préparation de la lecture Kindle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle पढ़ने की तैयारी विफल रही" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile preparare la lettura Kindle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindle読み上げを準備できませんでした" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível preparar a leitura do Kindle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 朗读准备失败" } } } },
    "Kindle source is out of sync" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Inhalt ist nicht synchronisiert" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Kindle source is out of sync" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El contenido de Kindle no está sincronizado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le contenu Kindle n’est pas synchronisé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle सामग्री सिंक नहीं है" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Il contenuto Kindle non è sincronizzato" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleコンテンツが同期されていません" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O conteúdo do Kindle não está sincronizado" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Kindle 内容不同步" } } } },
    "Loading more Kindle pages..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Weitere Kindle-Seiten werden geladen …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading more Kindle pages..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cargando más páginas de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chargement d’autres pages Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "और Kindle पेज लोड किए जा रहे हैं…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Caricamento di altre pagine Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "さらにKindleページを読み込み中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Carregando mais páginas do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在加载更多 Kindle 页面…" } } } },
    "Loading next Kindle page..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Nächste Kindle-Seite wird geladen …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading next Kindle page..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cargando la siguiente página de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chargement de la page Kindle suivante…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अगला Kindle पेज लोड किया जा रहा है…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Caricamento della pagina Kindle successiva…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "次のKindleページを読み込み中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Carregando a próxima página do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在加载下一页 Kindle 内容…" } } } },
    "Need the Kindle page open to load more" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Zum Nachladen muss die Kindle-Seite geöffnet sein" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Need the Kindle page open to load more" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre la página de Kindle para cargar más" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrez la page Kindle pour charger la suite" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आगे लोड करने के लिए Kindle पेज खुला रखें" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Apri la pagina Kindle per caricare altro contenuto" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "続けて読み込むにはKindleページを開いてください" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abra a página do Kindle para carregar mais" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要打开 Kindle 页面才能继续加载" } } } },
    "No more loaded Kindle pages" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine weiteren Kindle-Seiten geladen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No more loaded Kindle pages" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay más páginas de Kindle cargadas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune autre page Kindle n’est chargée" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "और कोई Kindle पेज लोड नहीं है" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Non ci sono altre pagine Kindle caricate" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込み済みのKindleページはもうありません" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não há mais páginas do Kindle carregadas" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有更多已加载的 Kindle 页面" } } } },
    "Open a Kindle book page, keep it visible for a moment, then retry." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffne eine Kindle-Buchseite, lass sie einen Moment sichtbar und versuche es erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open a Kindle book page, keep it visible for a moment, then retry." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre una página de un libro Kindle, déjala visible un momento y vuelve a intentarlo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrez une page de livre Kindle, laissez-la visible un instant, puis réessayez." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle किताब का पेज खोलें, उसे कुछ देर दिखने दें, फिर कोशिश करें।" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Apri una pagina di un libro Kindle, lasciala visibile per un momento e riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindle本のページを開いてしばらく表示したままにしてから、もう一度お試しください。" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abra uma página de um livro Kindle, mantenha-a visível por alguns instantes e tente novamente." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开 Kindle 书籍页面，保持显示片刻，然后重试。" } } } },
