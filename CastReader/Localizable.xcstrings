    "内容太短，无法解读，试试朗读": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt zu kurz für eine Erklärung. Versuche Vorlesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content too short to explain. Try Read Aloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido demasiado corto para explicarlo. Intente leer en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu trop court pour être expliqué. Essayez de lire à haute voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समझाने के लिए सामग्री बहुत छोटी है. जोर से पढ़ने का प्रयास करें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuto troppo breve per essere spiegato. Prova a leggere ad alta voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が短すぎて説明できません。声に出して読んでみてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo muito curto para explicar. Experimente ler em voz alta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太短，无法解读，试试朗读"
          }
        }
      }
    },
    "内容太短或暂不支持解读，请稍后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Inhalt ist zu kurz oder wird für Erklärungen nicht unterstützt. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content is too short or is not supported for explanation. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido es demasiado breve o no se puede explicar por ahora. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu est trop court ou n’est pas encore pris en charge pour l’explication. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सामग्री बहुत छोटी है या अभी व्याख्या के लिए समर्थित नहीं है। बाद में फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto è troppo breve o non è ancora supportato per la spiegazione. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が短すぎるか、現在は解説に対応していません。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo é curto demais ou ainda não é compatível com a explicação. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太短或暂不支持解读，请稍后重试"
          }
        }
      }
    },
