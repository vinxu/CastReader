    "声音仍可正常使用，名称同步暂不可用，请稍后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimme funktioniert weiterhin. Die Namensynchronisierung ist vorübergehend nicht verfügbar. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice still works. Name syncing is temporarily unavailable; try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz sigue funcionando. La sincronización del nombre no está disponible temporalmente; inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
