          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο δείγματος δεν χρειάζεται να ταιριάζει λέξη προς λέξη. Η ηχογράφησή σας έχει αποθηκευτεί· δοκιμάστε ξανά χωρίς αλλαγές."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mintaszövegnek nem kell szóról szóra egyeznie. A felvételt megőriztük; próbálja újra változtatás nélkül."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailangang sundan ang halimbawa nang salita sa salita. Naka-save ang iyong rekording; subukang iproseso itong muli nang walang pagbabago."
          }
        },
        "ms": {
          "stringUnit": {
