          "stringUnit": {
            "state": "translated",
            "value": "Kindle 세션이 만료되었습니다. 다시 로그인하고 라이브러리를 동기화하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة Kindle الخاصة بك. سجّل الدخول مرة أخرى وزامن مكتبتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия Kindle истекла. Войдите снова и синхронизируйте библиотеку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja sesja Kindle wygasła. Zaloguj się ponownie i zsynchronizuj bibliotekę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kindle-session har upphört. Logga in igen och synkronisera ditt bibliotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kindle-session er udløbet. Log ind igen og synkroniser dit bibliotek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kindle-sesjon har utløpt. Logg inn på nytt og synkroniser biblioteket ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle-istuntosi on vanhentunut. Kirjaudu uudelleen ja synkronoi kirjastosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše relace Kindle vypršela. Přihlaste se znovu a synchronizujte svou knihovnu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία Kindle σας έχει λήξει. Συνδεθείτε ξανά και συγχρονίστε τη βιβλιοθήκη σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kindle munkamenet lejárt. Jelentkezzen be újra, és szinkronizálja a könyvtárat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire ang iyong Kindle session. Mag-sign in ulit at i-sync ang iyong aklatan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle oturumunuzun süresi doldu. Tekrar giriş yapın ve kitaplığınızı senkronize edin."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Kindle anda telah tamat tempoh. Log masuk semula dan segerakkan pustaka anda."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Kindle Anda telah kedaluwarsa. Masuk kembali dan sinkronkan pustaka Anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea ta Kindle a expirat. Conectează-te din nou și sincronizează biblioteca."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף ההתחברות שלך ל־Kindle פג. יש להיכנס שוב ולסנכרן את הספרייה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên Kindle của bạn đã hết hạn. Đăng nhập lại và đồng bộ thư viện."
          }
        }
      }
    },
