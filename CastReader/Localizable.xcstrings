    "退出登录后需要重新登录才能继续使用 CastReader。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Abmelden musst du dich erneut anmelden, um CastReader weiter zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing out, you'll need to sign in again to keep using CastReader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cerrar sesión, deberás iniciar sesión de nuevo para seguir usando CastReader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la déconnexion, vous devrez vous reconnecter pour continuer à utiliser CastReader."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन आउट करने के बाद CastReader का उपयोग जारी रखने के लिए फिर से साइन इन करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la disconnessione dovrai accedere di nuovo per continuare a usare CastReader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウト後、CastReader を続けて使うには再度ログインが必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de sair, você precisará fazer login novamente para continuar usando o CastReader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录后需要重新登录才能继续使用 CastReader。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het afmelden moet u zich opnieuw aanmelden om CastReader te blijven gebruiken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃 후 CastReader를 계속 사용하려면 다시 로그인해야 합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تسجيل الخروج، ستحتاج إلى تسجيل الدخول مرة أخرى للاستمرار في استخدام CastReader."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выхода вам потребуется войти снова, чтобы продолжать использовать CastReader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wylogowaniu będziesz musiał się ponownie zalogować, aby nadal korzystać z CastReader."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter att du loggat ut måste du logga in igen för att fortsätta använda CastReader."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter udlogning skal du logge ind igen for at fortsætte med at bruge CastReader."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter at du logger deg ut, må du logge inn på nytt for å fortsette å bruke CastReader."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauduttuasi ulos sinun on kirjauduttava uudelleen käyttääksesi CastReaderia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po odhlášení se musíte znovu přihlásit, abyste mohli CastReader dál používat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά την αποσύνδεση, θα χρειαστεί να συνδεθείτε ξανά για να συνεχίσετε να χρησιμοποιείτε το CastReader."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelentkezés után újra be kell jelentkeznie a CastReader használatához."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagkatapos mag-sign out, kailangan mong mag-sign in ulit upang patuloy na gamitin ang CastReader."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah keluar, Anda perlu masuk kembali untuk terus menggunakan CastReader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış yaptıktan sonra CastReader kullanmaya devam edebilmek için tekrar giriş yapmanız gerekecek."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas log keluar, anda perlu log masuk semula untuk terus menggunakan CastReader."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După deconectare, va trebui să te conectezi din nou pentru a continua să folosești CastReader."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר היציאה מהחשבון יהיה צורך להיכנס שוב כדי להמשיך להשתמש ב־CastReader."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đăng xuất, bạn cần đăng nhập lại để tiếp tục sử dụng CastReader."
          }
        }
      }
    },
