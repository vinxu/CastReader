          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の読み上げ・解説はあと%d分です。正常に生成された音声時間だけが計上されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
