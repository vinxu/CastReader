    "Preparing more Kindle pages..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Weitere Kindle-Seiten werden vorbereitet …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing more Kindle pages..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preparando más páginas de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préparation d’autres pages Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "और Kindle पेज तैयार किए जा रहे हैं…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Preparazione di altre pagine Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "さらにKindleページを準備中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Preparando mais páginas do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备更多 Kindle 页面…" } } } },
