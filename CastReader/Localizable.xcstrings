    "登录后 Pro 与额度跨设备同步": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden, um Pro und Nutzung geräteübergreifend zu synchronisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to sync Pro and usage across devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para sincronizar Pro y el uso en todos los dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour synchroniser Pro et l'utilisation sur tous les appareils"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी डिवाइसों में प्रो और उपयोग को सिंक करने के लिए साइन इन करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per sincronizzare Pro e l'utilizzo su tutti i dispositivi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインして Pro とデバイス間での使用状況を同期する"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login para sincronizar o Pro e o uso entre dispositivos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后 Pro 与额度跨设备同步"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in om Pro en gebruik tussen apparaten te synchroniseren"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하여 기기 간에 Pro와 사용량을 동기화하세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لمزامنة Pro والاستخدام بين أجهزتك"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
