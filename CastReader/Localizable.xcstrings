            "state": "translated",
            "value": "Die Aufnahme konnte nicht vollständig gespeichert werden. Bitte nimm sie erneut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not be saved completely. Please record it again."
          }
        },
