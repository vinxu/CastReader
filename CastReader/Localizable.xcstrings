            "value": "لماذا تنهي صفحة ولا تتذكر شيئًا؟"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему вы заканчиваете страницу и ничего не помните?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego kończysz stronę i nic nie pamiętasz?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varför minns du inget när du läst klart en sida?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor husker du intet, når du har læst en side?"
