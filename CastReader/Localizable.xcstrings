    "拍摄、上传、输入网址或文本，处理过的内容都在这里。仅保存在本机。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du aufnimmst, hochlädst oder einfügst, erscheint hier. Nur auf diesem Gerät gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you capture, upload, or paste lives here. Stored on this device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que capturas, subes o pegas vive aquí. Almacenado únicamente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous capturez, téléchargez ou collez se trouve ici. Stocké sur cet appareil uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो कुछ भी कैप्चर करते हैं, अपलोड करते हैं या पेस्ट करते हैं वह यहां रहता है। केवल इस डिवाइस पर संग्रहीत."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che catturi, carichi o incolli risiede qui. Memorizzato solo su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ、アップロード、またはペーストしたものはすべてここに保存されます。このデバイスにのみ保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você captura, carrega ou cola fica aqui. Armazenado apenas neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄、上传、输入网址或文本，处理过的内容都在这里。仅保存在本机。"
          }
        }
      }
    },
