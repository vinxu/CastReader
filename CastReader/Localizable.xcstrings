        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là trang WeRead chính thức. CastReader không thể xem hoặc lưu trữ tài khoản hoặc mật khẩu WeChat của bạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je oficiální stránka WeRead. CastReader nemůže zobrazit ani uložit váš účet či heslo pro WeChat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a WeRead hivatalos oldala. A CastReader nem láthatja és nem tárolhatja a WeChat-fiókodat vagy jelszavadat."
