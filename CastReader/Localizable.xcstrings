    "打开任意位置，然后点播放开始朗读。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine beliebige Stelle und tippe zum Vorlesen auf Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open any position, then tap Play to read aloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra cualquier posición, luego toque Reproducir para leer en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez n’importe quelle position, puis appuyez sur Jouer pour lire à haute voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी स्थिति खोलें, फिर ज़ोर से पढ़ने के लिए चलाएँ पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri qualsiasi posizione, quindi tocca Riproduci per leggere ad alta voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の位置を開いて、「再生」をタップして読み上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra qualquer posição e toque em Reproduzir para ler em voz alta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开任意位置，然后点播放开始朗读。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een willekeurige locatie en tik op Afspelen om voor te lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 위치든 열고 재생을 탭하여 읽어줍니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أي موقع، ثم اضغط على تشغيل للقراءة بصوت عالٍ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте любую позицию, затем нажмите «Воспроизвести», чтобы включить озвучивание."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz dowolną pozycję, a następnie dotknij Odtwórz, aby przeczytać na głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna valfri position och tryck på Spela för att läsa upp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn et hvilket som helst afsnit, og tryk på Afspil for at læse op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne hvilken som helst posisjon, og trykk deretter på Spill av for å lese høyt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa mikä tahansa kohta, sitten napauta Toista ääneen lukeaksesi sen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete libovolné místo, pak klepněte na Přehrát pro čtení nahlas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε οποιαδήποτε θέση, στη συνέχεια πατήστε Αναπαραγωγή για ανάγνωση με φωνή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisson meg bármelyik pozíciót, majd koppintson a Lejátszás gombra a felolvasáshoz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang anumang posisyon, tapos i-tap ang Play para mabasa nang malakas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח מיקום כלשהו והקש על ניגון כדי להתחיל בקריאה בקול."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka posisi mana pun, lalu ketuk Putar untuk mulai membaca nyaring."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka mana-mana kedudukan, kemudian ketik Main untuk membaca kuat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir konumu açın, ardından sesli okumak için Oynat'a dokunun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide la orice poziție, apoi atinge Redare pentru a citi cu voce tare."
