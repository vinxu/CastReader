            "state": "translated",
            "value": "Si ve su biblioteca Kindle, toque Sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous voyez votre bibliothèque Kindle, appuyez sur Synchroniser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप अपनी किंडल लाइब्रेरी देखते हैं, तो सिंक पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vedi la tua libreria Kindle, tocca Sincronizza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle ライブラリが表示されたら、「同期」をタップします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você vir sua biblioteca Kindle, toque em Sincronizar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已经看到 Kindle 书架，请点同步。"
          }
        }
