    "录音未能完整保存，请重录": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht vollständig gespeichert werden. Bitte nimm sie erneut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not be saved completely. Please record it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación no se pudo guardar por completo. Por favor grábalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'a pas pu être sauvegardé complètement. Veuillez l'enregistrer à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग पूरी तरह से सहेजी नहीं जा सकी. कृपया इसे दोबारा रिकॉर्ड करें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare completamente la registrazione. Per favore, registralo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を完全に保存できませんでした。もう一度録音してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação não pôde ser salva completamente. Por favor, grave novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音未能完整保存，请重录"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname kon niet volledig worden opgeslagen. Neem deze opnieuw op."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 완전히 저장하지 못했습니다. 다시 녹음해 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ التسجيل بالكامل. يرجى تسجيله مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись не удалось сохранить полностью. Пожалуйста, запишите её снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się całkowicie zapisać nagrania. Nagraj je ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen kunde inte sparas helt. Vänligen spela in den igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen kunne ikke gemmes fuldstændigt. Optag den igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket kunne ikke lagres fullstendig. Vennligst ta det på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänitystä ei voitu tallentaa kokonaan. Tallenna se uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávku se nepodařilo uložit kompletně. Nahrajte ji znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ηχογράφηση δεν αποθηκεύτηκε πλήρως. Παρακαλώ ηχογραφήστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvételt nem sikerült teljesen menteni. Kérjük, rögzítse újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-save nang buo ang recording. Paki-record ulit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak dapat disimpan sepenuhnya. Silakan rekam ulang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt tamamen kaydedilemedi. Lütfen tekrar kaydedin."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman tidak dapat disimpan sepenuhnya. Sila rakam semula."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea nu a putut fi salvată integral. Înregistrează din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור את ההקלטה במלואה. יש להקליט שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu đầy đủ bản ghi âm. Vui lòng ghi lại."
          }
        }
      }
