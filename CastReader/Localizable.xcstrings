    "刷新会重新同步书架并更新这本书的入口，不会清除朗读设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This refresh syncs your library and updates this book's entry without clearing playback settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この更新によりライブラリが同期され、再生設定をクリアせずにこの本のエントリが更新されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta actualización sincroniza su biblioteca y actualiza la entrada de este libro sin borrar la configuración de reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette actualisation synchronise votre bibliothèque et met à jour l'entrée de ce livre sans effacer les paramètres de lecture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta atualização sincroniza sua biblioteca e atualiza a entrada deste livro sem limpar as configurações de reprodução."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo aggiornamento sincronizza la tua libreria e aggiorna la voce di questo libro senza cancellare le impostazioni di riproduzione."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिफ्रेश आपकी लाइब्रेरी को सिंक करता है और प्लेबैक सेटिंग्स को साफ़ किए बिना इस पुस्तक की प्रविष्टि को अपडेट करता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新会重新同步书架并更新这本书的入口，不会清除朗读设置。"
          }
        }
      }
    },
