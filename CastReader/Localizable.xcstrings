        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Откройте сохранённые книги."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Otwórz swoje zapisane książki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Öppna dina sparade böcker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Åbn dine gemte bøger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Åpne dine lagrede bøker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Avaa tallennetut kirjat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste offline. Otevřete své uložené knihy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε εκτός σύνδεσης. Ανοίξτε τα αποθηκευμένα βιβλία σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs internetkapcsolata. Nyissa meg a mentett könyveket."
