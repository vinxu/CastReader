        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc âm thanh này. Tệp có thể bị hỏng hoặc có định dạng chưa được hỗ trợ."
          }
        }
      }
    },
    "没有找到足够清晰、连续的人声，请换一个文件": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nicht genug klare, zusammenhängende Sprache gefunden. Wähle eine andere Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough clear, continuous speech was found. Choose another file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró suficiente voz clara y continua. Elige otro archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de parole claire et continue détectée. Choisissez un autre fichier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्याप्त साफ़ और लगातार आवाज़ नहीं मिली। कोई दूसरी फ़ाइल चुनें।"
