    "登录邮箱账号后，Pro 可跨设备同步。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit einem E-Mail-Konto an, um Pro geräteübergreifend zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with an email account to sync Pro across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con una cuenta de correo para sincronizar Pro entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec un compte e-mail pour synchroniser Pro entre vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपकरणों के बीच Pro सिंक करने के लिए ईमेल खाते से साइन इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con un account email per sincronizzare Pro su tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアカウントでログインすると、Pro をデバイス間で同期できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login com uma conta de e-mail para sincronizar o Pro entre dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录邮箱账号后，Pro 可跨设备同步。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld u aan met een e-mailaccount om Pro over apparaten te synchroniseren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 기능을 기기 간에 동기화하려면 이메일 계정으로 로그인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول بحساب بريد إلكتروني لمزامنة Pro عبر الأجهزة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите с помощью учётной записи электронной почты, чтобы синхронизировать Pro на всех устройствах."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się za pomocą konta e-mail, aby synchronizować wersję Pro między urządzeniami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med ett e-postkonto för att synkronisera Pro över enheter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med en e-mailkonto for at synkronisere Pro på tværs af enheder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn med en e-postkonto for å synkronisere Pro på tvers av enheter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sähköpostitilillä synkronoidaksesi Pro:n laitteiden välillä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro synchronizaci Pro mezi zařízeními se přihlaste pomocí e-mailového účtu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε με λογαριασμό ηλεκτρονικού ταχυδρομείου για συγχρονισμό του Pro σε όλες τις συσκευές."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be e-mail fiókkal a Pro funkció eszközök közötti szinkronizálásához."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in gamit ang email account upang i-sync ang Pro sa lahat ng device."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan akun email untuk menyinkronkan Pro di semua perangkat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro'yu cihazlar arasında senkronize etmek için e-posta hesabıyla giriş yapın."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk dengan akaun e-mel untuk menyegerakkan Pro antara peranti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te cu un cont de e-mail pentru a sincroniza Pro pe toate dispozitivele."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להיכנס עם חשבון דוא״ל כדי לסנכרן את Pro בין המכשירים."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng tài khoản email để đồng bộ Pro giữa các thiết bị."
          }
        }
      }
    },
