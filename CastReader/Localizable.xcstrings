            "value": "Stocké sur cet appareil uniquement, jamais téléchargé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस डिवाइस पर संग्रहीत, कभी अपलोड नहीं किया गया"
          }
        },
        "it": {
