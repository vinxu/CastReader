    "下一页已缓存，但 Kindle 页面同步失败，已暂停。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Seite ist zwischengespeichert, aber die Kindle-Seitensynchronisierung ist fehlgeschlagen. Die Wiedergabe wurde pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next page is cached, but Kindle page sync failed. Playback is paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página siguiente está en caché, pero no se pudo sincronizar la página de Kindle. La reproducción está en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page suivante est en cache, mais la synchronisation de la page Kindle a échoué. La lecture est en pause."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगला पेज कैश हो गया है, लेकिन Kindle पेज सिंक नहीं हुआ। प्लेबैक रोक दिया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina successiva è nella cache, ma la sincronizzazione della pagina Kindle non è riuscita. La riproduzione è in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のページはキャッシュ済みですが、Kindleページの同期に失敗したため一時停止しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima página está em cache, mas a sincronização da página do Kindle falhou. A reprodução foi pausada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一页已缓存，但 Kindle 页面同步失败，已暂停。"
          }
        }
      }
    },
    "下一页播放衔接失败，请点击播放继续。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe konnte auf der nächsten Seite nicht fortgesetzt werden. Tippe zum Fortfahren auf Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t continue playback on the next page. Tap Play to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo continuar la reproducción en la página siguiente. Toca Reproducir para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de poursuivre la lecture sur la page suivante. Touchez Lecture pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले पेज पर प्लेबैक जारी नहीं हो सका। जारी रखने के लिए चलाएँ पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile continuare la riproduzione nella pagina successiva. Tocca Riproduci per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のページへの連続再生に失敗しました。再生をタップして続けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível continuar a reprodução na próxima página. Toque em Reproduzir para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一页播放衔接失败，请点击播放继续。"
          }
        }
      }
    },
