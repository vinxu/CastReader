            "value": "इस डिवाइस पर अनलॉक किया गया. क्रॉस-प्लेटफ़ॉर्म सिंक लंबित है."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已解锁，跨平台同步待完成"
          }
        }
      }
    },
    "本机已解锁；登录邮箱后可完成跨平台同步。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is unlocked; log in with your email to sync Pro across platforms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはロックが解除されています。メールアドレスでログインして、プラットフォーム間で Pro を同期します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; inicie sesión con su correo electrónico para sincronizar Pro entre plataformas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est déverrouillé ; connectez-vous avec votre e-mail pour synchroniser Pro sur toutes les plateformes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está desbloqueado; faça login com seu e-mail para sincronizar o Pro entre plataformas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è sbloccato; accedi con la tua email per sincronizzare Pro su tutte le piattaforme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपकरण अनलॉक है; प्रो को सभी प्लेटफ़ॉर्म पर सिंक करने के लिए अपने ईमेल से लॉग इन करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已解锁；登录邮箱后可完成跨平台同步。"
          }
        }
      }
    },
    "本机已解锁；跨平台同步等待 Apple 验证接口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is unlocked; cross-platform sync is waiting for Apple verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはロックが解除されています。クロスプラットフォーム同期は Apple の検証を待っています。"
