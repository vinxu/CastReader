    "连接后可查看此账号在本机保存的书籍。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后可查看此账号在本机保存的书籍。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to view this account’s books saved on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携すると、このアカウントで端末に保存した本を確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta la cuenta para ver sus libros guardados en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez le compte pour voir ses livres enregistrés sur cet appareil."
          }
