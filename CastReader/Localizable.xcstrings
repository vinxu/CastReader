    "从 Safari 解锁完整朗读与解读": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock full Read Aloud and Explain from Safari"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariから「読み上げ」と「解説」の全機能を利用できます"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea todas las funciones de Leer en voz alta y Explicar desde Safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez toutes les fonctions Lire à voix haute et Expliquer depuis Safari"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie todos os recursos de Ler em voz alta e Explicar pelo Safari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca tutte le funzioni Leggi ad alta voce e Spiega da Safari"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari से ज़ोर से पढ़ें और व्याख्या की सभी सुविधाएँ अनलॉक करें"
          }
        },
        "zh-Hans": {
          "stringUnit": {
