        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק את כל ההיסטוריה המקומית בספרייה שלך. לא ניתן לבטל אותה."
          }
        }
      }
    },
    "将清除本机 Kindle 书架缓存和 read.amazon.com 登录状态。首页 Kindle 模块会回到绑定 Kindle，需要重新登录和同步。": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden der lokale Kindle-Bibliothekscache und die Anmeldung bei read.amazon.com gelöscht. Das Kindle-Modul auf der Startseite zeigt wieder „Kindle verbinden“ und du musst dich erneut anmelden und synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will clear the local Kindle shelf cache and the read.amazon.com sign-in state. The Kindle module on Home will return to Connect Kindle, and you will need to sign in and sync again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará la memoria caché local de Kindle y el estado de inicio de sesión de read.amazon.com. El módulo Kindle en Inicio volverá a Connect Kindle y deberá iniciar sesión y sincronizar nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera le cache de l'étagère Kindle locale et l'état de connexion read.amazon.com. Le module Kindle sur Home reviendra à Connect Kindle et vous devrez vous connecter et synchroniser à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे स्थानीय किंडल शेल्फ़ कैश और read.amazon.com साइन-इन स्थिति साफ़ हो जाएगी। होम पर किंडल मॉड्यूल कनेक्ट किंडल पर वापस आ जाएगा, और आपको फिर से साइन इन और सिंक करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò cancellerà la cache dello scaffale Kindle locale e lo stato di accesso read.amazon.com. Il modulo Kindle sulla Home tornerà a Connect Kindle e dovrai accedere e sincronizzare nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、ローカルの Kindle 棚キャッシュと read.amazon.com のサインイン状態がクリアされます。ホームの Kindle モジュールは Connect Kindle に戻り、サインインして再度同期する必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso limpará o cache local da prateleira do Kindle e o estado de login read.amazon.com. O módulo Kindle na página inicial retornará ao Connect Kindle e você precisará fazer login e sincronizar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将清除本机 Kindle 书架缓存和 read.amazon.com 登录状态。首页 Kindle 模块会回到绑定 Kindle，需要重新登录和同步。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de lokale cache van de Kindle-plank en de inlogstatus van read.amazon.com gewist. De Kindle-module op Start keert terug naar 'Kindle verbinden', en u moet zich opnieuw aanmelden en synchroniseren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 로컬 Kindle 책장 캐시와 read.amazon.com 로그인 상태를 초기화합니다. 홈의 Kindle 모듈이 'Kindle 연결'으로 돌아오며, 다시 로그인하고 동기화해야 합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى مسح ذاكرة التخزين المؤقت لرف Kindle وحالة تسجيل الدخول إلى read.amazon.com على هذا الجهاز. سيعود قسم Kindle في الشاشة الرئيسية إلى «ربط Kindle»، وستحتاج إلى تسجيل الدخول والمزامنة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие очистит локальный кэш полки Kindle и состояние входа на read.amazon.com. Модуль Kindle на главной странице вернётся к состоянию «Подключить Kindle», и вам потребуется войти в систему и выполнить синхронизацию заново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To czyści pamięć podręczną lokalnej półki Kindle oraz stan logowania read.amazon.com. Moduł Kindle na stronie głównej wróci do opcji Połącz Kindle, a Ty będziesz musiał ponownie zalogować się i zsynchronizować."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta rensar den lokala Kindle-hyllcachen och inloggningsstatusen för read.amazon.com. Kindle-modulen på Hem återgår till Anslut Kindle, och du måste logga in och synkronisera igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette rydder den lokale Kindle-bibliotekscache og loginstatus for read.amazon.com. Kindle på Hjem vender tilbage til Forbind Kindle, og du skal logge ind og synkronisere igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tømmer den lokale hurtigbufferen for Kindle-bokhyllen og påloggingen på read.amazon.com. Kindle-delen på Hjem går tilbake til «Koble til Kindle», og du må logge inn og synkronisere på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tyhjentää paikallisen Kindle-kirjaston välimuistin ja read.amazon.com-kirjautumistilan. Etusivun Kindle-osio palaa Yhdistä Kindle -tilaan. Sinun on kirjauduttava sisään ja synkronoitava uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se vymaže lokální mezipaměť police Kindle a stav přihlášení read.amazon.com. Modul Kindle na domovské obrazovce se vrátí na Připojit Kindle a budete muset znovu zadat přihlašovací údaje a provést synchronizaci."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει την τοπική προσωρινή μνήμη της βιβλιοθήκης Kindle και την κατάσταση σύνδεσης στο read.amazon.com. Η ενότητα Kindle στην Αρχική επιστρέφει στο «Σύνδεση Kindle» και θα χρειαστεί να συνδεθείτε και να συγχρονίσετε ξανά."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglilinis ito ng local Kindle estante cache at ng sign-in state ng read.amazon.com. Babalik ang Kindle module sa Home sa Connect Kindle, at kailangan mong mag-sign in at mag-sync muli."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va șterge memoria cache locală a raftului Kindle și starea de autentificare read.amazon.com. Modulul Kindle de pe Pagina principală va reveni la Conectare Kindle, iar tu va trebui să te autentifici și să sincronizezi din nou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động này sẽ xóa bộ nhớ đệm kệ Kindle cục bộ và trạng thái đăng nhập read.amazon.com. Mô-đun Kindle trên Trang chủ sẽ quay lại Kết nối Kindle, và bạn cần đăng nhập và đồng bộ lại."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli a helyi Kindle-könyvtár gyorsítótárát és a read.amazon.com bejelentkezési állapotát. A kezdőlapon újra a Kindle csatlakoztatása jelenik meg; ismét be kell jelentkezned és szinkronizálnod."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengosongkan cache rak Kindle setempat dan status log masuk read.amazon.com. Modul Kindle di Utama akan kembali kepada Sambungkan Kindle, dan anda perlu log masuk serta menyegerakkan semula."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan menghapus cache rak Kindle lokal dan status masuk read.amazon.com. Modul Kindle di Beranda akan kembali ke Hubungkan Kindle, dan Anda perlu masuk serta menyinkronkan kembali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, yerel Kindle kitaplık önbelleğini ve read.amazon.com oturumunu temizler. Ana Sayfa'daki Kindle bölümü Kindle'ı Bağla durumuna döner; yeniden giriş yapmanız ve eşitlemeniz gerekir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק את המטמון המקומי של מדף Kindle ואת מצב הכניסה ל־read.amazon.com. רכיב Kindle בדף הבית יחזור למצב חיבור Kindle, ויהיה צורך להיכנס ולסנכרן מחדש."
          }
        }
      }
    },
    "将清除本机 Kindle 书架缓存和所有 Amazon 站点的登录状态。首页 Kindle 模块会回到绑定 Kindle，需要重新登录和同步。": {
