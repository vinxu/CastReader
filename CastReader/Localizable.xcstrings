    "已替你选好，也可以点其他书。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben bereits ein Buch ausgewählt. Tippe zum Wechseln auf ein anderes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ve selected one for you. Tap another book to switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hemos elegido uno. Toca otro libro para cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous en avons déjà choisi un. Touchez un autre livre pour changer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने आपके लिए एक किताब चुन दी है। बदलने के लिए दूसरी किताब पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne abbiamo già scelto uno. Tocca un altro libro per cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1冊選んであります。別の本をタップすると変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já escolhemos um. Toque em outro livro para trocar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已替你选好，也可以点其他书。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben er één voor u geselecteerd. Tik op een ander boek om te wisselen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد اخترنا واحدًا لك. اضغط على كتاب آخر للتبديل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы уже выбрали одну для вас. Нажмите другую книгу, чтобы переключиться."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybraliśmy jedną za Ciebie. Stuknij inną książkę, aby przełączyć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har valt en åt dig. Tryck på en annan bok för att byta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har valgt én til dig. Tryk på en anden bog for at skifte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har valgt én for deg. Trykk på en annen bok for å bytte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olemme valinneet yhden puolestasi. Napauta toista kirjaa vaihtaaksesi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrali jsme jednu za vás. Klepněte na jinou knihu pro přepnutí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχουμε επιλέξει ένα για εσάς. Πατήστε σε άλλο βιβλίο για εναλλαγή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválasztottunk Önnek egy könyvet. A váltáshoz koppintson egy másikra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinili namin ang isa para sa iyo. I-tap ang ibang libro para palitan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 하나 선택해 두었습니다. 다른 책을 누르면 변경됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah memilih satu untuk anda. Ketik buku lain untuk menukar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah memilih satu untuk Anda. Ketuk buku lain untuk menggantinya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin için bir kitap seçtik. Değiştirmek için başka bir kitaba dokunun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am selectat o carte pentru tine. Atinge altă carte pentru a schimba selecția."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרנו ספר עבורך. אפשר להקיש על ספר אחר כדי להחליף."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã chọn một cuốn cho bạn. Nhấn vào cuốn khác để đổi."
          }
        }
      }
    },
    "系统已经替你选好，也可以稍后再换。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben bereits ein Buch für dich ausgewählt. Du kannst es später jederzeit ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ve already chosen a book for you. You can change it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hemos elegido un libro por ti. Puedes cambiarlo más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons déjà choisi un livre pour vous. Vous pourrez le changer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने आपके लिए किताब चुन दी है। आप इसे बाद में बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo già scelto un libro per te. Potrai cambiarlo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本はすでに選んであります。あとから変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já escolhemos um livro para você. É possível alterá-lo depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统已经替你选好，也可以稍后再换。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben al een boek voor je gekozen. Je kunt dit later wijzigen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد اخترنا لك كتابًا بالفعل. يمكنك تغييره لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы уже выбрали для вас книгу. Позже можно выбрать другую."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybraliśmy już dla Ciebie książkę. Możesz ją później zmienić."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har redan valt en bok åt dig. Du kan ändra den senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har allerede valgt en bog til dig. Du kan ændre den senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har allerede valgt en bok for deg. Du kan endre den senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olemme jo valinneet sinulle kirjan. Voit vaihtaa sen myöhemmin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vás již byla vybrána kniha. Později ji můžete změnit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχουμε ήδη επιλέξει ένα βιβλίο για εσάς. Μπορείτε να το αλλάξετε αργότερα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már kiválasztottunk Önnek egy könyvet. Ezt később módosíthatja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakapili na kami ng aklat para sa iyo. Maaari kang pumili ng iba mamaya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah memilihkan buku untuk anda. Anda boleh menukarnya nanti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin için zaten bir kitap seçtik. İsterseniz daha sonra değiştirebilirsiniz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 하나 골라 두었습니다. 나중에 변경할 수 있습니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami sudah memilih sebuah buku untuk Anda. Anda dapat menggantinya nanti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am ales deja o carte pentru tine. O poți schimba mai târziu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר בחרנו ספר עבורך. אפשר לשנות אותו בהמשך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã chọn sẵn một cuốn sách cho bạn. Bạn có thể đổi sau."
