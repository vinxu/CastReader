    "CastReader 不保存你的密码或整本正文。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader speichert weder dein Passwort noch den vollständigen Text deiner Bücher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader does not save your password or the full text of your books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader no guarda tu contraseña ni el texto completo de tus libros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader n’enregistre ni votre mot de passe ni le texte intégral de vos livres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader आपका पासवर्ड या आपकी किताबों का पूरा पाठ सेव नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader non salva la password né il testo completo dei tuoi libri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReaderはパスワードや本の全文を保存しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CastReader não salva sua senha nem o texto completo dos seus livros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader 不保存你的密码或整本正文。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader slaat uw wachtwoord of de volledige tekst van uw boeken niet op."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader는 비밀번호나 책의 전체 텍스트를 저장하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحفظ CastReader كلمة مرورك ولا النص الكامل لكتبك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader не сохраняет ваш пароль или полный текст книг."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader nie zapisuje Twojego hasła ani pełnego tekstu książek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader sparar inte ditt lösenord eller hela texten i dina böcker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader gemmer ikke din adgangskode eller hele teksten i dine bøger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader lagrer ikke passordet ditt eller hele teksten i bøkene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader ei tallenna salasanaasi tai kirjojesi koko tekstiä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader neukládá vaše heslo ani celý text vašich knih."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CastReader δεν αποθηκεύει τον κωδικό πρόσβασής σας ούτε το πλήρες κείμενο των βιβλίων σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CastReader nem menti el a jelszavát vagy könyvei teljes szövegét."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nag-iimbak ang CastReader ng iyong password o buong teksto ng iyong mga aklat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader לא שומר את הסיסמה שלך או את הטקסט המלא של הספרים שלך."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader tidak menyimpan kata sandi Anda atau teks lengkap buku Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader tidak menyimpan kata laluan anda atau teks penuh buku anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader nu salvează parola ta sau textul complet al cărților tale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader şifrenizi veya kitaplarınızın tam metnini kaydetmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CastReader không lưu mật khẩu hoặc toàn văn sách của bạn."
          }
        }
      }
    },
    "Debug only：测试锁屏后 WebView 是否还能滚动": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Debug: Testen, ob WebView nach dem Sperren weiter scrollen kann"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug only: test whether WebView can keep scrolling after the phone is locked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo depurar: pruebe si WebView puede seguir desplazándose después de que el teléfono esté bloqueado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débogage uniquement : testez si WebView peut continuer à défiler une fois le téléphone verrouillé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल डीबग करें: परीक्षण करें कि फ़ोन लॉक होने के बाद WebView स्क्रॉल करना जारी रख सकता है या नहीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo debug: verifica se WebView può continuare a scorrere dopo che il telefono è bloccato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグのみ: 電話がロックされた後も WebView がスクロールを継続できるかどうかをテストします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente depuração: teste se o WebView pode continuar rolando depois que o telefone for bloqueado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug only：测试锁屏后 WebView 是否还能滚动"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voor debug: testen of WebView kan blijven scrollen na het vergrendelen van de telefoon"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디버그 전용: 휴대전화가 잠긴 후에도 WebView가 계속 스크롤할 수 있는지 테스트"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاختبار فقط: اختبار ما إذا كان WebView يمكنه الاستمرار في التمرير بعد قفل الهاتف"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для отладки: проверка возможности прокрутки WebView после блокировки телефона"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko debugowanie: sprawdzenie, czy WebView może kontynuować przewijanie po zablokowaniu telefonu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast för felsökning: testa om WebView kan fortsätta rulla efter att telefonen låsts"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun til fejlfinding: test om WebView kan fortsætte med at rulle, efter telefonen er låst"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun for feilsøking: test om WebView kan fortsette å rulle etter at telefonen er låst"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain virheenkorjausta varten: testaa, voiko WebView jatkaa vieritystä puhelimen lukitsemisen jälkeen"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze pro ladění: testování, zda WebView dokáže pokračovat v posouvání po uzamčení telefonu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο για αποσφαλμάτωση: δοκιμή αν το WebView μπορεί να συνεχίσει την κύλιση μετά το κλείδωμα του τηλεφώνου"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak hibakeresés: tesztelje, hogy a WebView képes-e görgetni tovább, ha a telefon le van zárva"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug lang: subukin kung kaya ba ng WebView na mag-scroll pagkatapos ma-lock ang telepono"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לצורכי ניפוי באגים בלבד: בדיקה האם WebView יכול להמשיך לגלול לאחר שהטלפון ננעל"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk debug: uji apakah WebView dapat tetap menggulir setelah ponsel dikunci"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk nyahpepijat sahaja: uji sama ada WebView boleh terus ditatal selepas telefon dikunci"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pentru depanare: testează dacă WebView poate continua derularea după ce telefonul este blocat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece hata ayıklama: Telefon kilitlendiğinde WebView'nin kaydırmaya devam edip edemediğini test et"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ để gỡ lỗi: kiểm tra xem WebView có tiếp tục cuộn sau khi khóa điện thoại hay không"
          }
        }
      }
    },
