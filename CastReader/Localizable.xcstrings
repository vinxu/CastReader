    "识别语言不准确时，可在导入或拍摄前指定图片中的语言。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If language detection is inaccurate, select the language in the image before importing or taking a photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别语言不准确时，可在导入或拍摄前指定图片中的语言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語検出が正確でない場合は、インポートまたは撮影前に画像内の言語を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la detección del idioma no es precisa, selecciona el idioma del texto en la imagen antes de importar o tomar una foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la détection de la langue est inexacte, sélectionnez la langue présente dans l'image avant d'importer ou de prendre une photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls die Spracherkennung ungenau ist, wähle vor dem Importieren oder Fotografieren die Sprache im Bild aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a detecção do idioma estiver imprecisa, selecione o idioma da imagem antes de importar ou tirar uma foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il rilevamento della lingua non è accurato, seleziona la lingua presente nell'immagine prima di importare o scattare una foto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि भाषा पहचान सटीक नहीं है, तो फोटो लेने या आयात करने से पहले छवि में भाषा चुनें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als taalherkenning onnauwkeurig is, kies dan de taal van de tekst in de afbeelding voordat je deze importeert of een foto maakt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 감지가 정확하지 않은 경우, 이미지 내 언어를 선택한 후 이미지를 가져오거나 촬영하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان كشف اللغة غير دقيق، فحدد اللغة في الصورة قبل استيرادها أو التقاط صورة منها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если определение языка неточно, выберите язык на изображении перед импортом или съёмкой фото."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wykrywanie języka jest nieprecyzyjne, wybierz język na obrazie przed importem lub zrobieniem zdjęcia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om språkidentifieringen är felaktig, välj språket i bilden innan du importerar eller tar en bild."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis sproggenkendelsen er upræcis, skal du vælge sproget i billedet, før du importerer det eller tager et foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis språkgjenkjenning er upresis, velg språket i bildet før du importerer eller tar et bilde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos kielentunnistus on epätarkka, valitse kuvassa olevan tekstin kieli ennen kuvan tuomista tai valokuvan ottamista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud detekce jazyka není přesná, před importem nebo pořízením fotky vyberte jazyk na obrázku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν η ανίχνευση γλώσσας είναι ανακριβής, επιλέξτε τη γλώσσα στην εικόνα πριν εισάγετε ή τραβήξετε φωτογραφία."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a nyelvészlelés pontatlan, válassza ki a képen lévő nyelvet importálás vagy fényképezés előtt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung hindi tumpak ang pagtukoy sa wika, piliin ang wika ng teksto sa larawan bago ito i-import o kunan ng litrato."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם זיהוי השפה אינו מדויק, יש לבחור את שפת הטקסט בתמונה לפני הייבוא או הצילום."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pengesanan bahasa tidak tepat, pilih bahasa dalam imej sebelum mengimport atau mengambil gambar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil algılama doğru değilse, görüntüyü içe aktarmadan veya fotoğraf çekmeden önce dilini seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika deteksi bahasa tidak akurat, pilih bahasa pada gambar sebelum mengimpor atau mengambil foto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă detectarea limbii nu este precisă, selectează limba din imagine înainte de import sau fotografiere."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu nhận diện ngôn ngữ không chính xác, hãy chọn ngôn ngữ trong ảnh trước khi nhập hoặc chụp ảnh."
          }
        }
      }
    },
    "解读语言与所选语言不一致，请重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The explanation language does not match your selection. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解读语言与所选语言不一致，请重试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明言語が選択内容と一致していません。もう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de la explicación no coincide con tu selección. Por favor, inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue d'explication ne correspond pas à votre sélection. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erklärungssprache stimmt nicht mit deiner Auswahl überein. Bitte versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma da explicação não corresponde à sua seleção. Por favor, tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua della spiegazione non corrisponde alla tua selezione. Riprova."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्याख्या की भाषा चुनी गई भाषा से मेल नहीं खाती। कृपया फिर प्रयास करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taal van de uitleg komt niet overeen met je keuze. Probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설명 언어가 선택하신 것과 일치하지 않습니다. 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لغة الشرح لا تطابق اختيارك. يرجى المحاولة مجددًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык объяснения не совпадает с вашим выбором. Пожалуйста, попробуйте снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język wyjaśnienia nie pasuje do Twojego wyboru. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förklaringspråket matchar inte ditt val. Vänligen försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklaringssproget matcher ikke dit valg. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklaringspråket samsvarer ikke med ditt valg. Vennligst prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selityskieli ei vastaa valintaasi. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk vysvětlení neodpovídá vašemu výběru. Zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γλώσσα εξήγησης δεν ταιριάζει με την επιλογή σας. Παρακαλώ δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magyarázat nyelve nem egyezik a választásával. Kérjük, próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tugma ang wika ng paliwanag sa iyong pagpili. Subukan ulit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שפת ההסבר אינה תואמת לבחירה. יש לנסות שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa penjelasan tidak sepadan dengan pilihan anda. Sila cuba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklama dili seçiminizle eşleşmiyor. Lütfen tekrar deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa penjelasan tidak sesuai dengan pilihan Anda. Silakan coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limba explicației nu corespunde selecției tale. Încearcă din nou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
