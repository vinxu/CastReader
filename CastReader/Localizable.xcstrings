    "O’Reilly 登录已过期，请重新绑定 O’Reilly。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die O’Reilly-Anmeldung ist abgelaufen. Verbinden Sie O’Reilly erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your O’Reilly sign-in has expired. Reconnect O’Reilly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de O’Reilly ha caducado. Vuelve a conectar O’Reilly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion O’Reilly a expiré. Reconnectez O’Reilly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका O’Reilly साइन-इन समाप्त हो गया है। O’Reilly को फिर से कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a O’Reilly è scaduto. Ricollega O’Reilly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reilly のログイン期限が切れました。O’Reilly を再接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu login na O’Reilly expirou. Reconecte a O’Reilly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reilly 登录已过期，请重新绑定 O’Reilly。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw inloggegevens voor O'Reilly zijn verlopen. Verbind O'Reilly opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "O'Reilly 로그인이 만료되었습니다. O'Reilly 를 다시 연결하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى تسجيل الدخول الخاص بك إلى O’Reilly. أعد الاتصال بـ O’Reilly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия входа в O’Reilly истёк. Подключитесь заново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje logowanie do O’Reilly wygasło. Połącz się ponownie z O’Reilly."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din inloggning till O'Reilly har upphört. Anslut O'Reilly igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit O'Reilly-login er udløbet. Genforbind O'Reilly."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din O'Reilly-innlogging har utløpt. Koble til O'Reilly på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "O'Reilly-kirjautumisesi on vanhentunut. Yhdistä O'Reilly uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše přihlášení do O'Reilly vypršelo. Připojte O'Reilly znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεσή σας με το O'Reilly έχει λήξει. Επανασυνδεθείτε με το O'Reilly."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az O’Reilly-bejelentkezése lejárt. Csatlakoztassa újra az O’Reilly-t."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire ang iyong O'Reilly sign-in. I-reconnect ang O'Reilly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O’Reilly oturumunuzun süresi doldu. O’Reilly’yi tekrar bağlayın."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk O’Reilly anda telah tamat tempoh. Sambungkan O’Reilly semula."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi masuk O’Reilly Anda telah kedaluwarsa. Hubungkan kembali O’Reilly."
          }
        },
        "ro": {
          "stringUnit": {
