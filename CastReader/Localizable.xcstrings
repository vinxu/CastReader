        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 서비스의 일일 한도에 도달했습니다. 나중에 다시 시도해 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغت خدمة الصوت حدها اليومي. يُرجى إعادة المحاولة لاحقًا."
          }
