        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szövegfelismerés nem fejeződött be. Az oldal képe el lett mentve a telefonon. Koppintson a lejátszás gombra a próbálkozáshoz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tapos ang text recognition. Ang larawan ng pahina ay naka-save sa iyong phone. I-tap ang play para subukan ulit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זיהוי הטקסט לא הושלם. תמונת הדף שמורה בטלפון. הקש על ניגון כדי לנסות שוב."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan teks belum selesai. Gambar halaman disimpan di ponsel Anda. Ketuk putar untuk mencoba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengecaman teks belum selesai. Imej halaman disimpan pada telefon anda. Ketuk Main untuk mencuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recunoașterea textului nu s-a finalizat. Imaginea paginii este salvată pe telefon. Apasă Redă pentru a încerca din nou."
          }
        },
        "tr": {
