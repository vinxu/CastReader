          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio vocale ha raggiunto il limite giornaliero. Riprova più tardi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस सेवा की दैनिक सीमा पूरी हो गई है। कृपया बाद में फिर कोशिश करें।"
