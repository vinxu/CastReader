    "一本有声书的价格，够你听整个书库一个月——低至 %@/月": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preis eines Hörbuchs reicht für einen Monat deiner ganzen Bibliothek – ab %@/Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price of one audiobook covers your whole library for a month — from %@/month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio de un audiolibro te da un mes de toda tu biblioteca: desde %@/mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix d’un livre audio couvre un mois de toute votre bibliothèque — dès %@/mois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऑडियोबुक की कीमत में पूरी लाइब्रेरी एक महीने सुनें — %@/माह से"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo di un audiolibro copre un mese di tutta la tua libreria — da %@/mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオブック1冊の値段で、蔵書まるごと1か月聴ける——月あたり%@から"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço de um audiolivro cobre um mês de toda a sua biblioteca — a partir de %@/mês"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一本有声书的价格，够你听整个书库一个月——低至 %@/月"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prijs van één audioboek dekt uw hele bibliotheek voor een maand — vanaf %@/maand"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오북 한 권 가격으로 한 달 동안 전체 라이브러리를 이용할 수 있습니다 — %@/월부터"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعر كتاب صوتي واحد يغطي مكتبتك بأكملها لمدة شهر — من %@/شهر"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За цену одной аудиокниги можно месяц слушать всю вашу библиотеку — от %@/месяц"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za cenę jednego audiobooka możesz słuchać całej biblioteki przez miesiąc — od %@/miesiąc"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priset för en ljudbok täcker hela ditt bibliotek i en månad – från %@/månad"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
