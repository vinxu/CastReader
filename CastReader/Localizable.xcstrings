    "松手完成，上移取消": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Abschließen loslassen, zum Abbrechen nach oben wischen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to finish, slide up to cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta para terminar, desliza arriba para cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâchez pour terminer, glissez vers le haut pour annuler"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा करने के लिए छोड़ें, रद्द करने के लिए ऊपर खिसकाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia per terminare, scorri in alto per annullare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指を離して完了、上にスライドしてキャンセル"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte para concluir, deslize para cima para cancelar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松手完成，上移取消"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loslaten om te voltooien, veeg omhoog om te annuleren"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلِت للإنهاء، واسحب للأعلى للإلغاء"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпустите для завершения, проведите вверх для отмены"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puść, aby zakończyć; przesuwaj w górę, aby anulować"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp för att avsluta, dra upp för att avbryta"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip for at færdiggøre, svip op for at annullere"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp for å fullføre, dra opp for å avbryte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päästä irti lopettaaksesi, vedä ylös peruuttaaksesi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvolnit pro dokončení, posuňte nahoru pro zrušení"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε για ολοκλήρωση, σύρετε προς τα πάνω για ακύρωση"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedje el a befejezéshez, csúsztassa felfelé a megszakításhoz"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitawan upang tapusin, i-slide pataas upang kanselahin"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliberează pentru a finaliza, glisează în sus pentru a anula"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "놓으면 완료되고 위로 밀면 취소됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan untuk selesai, luncur ke atas untuk membatalkan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan untuk selesai, geser ke atas untuk membatalkan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitirmek için bırakın, iptal etmek için yukarı kaydırın"
