    "请滚动 Kindle 书架后再点同步。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle durch die Kindle-Bibliothek und tippe erneut auf Synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll the Kindle library, then tap Sync again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplácese por la biblioteca de Kindle y luego toque Sincronizar nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler la bibliothèque Kindle, puis appuyez à nouveau sur Synchroniser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किंडल लाइब्रेरी को स्क्रॉल करें, फिर सिंक पर दोबारा टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri la libreria Kindle, quindi tocca nuovamente Sincronizza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle ライブラリをスクロールし、もう一度 [同期] をタップします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role a biblioteca do Kindle e toque em Sincronizar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请滚动 Kindle 书架后再点同步。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrol door de Kindle-bibliotheek en tik opnieuw op Synchroniseren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر مكتبة Kindle، ثم اضغط على مزامنة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите библиотеку Kindle, затем снова нажмите «Синхронизировать»."
          }
        },
        "pl": {
          "stringUnit": {
