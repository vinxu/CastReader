          "stringUnit": {
            "state": "translated",
            "value": "Tjenesten er optaget. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjenesten for tale er opptatt. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänipalvelu on varattu. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasová služba je vytížena. Zkuste to prosím znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηρεσία φωνής είναι απασχολημένη. Παρακαλώ δοκιμάστε ξανά."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy ang serbisyo ng boses. Subukan ulit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul vocal este ocupat. Te rugăm să încerci din nou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ giọng nói đang bận. Vui lòng thử lại."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangszolgáltatás foglalt. Próbáld újra."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan suara sibuk. Sila cuba lagi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan suara sedang sibuk. Silakan coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses hizmeti meşgul. Lütfen yeniden deneyin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות הקול עמוס. יש לנסות שוב."
          }
        }
      }
