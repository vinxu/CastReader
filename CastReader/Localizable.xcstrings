    "请等待阅读页面加载完成后重试，或使用原阅读器的 Aa 设置。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待阅读页面加载完成后重试，或使用原阅读器的 Aa 设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the page to load and try again, or use the reader’s Aa settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die Seite geladen ist, und versuche es erneut, oder nutze die Aa-Einstellungen des Readers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que cargue la página e inténtalo de nuevo, o usa los ajustes Aa del lector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez le chargement de la page et réessayez, ou utilisez les réglages Aa du lecteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज लोड होने पर फिर कोशिश करें, या रीडर की Aa सेटिंग का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi il caricamento della pagina e riprova, oppure usa le impostazioni Aa del lettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの読み込み後に再試行するか、リーダーの Aa 設定を使用してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a página carregar e tente novamente ou use os ajustes Aa do leitor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de pagina is geladen en probeer het opnieuw, of gebruik de Aa-instellingen van de reader."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지가 로드될 때까지 기다렸다가 다시 시도하거나, 리더의 Aa 설정을 사용하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى يكتمل تحميل الصفحة وحاول مجددًا، أو استخدم إعدادات Aa في القارئ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь загрузки страницы и повторите попытку или откройте настройки Aa в окне чтения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj, aż strona się załaduje, i spróbuj ponownie, lub użyj ustawień Aa czytnika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänta tills sidan laddas och försök igen, eller använd läsarens Aa-inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent indtil siden er indlæst, og prøv igen, eller brug læserens Aa-indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent til siden lastes inn og prøv igjen, eller bruk leserens Aa-innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odota sivun latautumista ja yritä uudelleen, tai käytä lukijan Aa-asetuksia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počkejte na načtení stránky a zkuste to znovu, nebo použijte nastavení Aa čtečky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιμένετε να φορτώσει η σελίδα και δοκιμάστε ξανά, ή χρησιμοποιήστε τις ρυθμίσεις Aa του αναγνώστη."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várja meg, amíg az oldal betöltődik, és próbálja újra, vagy használja az olvasó Aa beállításait."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maghintay hanggang ma-load ang pahina at subukan ulit, o gamitin ang Aa settings ng reader."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתן לטעינת הדף ונסה שוב, או השתמש בהגדרות Aa של הקורא."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu halaman dimuat dan coba lagi, atau gunakan pengaturan Aa pembaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu halaman dimuatkan dan cuba lagi, atau gunakan tetapan Aa pembaca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așteaptă încărcarea paginii și încearcă din nou sau folosește setările Aa ale cititorului."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfanın yüklenmesini bekleyip yeniden deneyin veya okuyucunun Aa ayarlarını kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đợi trang tải xong rồi thử lại, hoặc dùng cài đặt Aa của trình đọc."
          }
        }
      }
    },
