        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul audio de referință nu este valid. Alege un alt fragment audio clar și încearcă din nou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans ses geçersizdir. Başka bir net ses parçası seçip tekrar deneyin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ שמע הייחוס אינו תקין. יש לבחור קטע שמע ברור אחר ולנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh tham chiếu không hợp lệ. Chọn một đoạn âm thanh rõ ràng khác rồi thử lại."
          }
        }
      }
    },
    "参考音频需要包含 3 到 30 秒的声音": {
