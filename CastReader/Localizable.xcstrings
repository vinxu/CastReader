    "在微信读书里加入一本书后回来，或者先用拍照、文件等方式听。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in WeRead ein Buch hinzu und komm zurück – oder starte zuerst mit einem Foto oder einer Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a book in WeRead and come back, or start with a photo or a file instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un libro en WeRead y vuelve, o empieza con una foto o un archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un livre dans WeRead puis revenez, ou commencez avec une photo ou un fichier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRead में कोई किताब जोड़कर वापस आएँ, या पहले फ़ोटो या फ़ाइल से सुनना शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un libro su WeRead e torna qui, oppure inizia con una foto o un file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRead で本を追加してから戻るか、写真やファイルから聴き始めてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um livro no WeRead e volte, ou comece com uma foto ou um arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在微信读书里加入一本书后回来，或者先用拍照、文件等方式听。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een boek toe in WeRead en kom terug, of begin met een foto of bestand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRead에 책을 추가하고 다시 오거나, 사진이나 파일로 시작하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف كتابًا في WeRead وعد، أو ابدأ بملف أو صورة بدلًا من ذلك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте книгу в WeRead и вернитесь, либо начните с фото или файла."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj książkę w aplikacji WeRead i wróć lub zacznij od zdjęcia lub pliku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en bok i WeRead och kom tillbaka, eller börja med en bild eller en fil istället."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en bog i WeRead og kom tilbage, eller start med et foto eller en fil i stedet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en bok i WeRead og kom tilbake, eller start med et bilde eller en fil i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kirja WeReadiin ja palaa takaisin, tai aloita valokuvalla tai tiedostolla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte knihu do WeRead a vraťte se, nebo začněte s fotkou nebo souborem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα βιβλίο στο WeRead και επιστρέψτε, ή ξεκινήστε με μια φωτογραφία ή αρχείο."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá egy könyvet a WeReadben, majd térjen vissza, vagy kezdjen egy fényképpel vagy fájllal."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng aklat sa WeRead at bumalik, o magsimula sa isang litrato o file."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף ספר ב-WeRead וחזור, או התחל עם תמונה או קובץ במקום."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan buku di WeRead dan kembali, atau mulai dengan foto atau file."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan buku dalam WeRead dan kembali, atau mulakan dengan foto atau fail."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă o carte în WeRead și revino, sau începe cu o fotografie sau un fișier."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRead'e bir kitap ekleyip tekrar gelin veya bunun yerine bir fotoğraf veya dosya ile başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một cuốn sách trong WeRead rồi quay lại, hoặc bắt đầu với ảnh hay tệp."
          }
        }
      }
    },
