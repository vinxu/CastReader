    "打开任意位置，然后点播放开始朗读。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine beliebige Stelle und tippe zum Vorlesen auf Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open any position, then tap Play to read aloud."
          }
        },
