    "参考音频无效，请换一段清晰音频后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Referenzaudio ist ungültig. Wähle einen anderen klaren Audioclip aus und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference audio is invalid. Choose another clear audio clip and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de referencia no es válido. Elige otro fragmento de audio claro e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio de référence n’est pas valide. Choisissez un autre extrait audio clair et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेफ़रेंस ऑडियो मान्य नहीं है। कोई दूसरा साफ़ ऑडियो क्लिप चुनकर फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio di riferimento non è valido. Scegli un altro clip audio chiaro e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照音声が無効です。別の明瞭な音声クリップを選んで、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio de referência é inválido. Escolha outro trecho de áudio nítido e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考音频无效，请换一段清晰音频后重试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De referentie-audio is ongeldig. Kies een andere duidelijke audioclip en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 오디오가 잘못되었습니다. 다른 명확한 오디오 클립을 선택하고 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت المرجعي غير صالح. اختر مقطعًا صوتيًا واضحًا آخر وحاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образец аудио недействителен. Выберите другой фрагмент с чёткой речью и повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio referencyjne jest nieprawidłowe. Wybierz inny wyraźny klip dźwiękowy i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Referensljudet är ogiltigt. Välj ett annat tydligt ljudklipp och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencelyden er ugyldig. Vælg et andet klart lydklip og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Referanseopptaket er ugyldig. Velg et annet tydelig lydklipp og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viiteääni on virheellinen. Valitse toinen selkeä äänileike ja yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenční nahrávka je neplatná. Vyberte jiný srozumitelný úsek řeči a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος αναφοράς δεν είναι έγκυρος. Επιλέξτε άλλο καθαρό ηχητικό απόσπασμα και δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A referenciahang érvénytelen. Válasszon másik tiszta hangrészletet, majd próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang audio na sanggunian ay hindi wasto. Pumili ng ibang malinaw na audio clip at subukan ulit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio referensi tidak valid. Pilih klip audio yang lebih jernih dan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio rujukan tidak sah. Pilih klip audio yang jelas lain dan cuba lagi."
