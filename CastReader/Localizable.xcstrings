    "我确认这是我本人的声音，并授权 CastReader 用它生成语音。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが私の声であることを確認し、CastReader がその声を使用して音声を生成することを許可します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmo que esta es mi voz y autorizo ​​a CastReader a usarla para generar voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je confirme qu'il s'agit bien de ma voix et j'autorise CastReader à l'utiliser pour générer de la parole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmo que esta é minha voz e autorizo ​​o CastReader a usá-la para gerar fala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermo che questa è la mia voce e autorizzo CastReader a utilizzarla per generare parlato."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं पुष्टि करता हूं कि यह मेरी आवाज है और मैं CastReader को भाषण उत्पन्न करने के लिए इसका उपयोग करने के लिए अधिकृत करता हूं।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I confirm this is my voice and authorize CastReader to use it to generate speech."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我确认这是我本人的声音，并授权 CastReader 用它生成语音。"
          }
        }
      }
    },
