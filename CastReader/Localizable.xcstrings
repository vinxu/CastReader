        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane tylko na tym urządzeniu, nigdy nie przesyłane"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast lagrad på denna enhet, aldrig uppladdad"
          }
        },
        "da": {
