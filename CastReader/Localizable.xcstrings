          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się załadować całej biblioteki. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att ladda hela biblioteket. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lykkedes ikke at indlæse hele biblioteket. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele biblioteket kunne ikke lastes inn. Vennligst prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko kirjastoa ei voitu ladata. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celou knihovnu se nepodařilo načíst. Zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πλήρης βιβλιοθήκη δεν μπόρεσε να φορτωθεί. Παρακαλώ δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes könyvtár nem tölthető be. Kérjük, próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-load ang buong aklatan. Subukan ulit."
