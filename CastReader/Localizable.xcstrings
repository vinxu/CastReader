    "只有你能看到这个备注，不会修改朗读者创建的声音名称。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du kannst diese Notiz sehen. Der Name der vom Leser erstellten Stimme wird nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can see this note. It does not change the name of the voice created by the reader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú puedes ver esta nota. No cambia el nombre de la voz creada por el lector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous seul pouvez voir cette note. Elle ne modifie pas le nom de la voix créée par le lecteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नोट केवल आपको दिखाई देगा। इससे रीडर द्वारा बनाई गई आवाज़ का नाम नहीं बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu puoi vedere questa nota. Non modifica il nome della voce creata dal lettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモはあなただけに表示され、朗読者が作成した声の名前は変更されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você pode ver esta nota. Ela não altera o nome da voz criada pelo leitor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能看到这个备注，不会修改朗读者创建的声音名称。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen u ziet deze notitie. De naam van de stem die de voorlezer heeft gemaakt, verandert niet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모는 나에게만 보입니다. 낭독자가 만든 음성의 이름은 바뀌지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يراها غيرك. لا تُغيّر اسم الصوت الذي أنشأه القارئ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту заметку видите только вы. Она не меняет название голоса, созданного рассказчиком."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko Ty widzisz tę notatkę. Nie zmienia ona nazwy głosu utworzonego przez lektora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast du kan se denna anteckning. Den ändrar inte namnet på rösten som uppläsaren skapade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun du kan se denne note. Den ændrer ikke navnet på den stemme, oplæseren har oprettet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare du kan se dette notatet. Det endrer ikke navnet på stemmen oppleseren har opprettet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sinä näet tämän huomautuksen. Se ei muuta lukijan luoman äänen nimeä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto poznámku vidíte jen vy. Nemění název hlasu vytvořeného předčítajícím."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο εσείς βλέπετε αυτό το σημείωμα. Δεν αλλάζει το όνομα της φωνής που δημιούργησε ο αφηγητής."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak Ön látja ezt a megjegyzést. Nem változtatja meg a felolvasó által létrehozott hang nevét."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikaw lamang ang makakakita ng talang ito. Hindi nito binabago ang pangalan ng boses na ginawa ng tagabasa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya Anda yang dapat melihat catatan ini. Ini tidak mengubah nama suara yang dibuat oleh pembaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya anda yang dapat melihat nota ini. Ia tidak mengubah nama suara yang dicipta oleh pembaca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar tu poți vedea această notă. Ea nu schimbă numele vocii create de cititor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu notu yalnızca siz görebilirsiniz. Okuyucu tarafından oluşturulan sesin adını değiştirmez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק לך יש גישה להערה הזו. היא אינה משנה את שם הקול שיצר המקריא."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bạn xem được ghi chú này. Ghi chú không thay đổi tên giọng do người đọc tạo."
          }
        }
      }
    },
