    "Google 登录已过期，请重新绑定 Google Play 图书。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Google-Sitzung ist abgelaufen. Verbinde Google Play Bücher erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Google session expired. Please connect Google Play Books again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de Google ha caducado. Vuelve a conectar Google Play Libros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Google a expiré. Reconnectez Google Play Livres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Google सत्र समाप्त हो गया। कृपया Google Play किताबें फिर से कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione Google è scaduta. Ricollega Google Play Libri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google のログインが期限切れです。Google Play ブックスを再連携してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão do Google expirou. Conecte o Google Play Livros novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 登录已过期，请重新绑定 Google Play 图书。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw Google-sessie is verlopen. Verbind Google Play Boeken opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 세션이 만료되었습니다. Google Play Books를 다시 연결하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلسة Google. يرجى إعادة توصيل Google Play Books."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша сессия Google истекла. Подключите Google Play Книги снова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja Google wygasła. Połącz ponownie z Google Play Books."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Google-session har löpt ut. Anslut Google Play Books igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Google-session er udløbet. Forbind Google Play Books igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-sesjonen din har utløpt. Vennligst koble til Google Play Books igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-istuntosi on vanhentunut. Yhdistä Google Play Books uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše relace Google vypršela. Připojte znovu Google Play Knihy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία Google έληξε. Συνδεθείτε ξανά με τα Google Play Books."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Google munkamenete lejárt. Kérjük, kapcsolja újra a Google Play Booksot."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire ang iyong Google session. I-connect muli ang Google Play Books."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף ההתחברות ל-Google פג. חבר שוב את Google Play Books."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Google Anda telah kedaluwarsa. Hubungkan kembali Google Play Books."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Google anda telah luput. Sila sambungkan semula Google Play Books."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea ta Google a expirat. Te rugăm să reconectezi Google Play Books."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google oturumunuzun süresi doldu. Lütfen Google Play Books’u tekrar bağlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên Google của bạn đã hết hạn. Vui lòng kết nối lại Google Play Sách."
          }
        }
      }
    },
