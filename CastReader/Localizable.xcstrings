    "请清除书架的搜索或进度筛选后重试。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne die Such- oder Fortschrittsfilter deiner Bibliothek und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the search or progress filter in your library, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los filtros de búsqueda o progreso de tu biblioteca y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez les filtres de recherche ou de progression de votre bibliothèque, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी में खोज या प्रगति फ़िल्टर हटाएँ, फिर दोबारा प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi i filtri di ricerca o avanzamento della libreria, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの検索または進捗フィルターを解除して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe os filtros de pesquisa ou progresso da biblioteca e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请清除书架的搜索或进度筛选后重试。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder de zoekopdracht of voortgangsfilter in je bibliotheek en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리에서 검색 또는 진행률 필터를 지운 후 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح فلتر البحث أو التقدم في مكتبتك، ثم حاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите фильтр поиска или прогресса в библиотеке, затем повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyść filtr wyszukiwania lub postępu w bibliotece, a następnie spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensa sök- eller framstegsfiltret i ditt bibliotek, och försök sedan igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd søge- eller fremskridtsfilteret i dit bibliotek, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern søke- eller fremdriftsfiltret i biblioteket, og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjennä hakuehto tai edistymän suodatin kirjastosta, sitten yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyčistěte filtr vyhledávání nebo postupu ve své knihovně a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθαρίστε το φίλτρο αναζήτησης ή προόδου στη βιβλιοθήκη σας, στη συνέχεια δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölje a keresési vagy előrehaladási szűrőt a könyvtárából, majd próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alisin ang search o filter ng progreso sa iyong aklatan, pagkatapos ay subukan ulit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקה את סינון החיפוש או התקדמות בספרייה, ואז נסה שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan carian atau penapis kemajuan dalam pustaka anda, kemudian cuba lagi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus pencarian atau filter progres di pustaka Anda, lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızdaki aramayı veya ilerleme filtresini temizleyip yeniden deneyin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge căutarea sau filtrul de progres din bibliotecă, apoi încearcă din nou."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa bộ lọc tìm kiếm hoặc tiến độ trong thư viện rồi thử lại."
          }
        }
      }
    },
    "书架尚未完整加载，请重试。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek ist noch nicht vollständig geladen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full library could not be loaded. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar toda la biblioteca. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque n’a pas pu être chargée entièrement. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी लाइब्रेरी लोड नहीं हो सकी। फिर कोशिश करें।"
