            "value": "Detta är den officiella WeRead-sidan. CastReader kan inte se eller lagra ditt WeChat-konto eller lösenord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er den officielle WeRead-side. CastReader kan ikke se eller gemme din WeChat-konto eller adgangskode."
