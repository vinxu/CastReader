    "Preparing Kindle explain..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Erklärung wird vorbereitet …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing Kindle explain..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preparando la explicación de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préparation de l’explication Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle व्याख्या तैयार की जा रही है…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Preparazione della spiegazione Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindle解説を準備中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Preparando a explicação do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备 Kindle 解读…" } } } },
    "Preparing Kindle read aloud..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Vorlesen wird vorbereitet …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing Kindle read aloud..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preparando la lectura de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préparation de la lecture Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle पढ़ना तैयार किया जा रहा है…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Preparazione della lettura Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindle読み上げを準備中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Preparando a leitura do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备 Kindle 朗读…" } } } },
