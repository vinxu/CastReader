            "value": "La suscripción se renueva automáticamente. Cancela en cualquier momento en la App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement se renouvelle automatiquement. Annulez à tout moment dans l’App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता स्वतः नवीनीकरण. ऐप स्टोर में किसी भी समय रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento si rinnova automaticamente. Annulla in qualsiasi momento nell'App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは自動更新されます。 App Storeでいつでもキャンセルできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura é renovada automaticamente. Cancele a qualquer momento na App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅自动续期，可随时在 App Store 取消。"
          }
        }
      }
    },
