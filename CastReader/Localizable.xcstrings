    "Recognizing Kindle text..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kindle-Text wird erkannt …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Recognizing Kindle text..." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Reconociendo el texto de Kindle…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reconnaissance du texte Kindle…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle टेक्स्ट पहचाना जा रहा है…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Riconoscimento del testo Kindle…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleのテキストを認識中…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Reconhecendo o texto do Kindle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在识别 Kindle 文字…" } } } },
    "Waiting for Kindle to load more pages." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Warten, bis Kindle weitere Seiten lädt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for Kindle to load more pages." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando a que Kindle cargue más páginas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "En attente du chargement d’autres pages par Kindle." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Kindle के और पेज लोड होने की प्रतीक्षा है।" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "In attesa che Kindle carichi altre pagine." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kindleがさらにページを読み込むのを待っています。" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aguardando o Kindle carregar mais páginas." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待 Kindle 加载更多页面。" } } } },
    "Waiting for more Kindle pages" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Warten auf weitere Kindle-Seiten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for more Kindle pages" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando más páginas de Kindle" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "En attente d’autres pages Kindle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "और Kindle पेज की प्रतीक्षा है" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "In attesa di altre pagine Kindle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "さらにKindleページを待っています" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aguardando mais páginas do Kindle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待更多 Kindle 页面" } } } },
    "免费朗读额度已用完。" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein kostenloses Vorlesekontingent ist aufgebraucht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your free Read Aloud allowance has been used up." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Has agotado tu cupo gratuito de lectura en voz alta." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Votre quota gratuit de lecture à voix haute est épuisé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपका मुफ़्त ज़ोर से पढ़ने का कोटा खत्म हो गया है।" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Hai esaurito la quota gratuita di lettura ad alta voce." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "無料の読み上げ枠を使い切りました。" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sua cota gratuita de leitura em voz alta acabou." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "免费朗读额度已用完。" } } } },
    "已读完这本书。" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Du hast dieses Buch zu Ende gelesen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "You’ve finished this book." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Has terminado este libro." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vous avez terminé ce livre." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपने यह किताब पूरी कर ली है।" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Hai finito questo libro." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この本を読み終えました。" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você terminou este livro." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已读完这本书。" } } } },
    "Cookie 提示已关闭，点击播放即可继续。" : {
      "localizations" : {
