    "Open a Kindle book page, keep it visible for a moment, then retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Kindle-Buchseite, lass sie einen Moment sichtbar und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a Kindle book page, keep it visible for a moment, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una página de un libro Kindle, déjala visible un momento y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une page de livre Kindle, laissez-la visible un instant, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle किताब का पेज खोलें, उसे कुछ देर दिखने दें, फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una pagina di un libro Kindle, lasciala visibile per un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle本のページを開いてしばらく表示したままにしてから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma página de um livro Kindle, mantenha-a visível por alguns instantes e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Kindle 书籍页面，保持显示片刻，然后重试。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een Kindle-boekpagina, houd deze even zichtbaar en probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح صفحة كتاب Kindle، وأبقها ظاهرة للحظة، ثم حاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте страницу книги Kindle, удерживайте её видимой несколько секунд, затем повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz stronę książki Kindle, utrzymaj ją widoczną przez chwilę, a następnie spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna en Kindle-boksida, håll den synlig en stund, och försök sedan igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn en Kindle-bogs side, hold den synlig et øjeblik, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne en Kindle-bokside, hold den synlig et øyeblikk, og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Kindle-kirjan sivu, pidä se hetken näkyvissä ja yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete stránku knihy Kindle, ponechte ji chvíli viditelnou a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε μια σελίδα βιβλίου Kindle, κρατήστε την ορατή για λίγο και δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisson meg egy Kindle-könyvoldalt, tartsa láthatóan egy pillanatig, majd próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang pahina ng aklat sa Kindle, panatilihing nakikita nang sandali, at subukang muli."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka halaman buku Kindle, kekalkan ia kelihatan sebentar, kemudian cuba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Kindle kitabı sayfası açın, kısa süreyle görünür bırakın ve ardından tekrar deneyin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle 책 페이지를 열어 잠시 화면에 표시한 다음 다시 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka halaman buku Kindle, biarkan terlihat sejenak, lalu coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide o pagină dintr-o carte Kindle, las-o vizibilă puțin timp, apoi încearcă din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח עמוד של ספר Kindle, להשאיר אותו מוצג לרגע ואז לנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một trang sách Kindle, giữ trang hiển thị trong giây lát rồi thử lại."
          }
        }
      }
    },
