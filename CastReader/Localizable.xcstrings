    "网络连接失败，请检查网络后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkverbindung fehlgeschlagen. Prüf deine Verbindung und versuch es erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network connection failed. Please check your connection and try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de conexión. Comprueba tu red e inténtalo de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion réseau. Vérifiez votre connexion et réessayez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क कनेक्शन विफल। कनेक्शन जाँचकर फिर कोशिश करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione di rete non riuscita. Controlla la rete e riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続できません。接続を確認してからお試しください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
