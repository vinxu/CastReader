    "请求超时，请检查网络后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage hat zu lange gedauert. Prüfe deine Verbindung und versuche es erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request timed out. Check your connection and try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud agotó el tiempo de espera. Comprueba tu conexión e inténtalo de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande a expiré. Vérifiez votre connexion et réessayez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध का समय समाप्त हो गया। अपना कनेक्शन जाँचें और फिर से कोशिश करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta è scaduta. Controlla la connessione e riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストがタイムアウトしました。接続を確認して、もう一度お試しください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação excedeu o tempo limite. Verifique sua conexão e tente novamente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求超时，请检查网络后重试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verzoek duurde te lang. Controleer uw verbinding en probeer het opnieuw"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة الطلب. تحقّق من اتصالك وحاول مجددًا"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания запроса истекло. Проверьте подключение и повторите попытку"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął limit czasu żądania. Sprawdź połączenie i spróbuj ponownie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begäran tog för lång tid. Kontrollera anslutningen och försök igen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmodningen tog for lang tid. Tjek forbindelsen, og prøv igen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forespørselen tok for lang tid. Sjekk tilkoblingen og prøv igjen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyynnön aikakatkaisu. Tarkista yhteys ja yritä uudelleen"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypršel časový limit požadavku. Zkontrolujte připojení a zkuste to znovu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αίτημα έληξε. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naubos ang oras ng paghihintay sa kahilingan. Suriin ang koneksyon at subukang muli"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תם הזמן הקצוב לבקשה. בדקו את החיבור ונסו שוב"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu permintaan habis. Periksa koneksi Anda dan coba lagi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan tamat masa. Semak sambungan anda dan cuba lagi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérés időtúllépés miatt megszakadt. Ellenőrizd a kapcsolatot, és próbáld újra"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 시간이 초과되었습니다. 연결을 확인한 후 다시 시도하세요"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek zaman aşımına uğradı. Bağlantınızı kontrol edip tekrar deneyin"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cererea a expirat. Verifică conexiunea și încearcă din nou"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu đã hết thời gian chờ. Kiểm tra kết nối rồi thử lại"
          }
        }
      }
    },
    "无法连接网络，请检查网络后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Prüfe dein Netzwerk und versuche es erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect. Check your network and try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar. Comprueba tu red e inténtalo de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Vérifiez votre réseau et réessayez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट नहीं हो सका। नेटवर्क जाँचें और फिर कोशिश करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione non riuscita. Controlla la rete e riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません。ネットワークを確認してもう一度お試しください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar. Verifique sua rede e tente novamente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接网络，请检查网络后重试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen verbinding maken. Controleer uw netwerk en probeer opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الاتصال. تحقق من شبكتك وحاول مرة أخرى"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться. Проверьте сеть и повторите попытку"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć. Sprawdź sieć i spróbuj ponownie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte ansluta. Kontrollera ditt nätverk och försök igen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke oprette forbindelse. Tjek dit netværk, og prøv igen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke koble til. Sjekk nettverket og prøv igjen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys epäonnistui. Tarkista verkkoyhteys ja yritä uudelleen"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se připojit. Zkontrolujte síť a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αδυναμία σύνδεσης. Ελέγξτε το δίκτυό σας και δοκιμάστε ξανά."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makakonekta. Suriin ang network at subukan ulit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחבר. בדוק את הרשת ונסה שוב"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat terhubung. Periksa jaringan Anda dan coba lagi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyambung. Semak rangkaian anda dan cuba lagi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült csatlakozni. Ellenőrizd a hálózatot, és próbáld újra"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하지 못했습니다. 네트워크를 확인하고 다시 시도하세요"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanılamadı. Ağınızı kontrol edip yeniden deneyin"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea a eșuat. Verifică rețeaua și încearcă din nou"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối. Kiểm tra mạng rồi thử lại"
          }
        }
      }
    },
    "登录失败，请稍后重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen. Bitte später erneut versuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Try again later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión. Inténtalo más tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion. Réessayez plus tard"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन विफल रहा। बाद में पुनः प्रयास करें"
          }
        },
        "it": {
          "stringUnit": {
