          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一种录音语言，录制一次即可生成可跨语言使用的声音。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
