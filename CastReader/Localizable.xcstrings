    "自动找到最清晰的约 10 秒，原文件不会上传": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet automatisch die klarsten etwa 10 Sekunden; die Originaldatei wird nicht hochgeladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically finds the clearest ~10 seconds; the original file is not uploaded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra automáticamente los 10 segundos más claros aproximadamente; el archivo original no se sube"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve automatiquement les quelque 10 secondes les plus claires ; le fichier d’origine n’est pas envoyé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आप सबसे साफ़ लगभग 10 सेकंड ढूंढता है; मूल फ़ाइल अपलोड नहीं होती"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova automaticamente i circa 10 secondi più chiari; il file originale non viene caricato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も明瞭な約10秒を自動で見つけます。元のファイルはアップロードされません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra automaticamente os cerca de 10 segundos mais nítidos; o arquivo original não é enviado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动找到最清晰的约 10 秒，原文件不会上传"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vindt automatisch de helderste ~10 seconden; het originele bestand wordt niet geüpload"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 명확한 약 10 초 구간을 자동으로 찾습니다. 원본 파일은 업로드되지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد أوضح مقطع مدته نحو 10 ثوانٍ تلقائيًا؛ ولا يُرفع الملف الأصلي"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически выбирается самый чёткий фрагмент длительностью около 10 секунд; исходный файл не отправляется на сервер"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie wybiera około 10 sekund najwyraźniejszej mowy. Oryginalny plik nie jest przesyłany."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittar automatiskt det tydligaste ~10 sekunder långa klippet; originalet laddas inte upp"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder automatisk de klareste ~10 sekunder; den originale fil uploades ikke"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finner automatisk de klareste ~10 sekundene; originalfilen lastes ikke opp"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löytää automaattisesti selkeimmät ~10 sekuntia; alkuperäistä tiedostoa ei ladata"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky vyhledá nejčistší úsek o ~10 sekundách; původní soubor se nenahraje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρίσκει αυτόματα το καθαρότερο τμήμα ~10 δευτερολέπτων· το αρχικό αρχείο δεν ανεβαίνει"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan kiválasztja a legtisztább, körülbelül 10 másodperces részt; az eredeti fájl nem kerül feltöltésre"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong hanapin ang malinaw na ~10 segundo; hindi i-uupload ang orihinal na file"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזהה אוטומטית את הקטע הברור ביותר של כ-10 שניות; הקובץ המקורי לא מועלה"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara automatik mencari segmen ~10 saat yang paling jelas; fail asal tidak dimuat naik"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește automat segmentul de ~10 secunde cel mai clar; fișierul original nu este încărcat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En net ~10 saniyeyi otomatik olarak bulur; orijinal dosya yüklenmez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatis menemukan sekitar 10 detik paling jernih; file asli tidak diunggah"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động tìm khoảng 10 giây rõ nhất; tệp gốc không được tải lên"
          }
        }
      }
    },
    "只保留一个人的声音": {
      "localizations": {
        "de": {
