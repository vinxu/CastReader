            "state": "translated",
            "value": "Logga in för att synkronisera ditt medlemskap och gratiskvot över enheter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at synkronisere dit abonnement og gratis kvote på tværs af enheder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
