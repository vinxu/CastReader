        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αναγνώριση της γλώσσας του κειμένου. Επιλέξτε γλώσσα ανάγνωσης."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
