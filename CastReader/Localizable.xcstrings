        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyt mere. Forstå mere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lytt mer. Forstå mer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntele enemmän. Ymmärrä enemmän."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslouchejte více. Chápejte více."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούστε περισσότερο. Κατανοήστε περισσότερο."
