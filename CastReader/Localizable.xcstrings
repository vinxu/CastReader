    "按住录制，松手发送，上移取消": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufnehmen halten, zum Senden loslassen, zum Abbrechen nach oben wischen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to record, release to send, slide up to cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén para grabar, suelta para enviar y desliza arriba para cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez pour enregistrer, relâchez pour envoyer, glissez vers le haut pour annuler"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करने के लिए दबाएँ, भेजने के लिए छोड़ें, रद्द करने के लिए ऊपर खिसकाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per registrare, rilascia per inviare, scorri in alto per annullare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しで録音、指を離して送信、上にスライドしてキャンセル"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure para gravar, solte para enviar e deslize para cima para cancelar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住录制，松手发送，上移取消"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ingedrukt om op te nemen, laat los om te verzenden, veeg omhoog om te annuleren"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطوّلًا للتسجيل، وأفلت للإرسال، واسحب للأعلى للإلغاء"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте для записи, отпустите для отправки, проведите вверх для отмены"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj, aby nagrać; puść, aby wysłać; przesuwaj w górę, aby anulować"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll för att spela in, släpp för att skicka, dra upp för att avbryta"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for at optage, slip for at sende, svip op for at annullere"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for å ta opp, slipp for å sende, dra opp for å avbryte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä painettuna nauhoittaaksesi, päästä irti lähettääksesi, vedä ylös peruuttaaksesi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte pro nahrávání, pusťte pro odeslání, posuňte nahoru pro zrušení"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε παρατεταμένα για ηχογράφηση, αφήστε για αποστολή, σύρετε προς τα πάνω για ακύρωση"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa nyomva a felvételhez, engedje el a küldéshez, csúsztassa felfelé a megszakításhoz"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindutin nang matagal para mag-record, bitawan para ipadala, i-slide pataas para kanselahin"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține apăsat pentru a înregistra, eliberează pentru a trimite, glisează în sus pentru a anula"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 눌러 녹음하고, 놓으면 전송되며, 위로 밀면 취소됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan tahan untuk merakam, lepaskan untuk menghantar, luncur ke atas untuk membatalkan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan tahan untuk merekam, lepaskan untuk mengirim, geser ke atas untuk membatalkan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek için basılı tutun, göndermek için bırakın, iptal etmek için yukarı kaydırın"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה ממושכת להקלטה, שחרור לשליחה, החלקה למעלה לביטול"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ để thu âm, thả để gửi, vuốt lên để hủy"
          }
        }
      }
    },
