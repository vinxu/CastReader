    "在首页拍摄、上传、输入网址或文本，处理过的内容会出现在这里": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende auf der Startseite Kamera, Datei hochladen, URL eingeben oder Text eingeben – verarbeitete Inhalte erscheinen hier"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Camera, Upload File, Enter URL, or Enter Text on Home — processed content shows up here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use la cámara, cargue un archivo, ingrese una URL o ingrese texto en Inicio: el contenido procesado se muestra aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser l'appareil photo, télécharger un fichier, saisir une URL ou saisir du texte sur l'accueil : le contenu traité s'affiche ici"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा का उपयोग करें, फ़ाइल अपलोड करें, यूआरएल दर्ज करें, या होम पर टेक्स्ट दर्ज करें - संसाधित सामग्री यहां दिखाई देती है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fotocamera, carica file, inserisci URL o inserisci testo nella home page: i contenuti elaborati vengono visualizzati qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームでカメラを使用、ファイルをアップロード、URL を入力、またはテキストを入力 - 処理されたコンテンツがここに表示されます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use câmera, fazer upload de arquivo, inserir URL ou inserir texto na página inicial – o conteúdo processado aparece aqui"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在首页拍摄、上传、输入网址或文本，处理过的内容会出现在这里"
          }
        }
      }
    },
