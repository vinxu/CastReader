<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Readable documents</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>org.idpf.epub-container</string>
				<string>org.openxmlformats.wordprocessingml.document</string>
				<string>public.text</string>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
			</array>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
				<string>AppIcon76x76</string>
			</array>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.same.castreader.deep-link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>castreader</string>
			</array>
		</dict>
	</array>
	<key>CastReaderInternalDistributionControlsEnabled</key>
	<string>$(CASTREADER_INTERNAL_DISTRIBUTION_CONTROLS)</string>
	<key>CastReaderPrivateKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CastReaderSafariKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.same.castreader.safari</string>
	<key>DropboxAppKey</key>
	<string>$(DROPBOX_APP_KEY)</string>
	<key>GoogleDriveClientID</key>
	<string>$(GOOGLE_DRIVE_CLIENT_ID)</string>
	<key>GoogleDriveRedirectScheme</key>
	<string>$(GOOGLE_DRIVE_REDIRECT_SCHEME)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>youtube</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>MicrosoftClientID</key>
	<string>$(MICROSOFT_CLIENT_ID)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>拍摄文字，用于朗读、逐词高亮和 AI 讲解。 部分语言需通过 CastReader 将图片发送至 Google 进行文字识别。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a short sample to create your personal voice.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>选择包含文字的照片，用于朗读、逐词高亮和 AI 讲解。 部分语言需通过 CastReader 将图片发送至 Google 进行文字识别。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
