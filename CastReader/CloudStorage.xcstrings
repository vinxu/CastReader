    "文件过大或解压后体积异常，已停止导入": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist zu groß oder wird auf eine unsichere Größe entpackt. Der Import wurde gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large or expands to an unsafe size. Import was stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es demasiado grande o se expande a un tamaño no seguro. Se detuvo la importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est trop volumineux ou se décompresse à une taille non sûre. L’importation a été arrêtée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल बहुत बड़ी है या निकालने पर असुरक्षित आकार तक फैलती है। आयात रोक दिया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è troppo grande o si espande fino a dimensioni non sicure. L’importazione è stata interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎるか、展開後のサイズが安全上限を超えるため、読み込みを停止しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é grande demais ou se expande para um tamanho não seguro. A importação foi interrompida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件过大或解压后体积异常，已停止导入"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is te groot of wordt na uitpakken onveilig groot. Het importeren is gestopt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 너무 크거나 압축을 풀면 안전한 크기를 초과하므로 가져오기를 중단했습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف كبير جدًا، أو يصبح حجمه غير آمن بعد فك الضغط. تم إيقاف الاستيراد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл слишком велик или после распаковки превысит безопасный размер. Импорт остановлен."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik jest zbyt duży lub po rozpakowaniu przekracza bezpieczny rozmiar. Import został zatrzymany."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen är för stor eller blir för stor vid uppackning. Importen stoppades."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er for stor eller bliver for stor ved udpakning. Importen blev stoppet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er for stor eller blir for stor ved utpakking. Importen ble stoppet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto on liian suuri tai kasvaa purettaessa liian suureksi. Tuonti keskeytettiin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor je příliš velký nebo po rozbalení překračuje bezpečnou velikost. Import byl zastaven."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο είναι πολύ μεγάλο ή το μέγεθός του μετά την αποσυμπίεση ξεπερνά το ασφαλές όριο. Η εισαγωγή διακόπηκε."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl túl nagy, vagy kibontva meghaladja a biztonságos mérethatárt. Az importálás leállt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong malaki ang file o magiging masyadong malaki ito matapos i-unpack. Itinigil ang pag-import."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail terlalu besar atau berkembang kepada saiz yang tidak selamat. Import dihentikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya çok büyük veya güvenli olmayan bir boyuta genişliyor. İçe aktarma durduruldu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File terlalu besar atau mengembang hingga ukuran yang tidak aman. Impor dihentikan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul este prea mare sau se extinde la o dimensiune nesigură. Importul a fost oprit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ גדול מדי או מתרחב לגודל לא בטוח. הייבוא נעצר."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp quá lớn hoặc có kích thước sau giải nén không an toàn. Đã dừng nhập."
          }
        }
      }
    },
