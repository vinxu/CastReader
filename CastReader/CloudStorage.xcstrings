{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "搜索云盘文件": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Cloud-Dateien durchsuchen"}},
      "en": {"stringUnit": {"state": "translated", "value": "Search cloud files"}},
      "es": {"stringUnit": {"state": "translated", "value": "Buscar archivos en la nube"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Rechercher des fichiers cloud"}},
      "hi": {"stringUnit": {"state": "translated", "value": "क्लाउड फ़ाइलें खोजें"}},
      "it": {"stringUnit": {"state": "translated", "value": "Cerca file nel cloud"}},
      "ja": {"stringUnit": {"state": "translated", "value": "クラウドファイルを検索"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Buscar arquivos na nuvem"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "搜索云盘文件"}}
    }},
    "未找到匹配的文件": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Keine passenden Dateien gefunden"}},
      "en": {"stringUnit": {"state": "translated", "value": "No matching files found"}},
      "es": {"stringUnit": {"state": "translated", "value": "No se encontraron archivos coincidentes"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Aucun fichier correspondant"}},
      "hi": {"stringUnit": {"state": "translated", "value": "कोई मिलती-जुलती फ़ाइल नहीं मिली"}},
      "it": {"stringUnit": {"state": "translated", "value": "Nessun file corrispondente trovato"}},
      "ja": {"stringUnit": {"state": "translated", "value": "一致するファイルが見つかりません"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Nenhum arquivo correspondente encontrado"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "未找到匹配的文件"}}
    }},
    "与我共享": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Für mich freigegeben"}},
      "en": {"stringUnit": {"state": "translated", "value": "Shared with me"}},
      "es": {"stringUnit": {"state": "translated", "value": "Compartido conmigo"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Partagés avec moi"}},
      "hi": {"stringUnit": {"state": "translated", "value": "मेरे साथ शेयर किया गया"}},
      "it": {"stringUnit": {"state": "translated", "value": "Condivisi con me"}},
      "ja": {"stringUnit": {"state": "translated", "value": "共有アイテム"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Compartilhados comigo"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "与我共享"}}
    }},
    "我的云端硬盘": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Meine Ablage"}},
      "en": {"stringUnit": {"state": "translated", "value": "My Drive"}},
      "es": {"stringUnit": {"state": "translated", "value": "Mi unidad"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Mon Drive"}},
      "hi": {"stringUnit": {"state": "translated", "value": "मेरी ड्राइव"}},
      "it": {"stringUnit": {"state": "translated", "value": "Il mio Drive"}},
      "ja": {"stringUnit": {"state": "translated", "value": "マイドライブ"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Meu Drive"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "我的云端硬盘"}}
    }},
    "%@ 账号操作": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Kontoaktionen für %@"}},
      "en": {"stringUnit": {"state": "translated", "value": "Account actions for %@"}},
      "es": {"stringUnit": {"state": "translated", "value": "Acciones de la cuenta de %@"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Actions du compte %@"}},
      "hi": {"stringUnit": {"state": "translated", "value": "%@ खाते की कार्रवाइयाँ"}},
      "it": {"stringUnit": {"state": "translated", "value": "Azioni dell’account %@"}},
      "ja": {"stringUnit": {"state": "translated", "value": "%@ のアカウント操作"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Ações da conta do %@"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@ 账号操作"}}
    }},
    "切换云盘，当前 %@": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Cloud-Speicher wechseln, aktuell %@"}},
      "en": {"stringUnit": {"state": "translated", "value": "Switch drive, currently %@"}},
      "es": {"stringUnit": {"state": "translated", "value": "Cambiar unidad, actual %@"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Changer de lecteur, actuellement %@"}},
      "hi": {"stringUnit": {"state": "translated", "value": "क्लाउड ड्राइव बदलें, अभी %@"}},
      "it": {"stringUnit": {"state": "translated", "value": "Cambia unità, attualmente %@"}},
      "ja": {"stringUnit": {"state": "translated", "value": "ドライブを切り替え、現在 %@"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Trocar unidade, atual %@"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "切换云盘，当前 %@"}}
    }},
    "设备可用空间不足，无法下载此文件": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Auf dem Gerät ist nicht genug freier Speicherplatz für diese Datei verfügbar."}},
      "en": {"stringUnit": {"state": "translated", "value": "This device does not have enough free space to download the file."}},
      "es": {"stringUnit": {"state": "translated", "value": "El dispositivo no tiene suficiente espacio libre para descargar el archivo."}},
      "fr": {"stringUnit": {"state": "translated", "value": "L’appareil ne dispose pas d’assez d’espace libre pour télécharger ce fichier."}},
      "hi": {"stringUnit": {"state": "translated", "value": "इस फ़ाइल को डाउनलोड करने के लिए डिवाइस में पर्याप्त खाली स्थान नहीं है।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Il dispositivo non dispone di spazio libero sufficiente per scaricare il file."}},
      "ja": {"stringUnit": {"state": "translated", "value": "このファイルをダウンロードするための空き容量が端末にありません。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "O dispositivo não tem espaço livre suficiente para baixar o arquivo."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "设备可用空间不足，无法下载此文件"}}
    }},
    "连接云盘": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Cloud-Speicher verbinden"}},
      "en": {"stringUnit": {"state": "translated", "value": "Connect cloud storage"}},
      "es": {"stringUnit": {"state": "translated", "value": "Conectar almacenamiento en la nube"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Connecter le stockage cloud"}},
      "hi": {"stringUnit": {"state": "translated", "value": "क्लाउड स्टोरेज कनेक्ट करें"}},
      "it": {"stringUnit": {"state": "translated", "value": "Collega l’archivio cloud"}},
      "ja": {"stringUnit": {"state": "translated", "value": "クラウドストレージに接続"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Conectar armazenamento em nuvem"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "连接云盘"}}
    }},
    "从文库移除此记录": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Diesen Eintrag aus der Bibliothek entfernen"}},
      "en": {"stringUnit": {"state": "translated", "value": "Remove this entry from Library"}},
      "es": {"stringUnit": {"state": "translated", "value": "Eliminar este registro de la biblioteca"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Retirer cette entrée de la bibliothèque"}},
      "hi": {"stringUnit": {"state": "translated", "value": "इस रिकॉर्ड को लाइब्रेरी से हटाएँ"}},
      "it": {"stringUnit": {"state": "translated", "value": "Rimuovi questa voce dalla libreria"}},
      "ja": {"stringUnit": {"state": "translated", "value": "この履歴をライブラリから削除"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Remover este registro da biblioteca"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "从文库移除此记录"}}
    }},
    "连接原账号后继续": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Verbinde das ursprüngliche Konto, um fortzufahren"}},
      "en": {"stringUnit": {"state": "translated", "value": "Connect the original account to continue"}},
      "es": {"stringUnit": {"state": "translated", "value": "Conecta la cuenta original para continuar"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Connectez le compte d’origine pour continuer"}},
      "hi": {"stringUnit": {"state": "translated", "value": "जारी रखने के लिए मूल खाता कनेक्ट करें"}},
      "it": {"stringUnit": {"state": "translated", "value": "Collega l’account originale per continuare"}},
      "ja": {"stringUnit": {"state": "translated", "value": "元のアカウントに接続して続ける"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Conecte a conta original para continuar"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "连接原账号后继续"}}
    }},
    "需连接原账号": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Ursprüngliches Konto erforderlich"}},
      "en": {"stringUnit": {"state": "translated", "value": "Original account required"}},
      "es": {"stringUnit": {"state": "translated", "value": "Se requiere la cuenta original"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Compte d’origine requis"}},
      "hi": {"stringUnit": {"state": "translated", "value": "मूल खाता आवश्यक है"}},
      "it": {"stringUnit": {"state": "translated", "value": "È richiesto l’account originale"}},
      "ja": {"stringUnit": {"state": "translated", "value": "元のアカウントが必要です"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "A conta original é necessária"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "需连接原账号"}}
    }},
    "云端文件已更新，已加载最新版本": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Die Cloud-Datei wurde aktualisiert. Die neueste Version wurde geladen."}},
      "en": {"stringUnit": {"state": "translated", "value": "The cloud file was updated. The latest version has been loaded."}},
      "es": {"stringUnit": {"state": "translated", "value": "El archivo en la nube se actualizó. Se cargó la versión más reciente."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Le fichier cloud a été mis à jour. La dernière version a été chargée."}},
      "hi": {"stringUnit": {"state": "translated", "value": "क्लाउड फ़ाइल अपडेट हुई। नवीनतम संस्करण लोड किया गया है।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Il file cloud è stato aggiornato. È stata caricata la versione più recente."}},
      "ja": {"stringUnit": {"state": "translated", "value": "クラウド上のファイルが更新されました。最新バージョンを読み込みました。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "O arquivo na nuvem foi atualizado. A versão mais recente foi carregada."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "云端文件已更新，已加载最新版本"}}
    }},
    "切换云盘": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Laufwerk wechseln"}},
      "en": {"stringUnit": {"state": "translated", "value": "Switch drive"}},
      "es": {"stringUnit": {"state": "translated", "value": "Cambiar unidad"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Changer de lecteur"}},
      "hi": {"stringUnit": {"state": "translated", "value": "ड्राइव बदलें"}},
      "it": {"stringUnit": {"state": "translated", "value": "Cambia unità"}},
      "ja": {"stringUnit": {"state": "translated", "value": "ドライブを切り替える"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Trocar unidade"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "切换云盘"}}
    }},
    "朗读或解读可能发送全文": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Vorlesen oder Erklären kann den Volltext senden"}},
      "en": {"stringUnit": {"state": "translated", "value": "Read Aloud or Explain may send the full text"}},
      "es": {"stringUnit": {"state": "translated", "value": "Leer o Explicar puede enviar el texto completo"}},
      "fr": {"stringUnit": {"state": "translated", "value": "La lecture ou l’explication peut envoyer le texte intégral"}},
      "hi": {"stringUnit": {"state": "translated", "value": "ज़ोर से पढ़ें या व्याख्या पूरा पाठ भेज सकती है"}},
      "it": {"stringUnit": {"state": "translated", "value": "Lettura o Spiegazione può inviare il testo completo"}},
      "ja": {"stringUnit": {"state": "translated", "value": "読み上げ・解説では全文が送信される場合があります"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Leitura ou Explicação pode enviar o texto completo"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "朗读或解读可能发送全文"}}
    }},
    "仅当你主动开始朗读或解读时，CastReader 才会发送在本机解析出的处理所需文本（可能覆盖所选文件全文）；原始文件不会发送到文件上传或存储接口。": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Nur wenn du Vorlesen oder Erklären aktiv startest, sendet CastReader den dafür benötigten, auf diesem Gerät extrahierten Text (möglicherweise den gesamten Text der ausgewählten Datei). Die Originaldatei wird nicht an Datei-Upload- oder Speicherendpunkte gesendet."}},
      "en": {"stringUnit": {"state": "translated", "value": "Only when you actively start Read Aloud or Explain does CastReader send the required text parsed on this device (which may include the full text of the selected file). The original file is not sent to file-upload or storage endpoints."}},
      "es": {"stringUnit": {"state": "translated", "value": "Solo cuando inicias activamente Leer o Explicar, CastReader envía el texto necesario analizado en este dispositivo (que puede incluir todo el texto del archivo seleccionado). El archivo original no se envía a interfaces de carga ni almacenamiento de archivos."}},
      "fr": {"stringUnit": {"state": "translated", "value": "CastReader envoie le texte nécessaire extrait sur cet appareil (pouvant inclure tout le texte du fichier choisi) uniquement lorsque vous lancez activement la lecture ou l’explication. Le fichier d’origine n’est pas envoyé à des interfaces de téléversement ou de stockage de fichiers."}},
      "hi": {"stringUnit": {"state": "translated", "value": "CastReader केवल तब इस डिवाइस पर पार्स किया गया आवश्यक पाठ भेजता है, जब आप स्वयं ज़ोर से पढ़ना या व्याख्या शुरू करते हैं (इसमें चुनी गई फ़ाइल का पूरा पाठ शामिल हो सकता है)। मूल फ़ाइल किसी फ़ाइल अपलोड या स्टोरेज इंटरफ़ेस पर नहीं भेजी जाती।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Solo quando avvii attivamente Lettura o Spiegazione, CastReader invia il testo necessario estratto su questo dispositivo (che può includere tutto il testo del file selezionato). Il file originale non viene inviato a interfacce di caricamento o archiviazione dei file."}},
      "ja": {"stringUnit": {"state": "translated", "value": "ユーザーが読み上げまたは解説を開始した場合にのみ、CastReaderはこの端末で解析した処理に必要なテキスト（選択したファイルの全文を含む場合があります）を送信します。元のファイルがファイルアップロードまたはストレージ用インターフェースに送信されることはありません。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Somente quando você inicia ativamente Leitura ou Explicação, o CastReader envia o texto necessário processado neste dispositivo (que pode incluir todo o texto do arquivo selecionado). O arquivo original não é enviado a interfaces de upload ou armazenamento de arquivos."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅当你主动开始朗读或解读时，CastReader 才会发送在本机解析出的处理所需文本（可能覆盖所选文件全文）；原始文件不会发送到文件上传或存储接口。"}}
    }},
    "本机会保存脱敏账号提示、派生账号 key、云盘与文件 ID、文件名、格式和版本；保留到你删除记录或 App 数据。原文件不永久保存。": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Auf diesem Gerät werden ein maskierter Kontohinweis, ein abgeleiteter Kontoschlüssel, Cloud- und Datei-ID, Dateiname, Format und Version gespeichert, bis du den Eintrag oder die App-Daten löschst. Die Originaldatei wird nicht dauerhaft gespeichert."}},
      "en": {"stringUnit": {"state": "translated", "value": "This device stores a masked account hint, a derived account key, cloud and file IDs, filename, format, and version until you delete the record or app data. The original file is not stored permanently."}},
      "es": {"stringUnit": {"state": "translated", "value": "Este dispositivo guarda una referencia de cuenta enmascarada, una clave derivada, los ID de nube y archivo, el nombre, el formato y la versión hasta que elimines el registro o los datos de la app. El archivo original no se guarda de forma permanente."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Cet appareil conserve un indice de compte masqué, une clé dérivée, les identifiants du cloud et du fichier, le nom, le format et la version jusqu’à la suppression de l’entrée ou des données de l’app. Le fichier original n’est pas conservé durablement."}},
      "hi": {"stringUnit": {"state": "translated", "value": "यह डिवाइस मास्क किया गया खाता संकेत, निकाली गई खाता कुंजी, क्लाउड और फ़ाइल ID, फ़ाइल नाम, फ़ॉर्मेट और संस्करण तब तक रखता है जब तक आप रिकॉर्ड या ऐप डेटा नहीं मिटाते। मूल फ़ाइल स्थायी रूप से नहीं रखी जाती।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Questo dispositivo conserva un riferimento account mascherato, una chiave derivata, gli ID cloud e file, il nome, il formato e la versione finché non elimini il record o i dati dell’app. Il file originale non viene conservato in modo permanente."}},
      "ja": {"stringUnit": {"state": "translated", "value": "この端末には、マスク済みアカウント表示、派生アカウントキー、クラウド／ファイルID、ファイル名、形式、バージョンが、履歴またはAppデータを削除するまで保存されます。元ファイルは恒久保存されません。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Este dispositivo guarda uma indicação de conta mascarada, uma chave derivada, IDs da nuvem e do arquivo, nome, formato e versão até você excluir o registro ou os dados do app. O arquivo original não é armazenado permanentemente."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "本机会保存脱敏账号提示、派生账号 key、云盘与文件 ID、文件名、格式和版本；保留到你删除记录或 App 数据。原文件不永久保存。"}}
    }},
    "删除与控制": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Löschen und Kontrolle"}},
      "en": {"stringUnit": {"state": "translated", "value": "Deletion and control"}},
      "es": {"stringUnit": {"state": "translated", "value": "Eliminación y control"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Suppression et contrôle"}},
      "hi": {"stringUnit": {"state": "translated", "value": "हटाना और नियंत्रण"}},
      "it": {"stringUnit": {"state": "translated", "value": "Eliminazione e controllo"}},
      "ja": {"stringUnit": {"state": "translated", "value": "削除と管理"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Exclusão e controle"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "删除与控制"}}
    }},
    "解除关联会立即删除可访问文件的本机关联；若 Google 撤销暂未确认，只在隔离的撤销队列保留旧令牌用于重试，CastReader 不会使用它获取文件，确认后删除。删除文库记录会删除远程引用。": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Beim Trennen wird die lokale Verknüpfung zu zugänglichen Dateien sofort gelöscht. Ist der Widerruf bei Google noch nicht bestätigt, bleibt das alte Token nur in einer isolierten Widerrufswarteschlange für einen erneuten Versuch erhalten. CastReader verwendet es nicht zum Abrufen von Dateien und löscht es nach der Bestätigung. Das Löschen eines Bibliothekseintrags entfernt die Remote-Referenz."}},
      "en": {"stringUnit": {"state": "translated", "value": "Disconnecting immediately removes the local link to accessible files. If Google revocation is not yet confirmed, the old token is retained only in an isolated revocation queue for retry. CastReader will not use it to retrieve files and deletes it after confirmation. Deleting a Library record removes its remote reference."}},
      "es": {"stringUnit": {"state": "translated", "value": "Al desconectar se elimina de inmediato el vínculo local con los archivos accesibles. Si Google aún no confirma la revocación, el token anterior solo se conserva en una cola de revocación aislada para volver a intentarlo. CastReader no lo usará para obtener archivos y lo eliminará tras la confirmación. Al borrar un registro de la biblioteca se elimina su referencia remota."}},
      "fr": {"stringUnit": {"state": "translated", "value": "La déconnexion supprime immédiatement le lien local vers les fichiers accessibles. Si Google n’a pas encore confirmé la révocation, l’ancien jeton est conservé uniquement dans une file de révocation isolée afin de réessayer. CastReader ne l’utilisera pas pour récupérer des fichiers et le supprimera après confirmation. La suppression d’une entrée de la bibliothèque retire sa référence distante."}},
      "hi": {"stringUnit": {"state": "translated", "value": "डिस्कनेक्ट करने पर सुलभ फ़ाइलों का स्थानीय संबंध तुरंत हट जाता है। यदि Google निरस्तीकरण की पुष्टि लंबित है, तो पुराने टोकन को केवल दोबारा प्रयास करने के लिए एक अलग निरस्तीकरण कतार में रखा जाता है। CastReader इसका उपयोग फ़ाइलें प्राप्त करने के लिए नहीं करेगा और पुष्टि के बाद इसे मिटा देगा। लाइब्रेरी रिकॉर्ड मिटाने पर उसका रिमोट संदर्भ हट जाता है।"}},
      "it": {"stringUnit": {"state": "translated", "value": "La disconnessione elimina subito il collegamento locale ai file accessibili. Se Google non ha ancora confermato la revoca, il vecchio token viene conservato solo in una coda di revoca isolata per riprovare. CastReader non lo userà per recuperare file e lo eliminerà dopo la conferma. Eliminando un elemento della libreria si rimuove il relativo riferimento remoto."}},
      "ja": {"stringUnit": {"state": "translated", "value": "連携を解除すると、アクセス可能なファイルとの端末内の関連付けは直ちに削除されます。Googleでの取り消しが未確認の場合、再試行のために古いトークンを隔離された取り消しキュー内にのみ保持します。CastReaderがそのトークンをファイル取得に使用することはなく、確認後に削除します。ライブラリ履歴を削除するとリモート参照も削除されます。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Ao desconectar, o vínculo local com os arquivos acessíveis é removido imediatamente. Se a revogação do Google ainda não estiver confirmada, o token antigo será mantido somente em uma fila de revogação isolada para nova tentativa. O CastReader não o usará para obter arquivos e o excluirá após a confirmação. Excluir um registro da Biblioteca remove sua referência remota."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "解除关联会立即删除可访问文件的本机关联；若 Google 撤销暂未确认，只在隔离的撤销队列保留旧令牌用于重试，CastReader 不会使用它获取文件，确认后删除。删除文库记录会删除远程引用。"}}
    }},
    "重新连接": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Erneut verbinden"}},
      "en": {"stringUnit": {"state": "translated", "value": "Reconnect"}},
      "es": {"stringUnit": {"state": "translated", "value": "Volver a conectar"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Reconnecter"}},
      "hi": {"stringUnit": {"state": "translated", "value": "फिर से कनेक्ट करें"}},
      "it": {"stringUnit": {"state": "translated", "value": "Ricollega"}},
      "ja": {"stringUnit": {"state": "translated", "value": "再接続"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Reconectar"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新连接"}}
    }},
    "组织策略禁止 CastReader 访问此云盘，请联系组织管理员": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Eine Organisationsrichtlinie verhindert den Zugriff von CastReader auf diesen Cloud-Speicher. Wende dich an die Administration deiner Organisation."}},
      "en": {"stringUnit": {"state": "translated", "value": "Your organization’s policy prevents CastReader from accessing this cloud storage. Contact your organization administrator."}},
      "es": {"stringUnit": {"state": "translated", "value": "La política de tu organización impide que CastReader acceda a este almacenamiento en la nube. Contacta con el administrador de tu organización."}},
      "fr": {"stringUnit": {"state": "translated", "value": "La politique de votre organisation empêche CastReader d’accéder à ce stockage cloud. Contactez l’administrateur de votre organisation."}},
      "hi": {"stringUnit": {"state": "translated", "value": "आपके संगठन की नीति CastReader को इस क्लाउड स्टोरेज तक पहुँचने से रोकती है। अपने संगठन के व्यवस्थापक से संपर्क करें।"}},
      "it": {"stringUnit": {"state": "translated", "value": "I criteri della tua organizzazione impediscono a CastReader di accedere a questo archivio cloud. Contatta l’amministratore dell’organizzazione."}},
      "ja": {"stringUnit": {"state": "translated", "value": "組織のポリシーにより、CastReaderはこのクラウドストレージにアクセスできません。組織の管理者にお問い合わせください。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "A política da sua organização impede o CastReader de acessar este armazenamento em nuvem. Entre em contato com o administrador da organização."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "组织策略禁止 CastReader 访问此云盘，请联系组织管理员"}}
    }},
    "此 Google 文档超过 Google Drive 的导出大小限制，无法导入": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Dieses Google-Dokument überschreitet das Exportgrößenlimit von Google Drive und kann nicht importiert werden."}},
      "en": {"stringUnit": {"state": "translated", "value": "This Google document exceeds Google Drive’s export size limit and cannot be imported."}},
      "es": {"stringUnit": {"state": "translated", "value": "Este documento de Google supera el límite de tamaño de exportación de Google Drive y no se puede importar."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Ce document Google dépasse la limite de taille d’exportation de Google Drive et ne peut pas être importé."}},
      "hi": {"stringUnit": {"state": "translated", "value": "यह Google दस्तावेज़ Google Drive की निर्यात आकार सीमा से बड़ा है और आयात नहीं किया जा सकता।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Questo documento Google supera il limite di dimensione per l’esportazione di Google Drive e non può essere importato."}},
      "ja": {"stringUnit": {"state": "translated", "value": "このGoogleドキュメントはGoogle Driveのエクスポート上限を超えているため、読み込めません。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Este documento do Google excede o limite de tamanho de exportação do Google Drive e não pode ser importado."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Google 文档超过 Google Drive 的导出大小限制，无法导入"}}
    }},
    "云盘拒绝了此操作，请联系云盘管理员或稍后查看服务状态": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Speicher hat diesen Vorgang abgelehnt. Wende dich an die Administration oder prüfe später den Dienststatus."}},
      "en": {"stringUnit": {"state": "translated", "value": "The cloud service rejected this operation. Contact your cloud administrator or check the service status later."}},
      "es": {"stringUnit": {"state": "translated", "value": "El servicio en la nube rechazó esta operación. Contacta con el administrador o consulta el estado del servicio más tarde."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Le service cloud a refusé cette opération. Contactez l’administrateur ou consultez l’état du service ultérieurement."}},
      "hi": {"stringUnit": {"state": "translated", "value": "क्लाउड सेवा ने यह कार्रवाई अस्वीकार कर दी। अपने क्लाउड व्यवस्थापक से संपर्क करें या बाद में सेवा की स्थिति देखें।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Il servizio cloud ha rifiutato l’operazione. Contatta l’amministratore o verifica più tardi lo stato del servizio."}},
      "ja": {"stringUnit": {"state": "translated", "value": "クラウドサービスがこの操作を拒否しました。クラウド管理者に問い合わせるか、後でサービス状況を確認してください。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "O serviço de nuvem recusou esta operação. Entre em contato com o administrador ou verifique o status do serviço mais tarde."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "云盘拒绝了此操作，请联系云盘管理员或稍后查看服务状态"}}
    }},
    "云盘返回了无法识别的数据，暂时无法完成此操作": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Speicher hat nicht erkennbare Daten zurückgegeben. Dieser Vorgang kann derzeit nicht abgeschlossen werden."}},
      "en": {"stringUnit": {"state": "translated", "value": "The cloud service returned unrecognized data, so this operation cannot be completed right now."}},
      "es": {"stringUnit": {"state": "translated", "value": "El servicio en la nube devolvió datos no reconocidos y la operación no se puede completar ahora."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Le service cloud a renvoyé des données non reconnues ; cette opération ne peut pas être effectuée pour le moment."}},
      "hi": {"stringUnit": {"state": "translated", "value": "क्लाउड सेवा ने अपरिचित डेटा लौटाया, इसलिए यह कार्रवाई अभी पूरी नहीं की जा सकती।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Il servizio cloud ha restituito dati non riconosciuti, quindi al momento non è possibile completare l’operazione."}},
      "ja": {"stringUnit": {"state": "translated", "value": "クラウドサービスから認識できないデータが返されたため、現在この操作を完了できません。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "O serviço de nuvem retornou dados não reconhecidos, portanto a operação não pode ser concluída agora."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "云盘返回了无法识别的数据，暂时无法完成此操作"}}
    }},
    "设备可用空间不足，请在系统设置中管理存储空间后再试": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Auf dem Gerät ist nicht genug Speicherplatz verfügbar. Gib in den Systemeinstellungen Speicher frei und versuche es erneut."}},
      "en": {"stringUnit": {"state": "translated", "value": "This device does not have enough free space. Manage storage in System Settings, then try again."}},
      "es": {"stringUnit": {"state": "translated", "value": "El dispositivo no tiene suficiente espacio libre. Gestiona el almacenamiento en Ajustes y vuelve a intentarlo."}},
      "fr": {"stringUnit": {"state": "translated", "value": "L’appareil ne dispose pas d’assez d’espace libre. Gérez le stockage dans Réglages, puis réessayez."}},
      "hi": {"stringUnit": {"state": "translated", "value": "डिवाइस में पर्याप्त खाली स्थान नहीं है। सिस्टम सेटिंग्स में स्टोरेज प्रबंधित करें, फिर दोबारा कोशिश करें।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Il dispositivo non dispone di spazio libero sufficiente. Gestisci lo spazio nelle Impostazioni di sistema, quindi riprova."}},
      "ja": {"stringUnit": {"state": "translated", "value": "端末の空き容量が不足しています。システム設定でストレージを管理してから、もう一度お試しください。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "O dispositivo não tem espaço livre suficiente. Gerencie o armazenamento nos Ajustes do sistema e tente novamente."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "设备可用空间不足，请在系统设置中管理存储空间后再试"}}
    }},
    "云盘暂时无法完成此操作，请稍后再试": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Speicher kann diesen Vorgang derzeit nicht abschließen. Versuche es später erneut."}},
      "en": {"stringUnit": {"state": "translated", "value": "The cloud service cannot complete this operation right now. Try again later."}},
      "es": {"stringUnit": {"state": "translated", "value": "El servicio en la nube no puede completar esta operación ahora. Inténtalo más tarde."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Le service cloud ne peut pas effectuer cette opération pour le moment. Réessayez plus tard."}},
      "hi": {"stringUnit": {"state": "translated", "value": "क्लाउड सेवा यह कार्रवाई अभी पूरी नहीं कर सकती। बाद में फिर कोशिश करें।"}},
      "it": {"stringUnit": {"state": "translated", "value": "Al momento il servizio cloud non può completare l’operazione. Riprova più tardi."}},
      "ja": {"stringUnit": {"state": "translated", "value": "クラウドサービスは現在この操作を完了できません。しばらくしてからもう一度お試しください。"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "O serviço de nuvem não pode concluir esta operação agora. Tente novamente mais tarde."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "云盘暂时无法完成此操作，请稍后再试"}}
    }},
    "查看完整隐私政策": {"localizations": {
      "de": {"stringUnit": {"state": "translated", "value": "Vollständige Datenschutzrichtlinie ansehen"}},
      "en": {"stringUnit": {"state": "translated", "value": "View the full Privacy Policy"}},
      "es": {"stringUnit": {"state": "translated", "value": "Ver la Política de privacidad completa"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Voir la Politique de confidentialité complète"}},
      "hi": {"stringUnit": {"state": "translated", "value": "पूरी गोपनीयता नीति देखें"}},
      "it": {"stringUnit": {"state": "translated", "value": "Visualizza l’Informativa sulla privacy completa"}},
      "ja": {"stringUnit": {"state": "translated", "value": "プライバシーポリシー全文を見る"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Ver a Política de Privacidade completa"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看完整隐私政策"}}
    }},
    "文件过大或解压后体积异常，已停止导入": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist zu groß oder wird auf eine unsichere Größe entpackt. Der Import wurde gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large or expands to an unsafe size. Import was stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es demasiado grande o se expande a un tamaño no seguro. Se detuvo la importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est trop volumineux ou se décompresse à une taille non sûre. L’importation a été arrêtée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल बहुत बड़ी है या निकालने पर असुरक्षित आकार तक फैलती है। आयात रोक दिया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è troppo grande o si espande fino a dimensioni non sicure. L’importazione è stata interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎるか、展開後のサイズが安全上限を超えるため、読み込みを停止しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é grande demais ou se expande para um tamanho não seguro. A importação foi interrompida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件过大或解压后体积异常，已停止导入"
          }
        }
      }
    },
