    "账号关联及云盘授权已解除": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoverknüpfung und Cloud-Autorisierung wurden aufgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account link and cloud authorization have been removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado la vinculación de la cuenta y la autorización del almacenamiento en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’association du compte et l’autorisation cloud ont été supprimées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता लिंक और क्लाउड प्राधिकरण हटा दिए गए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento dell’account e l’autorizzazione al cloud sono stati rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント連携とクラウドの認証を解除しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vínculo da conta e a autorização da nuvem foram removidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号关联及云盘授权已解除"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De accountkoppeling en cloudautorisatie zijn verwijderd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 연결과 클라우드 접근 권한이 해제되었습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل ارتباط الحساب وأُلغي تفويض الوصول إلى التخزين السحابي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка учётной записи и облачная авторизация удалены."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto połączenie z kontem i uprawnienia dostępu do chmury."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontolänken och molnauktoriseringen har tagits bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontolink og cloud-godkendelse er blevet fjernet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontokoblingen og skyautoriseringen er fjernet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiliyhteys ja pilvipalvelun käyttöoikeus on poistettu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propojení s účtem a oprávnění ke cloudovému úložišti byla odstraněna."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση λογαριασμού και η εξουσιοδότηση cloud έχουν αφαιρεθεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókkapcsolat és a felhőengedélyezés eltávolításra került."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naalis ang link ng account at awtorisasyon ng cloud."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan akaun dan kebenaran awan telah dipadam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bağlantısı ve bulut yetkilendirmesi kaldırıldı."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan akun dan otorisasi cloud telah dihapus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Legătura contului și autorizarea cloud au fost eliminate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישור החשבון והרשאת הענן הוסרו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa liên kết tài khoản và quyền truy cập đám mây."
          }
        }
      }
    },
    "已从此设备断开；云盘端授权暂未确认撤销，可稍后在云盘账号设置中检查": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung auf diesem Gerät getrennt. Ob die Autorisierung beim Cloud-Anbieter widerrufen wurde, konnte noch nicht bestätigt werden. Prüfe dies später in den Kontoeinstellungen des Cloud-Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected from this device. Revocation by the cloud provider has not yet been confirmed; check later in the cloud account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado de este dispositivo. Aún no se ha confirmado la revocación de la autorización en el proveedor; puedes comprobarlo más tarde en los ajustes de la cuenta del servicio en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté de cet appareil. La révocation de l’autorisation auprès du fournisseur cloud n’est pas encore confirmée ; vérifiez-la plus tard dans les réglages du compte cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से डिस्कनेक्ट किया गया। क्लाउड सेवा में प्राधिकरण रद्द होने की अभी पुष्टि नहीं हुई है; बाद में क्लाउड खाते की सेटिंग में जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnessione da questo dispositivo completata. La revoca dell’autorizzazione presso il provider cloud non è ancora confermata; controlla in seguito nelle impostazioni dell’account cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスとの接続を解除しました。クラウド側の認証が取り消されたかはまだ確認できません。後でクラウドのアカウント設定を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado deste dispositivo. A revogação da autorização no provedor de nuvem ainda não foi confirmada; verifique depois nas configurações da conta do serviço de nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从此设备断开；云盘端授权暂未确认撤销，可稍后在云盘账号设置中检查"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding op dit apparaat is verbroken. De cloudprovider heeft de intrekking nog niet bevestigd; controleer dit later in de instellingen van uw cloudaccount."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 연결이 끊어졌습니다. 클라우드 제공업체에 의한 권한 회수가 아직 확인되지 않았습니다. 나중에 클라우드 계정 설정에서 확인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فصله عن هذا الجهاز. لم يتم تأكيد سحب الإذن من مزود السحابة بعد؛ تحقق لاحقًا في إعدادات حساب السحابة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено от этого устройства. Отзыв со стороны облачного провайдера ещё не подтверждён; проверьте позже в настройках облачной учётной записи."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłączono z tego urządzenia. Odwołanie przez dostawcę chmury nie zostało jeszcze potwierdzone; sprawdź później w ustawieniach konta w chmurze."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplad bort från denna enhet. Återkallelse av molnleverantören har ännu inte bekräftats; kolla senare i molnkonto-inställningarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afkoblet fra denne enhed. Tilbagetrækning fra cloududbyderen er endnu ikke bekræftet; tjek senere i cloud-kontoindstillingerne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frakoblet fra denne enheten. Tilbakekalling fra skyleverandøren er ennå ikke bekreftet; sjekk senere i innstillingene for skykontoen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys katkaistu tästä laitteesta. Pilven tarjoajan peruutus ei ole vielä vahvistettu; tarkista myöhemmin pilvitilin asetuksista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojeno z tohoto zařízení. Zrušení povolení poskytovatelem cloudu ještě nebylo potvrzeno; zkontrolujte později v nastavení účtu v cloudu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσυνδέθηκε από αυτή τη συσκευή. Η ανάκληση από τον πάροχο cloud δεν έχει επιβεβαιωθεί ακόμη· ελέγξτε αργότερα στις ρυθμίσεις του λογαριασμού cloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leválasztva erről az eszközről. A felhőszolgáltató által végrehajtott visszavonás még nincs megerősítve; ellenőrizze később a felhőfiók beállításaiban."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiskonekta na sa device na ito. Hindi pa nakumpirma ng cloud provider ang pagbawi ng pahintulot. Tingnan muli sa mga setting ng cloud account mamaya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terputus dari peranti ini. Pembatalan oleh penyedia awan belum disahkan; semak kemudian dalam tetapan akaun awan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdan bağlantı kesildi. Sağlayıcı tarafından iptal henüz onaylanmadı; daha sonra bulut hesap ayarlarında kontrol edin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi di perangkat ini telah diputus. Pencabutan oleh penyedia cloud belum dikonfirmasi; periksa nanti di pengaturan akun cloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectat de pe acest dispozitiv. Revocarea de către furnizorul cloud nu a fost încă confirmată; verifică mai târziu în setările contului cloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותק מהמכשיר הזה. ביטול ההרשאה אצל ספק הענן עדיין לא אושר; יש לבדוק בהמשך בהגדרות חשבון הענן."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt kết nối khỏi thiết bị này. Chưa xác nhận nhà cung cấp đám mây đã thu hồi quyền; hãy kiểm tra sau trong cài đặt tài khoản đám mây."
          }
        }
      }
    },
