        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa chmurowa nie może teraz zakończyć tej operacji. Spróbuj ponownie później."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Molntjänsten kan inte slutföra denna åtgärd just nu. Försök igen senare."
          }
        },
        "da": {
          "stringUnit": {
