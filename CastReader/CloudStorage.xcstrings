        }
      }
    },
    "连接已失效，请重新连接后再试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung abgelaufen. Stelle die Verbindung erneut her und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection expired. Reconnect and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión ha caducado. Vuelve a conectarte e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré. Reconnectez-vous et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन की समय-सीमा खत्म हो गई है। फिर से कनेक्ट करके कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è scaduta. Riconnettiti e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の有効期限が切れました。再接続して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão expirou. Reconecte e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已失效，请重新连接后再试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding verlopen. Maak opnieuw verbinding en probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الاتصال. أعد الاتصال وحاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия подключения истёк. Подключитесь заново и повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie wygasło. Połącz się ponownie i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen har upphört. Anslut igen och försök."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelse udløbet. Genopret forbindelsen og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblingen har utløpt. Koble til på nytt og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys on vanhentunut. Yhdistä uudelleen ja yritä uudestaan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost připojení vypršela. Připojte se znovu a zkuste to."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση έληξε. Συνδεθείτε ξανά και δοκιμάστε."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolódás lejárt. Csatlakozzon újra, majd próbálja meg ismét."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawalan ng bisa ang koneksyon. I-reconnect at subukan ulit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan telah luput. Sambung semula dan cuba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı süresi doldu. Yeniden bağlanıp tekrar deneyin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 만료되었습니다. 다시 연결한 후 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi kedaluwarsa. Hubungkan kembali lalu coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea a expirat. Reconectează-te și încearcă din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף החיבור פג. יש להתחבר מחדש ולנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối đã hết hạn. Hãy kết nối lại rồi thử lại."
          }
        }
      }
    },
    "当前连接的账号不是这个文件所属账号，请切换账号后再试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das derzeit verbundene Konto gehört nicht zu dieser Datei. Wechsle das Konto und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected account does not own this file. Switch accounts and try again."
          }
        },
        "es": {
