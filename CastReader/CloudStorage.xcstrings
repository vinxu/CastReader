        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在接続中のアカウントは、このファイルの所有アカウントではありません。アカウントを変更して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta conectada não é a proprietária deste arquivo. Troque de conta e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
