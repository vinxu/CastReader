    "当前连接的账号不是这个文件所属账号，请切换账号后再试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das derzeit verbundene Konto gehört nicht zu dieser Datei. Wechsle das Konto und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected account does not own this file. Switch accounts and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta conectada no es la propietaria de este archivo. Cambia de cuenta e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
