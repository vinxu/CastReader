          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan cloud mengembalikan data yang tidak dikenali, sehingga operasi ini belum dapat diselesaikan saat ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul cloud a returnat date nerecunoscute, așa că această operațiune nu poate fi finalizată momentan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות הענן החזיר נתונים לא מזוהים, ולכן לא ניתן להשלים את הפעולה כרגע."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ đám mây trả về dữ liệu không nhận diện được nên hiện chưa thể hoàn tất thao tác này."
          }
        }
      }
    },
    "设备可用空间不足，请在系统设置中管理存储空间后再试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät ist nicht genug Speicherplatz verfügbar. Gib in den Systemeinstellungen Speicher frei und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not have enough free space. Manage storage in System Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo no tiene suficiente espacio libre. Gestiona el almacenamiento en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil ne dispose pas d’assez d’espace libre. Gérez le stockage dans Réglages, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस में पर्याप्त खाली स्थान नहीं है। सिस्टम सेटिंग्स में स्टोरेज प्रबंधित करें, फिर दोबारा कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo non dispone di spazio libero sufficiente. Gestisci lo spazio nelle Impostazioni di sistema, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の空き容量が不足しています。システム設定でストレージを管理してから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo não tem espaço livre suficiente. Gerencie o armazenamento nos Ajustes do sistema e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可用空间不足，请在系统设置中管理存储空间后再试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niet genoeg vrije ruimte op dit apparaat. Beheer de opslag in Systeeminstellingen en probeer het daarna opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 충분한 여유 공간이 없습니다. 시스템 설정에서 저장 공간을 관리한 후 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر مساحة كافية على هذا الجهاز. أدر مساحة التخزين في إعدادات النظام، ثم حاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве недостаточно свободного места. Освободите место в системных настройках и повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma wystarczająco wolnego miejsca. Zarządzaj pamięcią w Ustawieniach systemowych, a następnie spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten har inte tillräckligt med ledigt utrymme. Hantera lagring i Systeminställningar och försök sedan igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke nok ledig plads på denne enhed. Administrer lagerplads i Systemindstillinger, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten har ikke nok ledig plass. Administrer lagring i Systeminnstillinger, og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteessa ei ole tarpeeksi vapaata tilaa. Hallinnoi tallennustilaa Järjestelmäasetuksissa ja yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto zařízení není dostatek volného místa. Spravujte úložiště v Nastavení systému a zkuste to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή δεν διαθέτει αρκετό ελεύθερο χώρο. Διαχειριστείτε τον χώρο αποθήκευσης στις ρυθμίσεις συστήματος και δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs elég szabad tárhely az eszközön. Kezelje a tárhelyet a Rendszerbeállításokban, majd próbálja újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sapat ang libreng espasyo sa device na ito. Pamahalaan ang imbakan sa System Settings, pagkatapos subukan ulit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti ini tidak mempunyai ruang kosong yang mencukupi. Urus storan dalam Tetapan Sistem, kemudian cuba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda yeterli boş alan yok. Sistem Ayarları'ndan depolamayı yönetin ve tekrar deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak memiliki cukup ruang kosong. Kelola penyimpanan di Pengaturan Sistem, lalu coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu are suficient spațiu liber. Gestionează stocarea din setările sistemului, apoi încearcă din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מספיק מקום פנוי במכשיר הזה. יש לנהל את האחסון בהגדרות המערכת ואז לנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không đủ dung lượng trống. Hãy quản lý dung lượng trong Cài đặt hệ thống rồi thử lại."
          }
        }
      }
    },
    "云盘暂时无法完成此操作，请稍后再试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cloud-Speicher kann diesen Vorgang derzeit nicht abschließen. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud service cannot complete this operation right now. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en la nube no puede completar esta operación ahora. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service cloud ne peut pas effectuer cette opération pour le moment. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड सेवा यह कार्रवाई अभी पूरी नहीं कर सकती। बाद में फिर कोशिश करें।"
          }
        },
        "it": {
