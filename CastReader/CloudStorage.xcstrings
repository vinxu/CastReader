    "账号关联及云盘授权已解除": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoverknüpfung und Cloud-Autorisierung wurden aufgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account link and cloud authorization have been removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado la vinculación de la cuenta y la autorización del almacenamiento en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’association du compte et l’autorisation cloud ont été supprimées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता लिंक और क्लाउड प्राधिकरण हटा दिए गए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento dell’account e l’autorizzazione al cloud sono stati rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント連携とクラウドの認証を解除しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vínculo da conta e a autorização da nuvem foram removidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号关联及云盘授权已解除"
          }
        }
      }
    },
    "已从此设备断开；云盘端授权暂未确认撤销，可稍后在云盘账号设置中检查": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung auf diesem Gerät getrennt. Ob die Autorisierung beim Cloud-Anbieter widerrufen wurde, konnte noch nicht bestätigt werden. Prüfe dies später in den Kontoeinstellungen des Cloud-Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected from this device. Revocation by the cloud provider has not yet been confirmed; check later in the cloud account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado de este dispositivo. Aún no se ha confirmado la revocación de la autorización en el proveedor; puedes comprobarlo más tarde en los ajustes de la cuenta del servicio en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté de cet appareil. La révocation de l’autorisation auprès du fournisseur cloud n’est pas encore confirmée ; vérifiez-la plus tard dans les réglages du compte cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से डिस्कनेक्ट किया गया। क्लाउड सेवा में प्राधिकरण रद्द होने की अभी पुष्टि नहीं हुई है; बाद में क्लाउड खाते की सेटिंग में जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnessione da questo dispositivo completata. La revoca dell’autorizzazione presso il provider cloud non è ancora confermata; controlla in seguito nelle impostazioni dell’account cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスとの接続を解除しました。クラウド側の認証が取り消されたかはまだ確認できません。後でクラウドのアカウント設定を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado deste dispositivo. A revogação da autorização no provedor de nuvem ainda não foi confirmada; verifique depois nas configurações da conta do serviço de nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从此设备断开；云盘端授权暂未确认撤销，可稍后在云盘账号设置中检查"
          }
        }
      }
    },
