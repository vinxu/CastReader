    "组织策略禁止 CastReader 访问此云盘，请联系组织管理员": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Organisationsrichtlinie verhindert den Zugriff von CastReader auf diesen Cloud-Speicher. Wende dich an die Administration deiner Organisation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organization’s policy prevents CastReader from accessing this cloud storage. Contact your organization administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La política de tu organización impide que CastReader acceda a este almacenamiento en la nube. Contacta con el administrador de tu organización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La politique de votre organisation empêche CastReader d’accéder à ce stockage cloud. Contactez l’administrateur de votre organisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संगठन की नीति CastReader को इस क्लाउड स्टोरेज तक पहुँचने से रोकती है। अपने संगठन के व्यवस्थापक से संपर्क करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I criteri della tua organizzazione impediscono a CastReader di accedere a questo archivio cloud. Contatta l’amministratore dell’organizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織のポリシーにより、CastReaderはこのクラウドストレージにアクセスできません。組織の管理者にお問い合わせください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A política da sua organização impede o CastReader de acessar este armazenamento em nuvem. Entre em contato com o administrador da organização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组织策略禁止 CastReader 访问此云盘，请联系组织管理员"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het beleid van uw organisatie verhindert dat CastReader toegang krijgt tot deze cloudopslag. Neem contact op met uw organisatiebeheerder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조직 정책으로 인해 CastReader에서 이 클라우드 스토리지에 액세스할 수 없습니다. 조직 관리자에게 문의하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمنع سياسة منظمتك استخدام CastReader للوصول إلى هذا التخزين السحابي. اتصل بمسؤول منظمتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика вашей организации запрещает CastReader доступ к этому облачному хранилищу. Свяжитесь с администратором организации."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasady organizacji uniemożliwiają CastReader dostęp do tego magazynu w chmurze. Skontaktuj się z administratorem swojej organizacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din organisations policy hindrar CastReader från att komma åt detta molnlager. Kontakta din organisations administratör."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din organisations politik forhindrer CastReader i at få adgang til dette cloud-lager. Kontakt din organisationsadministrator."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisasjonens retningslinjer tillater ikke at CastReader får tilgang til denne skylagringen. Kontakt din organisasjonsadministrator."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisaatiosi käytäntö estää CastReaderin pääsyn tähän pilvitallennustilaan. Ota yhteyttä organisaatiosi ylläpitäjään."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásada vaší organizace brání aplikaci CastReader přistupovat k tomuto úložišti v cloudu. Kontaktujte správce vaší organizace."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πολιτική του οργανισμού σας εμποδίζει το CastReader να προσπελάσει αυτόν τον χώρο cloud. Επικοινωνήστε με τον διαχειριστή του οργανισμού σας."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szervezete szabályzata megakadályozza, hogy a CastReader hozzáférjen ehhez a felhőtárhelyhez. Vegye fel a kapcsolatot szervezeti rendszergazdájával."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbabawal ang patakaran ng iyong organisasyon sa CastReader na ma-access ang cloud storage na ito. Makipag-ugnayan sa iyong administrator ng organisasyon."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasar organisasi anda menghalang CastReader daripada mengakses storan awan ini. Hubungi pentadbir organisasi anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuruluşunuzun politikası, CastReader'ın bu bulut depolamaya erişmesini engeller. Kuruluş yöneticinizle iletişime geçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan organisasi Anda mencegah CastReader mengakses penyimpanan cloud ini. Hubungi administrator organisasi Anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Politica organizației tale împiedică accesul CastReader la acest spațiu de stocare în cloud. Contactează administratorul organizației."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדיניות הארגון שלך מונעת מ־CastReader לגשת לאחסון הענן הזה. יש לפנות למנהל המערכת בארגון."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính sách của tổ chức không cho phép CastReader truy cập bộ nhớ đám mây này. Hãy liên hệ quản trị viên của tổ chức."
          }
        }
      }
    },
    "此 Google 文档超过 Google Drive 的导出大小限制，无法导入": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Google-Dokument überschreitet das Exportgrößenlimit von Google Drive und kann nicht importiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Google document exceeds Google Drive’s export size limit and cannot be imported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento de Google supera el límite de tamaño de exportación de Google Drive y no se puede importar."
