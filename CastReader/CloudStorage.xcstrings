        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड पर बहुत ज़्यादा अनुरोध हुए हैं। बाद में फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste al cloud. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドへのリクエストが多すぎます。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas solicitações à nuvem. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云盘请求过于频繁，请稍后重试"
