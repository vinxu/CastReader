        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhőszolgáltatás ismeretlen adatot küldött vissza, így ez a művelet jelenleg nem fejezhető be."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbalik ang serbisyo ng cloud ng hindi kilalang datos, kaya hindi matatapos ang operasyong ito ngayon."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan awan mengembalikan data yang tidak dikenali, jadi operasi ini tidak dapat diselesaikan pada masa ini."
          }
        },
        "tr": {
          "stringUnit": {
