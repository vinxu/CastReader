    "该云盘尚未完成开发者配置，请稍后再试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Cloud-Speicher ist noch nicht für die App konfiguriert. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cloud provider hasn’t been configured for the app yet. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servicio en la nube todavía no está configurado para la app. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur cloud n’est pas encore configuré pour l’app. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह क्लाउड सेवा अभी ऐप के लिए कॉन्फ़िगर नहीं है। बाद में फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo provider cloud non è ancora configurato per l’app. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクラウドサービスはまだアプリ用に設定されていません。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor de nuvem ainda não foi configurado para o app. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该云盘尚未完成开发者配置，请稍后再试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze cloudprovider is nog niet voor de app geconfigureerd. Probeer het later opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تكوين مزود السحابة هذا للتطبيق بعد. يرجى المحاولة لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот облачный провайдер ещё не настроен для приложения. Повторите попытку позже."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dostawca chmury nie został jeszcze skonfigurowany dla aplikacji. Spróbuj ponownie później."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna molntjänst har inte konfigurerats för appen än. Försök igen senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne skyudbyder er ikke konfigureret til appen endnu. Prøv igen senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyleverandøren er ikke konfigurert for appen ennå. Vennligst prøv igjen senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilvipalveluntarjoajaa ei ole vielä määritetty sovellukselle. Yritä myöhemmin uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento poskytovatel cloudu pro aplikaci ještě není nakonfigurován. Zkuste to prosím později."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πάροχος cloud δεν έχει ρυθμιστεί ακόμα για την εφαρμογή. Παρακαλώ δοκιμάστε ξανά αργότερα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a felhőszolgáltató még nincs beállítva az alkalmazásban. Kérjük, próbálja meg később."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa inayos ang cloud provider na ito para sa app. Subukan ulit mamaya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyedia awan ini belum dikonfigurasi untuk aplikasi. Sila cuba lagi nanti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bulut sağlayıcısı henüz uygulama için yapılandırılmamış. Lütfen daha sonra tekrar deneyin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 클라우드 서비스가 앱에 아직 설정되지 않았습니다. 나중에 다시 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyedia cloud ini belum dikonfigurasi untuk aplikasi. Silakan coba lagi nanti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest furnizor cloud nu a fost încă configurat pentru aplicație. Încearcă din nou mai târziu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספק הענן הזה עדיין לא הוגדר עבור האפליקציה. יש לנסות שוב מאוחר יותר."
