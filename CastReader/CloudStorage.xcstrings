    "云端文档会在设备上导出后进入现有阅读器": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Cloud-Dokument wird auf diesem Gerät exportiert und anschließend im vorhandenen Reader geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud document will be exported on this device and opened in the existing reader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento en la nube se exportará en este dispositivo y se abrirá en el lector existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document cloud sera exporté sur cet appareil, puis ouvert dans le lecteur existant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड दस्तावेज़ इस डिवाइस पर निर्यात होकर मौजूदा रीडर में खुलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento nel cloud verrà esportato su questo dispositivo e aperto nel lettore esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上のドキュメントをこのデバイスでエクスポートして、既存のリーダーで開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento na nuvem será exportado neste dispositivo e aberto no leitor atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端文档会在设备上导出后进入现有阅读器"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het clouddocument wordt op dit apparaat geëxporteerd en geopend in de bestaande reader."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 문서가 이 기기에서 내보내져 기존 리더에서 열립니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُصدّر المستند السحابي على هذا الجهاز ويُفتح في قارئ التطبيق الحالي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачный документ будет экспортирован на это устройство и открыт в приложении для чтения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokument z chmury zostanie wyeksportowany na tym urządzeniu i otwarty w istniejącym czytniku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentet i molnet kommer att exporteras på denna enhet och öppnas i den befintliga läsaren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette cloud-dokument vil blive eksporteret på denne enhed og åbnet i den eksisterende læser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette skydokumentet vil bli eksportert på denne enheten og åpnet i den eksisterende leseren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilvidokumentti viedään tälle laitteelle ja avataan olemassa olevassa lukijassa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudový dokument bude exportován do tohoto zařízení a otevřen ve stávající čtečce."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το έγγραφο cloud θα εξαχθεί σε αυτή τη συσκευή και θα ανοίξει στον υπάρχοντα αναγνώστη."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhődokumentum erre az eszközre lesz exportálva, és megnyílik a meglévő olvasóban."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ie-export ang dokumento mula sa cloud sa device na ito at bubuksan sa kasalukuyang pangbasa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen awan akan dieksport pada peranti ini dan dibuka dalam pembaca sedia ada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut belgesi bu cihazda dışa aktarılacak ve mevcut okuyucuda açılacaktır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen cloud akan diekspor di perangkat ini dan dibuka di pembaca yang ada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentul din cloud va fi exportat pe acest dispozitiv și deschis în cititorul existent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסמך הענן ייוצא במכשיר הזה וייפתח בקורא הקיים."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu đám mây sẽ được xuất trên thiết bị này và mở trong trình đọc hiện có."
          }
        }
      }
    },
