    "只读访问 · 原文件不上 CastReader 云端": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützter Zugriff · Originaldateien werden nicht in die CastReader-Cloud hochgeladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only access · Original files are not uploaded to CastReader Cloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso de solo lectura · Los archivos originales no se suben a la nube de CastReader"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès en lecture seule · Les fichiers d’origine ne sont pas envoyés dans le cloud CastReader"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पढ़ने का एक्सेस · मूल फ़ाइलें CastReader Cloud पर अपलोड नहीं होतीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso in sola lettura · I file originali non vengono caricati nel cloud CastReader"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用アクセス · 元のファイルはCastReaderクラウドにアップロードされません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso somente leitura · Os arquivos originais não são enviados à nuvem do CastReader"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读访问 · 原文件不上 CastReader 云端"
          }
        }
      }
    },
    "仅申请读取权限": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum vollständiger Lesezugriff erforderlich ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why full read-only access is needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué se necesita acceso completo de solo lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi l’accès complet en lecture seule est nécessaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण केवल-पढ़ने की पहुँच क्यों आवश्यक है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché serve l’accesso completo in sola lettura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
