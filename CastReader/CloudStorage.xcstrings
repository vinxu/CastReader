        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp tylko do odczytu · Oryginalne pliki nie są przesyłane do chmury CastReader"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
