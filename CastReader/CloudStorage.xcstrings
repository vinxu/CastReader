            "value": "Acest fișier nu poate fi citit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את הקובץ הזה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc tệp này."
          }
        }
      }
    },
    "已从此设备断开；云盘端授权暂未确认撤销": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung auf diesem Gerät getrennt. Der Widerruf der Cloud-Autorisierung wurde noch nicht bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected from this device; cloud authorization revocation has not yet been confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado de este dispositivo; aún no se ha confirmado la revocación de la autorización en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté de cet appareil ; la révocation de l’autorisation cloud n’est pas encore confirmée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से डिस्कनेक्ट किया गया; क्लाउड प्राधिकरण रद्द होने की अभी पुष्टि नहीं हुई है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnessione da questo dispositivo completata; la revoca dell’autorizzazione cloud non è ancora confermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスとの接続を解除しましたが、クラウド側の認証取り消しはまだ確認できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado deste dispositivo; a revogação da autorização da nuvem ainda não foi confirmada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从此设备断开；云盘端授权暂未确认撤销"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding verbroken met dit apparaat; intrekking van de cloudautorisatie is nog niet bevestigd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منفصل عن هذا الجهاز؛ لم يتم تأكيد سحب إذن السحابة بعد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено от этого устройства; отзыв авторизации в облаке ещё не подтверждён."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłączono od tego urządzenia. Cofnięcie uprawnień dostępu do chmury nie zostało jeszcze potwierdzone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frånkopplad från denna enhet; återkallande av molnauktorisering har inte bekräftats än."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afkoblet fra denne enhed; ophævelse af godkendelse til skyen er endnu ikke bekræftet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frakoblet fra denne enheten; tilbakekalling av skyautorisering er ikke bekreftet ennå."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys tähän laitteeseen on katkaistu. Pilvipalvelun käyttöoikeuden perumista ei ole vielä vahvistettu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojeno od tohoto zařízení; odvolání oprávnění cloudu ještě nebylo potvrzeno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσυνδέθηκε από αυτή τη συσκευή· η ανάκληση της εξουσιοδότησης cloud δεν έχει επιβεβαιωθεί ακόμη."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leválasztva erről az eszközről; a felhőszolgáltató még nem erősítette meg a hozzáférés visszavonását."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiskonekta na sa device na ito; hindi pa nakumpirma ang pagbawi ng pahintulot sa cloud."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan pada peranti ini telah diputuskan; pembatalan kebenaran awan belum disahkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdan bağlantı kesildi; bulut erişim yetkisinin iptali henüz onaylanmadı."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 연결을 해제했습니다. 클라우드 권한 철회 여부는 아직 확인되지 않았습니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi di perangkat ini telah diputus; pencabutan otorisasi cloud belum dikonfirmasi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectat de pe acest dispozitiv; retragerea autorizării cloud nu a fost încă confirmată."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותק מהמכשיר הזה; ביטול הרשאת הענן עדיין לא אושר."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt kết nối khỏi thiết bị này; chưa xác nhận việc thu hồi quyền truy cập đám mây."
          }
        }
      }
    },
    "这会取消当前云盘操作并删除本机账号关联；阅读历史基础信息会保留。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der aktuelle Cloud-Vorgang abgebrochen und die Kontoverknüpfung auf diesem Gerät gelöscht. Grundlegende Angaben im Leseverlauf bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will cancel the current cloud operation and remove the account link from this device. Basic reading history metadata will be kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cancelará la operación actual en la nube y eliminará la vinculación de la cuenta de este dispositivo. Se conservarán los datos básicos del historial de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela annulera l’opération cloud en cours et supprimera l’association du compte sur cet appareil. Les informations de base de l’historique de lecture seront conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे मौजूदा क्लाउड कार्रवाई रद्द हो जाएगी और इस डिवाइस से खाता लिंक हट जाएगा। पढ़ने के इतिहास की बुनियादी जानकारी बनी रहेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione annullerà l’operazione cloud in corso e rimuoverà il collegamento dell’account da questo dispositivo. I dati di base della cronologia di lettura verranno conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のクラウド操作をキャンセルし、このデバイスのアカウント連携を削除します。読書履歴の基本情報は保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso cancelará a operação atual na nuvem e removerá o vínculo da conta deste dispositivo. As informações básicas do histórico de leitura serão mantidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会取消当前云盘操作并删除本机账号关联；阅读历史基础信息会保留。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de huidige cloudbewerking geannuleerd en de accountkoppeling van dit apparaat verwijderd. De basismetadata van de leesgeschiedenis blijft behouden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى إلغاء عملية السحابة الحالية وإزالة رابط الحساب من هذا الجهاز. سيتم الاحتفاظ ببيانات سجل القراءة الأساسي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая операция с облаком будет отменена, а связь с аккаунтом на этом устройстве удалена. Основные метаданные истории чтения сохранятся."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to anulowanie bieżącej operacji chmurowej i usunięcie połączenia konta z tego urządzenia. Podstawowe metadane historii czytania zostaną zachowane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kommer att avbryta den pågående molnåtgärden och ta bort kontolänken från denna enhet. Grundläggande metadata för läshistorik sparas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil annullere den aktuelle sky-handling og fjerne kontolinket fra denne enhed. Grundlæggende metadata om læsehistorik bevares."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil avbryte den pågående skyoperasjonen og fjerne kontokoblingen fra denne enheten. Grunnleggende metadata om lesningshistorikk beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä peruuttaa nykyisen pilvitoiminnon ja poistaa tiliyhteyden laitteesta. Lukuhistorian perustiedot säilytetään."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se zruší aktuální cloudová operace a odstraní propojení s účtem z tohoto zařízení. Základní údaje historie čtení zůstanou zachovány."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα ακυρώσει την τρέχουσα ενέργεια cloud και θα αφαιρέσει τη σύνδεση του λογαριασμού από αυτή τη συσκευή. Τα βασικά μεταδεδομένα ιστορικού ανάγνωσης θα διατηρηθούν."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez megszakítja a jelenlegi felhőműveletet, és eltávolítja a fiókkapcsolatot erről az eszközről. Az alapvető olvasási előzmények metaadatai megmaradnak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakanselahin nito ang kasalukuyang operasyon sa cloud at aalisin ang koneksyon ng account sa device na ito. Mananatili ang pangunahing metadata ng kasaysayan ng pagbasa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan membatalkan operasi awan semasa dan membuang pautan akaun dari peranti ini. Metadata sejarah bacaan asas akan dikekalkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut bulut işlemi iptal edilecek ve bu cihazdaki hesap bağlantısı kaldırılacak. Temel okuma geçmişi meta verileri saklanacaktır."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 클라우드 작업을 취소하고 이 기기에서 계정 연결을 제거합니다. 기본 읽기 기록 정보는 유지됩니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan membatalkan operasi cloud saat ini dan menghapus tautan akun dari perangkat ini. Metadata dasar riwayat membaca akan dipertahankan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va anula operațiunea cloud curentă și va elimina legătura contului de pe acest dispozitiv. Metadatele de bază ale istoricului de lectură vor fi păstrate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תבטל את פעולת הענן הנוכחית ותסיר את קישור החשבון מהמכשיר הזה. מטא־נתונים בסיסיים של היסטוריית הקריאה יישמרו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ hủy thao tác đám mây hiện tại và xóa liên kết tài khoản khỏi thiết bị. Siêu dữ liệu cơ bản của lịch sử đọc sẽ được giữ lại."
          }
        }
      }
    },
