    "云盘暂时无法完成此操作，请重试": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cloud-Speicher kann diesen Vorgang derzeit nicht abschließen. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud provider can’t complete this operation right now. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en la nube no puede completar esta operación ahora. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur cloud ne peut pas terminer cette opération pour le moment. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड सेवा अभी यह कार्रवाई पूरी नहीं कर सकती। फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il provider cloud non può completare l’operazione al momento. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、クラウドサービスでこの操作を完了できません。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor de nuvem não pode concluir esta operação agora. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云盘暂时无法完成此操作，请重试"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De cloudprovider kan deze bewerking op dit moment niet voltooien. Probeer het later opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع مزود السحابة إكمال هذه العملية حاليًا. يرجى المحاولة لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачный провайдер не может выполнить эту операцию прямо сейчас. Повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawca chmury nie może teraz dokończyć tej operacji. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Molntjänsten kan inte slutföra denna åtgärd just nu. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyudbyderen kan ikke fuldføre denne handling lige nu. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyleverandøren kan ikke fullføre denne operasjonen akkurat nå. Vennligst prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilvipalveluntarjoaja ei pysty suorittamaan tätä toimintoa juuri nyt. Yritä myöhemmin uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskytovatel cloudu nemůže tuto operaci nyní dokončit. Zkuste to prosím znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πάροχος cloud δεν μπορεί να ολοκληρώσει αυτή την ενέργεια αυτή τη στιγμή. Παρακαλώ δοκιμάστε ξανά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhőszolgáltató jelenleg nem tudja végrehajtani ezt a műveletet. Kérjük, próbálja meg újra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi matapos ng cloud provider ang operasyong ito ngayon. Subukan ulit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyedia awan tidak dapat menyelesaikan operasi ini sekarang. Sila cuba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut sağlayıcısı şu anda bu işlemi tamamlayamıyor. Lütfen tekrar deneyin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 서비스가 지금 이 작업을 완료할 수 없습니다. 다시 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyedia cloud tidak dapat menyelesaikan operasi ini saat ini. Silakan coba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Furnizorul cloud nu poate finaliza această operațiune momentan. Încearcă din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספק הענן אינו יכול להשלים את הפעולה כרגע. יש לנסות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp đám mây hiện chưa thể hoàn tất thao tác này. Vui lòng thử lại."
          }
        }
      }
    },
    "文件可能已损坏、受密码或 DRM 保护，暂时无法读取": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist möglicherweise beschädigt oder durch ein Passwort bzw. DRM geschützt und kann derzeit nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file may be corrupted or protected by a password or DRM and cannot be read right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el archivo esté dañado o protegido con contraseña o DRM y no pueda leerse ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est peut-être endommagé ou protégé par un mot de passe ou un DRM et ne peut pas être lu pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल खराब हो सकती है या पासवर्ड अथवा DRM से सुरक्षित हो सकती है, इसलिए अभी पढ़ी नहीं जा सकती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file potrebbe essere danneggiato o protetto da password o DRM e non può essere letto al momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが破損しているか、パスワードまたはDRMで保護されているため、現在読み込めない可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo pode estar corrompido ou protegido por senha ou DRM e não pode ser lido no momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件可能已损坏、受密码或 DRM 保护，暂时无法读取"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand kan mogelijk beschadigd zijn, beveiligd met een wachtwoord of DRM, en kan nu niet worden gelezen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون الملف تالفًا أو محميًا بكلمة مرور أو بإدارة الحقوق الرقمية (DRM)، ولا يمكن قراءته حاليًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл может быть повреждён или защищён паролем или DRM, поэтому его нельзя прочитать прямо сейчас."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik może być uszkodzony lub chroniony hasłem lub DRM i nie można go obecnie odczytać."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kan vara skadad eller skyddad med lösenord eller DRM och kan inte läsas just nu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kan være beskadiget eller beskyttet af et kodeord eller DRM og kan ikke læses lige nu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kan være skadet eller beskyttet med passord eller DRM og kan ikke leses akkurat nå."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto saattaa olla vioittunut tai suojattu salasanalla tai DRM:llä, eikä sitä voida lukea juuri nyt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor může být poškozený nebo chráněn heslem nebo DRM a nelze jej nyní přečíst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο μπορεί να είναι κατεστραμμένο ή προστατευμένο με κωδικό πρόσβασης ή DRM και δεν μπορεί να ανοιχτεί τώρα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl sérült lehet, jelszóval vagy DRM-mel védett, és jelenleg nem olvasható."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baka sira ang file o protektado ito ng password o DRM kaya hindi mabasa ngayon."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail mungkin rosak atau dilindungi oleh kata laluan atau DRM dan tidak boleh dibaca sekarang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya bozuk olabilir, şifreli veya DRM korumasına sahip olabilir ve şu anda okunamıyor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 손상되었거나 비밀번호 또는 DRM으로 보호되어 지금 읽을 수 없습니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File mungkin rusak atau dilindungi kata sandi maupun DRM dan belum dapat dibaca saat ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul poate fi deteriorat sau protejat prin parolă ori DRM și nu poate fi citit momentan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהקובץ פגום או מוגן בסיסמה או ב־DRM, ולא ניתן לקרוא אותו כרגע."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp có thể bị hỏng hoặc được bảo vệ bằng mật khẩu hay DRM nên hiện không thể đọc."
          }
        }
      }
    },
    "文件格式与扩展名不一致，已停止导入": {
      "localizations": {
