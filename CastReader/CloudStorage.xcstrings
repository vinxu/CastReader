            "state": "translated",
            "value": "云盘暂时无法完成此操作，请重试"
          }
        }
      }
    },
    "文件可能已损坏、受密码或 DRM 保护，暂时无法读取": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist möglicherweise beschädigt oder durch ein Passwort bzw. DRM geschützt und kann derzeit nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file may be corrupted or protected by a password or DRM and cannot be read right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el archivo esté dañado o protegido con contraseña o DRM y no pueda leerse ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est peut-être endommagé ou protégé par un mot de passe ou un DRM et ne peut pas être lu pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल खराब हो सकती है या पासवर्ड अथवा DRM से सुरक्षित हो सकती है, इसलिए अभी पढ़ी नहीं जा सकती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file potrebbe essere danneggiato o protetto da password o DRM e non può essere letto al momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが破損しているか、パスワードまたはDRMで保護されているため、現在読み込めない可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo pode estar corrompido ou protegido por senha ou DRM e não pode ser lido no momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件可能已损坏、受密码或 DRM 保护，暂时无法读取"
          }
        }
      }
    },
    "文件格式与扩展名不一致，已停止导入": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiformat und Erweiterung stimmen nicht überein. Der Import wurde beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file format does not match its extension. Import stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato del archivo no coincide con su extensión. Se ha detenido la importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format du fichier ne correspond pas à son extension. L’importation a été interrompue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल फ़ॉर्मेट और एक्सटेंशन मेल नहीं खाते। इंपोर्ट रोक दिया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato del file non corrisponde all’estensione. Importazione interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル形式と拡張子が一致しないため、インポートを中止しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato do arquivo não corresponde à extensão. A importação foi interrompida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件格式与扩展名不一致，已停止导入"
          }
        }
      }
    },
    "下载的文件不完整，请重新下载": {
      "localizations": {
        "de": {
