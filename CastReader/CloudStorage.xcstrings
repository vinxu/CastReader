    "只读访问 · 原文件不上 CastReader 云端": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützter Zugriff · Originaldateien werden nicht in die CastReader-Cloud hochgeladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only access · Original files are not uploaded to CastReader Cloud"
          }
        },
        "es": {
