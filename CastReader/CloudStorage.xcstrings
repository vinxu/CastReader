    "原文件仅下载到本机临时目录，不会上传到 CastReader 云端": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaldateien werden nur in einen temporären Ordner auf diesem Gerät geladen und nicht in die CastReader-Cloud hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original files are downloaded only to a temporary folder on this device and are not uploaded to CastReader Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos originales solo se descargan en una carpeta temporal de este dispositivo y no se suben a la nube de CastReader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers d’origine sont téléchargés uniquement dans un dossier temporaire sur cet appareil et ne sont pas envoyés dans le cloud CastReader."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ाइलें केवल इस डिवाइस के अस्थायी फ़ोल्डर में डाउनलोड होती हैं और CastReader Cloud पर अपलोड नहीं होतीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file originali vengono scaricati solo in una cartella temporanea su questo dispositivo e non vengono caricati nel cloud CastReader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルはこのデバイスの一時フォルダにのみダウンロードされ、CastReaderクラウドにはアップロードされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos originais são baixados somente para uma pasta temporária neste dispositivo e não são enviados à nuvem do CastReader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件仅下载到本机临时目录，不会上传到 CastReader 云端"
          }
        }
      }
    },
