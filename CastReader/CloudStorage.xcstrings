        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de nuvem retornou dados não reconhecidos, portanto a operação não pode ser concluída agora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云盘返回了无法识别的数据，暂时无法完成此操作"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De clouddienst gaf onbekende gegevens terug, waardoor deze bewerking nu niet kan worden voltooid."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 서비스에서 인식하지 못한 데이터를 반환했으므로 현재 이 작업을 완료할 수 없습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجعت خدمة السحابة بيانات غير معروفة، لذا لا يمكن إكمال هذه العملية حاليًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачный сервис вернул нераспознанные данные, поэтому эту операцию нельзя выполнить прямо сейчас."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa chmurowa zwróciła nierozpoznane dane, więc tej operacji nie można teraz zakończyć."
