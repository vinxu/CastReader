    "原文件仅下载到本机临时目录，不会上传到 CastReader 云端": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaldateien werden nur in einen temporären Ordner auf diesem Gerät geladen und nicht in die CastReader-Cloud hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original files are downloaded only to a temporary folder on this device and are not uploaded to CastReader Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos originales solo se descargan en una carpeta temporal de este dispositivo y no se suben a la nube de CastReader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers d’origine sont téléchargés uniquement dans un dossier temporaire sur cet appareil et ne sont pas envoyés dans le cloud CastReader."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ाइलें केवल इस डिवाइस के अस्थायी फ़ोल्डर में डाउनलोड होती हैं और CastReader Cloud पर अपलोड नहीं होतीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file originali vengono scaricati solo in una cartella temporanea su questo dispositivo e non vengono caricati nel cloud CastReader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルはこのデバイスの一時フォルダにのみダウンロードされ、CastReaderクラウドにはアップロードされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos originais são baixados somente para uma pasta temporária neste dispositivo e não são enviados à nuvem do CastReader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件仅下载到本机临时目录，不会上传到 CastReader 云端"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Originele bestanden worden alleen gedownload naar een tijdelijke map op dit apparaat en niet geüpload naar CastReader Cloud."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일은 이 기기의 임시 폴더에만 다운로드되며 CastReader Cloud로 업로드되지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تنزيل الملفات الأصلية فقط إلى مجلد مؤقت على هذا الجهاز ولا يتم تحميلها إلى سحابة CastReader."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные файлы загружаются только во временную папку на этом устройстве и не загружаются в CastReader Cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalne pliki są pobierane tylko do folderu tymczasowego na tym urządzeniu i nie są przesyłane do chmury CastReader."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ursprungliga filer laddas bara ner till en tillfällig mapp på denna enhet och laddas inte upp till CastReader Cloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalfiler downloades kun til en midlertidig mappe på denne enhed og uploades ikke til CastReader Cloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprinnelige filer lastes kun ned til en midlertidig mappe på denne enheten og lastes ikke opp til CastReader Cloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäiset tiedostot ladataan vain tämän laitteen väliaikaiseen kansioon. Niitä ei lähetetä CastReader Cloudiin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Původní soubory se stahují pouze do dočasné složky na tomto zařízení a nejsou nahrávány do cloudu CastReader."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχικά αρχεία κατεβαίνουν μόνο σε έναν προσωρινό φάκελο σε αυτή τη συσκευή και δεν ανεβάζονται στο CastReader Cloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredeti fájlok kizárólag az eszköz ideiglenes mappájába töltődnek le, a CastReader Cloudba nem kerülnek feltöltésre."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina-download lamang ang mga orihinal na file sa pansamantalang folder sa device na ito. Hindi ina-upload ang mga ito sa CastReader Cloud."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail asal hanya dimuat turun ke folder sementara pada peranti ini dan tidak dimuat naik ke awan CastReader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal dosyalar yalnızca bu cihazdaki geçici bir klasöre indirilir ve CastReader Cloud'a yüklenmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File asli hanya diunduh ke folder sementara di perangkat ini dan tidak diunggah ke CastReader Cloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele originale sunt descărcate doar într-un dosar temporar de pe acest dispozitiv și nu sunt încărcate în cloudul CastReader."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים המקוריים יורדים רק לתיקייה זמנית במכשיר הזה ואינם מועלים לענן של CastReader."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp gốc chỉ được tải xuống thư mục tạm thời trên thiết bị này và không được tải lên CastReader Cloud."
          }
        }
      }
    },
