          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många begäranden till molnet. Försök igen senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange anmodninger til skyen. Prøv igen senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange skyforespørsler. Vennligst prøv igjen senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta pilvipyyntöä. Yritä myöhemmin uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho požadavků na cloud. Zkuste to prosím později."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
