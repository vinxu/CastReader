        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak olvasható hozzáférés · Az eredeti fájlokat nem töltik fel a CastReader Cloudba"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Access para sa pagbasa lamang · Hindi ina-upload sa CastReader Cloud ang mga orihinal na file"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses baca sahaja · Fail asal tidak dimuat naik ke Awan CastReader"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur erişim · Orijinal dosyalar CastReader Cloud'a yüklenmez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses hanya-baca · File asli tidak diunggah ke CastReader Cloud"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acces doar pentru citire · Fișierele originale nu sunt încărcate în cloudul CastReader"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גישה לקריאה בלבד · הקבצים המקוריים אינם מועלים לענן של CastReader"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền chỉ đọc · Tệp gốc không được tải lên CastReader Cloud"
          }
        }
      }
    },
    "仅申请读取权限": {
      "localizations": {
        "de": {
