    "确认更换账号？": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto wirklich wechseln?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch accounts?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Confirmas que quieres cambiar de cuenta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer le changement de compte ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता बदलने की पुष्टि करें?"
          }
