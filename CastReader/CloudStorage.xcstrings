          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que o acesso completo somente leitura é necessário"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么需要完整只读权限"
          }
        }
      }
    },
    "CastReader 不会在你的云盘中创建、修改、移动或删除文件。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du vor der Auswahl in zugänglichen Drive-Ordnern navigieren und dateiübergreifend suchen kannst. CastReader erstellt, ändert, verschiebt oder löscht keine Drive-Dateien und scannt oder indexiert Drive nicht im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lets you browse accessible Drive folders and search across files before choosing one. CastReader never creates, modifies, moves, or deletes Drive files, and never scans or indexes Drive in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto te permite explorar las carpetas accesibles de Drive y buscar entre archivos antes de elegir uno. CastReader nunca crea, modifica, mueve ni elimina archivos de Drive, ni analiza o indexa Drive en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous permet de parcourir les dossiers Drive accessibles et de rechercher parmi les fichiers avant d’en choisir un. CastReader ne crée, ne modifie, ne déplace ni ne supprime de fichiers Drive, et n’analyse ni n’indexe Drive en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आप किसी फ़ाइल को चुनने से पहले उपलब्ध Drive फ़ोल्डर ब्राउज़ और सभी फ़ाइलों में खोज सकते हैं। CastReader Drive फ़ाइलें बनाता, बदलता, खिसकाता या मिटाता नहीं और पृष्ठभूमि में Drive को स्कैन या इंडेक्स नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di esplorare le cartelle Drive accessibili e cercare tra i file prima di sceglierne uno. CastReader non crea, modifica, sposta o elimina file Drive e non esegue scansioni o indicizzazioni di Drive in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを選ぶ前に、アクセス可能なDriveフォルダを閲覧し、ファイル全体を検索できます。CastReaderがDriveファイルを作成、変更、移動、削除したり、バックグラウンドでDriveをスキャンまたは索引化したりすることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso permite navegar pelas pastas acessíveis do Drive e pesquisar entre arquivos antes de escolher um. O CastReader nunca cria, modifica, move ou exclui arquivos do Drive e nunca verifica ou indexa o Drive em segundo plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于让你在选择文件前浏览可访问的 Drive 文件夹并跨文件搜索。CastReader 不会创建、修改、移动或删除 Drive 文件，也不会在后台扫描或索引 Drive。"
          }
        }
      }
    },
    "文件只下载到这台设备": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden nur auf dieses Gerät heruntergeladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files download only to this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos solo se descargan en este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont téléchargés uniquement sur cet appareil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें केवल इस डिवाइस पर डाउनलोड होती हैं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono scaricati solo su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはこのデバイスにのみダウンロード"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são baixados somente neste dispositivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件只下载到这台设备"
          }
        }
      }
    },
    "支持的文档会进入临时目录并在本机校验、解析；不会上传到 CastReader 的文件存储。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützte Dokumente werden in einem temporären Ordner auf diesem Gerät geprüft und verarbeitet. Sie werden nicht in den Dateispeicher von CastReader hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported documents are placed in a temporary folder and validated and parsed on this device. They are not uploaded to CastReader file storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos compatibles se guardan en una carpeta temporal y se validan y procesan en este dispositivo. No se suben al almacenamiento de archivos de CastReader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents pris en charge sont placés dans un dossier temporaire, puis vérifiés et analysés sur cet appareil. Ils ne sont pas envoyés dans l’espace de stockage de CastReader."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित दस्तावेज़ अस्थायी फ़ोल्डर में रखे जाते हैं और इसी डिवाइस पर जाँचे व पार्स किए जाते हैं। उन्हें CastReader के फ़ाइल स्टोरेज पर अपलोड नहीं किया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I documenti supportati vengono inseriti in una cartella temporanea e verificati e analizzati su questo dispositivo. Non vengono caricati nello spazio di archiviazione file di CastReader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応している文書は一時フォルダに保存され、このデバイス上で検証・解析されます。CastReaderのファイルストレージにはアップロードされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os documentos compatíveis são colocados em uma pasta temporária e validados e processados neste dispositivo. Eles não são enviados ao armazenamento de arquivos do CastReader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的文档会进入临时目录并在本机校验、解析；不会上传到 CastReader 的文件存储。"
          }
        }
      }
    },
    "朗读与解读沿用现有服务": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlesen und Erklären nutzen die vorhandenen Dienste"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Aloud and Explain use existing services"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer en voz alta y Explicar usan los servicios existentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture à voix haute et l’explication utilisent les services existants"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ोर से पढ़ना और व्याख्या मौजूदा सेवाओं का उपयोग करते हैं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura ad alta voce e Spiegazione usano i servizi esistenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げと解説は既存のサービスを利用"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler em voz alta e Explicar usam os serviços existentes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读与解读沿用现有服务"
          }
        }
      }
    },
    "开始朗读或解读后，必要的文本会按现有产品逻辑发送到 CastReader 的 TTS 或 QuickRead 服务。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das Vorlesen oder Erklären startest, wird erforderlicher Text gemäß der bestehenden Produktlogik an die TTS- oder QuickRead-Dienste von CastReader gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you start Read Aloud or Explain, required text is sent to CastReader’s TTS or QuickRead services under the app’s existing processing flow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando inicies Leer en voz alta o Explicar, el texto necesario se enviará a los servicios TTS o QuickRead de CastReader según el flujo de procesamiento existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le démarrage de la lecture à voix haute ou de l’explication, le texte nécessaire est envoyé aux services TTS ou QuickRead de CastReader selon le processus existant de l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ोर से पढ़ना या व्याख्या शुरू करने के बाद, आवश्यक टेक्स्ट ऐप की मौजूदा प्रक्रिया के अनुसार CastReader की TTS या QuickRead सेवा को भेजा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando avvii Lettura ad alta voce o Spiegazione, il testo necessario viene inviato ai servizi TTS o QuickRead di CastReader secondo il flusso di elaborazione esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げまたは解説を開始すると、必要なテキストが既存の処理フローに従ってCastReaderのTTSまたはQuickReadサービスに送信されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao iniciar Ler em voz alta ou Explicar, o texto necessário é enviado aos serviços TTS ou QuickRead do CastReader conforme o fluxo de processamento atual do app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始朗读或解读后，必要的文本会按现有产品逻辑发送到 CastReader 的 TTS 或 QuickRead 服务。"
          }
        }
      }
    },
    "历史只保存远程引用": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf speichert nur den Remoteverweis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History stores remote references only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial solo guarda referencias remotas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique ne conserve que les références distantes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास में केवल रिमोट संदर्भ सेव होते हैं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia salva solo riferimenti remoti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴にはリモート参照のみを保存"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico salva somente referências remotas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史只保存远程引用"
          }
        }
      }
    },
    "文库会保存文件来源、版本和基础元数据；再次打开时从原云盘重新下载，不自动永久保存原文件。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek speichert Quelle, Version und grundlegende Metadaten. Beim erneuten Öffnen wird die Datei wieder aus dem ursprünglichen Cloud-Speicher geladen; die Originaldatei wird nicht dauerhaft gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library saves the file source, version, and basic metadata. When reopened, the file is downloaded again from its original cloud storage and is not automatically kept permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca guarda el origen, la versión y los metadatos básicos del archivo. Al volver a abrirlo, se descarga de nuevo del almacenamiento en la nube original y no se conserva automáticamente de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque enregistre la source, la version et les métadonnées de base du fichier. À la réouverture, le fichier est téléchargé à nouveau depuis son stockage cloud d’origine et n’est pas conservé automatiquement de façon permanente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी फ़ाइल का स्रोत, संस्करण और बुनियादी मेटाडेटा सेव करती है। दोबारा खोलने पर फ़ाइल मूल क्लाउड स्टोरेज से फिर डाउनलोड होती है और मूल फ़ाइल अपने-आप स्थायी रूप से सेव नहीं होती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria salva l’origine, la versione e i metadati di base del file. Alla riapertura, il file viene scaricato di nuovo dal cloud originale e non viene conservato automaticamente in modo permanente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリにはファイルの提供元、バージョン、基本メタデータが保存されます。再度開くと元のクラウドからダウンロードされ、元のファイルが自動的に永続保存されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca salva a origem, a versão e os metadados básicos do arquivo. Ao abri-lo novamente, ele é baixado outra vez do armazenamento em nuvem original e não é mantido automaticamente de forma permanente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文库会保存文件来源、版本和基础元数据；再次打开时从原云盘重新下载，不自动永久保存原文件。"
          }
        }
      }
