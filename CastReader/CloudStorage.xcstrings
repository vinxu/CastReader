          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok felhőkérés történt. Kérjük, próbálja meg később."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming kahilingan sa cloud. Subukan ulit mamaya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan awan. Sila cuba lagi nanti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla bulut isteği yapıldı. Lütfen daha sonra tekrar deneyin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 요청이 너무 많습니다. 나중에 다시 시도하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
