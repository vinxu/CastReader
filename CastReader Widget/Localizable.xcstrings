    "Continue the latest item, or choose a recent CastReader item.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den letzten Inhalt fort oder wähle einen kürzlich verwendeten CastReader-Inhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue the latest item, or choose a recent CastReader item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa el último elemento o elige uno reciente de CastReader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez le dernier élément ou choisissez un élément CastReader récent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे हाल की सामग्री जारी रखें या CastReader की हाल की सामग्री चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua l’ultimo elemento o scegline uno recente di CastReader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の項目を続けるか、CastReaderの最近の項目を選びます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue o item mais recente ou escolha um item recente do CastReader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续最近的内容，或选择一个最近使用的 CastReader 内容。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door met het laatste item, of kies een recent CastReader-item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить последний элемент или выбрать недавний элемент из CastReader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj najnowszy element lub wybierz niedawny element CastReader."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt med senaste objektet, eller välj ett nyligen använt CastReader-objekt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt med det seneste element, eller vælg et nyligt CastReader-element."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett med det siste innholdet, eller velg et nylig åpnet element i CastReader."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka viimeisintä kohdetta tai valitse jokin äskettäin käytetyistä CastReader-kohdista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračovat v nejnovější položce nebo zvolit nedávnou položku z CastReader."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνέχεια του τελευταίου στοιχείου ή επιλογή πρόσφατου στοιχείου CastReader."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytasd a legutóbbi tartalmat, vagy válassz a CastReaderben nemrég megnyitott elemek közül."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magpatuloy sa huling item, o pumili ng kamakailang item sa CastReader."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teruskan item terkini, atau pilih item CastReader terkini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă cel mai recent element sau alege un element deschis recent în CastReader."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع أحدث عنصر، أو اختر عنصرًا حديثًا من CastReader."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근 항목을 이어서 보거나 최근 CastReader 항목을 선택하세요."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan item terakhir, atau pilih item CastReader terbaru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son öğeye devam edin veya yakın tarihli bir CastReader öğesi seçin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך הפריט האחרון או בחירת פריט שנפתח לאחרונה ב־CastReader."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục mục mới nhất hoặc chọn một mục gần đây trong CastReader."
          }
        }
      }
    },
