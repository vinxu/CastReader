    "Continue the latest item, or choose a recent CastReader item." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Setze den letzten Inhalt fort oder wähle einen kürzlich verwendeten CastReader-Inhalt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue the latest item, or choose a recent CastReader item." } },
