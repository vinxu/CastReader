    "widget_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze aktuelle Inhalte mit Vorlesen oder Erklären fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume recent content with Read Aloud or Explain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma contenido reciente con Leer en voz alta o Explicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez un contenu récent avec Lire à voix haute ou Expliquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल की सामग्री को ज़ोर से पढ़ें या समझाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi i contenuti recenti con Leggi ad alta voce o Spiega."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のコンテンツを読み上げまたは解説で再開します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome conteúdos recentes com Ler em voz alta ou Explicar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用朗读或解读继续最近的内容。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervat recente inhoud met Voorlezen of Uitleggen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 내어 읽기 또는 해설 기능으로 최근 콘텐츠를 이어서 보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر في المحتوى الأخير باستخدام القراءة بصوت عالٍ أو الشرح."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите недавний контент в режиме «Чтение вслух» или «Объяснить»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznów ostatnią treść za pomocą funkcji Czytaj na głos lub Wyjaśnij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återuppta nyligen sett innehåll med Läs upp eller Förklara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoptag nyligt indhold med Læs højt eller Forklar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett med nylig innhold ved hjelp av Les høyt eller Forklar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka viimeisintä sisältöä Lue ääneen -toiminnolla tai Selitä-toiminnolla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračujte v nedávném obsahu pomocí funkcí Číst nahlas nebo Vysvětlit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε πρόσφατο περιεχόμενο με Ανάγνωση φωναχτά ή Εξήγηση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytasd a legutóbbi tartalmat a Felolvasás vagy a Magyarázat funkcióval."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ituloy ang huling nilalaman gamit ang Basahin nang Malakas o Ipaliwanag."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan konten terbaru dengan Baca nyaring atau Jelaskan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teruskan kandungan terkini dengan Baca Lantang atau Terangkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son içeriklere Sesli Okuma veya Açıklama ile devam edin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reia conținutul recent prin Citire cu voce tare sau Explică."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך תוכן שנפתח לאחרונה באמצעות הקראה או הסבר."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục nội dung gần đây bằng Đọc thành tiếng hoặc Giải thích."
          }
        }
      }
    },
