{
  "sourceLanguage" : "en",
  "strings" : {
    "Continue ${item} in ${mode} mode" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "${item} im Modus ${mode} fortsetzen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue ${item} in ${mode} mode" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Continuar ${item} en modo ${mode}" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Continuer ${item} en mode ${mode}" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "${item} को ${mode} मोड में जारी रखें" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Continua ${item} in modalità ${mode}" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "${item}を${mode}モードで続ける" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Continuar ${item} no modo ${mode}" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以${mode}模式继续${item}" } }
