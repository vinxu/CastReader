[
  {
    "file": "/etc/nginx/sites-enabled/castreader",
    "directives": [
      "listen 80;",
      "listen [::]:80;",
      "server_name api.castreader.cn;",
      "location = /api/pro/alipay/notify {",
      "proxy_pass http://127.0.0.1:3000;",
      "location = /api/pro/alipay/gateway {",
      "proxy_pass http://127.0.0.1:3000;",
      "location /.well-known/acme-challenge/ { root /var/www/certbot; }",
      "location / { return 301 https://$host$request_uri; }",
      "listen 443 ssl http2;",
      "listen [::]:443 ssl http2;",
      "server_name api.castreader.cn;",
      "location = /api/captioned_speech_partly {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 600s;",
      "proxy_send_timeout 600s;",
      "location = /api/tts/catalog {",
      "location ^~ /download/ {",
      "location ^~ /api/tts/assets/voice-library/ {",
      "location ^~ /api/tts/ {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 600s;",
      "proxy_send_timeout 600s;",
      "location ^~ /api/markdown-tts/ {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 600s;",
      "proxy_send_timeout 600s;",
      "location ^~ /api/regional-assets/ {",
      "access_log off;",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 120s;",
      "location = /documents {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 120s;",
      "location = /sts {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 120s;",
      "location = /async-md-upload-by-url {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 600s;",
      "proxy_send_timeout 600s;",
      "location = /upload {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 900s;",
      "proxy_send_timeout 900s;",
      "location = /api/quickread/ { return 308 /api/quickread$is_args$args; }",
      "location = /api/quickread {",
      "access_log off;",
      "proxy_pass http://127.0.0.1:7777;",
      "proxy_read_timeout 900s;",
      "proxy_send_timeout 900s;",
      "location ^~ /api/quickread/ {",
      "access_log off;",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 900s;",
      "proxy_send_timeout 900s;",
      "location = /voice-gift/request {",
      "location = /zh/voice-gift/request {",
      "location = /ja/voice-gift/request {",
      "location = /es/voice-gift/request {",
      "location = /fr/voice-gift/request {",
      "location = /de/voice-gift/request {",
      "location = /pt-br/voice-gift/request {",
      "location = /it/voice-gift/request {",
      "location = /hi/voice-gift/request {",
      "location ^~ /_voice-gift-web/_next/static/ {",
      "proxy_pass http://127.0.0.1:3001;",
      "access_log off;",
      "location = /api/voice-clone/requests/invitation {",
      "location = /api/voice-clone/requests/draft-prepare {",
      "location = /api/voice-clone/requests/draft-preview {",
      "location = /api/voice-clone/requests/fulfill-draft {",
      "location / {",
      "proxy_pass http://127.0.0.1:3000;",
      "proxy_read_timeout 300s;",
      "listen 80;",
      "listen [::]:80;",
      "server_name quickread.castreader.cn;",
      "access_log off;",
      "location /.well-known/acme-challenge/ { root /var/www/certbot; }",
      "location / { return 301 https://$host$request_uri; }",
      "listen 443 ssl http2;",
      "listen [::]:443 ssl http2;",
      "server_name quickread.castreader.cn;",
      "location = /api/quickread/ { return 308 /api/quickread$is_args$args; }",
      "location = /api/quickread {",
      "access_log off;",
      "proxy_pass http://127.0.0.1:7777;",
      "proxy_read_timeout 900s;",
      "proxy_send_timeout 900s;",
      "location ^~ /api/quickread/ {",
      "access_log off;",
      "proxy_pass $qr_upstream;",
      "proxy_read_timeout 900s;",
      "proxy_send_timeout 900s;",
      "location / { return 404; }"
    ]
  },
  {
    "file": "/etc/nginx/sites-enabled/castreader-voice-api-port",
    "directives": [
      "listen 18443 ssl;",
      "server_name api.castreader.cn;",
      "access_log off;",
      "error_log /var/log/nginx/castreader-voice-api-port-error.log warn;",
      "location ^~ /v1/objects/ {",
      "proxy_pass http://127.0.0.1:32891;",
      "proxy_connect_timeout 3s;",
      "proxy_read_timeout 60s;",
      "proxy_send_timeout 60s;",
      "location = /storage-healthz {",
      "proxy_pass http://127.0.0.1:32891/healthz;",
      "proxy_connect_timeout 3s;",
      "proxy_read_timeout 5s;",
      "location = /v1/developer/voices {",
      "proxy_pass https://127.0.0.1:32890;",
      "proxy_connect_timeout 3s;",
      "proxy_read_timeout 90s;",
      "proxy_send_timeout 20s;",
      "location ^~ /v1/developer/ {",
      "location ^~ /v1/voices/ {",
      "location = /health {",
      "location @developer_worker_unavailable {",
      "location / { return 404; }"
    ]
  }
]