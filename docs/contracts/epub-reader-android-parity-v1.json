  "navigationPolicy": {
    "sourcePriority": [
      "nav",
      "ncx",
      "guide",
      "headings",
      "spine"
    ],
    "minimumResolvedTargetsForUsableCandidate": 1,
    "partialInvalidCandidate": "retain_source_and_disable_bad_entries",
    "maxEntries": 10000,
    "maxDepthInclusive": 64,
    "contentDepthExclusive": 256,
    "keepGroups": true,
    "keepDuplicateTitlesAndTargets": true,
    "ncxOrder": "dom_not_playOrder",
    "sourceRepair": {
      "normalizedTitle": "NFC_remove_Unicode_whitespace_lowercase",
      "repeatedBodyHeadings": "do_not_vote",
      "match": "exact_heading_or_only_empty_text_blocks_before_it",
      "originalGate": "conflicts >= 3 AND conflicts > matches",
      "alternativeGate": "matches >= 3 AND matches > original.matches AND matches >= 4 * max(conflicts, 1)",
      "preserveOriginalDepth": "only_when_entire_normalized_title_sequences_are_equal"
    }
  },
