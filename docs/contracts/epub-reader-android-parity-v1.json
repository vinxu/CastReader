    "landingFromBottom": 0.75,
    "bandContainsWholeTarget": true,
    "boundaryComparison": "inclusive",
    "animationMaximumDistanceInViewports": 1.5,
    "targetDelta": "targetTop - (viewportTop + 0.25 * (viewportBottom - viewportTop))",
    "clampDelta": "max(-remainingBackwardPx, min(remainingForwardPx, targetDelta))",
    "shortFollowMustHaveIntermediateFrames": true,
    "repeatedTicksMustNotRestartSameMotion": true,
    "userDragFlingOrZoomWins": true,
    "explicitTocAlignment": "unobscured_viewport_top",
    "explicitTocAutoPlay": false
  },
