{
  "contract_version": 2,
  "transport": {
    "endpoint": "https://api.castreader.ai/api/events",
    "endpoint_cn": "https://api.castreader.cn/api/events",
    "endpoint_comment": "新版按启动时冻结的 ServiceRouting 分派到 api.castreader.ai / api.castreader.cn；legacy 仅为历史已落盘事件的入库兼容值",
    "batch_max": 20,
    "compatibility": "dual_v2_legacy"
  },
  "required_envelope_fields": [
    "eventId",
    "eventName",
    "eventVersion",
    "occurredAt",
    "environment",
    "clientPlatform",
    "clientVariant",
    "clientVersion",
    "clientRegion",
    "serviceRoute",
    "anonymousId",
    "appSessionId",
    "productArea",
    "surface",
    "properties"
  ],
  "value_domains": {
    "clientVariant": [
      "app_store",
      "testflight",
      "internal",
      "internal_debug",
      "simulator",
      "google_play"
    ],
    "clientRegion": ["global", "cn"],
    "serviceRoute": ["legacy", "global", "cn"],
    "contentSource": [
      "camera",
      "photo_library",
      "file",
      "url",
      "text",
      "clipboard",
      "share_sheet",
      "system",
      "history",
      "kindle",
      "weread",
      "google_books",
      "kobo",
      "oreilly",
      "google_drive",
      "dropbox",
      "onedrive",
      "youtube_ios",
      "youtube_android",
      "unknown"
    ],
    "contentFormat": [
      "photo",
      "pdf",
      "epub",
      "docx",
      "text",
      "web",
      "kindle",
      "weread",
      "google_books",
      "kobo",
      "oreilly",
      "youtube",
      "unknown"
    ],
    "storefront": [
      "us",
      "uk",
      "ca",
      "au",
      "jp",
      "de",
      "fr",
      "it",
      "es",
      "in",
      "br",
      "mx",
      "nl"
    ],
    "librarySource": ["kindle", "weread", "google_books", "kobo", "oreilly"],
    "libraryConnectionStage": [
      "entry_tapped",
      "connection_presented",
      "login_started",
      "login_succeeded",
      "sync_started",
      "sync_completed",
      "cancelled",
      "failed"
    ],
    "contentInputStage": [
      "source_opened",
      "input_confirmed",
      "processing_started",
      "processing_completed",
      "cancelled",
      "failed"
    ],
    "flowResult": ["started", "success", "cancelled", "failed"],
    "bookCountBucket": [
      "none",
      "1",
      "2_5",
      "6_20",
      "21_50",
      "51_plus",
      "unknown"
    ],
    "transactionEnvironment": ["production", "sandbox", "xcode", "unknown"],
    "youtubeEntry": ["share", "clipboard", "scheme", "paste", "sample"],
    "youtubeFailure": [
      "no_captions",
      "live",
      "restricted",
      "unavailable",
      "caption_access",
      "player_bootstrap_failed",
      "youtube_access_limited",
      "unsupported_webview",
      "track_unavailable",
      "timeout",
      "unsupported_language"
    ],
    "youtubeCaptionKind": ["asr", "manual"],
    "firstOpenKind": ["fresh_install", "instrumentation_backfill", "unknown"],
    "attributionProvider": ["apple_ads", "play_install_referrer"],
    "playAttributionResult": ["attributed", "organic", "unavailable", "unsupported", "failed"],
    "campaignSource": ["google_ads", "meta_ads", "tiktok_ads", "microsoft_ads", "organic", "unknown"],
    "campaignMedium": ["cpc", "paid_social", "display", "video", "affiliate", "organic", "unknown"],
    "storefrontChoiceSurface": ["inline", "chooser"],
    "storefrontRecommendationSignal": ["persisted_onboarding", "bound_library", "local_signals", "default"],
    "paywallAction": ["cta_tapped", "dismissed"],
    "offerType": ["introductory", "promotional", "code", "other", "none"],
    "paymentStore": ["app_store", "google_play", "alipay"],
    "accountGateResult": ["success", "cancelled", "failed"],
    "onboardingStep": [
      "auth_gate_viewed",
      "auth_provider_tapped",
      "auth_succeeded",
      "auth_failed",
      "source_chooser_shown",
      "source_selected",
      "library_ready",
      "first_book_opened",
      "first_audio",
      "listen_30s",
      "listen_300s",
      "trial_offer_shown",
      "trial_started",
      "value",
      "storefront",
      "login",
      "scan",
      "first_listen"
    ],
    "onboardingOutcome": ["shown", "tapped", "started", "success", "failed", "skipped", "done"],
    "onboardingSource": [
      "app", "apple", "google", "email", "phone", "kindle", "weread",
      "google_books", "kobo", "oreilly", "file", "camera", "photo_library",
      "clipboard", "url", "text", "unknown", "other"
    ],
    "adAttributionAttemptOutcome": [
      "token_acquired", "referrer_acquired", "retryable_error", "unsupported", "failed",
      "window_expired", "delivery_not_accepted"
    ],
    "adAttributionDiagnosticCode": [
      "simulator", "token_empty", "network_unavailable", "request_timed_out",
      "adservices_unavailable", "unsupported_platform", "unknown",
      "window_expired", "analytics_rejected", "analytics_unavailable",
      "service_unavailable", "service_disconnected", "feature_not_supported",
      "permission_error", "developer_error", "client_error", "distribution_not_play"
    ],
    "growthMarket": ["us", "gb", "other"],
    "growthEligibility": ["eligible", "ineligible"],
    "paywallValueMilestone": [
      "library_ready", "first_audio", "listen_30s", "listen_300s", "quota_exhausted"
    ],
    "planSelectionSource": ["default", "user"],
    "planInterval": ["monthly", "yearly"],
    "resumeReminderAction": ["permission_requested", "scheduled", "opened", "cancelled"],
    "resumeReminderOutcome": ["success", "denied", "failed", "unavailable", "cancelled"],
    "notificationPermissionStatus": [
      "not_determined", "denied", "authorized", "provisional", "ephemeral", "unknown"
    ]
  },
  "events": [
    {
      "name": "app_session_start",
      "legacy_event": "session_start",
      "product_area": "app",
      "required_properties": ["launchType"],
      "optional_properties": []
    },
    {
      "name": "app_first_open",
      "legacy_event": "app_first_open",
      "product_area": "app",
      "required_properties": ["firstOpenKind"],
      "optional_properties": [],
      "comment": "One durable event id per install. iOS freezes fresh_install versus instrumentation_backfill before application defaults are written, retries the same envelope, and excludes backfills from new-install growth cohorts."
    },
    {
      "name": "onboarding_step",
      "legacy_event": "onboarding_step",
      "product_area": "app",
      "required_properties": ["step", "result", "source"],
      "optional_properties": ["durationMs", "errorCode", "bindSessionId", "configId", "storefront", "choiceSurface", "recommendationSignal", "matched"]
    },
    {
      "name": "library_connection",
      "legacy_event": "library_connection",
      "product_area": "reader",
      "required_properties": ["bindSessionId", "source", "stage", "result"],
      "optional_properties": ["errorCode", "durationMs", "bookCountBucket"]
    },
    {
      "name": "content_input_stage",
      "legacy_event": "content_input_stage",
      "product_area": "reader",
      "required_properties": [
        "contentSource",
        "contentFormat",
        "stage",
        "result"
      ],
      "optional_properties": [
        "intendedMode",
        "durationMs",
        "errorCode",
        "storefront"
      ]
    },
    {
      "name": "content_intent",
      "legacy_event": "feature_use",
      "product_area": "reader",
      "required_properties": ["contentSource", "contentFormat"],
      "optional_properties": ["intendedMode", "storefront"]
    },
    {
      "name": "content_ready",
      "legacy_event": "reader_file_loaded",
      "product_area": "reader",
      "required_properties": [
        "contentSource",
        "contentFormat",
        "lengthBucket",
        "paragraphCountBucket"
      ],
      "optional_properties": ["latencyMs", "storefront"]
    },
    {
      "name": "content_failed",
      "legacy_event": "reader_file_error",
      "product_area": "reader",
      "required_properties": [
        "contentSource",
        "contentFormat",
        "result",
        "errorStage",
        "errorCode"
      ],
      "optional_properties": ["latencyMs", "storefront"]
    },
    {
      "name": "yt_share_received",
      "legacy_event": "yt_share_received",
      "product_area": "reader",
      "required_properties": ["entry"],
      "optional_properties": []
    },
    {
      "name": "yt_home_view",
      "legacy_event": "yt_home_view",
      "product_area": "reader",
      "required_properties": ["firstTime"],
      "optional_properties": []
    },
    {
      "name": "yt_extract_done",
      "legacy_event": "yt_extract_done",
      "product_area": "reader",
      "required_properties": [
        "cueCount",
        "paragraphCount",
        "language",
        "elapsedMs"
      ],
      "optional_properties": ["warmSession"]
    },
    {
      "name": "yt_extract_fail",
      "legacy_event": "yt_extract_fail",
      "product_area": "reader",
      "required_properties": ["reason"],
      "optional_properties": []
    },
    {
      "name": "yt_caption_language_open",
      "legacy_event": "yt_caption_language_open",
      "product_area": "reader",
      "required_properties": ["trackCount"],
      "optional_properties": ["playableTrackCount"]
    },
    {
      "name": "yt_caption_language_switch",
      "legacy_event": "yt_caption_language_switch",
      "product_area": "reader",
      "required_properties": ["fromLanguage", "toLanguage", "kind"],
      "optional_properties": ["cacheHit", "elapsedMs"]
    },
    {
      "name": "read_start",
      "legacy_event": "reading_start",
      "product_area": "read_aloud",
      "required_properties": [
        "contentSource",
        "contentFormat",
        "language",
        "voiceId",
        "speed",
        "resume"
      ],
      "optional_properties": ["storefront"]
    },
    {
      "name": "read_first_audio",
      "legacy_event": "perf_metric",
      "product_area": "read_aloud",
      "required_properties": ["latencyMs", "language", "voiceId"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "read_milestone",
      "legacy_event": "playback_progress",
      "product_area": "read_aloud",
      "required_properties": ["milestoneSeconds", "playbackSeconds"],
      "optional_properties": ["completionBucket", "storefront"]
    },
    {
      "name": "read_end",
      "legacy_event": "reading_end",
      "product_area": "read_aloud",
      "required_properties": [
        "result",
        "endReason",
        "playbackSeconds",
        "completionBucket"
      ],
      "optional_properties": ["errorStage", "errorCode", "storefront"]
    },
    {
      "name": "explain_start",
      "legacy_event": "quickread_pipeline_start",
      "product_area": "explain",
      "required_properties": [
        "contentSource",
        "contentFormat",
        "language",
        "scenario"
      ],
      "optional_properties": ["storefront"]
    },
    {
      "name": "explain_first_block",
      "legacy_event": "quickread_player_open",
      "product_area": "explain",
      "required_properties": ["latencyMs", "scenario"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "explain_milestone",
      "legacy_event": "quickread_video_complete",
      "product_area": "explain",
      "required_properties": ["milestone", "blocksStarted", "blocksCompleted"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "explain_end",
      "legacy_event": "quickread_pipeline_done",
      "product_area": "explain",
      "required_properties": [
        "result",
        "endReason",
        "blocksStarted",
        "blocksCompleted",
        "completionBucket"
      ],
      "optional_properties": ["errorStage", "errorCode", "storefront"]
    },
    {
      "name": "paywall_shown",
      "legacy_event": "paywall_shown",
      "product_area": "billing",
      "required_properties": ["trigger", "entitlementState"],
      "optional_properties": [
        "hadMeaningfulReading",
        "valueMilestone",
        "offerEligible",
        "selectedProductId",
        "configId"
      ]
    },
    {
      "name": "home_pro_card_impression",
      "legacy_event": "home_pro_card_impression",
      "product_area": "billing",
      "required_properties": [],
      "optional_properties": []
    },
    {
      "name": "home_pro_card_yearly_purchase_tap",
      "legacy_event": "home_pro_card_yearly_purchase_tap",
      "product_area": "billing",
      "required_properties": [],
      "optional_properties": []
    },
    {
      "name": "home_pro_card_secondary_tap",
      "legacy_event": "home_pro_card_secondary_tap",
      "product_area": "billing",
      "required_properties": [],
      "optional_properties": []
    },
    {
      "name": "purchase_start",
      "legacy_event": "checkout_started",
      "product_area": "billing",
      "required_properties": ["store", "productId", "trigger"],
      "optional_properties": ["transactionEnvironment"]
    },
    {
      "name": "purchase_result",
      "legacy_event": "checkout_completed",
      "legacy_event_by_result": {
        "success": "checkout_completed",
        "cancelled": "checkout_return_cancel",
        "pending": "checkout_error",
        "blocked": "checkout_error",
        "failed": "checkout_error"
      },
      "product_area": "billing",
      "required_properties": ["store", "productId", "trigger", "result"],
      "optional_properties": ["errorCode", "transactionEnvironment", "offerType", "trialDays"]
    },
    {
      "name": "entitlement_activated",
      "legacy_event": "pro_activated",
      "product_area": "billing",
      "required_properties": [
        "store",
        "productId",
        "trigger",
        "activationSource"
      ],
      "optional_properties": ["syncState", "transactionEnvironment", "offerType", "trialDays"]
    },
    {
      "name": "review_prompt_eligible",
      "legacy_event": "rating_prompt_eligible",
      "product_area": "app",
      "required_properties": ["trigger", "store"],
      "optional_properties": []
    },
    {
      "name": "review_request_attempted",
      "legacy_event": "rating_prompt",
      "product_area": "app",
      "required_properties": ["trigger", "store", "result"],
      "optional_properties": ["errorCode"]
    },
    {
      "name": "review_store_link_opened",
      "legacy_event": "rating_store_link_opened",
      "product_area": "app",
      "required_properties": ["trigger", "store"],
      "optional_properties": []
    },
    {
      "name": "ad_attribution_attempt",
      "legacy_event": "ad_attribution_attempt",
      "product_area": "app",
      "required_properties": ["provider", "attemptCount", "outcome", "latencyMs"],
      "optional_properties": ["errorCode"],
      "comment": "Operational diagnostic only. Never contains an AdServices token or account identifier."
    },
    {
      "name": "ad_attribution",
      "legacy_event": "ad_attribution",
      "product_area": "app",
      "required_properties": ["provider", "attributionResult"],
      "optional_properties": ["attributionToken", "attemptCount", "campaignSource", "campaignMedium", "landingTouchId", "campaignId", "adGroupId", "creativeId"],
      "comment": "Apple uses provider=apple_ads and a terminal token that is sealed only after collector acceptance. Android uses provider=play_install_referrer and only bounded source/medium enums plus optional numeric campaign IDs. Raw Play referrer, click IDs, keywords, and campaign names are forbidden."
    },
    {
      "name": "growth_config_assigned",
      "legacy_event": "growth_config_assigned",
      "product_area": "app",
      "required_properties": ["configId", "market", "eligibility"],
      "optional_properties": []
    },
    {
      "name": "paywall_plan_selected",
      "legacy_event": "paywall_plan_selected",
      "product_area": "billing",
      "required_properties": ["productId", "selectionSource", "interval"],
      "optional_properties": ["trigger", "configId", "offerEligible"]
    },
    {
      "name": "paywall_action",
      "legacy_event": "paywall_action",
      "product_area": "billing",
      "required_properties": ["trigger", "productId", "action"],
      "optional_properties": ["offerEligible", "trialDays"]
    },
    {
      "name": "account_gate_result",
      "legacy_event": "account_gate_result",
      "product_area": "billing",
      "required_properties": ["trigger", "productId", "result", "gatePresented"],
      "optional_properties": ["durationMs", "errorCode"]
    },
    {
      "name": "resume_reminder",
      "legacy_event": "resume_reminder",
      "product_area": "app",
      "required_properties": ["action", "result"],
      "optional_properties": ["permissionStatus", "trigger", "daysSinceLastRead", "errorCode"],
      "comment": "Never contains a book title, content text, URL, or notification body."
    }
  ],
  "privacy_forbidden_keys": [
    "content",
    "text",
    "ocrText",
    "fileName",
    "title",
    "url",
    "urlPath",
    "referrer",
    "email",
    "imageData",
    "rawError",
    "responseBody",
    "phone",
    "phoneNumber",
    "smsCode",
    "verificationCode",
    "wechatUid",
    "wereadUid",
    "agreementNo",
    "userId",
    "backendUserId",
    "transactionId",
    "originalTransactionId"
  ]
}
