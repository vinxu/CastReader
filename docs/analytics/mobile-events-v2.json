{
  "contract_version": 2,
  "transport": {
    "endpoint": "https://castreader.ai/api/events",
    "batch_max": 20,
    "compatibility": "dual_v2_legacy"
  },
  "required_envelope_fields": [
    "eventId",
    "eventName",
    "eventVersion",
    "occurredAt",
    "environment",
    "clientPlatform",
    "clientVariant",
    "clientVersion",
    "anonymousId",
    "appSessionId",
    "productArea",
    "surface",
    "properties"
  ],
  "value_domains": {
    "clientVariant": ["app_store", "testflight", "internal", "internal_debug", "simulator", "google_play"],
    "contentSource": ["camera", "photo_library", "file", "url", "text", "clipboard", "share_sheet", "system", "history", "kindle", "weread", "google_books", "kobo", "oreilly", "google_drive", "dropbox", "onedrive", "youtube_ios", "youtube_android", "unknown"],
    "contentFormat": ["photo", "pdf", "epub", "docx", "text", "web", "kindle", "weread", "google_books", "kobo", "oreilly", "youtube", "unknown"],
    "storefront": ["us", "uk", "ca", "au", "jp", "de", "fr", "it", "es", "in", "br", "mx", "nl"],
    "librarySource": ["kindle", "weread", "google_books", "kobo", "oreilly"],
    "libraryConnectionStage": ["entry_tapped", "connection_presented", "login_started", "login_succeeded", "sync_started", "sync_completed", "cancelled", "failed"],
    "contentInputStage": ["source_opened", "input_confirmed", "processing_started", "processing_completed", "cancelled", "failed"],
    "flowResult": ["started", "success", "cancelled", "failed"],
    "bookCountBucket": ["none", "1", "2_5", "6_20", "21_50", "51_plus", "unknown"],
    "transactionEnvironment": ["production", "sandbox", "xcode", "unknown"]
  },
  "events": [
    {
      "name": "app_session_start",
      "legacy_event": "session_start",
      "product_area": "app",
      "required_properties": ["launchType"],
      "optional_properties": []
    },
    {
      "name": "onboarding_step",
      "legacy_event": "onboarding_step",
      "product_area": "app",
      "required_properties": ["step", "result", "source"],
      "optional_properties": []
    },
    {
      "name": "library_connection",
      "legacy_event": "library_connection",
      "product_area": "reader",
      "required_properties": ["bindSessionId", "source", "stage", "result"],
      "optional_properties": ["errorCode", "durationMs", "bookCountBucket"]
    },
    {
      "name": "content_input_stage",
      "legacy_event": "content_input_stage",
      "product_area": "reader",
      "required_properties": ["contentSource", "contentFormat", "stage", "result"],
      "optional_properties": ["intendedMode", "durationMs", "errorCode", "storefront"]
    },
    {
      "name": "content_intent",
      "legacy_event": "feature_use",
      "product_area": "reader",
      "required_properties": ["contentSource", "contentFormat"],
      "optional_properties": ["intendedMode", "storefront"]
    },
    {
      "name": "content_ready",
      "legacy_event": "reader_file_loaded",
      "product_area": "reader",
      "required_properties": ["contentSource", "contentFormat", "lengthBucket", "paragraphCountBucket"],
      "optional_properties": ["latencyMs", "storefront"]
    },
    {
      "name": "content_failed",
      "legacy_event": "reader_file_error",
      "product_area": "reader",
      "required_properties": ["contentSource", "contentFormat", "result", "errorStage", "errorCode"],
      "optional_properties": ["latencyMs", "storefront"]
    },
    {
      "name": "yt_share_received",
      "legacy_event": "yt_share_received",
      "product_area": "reader",
      "required_properties": ["entry"],
      "optional_properties": []
    },
    {
      "name": "yt_home_view",
      "legacy_event": "yt_home_view",
      "product_area": "reader",
      "required_properties": ["firstTime"],
      "optional_properties": []
    },
    {
      "name": "yt_extract_done",
      "legacy_event": "yt_extract_done",
      "product_area": "reader",
      "required_properties": ["cueCount", "paragraphCount", "language", "elapsedMs"],
      "optional_properties": ["warmSession"]
    },
    {
      "name": "yt_extract_fail",
      "legacy_event": "yt_extract_fail",
      "product_area": "reader",
      "required_properties": ["reason"],
      "optional_properties": []
    },
    {
      "name": "yt_caption_language_open",
      "legacy_event": "yt_caption_language_open",
      "product_area": "reader",
      "required_properties": ["trackCount"],
      "optional_properties": ["playableTrackCount"]
    },
    {
      "name": "yt_caption_language_switch",
      "legacy_event": "yt_caption_language_switch",
      "product_area": "reader",
      "required_properties": ["fromLanguage", "toLanguage", "kind"],
      "optional_properties": ["cacheHit", "elapsedMs"]
    },
    {
      "name": "read_start",
      "legacy_event": "reading_start",
      "product_area": "read_aloud",
      "required_properties": ["contentSource", "contentFormat", "language", "voiceId", "speed", "resume"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "read_first_audio",
      "legacy_event": "perf_metric",
      "product_area": "read_aloud",
      "required_properties": ["latencyMs", "language", "voiceId"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "read_milestone",
      "legacy_event": "playback_progress",
      "product_area": "read_aloud",
      "required_properties": ["milestoneSeconds", "playbackSeconds"],
      "optional_properties": ["completionBucket", "storefront"]
    },
    {
      "name": "read_end",
      "legacy_event": "reading_end",
      "product_area": "read_aloud",
      "required_properties": ["result", "endReason", "playbackSeconds", "completionBucket"],
      "optional_properties": ["errorStage", "errorCode", "storefront"]
    },
    {
      "name": "explain_start",
      "legacy_event": "quickread_pipeline_start",
      "product_area": "explain",
      "required_properties": ["contentSource", "contentFormat", "language", "scenario"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "explain_first_block",
      "legacy_event": "quickread_player_open",
      "product_area": "explain",
      "required_properties": ["latencyMs", "scenario"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "explain_milestone",
      "legacy_event": "quickread_video_complete",
      "product_area": "explain",
      "required_properties": ["milestone", "blocksStarted", "blocksCompleted"],
      "optional_properties": ["storefront"]
    },
    {
      "name": "explain_end",
      "legacy_event": "quickread_pipeline_done",
      "product_area": "explain",
      "required_properties": ["result", "endReason", "blocksStarted", "blocksCompleted", "completionBucket"],
      "optional_properties": ["errorStage", "errorCode", "storefront"]
    },
    {
      "name": "paywall_shown",
      "legacy_event": "paywall_shown",
      "product_area": "billing",
      "required_properties": ["trigger", "entitlementState"],
      "optional_properties": ["hadMeaningfulReading"]
    },
    {
      "name": "home_pro_card_impression",
      "legacy_event": "home_pro_card_impression",
      "product_area": "billing",
      "required_properties": [],
      "optional_properties": []
    },
    {
      "name": "home_pro_card_yearly_purchase_tap",
      "legacy_event": "home_pro_card_yearly_purchase_tap",
      "product_area": "billing",
      "required_properties": [],
      "optional_properties": []
    },
    {
      "name": "home_pro_card_secondary_tap",
      "legacy_event": "home_pro_card_secondary_tap",
      "product_area": "billing",
      "required_properties": [],
      "optional_properties": []
    },
    {
      "name": "purchase_start",
      "legacy_event": "checkout_started",
      "product_area": "billing",
      "required_properties": ["store", "productId", "trigger"],
      "optional_properties": ["transactionEnvironment"]
    },
    {
      "name": "purchase_result",
      "legacy_event": "checkout_completed",
      "legacy_event_by_result": {
        "success": "checkout_completed",
        "cancelled": "checkout_return_cancel",
        "pending": "checkout_error",
        "blocked": "checkout_error",
        "failed": "checkout_error"
      },
      "product_area": "billing",
      "required_properties": ["store", "productId", "trigger", "result"],
      "optional_properties": ["errorCode", "transactionEnvironment"]
    },
    {
      "name": "entitlement_activated",
      "legacy_event": "pro_activated",
      "product_area": "billing",
      "required_properties": ["store", "productId", "trigger", "activationSource"],
      "optional_properties": ["syncState", "transactionEnvironment"]
    },
    {
      "name": "review_prompt_eligible",
      "legacy_event": "rating_prompt_eligible",
      "product_area": "app",
      "required_properties": ["trigger", "store"],
      "optional_properties": []
    },
    {
      "name": "review_request_attempted",
      "legacy_event": "rating_prompt",
      "product_area": "app",
      "required_properties": ["trigger", "store", "result"],
      "optional_properties": ["errorCode"]
    },
    {
      "name": "review_store_link_opened",
      "legacy_event": "rating_store_link_opened",
      "product_area": "app",
      "required_properties": ["trigger", "store"],
      "optional_properties": []
    }
  ],
  "privacy_forbidden_keys": [
    "content",
    "text",
    "ocrText",
    "fileName",
    "title",
    "url",
    "urlPath",
    "referrer",
    "email",
    "imageData",
    "rawError",
    "responseBody"
  ]
}
