// 复制本文件为 Secrets.xcconfig（已 gitignore），填入真实值。
QUICKREAD_API_KEY = 

// 云盘 OAuth public client 配置（不是 client secret）。三家分别在各自开发者后台创建 iOS/native app。
// Google Drive 必须使用与 CastReader 登录不同的 Google Cloud project/client，避免解绑互相影响。
GOOGLE_DRIVE_CLIENT_ID = YOUR_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_REDIRECT_SCHEME = com.googleusercontent.apps.unconfigured
DROPBOX_APP_KEY = unconfigured
MICROSOFT_CLIENT_ID = YOUR_MICROSOFT_CLIENT_ID
